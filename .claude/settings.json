{
  "permissions": {
    "deny": [
      "Read(./_build/**)",
      "Read(./deps/**)",
      "Read(./**/node_modules/**)",
      "Read(./apps/retro_hex_chat_web/priv/static/assets/**)",
      "Read(./**/*.beam)",
      "Read(./tmp/**)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/scripts/hooks/guard_bash.py"
          }
        ]
      }
    ]
  }
}
