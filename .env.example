# Required
DATABASE_URL=ecto://user:pass@host/retro_hex_chat_prod
SECRET_KEY_BASE=<run: mix phx.gen.secret>
PHX_HOST=retrohexchat.app

# Dashboard auth (required in production)
DASHBOARD_USER=admin
DASHBOARD_PASSWORD=<strong-password>

# Optional (defaults shown)
PORT=4000
POOL_SIZE=10

# Local development overrides (optional)
# COMPOSE_PROJECT_NAME=retrohexchat_alt
# DEV_DB_PORT=15432
# TEST_DB_PORT=15433
# TEST_PORT=4102
# E2E_PORT=4103
# E2E_BASE_URL=http://localhost:4103
# BASE_URL=http://localhost:4100
# PUBLIC_ORIGIN=http://localhost:4100
# TURN_LISTEN_PORT=13478
# TURN_RELAY_PORT_MIN=50152
# TURN_RELAY_PORT_MAX=50651

# Embedded group-call SFU / WebRTC ICE (optional)
# GROUP_CALL_ENABLED=true
# GROUP_CALL_MAX_PARTICIPANTS=100
# GROUP_CALL_READY_TIMEOUT_MS=10000
# GROUP_CALL_RECONNECT_TIMEOUT_MS=30000
# GROUP_CALL_PEERLESS_TIMEOUT_MS=60000
# GROUP_CALL_CREATE_RATE_LIMIT_COUNT=3
# GROUP_CALL_CREATE_RATE_LIMIT_WINDOW_MS=600000
# GROUP_CALL_JOIN_RATE_LIMIT_COUNT=20
# GROUP_CALL_JOIN_RATE_LIMIT_WINDOW_MS=60000
# GROUP_CALL_SIGNAL_RATE_LIMIT_COUNT=300
# GROUP_CALL_SIGNAL_RATE_LIMIT_WINDOW_MS=60000
# SFU_ICE_PORT_RANGE=50000-50100
# SFU_ICE_TRANSPORT_POLICY=all
# SFU_PUBLIC_IP=

# Deploy target (required for make deploy)
# DEPLOY_USER=myuser
# SUN_IP=1.2.3.4
# SSH_PORT=2222
