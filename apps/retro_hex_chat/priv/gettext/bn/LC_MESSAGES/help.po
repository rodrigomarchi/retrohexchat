msgstr "ভেরিয়েবল সমর্থন সহ স্বনির্ধারিত কমান্ড শর্ট-কাট নির্মাণ করুন।"

#: lib/retro_hex_chat/chat/help_topics/features.ex:426
#, elixir-autogen, elixir-format
msgid "Custom Menus"
msgstr "স্বনির্বাচিত মেনু"

#: lib/retro_hex_chat/chat/help_topics/features.ex:646
#, elixir-autogen, elixir-format
