#: lib/retro_hex_chat/arcade/content/quake_shareware.ex:43
#, elixir-autogen, elixir-format
msgid "Rocket jumping is possible (jump + shoot down) to reach secret areas, at the cost of health."
msgstr "Прыжок на ракете возможен (прыжок + выстрел вниз), чтобы добраться до секретных зон ценой здоровья."

#: lib/retro_hex_chat/arcade/content/controls.ex:46
#: lib/retro_hex_chat/arcade/content/wolfenstein_3d.ex:29
