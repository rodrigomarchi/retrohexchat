msgstr "Завершите ранжированный матч, чтобы войти в него."

#: lib/retro_hex_chat/games/room_facts.ex:195
#, elixir-autogen, elixir-format
msgid "Each game also has its own room."
msgstr "У каждой игры есть своя комната."

#: lib/retro_hex_chat/games/room_facts.ex:215
#, elixir-autogen, elixir-format
