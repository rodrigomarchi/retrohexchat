#: lib/retro_hex_chat/games/catalog.ex:447
#, elixir-autogen, elixir-format
msgid "1 long round — 20-piece igloo, all enemies from the start, "
msgstr "1 длинный раунд — 20 штук иглу, все враги с самого начала,"

#: lib/retro_hex_chat/games/catalog.ex:328
#, elixir-autogen, elixir-format
msgid "3-minute race in permanent darkness with fog bursts. "
msgstr "3-минутная гонка в постоянной темноте с туманными всплесками."

#: lib/retro_hex_chat/games/catalog.ex:196
#, elixir-autogen, elixir-format
msgid "5 sections of intense River Raid action — river starts narrow, "
msgstr "5 секций интенсивного речного рейда — река начинается узкой,"

#: lib/retro_hex_chat/games/catalog.ex:302
#, elixir-autogen, elixir-format
msgid "5 waves of pure chaos from the start."
msgstr "5 волн чистого хаоса с самого начала"

#: lib/retro_hex_chat/games/catalog.ex:343
#, elixir-autogen, elixir-format
msgid "90 seconds of fury"
msgstr "90 секунд ярости"

#: lib/retro_hex_chat/games/catalog.ex:349
#, elixir-autogen, elixir-format
msgid "90 seconds to score maximum overtakes."
msgstr "90 секунд, чтобы набрать максимальные обгоны."

#: lib/retro_hex_chat/games/catalog.ex:431
#, elixir-autogen, elixir-format
msgid "Arctic construction race — jump on floating ice blocks to build your igloo. "
msgstr ""
"Арктическая строительная гонка — прыгайте на плавучие ледяные блоки, чтобы "
"построить иглу."

#: lib/retro_hex_chat/games/catalog.ex:66
#, elixir-autogen, elixir-format
msgid "Arrow keys (Left/Right rotate, Up forward), Space to fire"
msgstr "Стрелы (слева)/Right Вращайся, Вверх, Пространство для огня"

#: lib/retro_hex_chat/games/catalog.ex:139
#, elixir-autogen, elixir-format
msgid "Arrow keys (Left/Right) to move paddle"
msgstr "Стрелы (слева)/Right) для перемещения весла"

#: lib/retro_hex_chat/games/catalog.ex:156
#, elixir-autogen, elixir-format
msgid "Arrow keys (Up/Down) to move shield, Space to catch/release fireball"
msgstr ""
"Стрелы (Вверх)/Down) для перемещения щита, пространство для ловли/release "
"огненный шар"

#: lib/retro_hex_chat/games/catalog.ex:318
#: lib/retro_hex_chat/games/catalog.ex:335
#: lib/retro_hex_chat/games/catalog.ex:352
#, elixir-autogen, elixir-format
msgid "Arrow keys (←/→ lane, ↑ accel, ↓ brake), Space or Shift for turbo"
msgstr ""
"Стрелы (←/→ полоса, ↑ аксел, ↓ тормоз), Пространство или Сдвиг для турбо"

#: lib/retro_hex_chat/games/catalog.ex:404
#: lib/retro_hex_chat/games/catalog.ex:414
#: lib/retro_hex_chat/games/catalog.ex:424
#, elixir-autogen, elixir-format
msgid "Arrow keys (←/→) or A/D to steer"
msgstr "Стрелы (←/→) или A/D управлять"

#: lib/retro_hex_chat/games/catalog.ex:281
#: lib/retro_hex_chat/games/catalog.ex:294
#: lib/retro_hex_chat/games/catalog.ex:304
#, elixir-autogen, elixir-format
msgid "Arrow keys or A/D to move, Space to fire"
msgstr "Стрелочные ключи или A/D Пространство для огня Space to Fire"

#: lib/retro_hex_chat/games/catalog.ex:42
#, elixir-autogen, elixir-format
msgid "Arrow keys or W/S to move paddle"
msgstr "Стрелы или W/S для перемещения весла"

#: lib/retro_hex_chat/games/catalog.ex:226
#: lib/retro_hex_chat/games/catalog.ex:255
#: lib/retro_hex_chat/games/catalog.ex:268
#, elixir-autogen, elixir-format
msgid "Arrow keys or WASD to move, Space or Shift to fire"
msgstr ""
"Стрелочные ключи или WASD для перемещения, пространства или сдвига для "
"стрельбы"

#: lib/retro_hex_chat/games/catalog.ex:213
#, elixir-autogen, elixir-format
msgid "Arrow keys or WASD to move, Space or Shift to punch"
msgstr ""
"Ключи стрелы или WASD для перемещения, пространства или сдвига для удара"

#: lib/retro_hex_chat/games/catalog.ex:368
#: lib/retro_hex_chat/games/catalog.ex:378
#: lib/retro_hex_chat/games/catalog.ex:388
#, elixir-autogen, elixir-format
msgid "Arrow keys or WASD to move, Space or Shift to serve"
msgstr ""
"Стрелы или WASD для перемещения, Пространство или Сдвиг для обслуживания"

#: lib/retro_hex_chat/games/catalog.ex:477
#: lib/retro_hex_chat/games/catalog.ex:491
#: lib/retro_hex_chat/games/catalog.ex:505
#, elixir-autogen, elixir-format
msgid "Arrow keys or WASD to move, Space or Shift to shoot/tackle"
msgstr ""
"Стрелы или WASD для перемещения, Пространство или Сдвиг для стрельбы/tackle"

#: lib/retro_hex_chat/games/catalog.ex:440
#: lib/retro_hex_chat/games/catalog.ex:450
#: lib/retro_hex_chat/games/catalog.ex:460
#, elixir-autogen, elixir-format
msgid "Arrow keys or WASD to move, Up/Down to jump between rows"
msgstr ""
"клавиши стрелы или WASD для перемещения вверх/Down прыгать между рядами"

#: lib/retro_hex_chat/games/catalog.ex:242
#, elixir-autogen, elixir-format
msgid "Arrow keys or WASD to move/aim, Space or Shift to fire"
msgstr "Стрелы или WASD для перемещения/aimПространство или смещение для огня"

#: lib/retro_hex_chat/games/catalog.ex:83
#: lib/retro_hex_chat/games/catalog.ex:100
#: lib/retro_hex_chat/games/catalog.ex:120
#, elixir-autogen, elixir-format
msgid "Arrow keys or WASD to thrust/rotate, Space to fire, Down/S to warp"
msgstr ""
"Стрелы или WASD для тяги/rotateПространство для огня, Down/S деформировать"

#: lib/retro_hex_chat/games/catalog.ex:55
#, elixir-autogen, elixir-format
msgid "Arrow keys to change direction"
msgstr "Стрелы ключи, чтобы изменить направление"

#: lib/retro_hex_chat/games/catalog.ex:189
#, elixir-autogen, elixir-format
msgid "Arrow keys to move/speed, Space to fire"
msgstr "Стрелы ключи для перемещения/speedПространство для огня"

#: lib/retro_hex_chat/games/catalog.ex:176
#: lib/retro_hex_chat/games/catalog.ex:200
#, elixir-autogen, elixir-format
msgid "Arrow keys to move/speed, Space to fire, Shift to drop mine"
msgstr ""
"Стрелы ключи для перемещения/speedSpace to fire, Shift to drop mine "
"(недоступная ссылка)"

#: lib/retro_hex_chat/games/catalog.ex:60
#, elixir-autogen, elixir-format
msgid "Blast through the maze"
msgstr "Взрыв через лабиринт"

#: lib/retro_hex_chat/games/catalog.ex:301
#, elixir-autogen, elixir-format
msgid "Blitz Space Invaders — instant alien drops, easier combos, "
msgstr ""
"Blitz Space Invaders — мгновенные инопланетные капли, более простые "
"комбинации"

#: lib/retro_hex_chat/games/catalog.ex:128
#, elixir-autogen, elixir-format
msgid "Break blocks together"
msgstr "Разбивать блоки вместе"

#: lib/retro_hex_chat/games/catalog.ex:429
#, elixir-autogen, elixir-format
msgid "Build or be frozen"
msgstr "Построить или заморозить"

#: lib/retro_hex_chat/games/catalog.ex:231
#, elixir-autogen, elixir-format
msgid "Bullets bounce back"
msgstr "Пули отскакивают назад"

#: lib/retro_hex_chat/games/catalog.ex:237
#, elixir-autogen, elixir-format
msgid "Bullets ricochet once off ceiling/floor. First to 10. Best of 3 rounds."
msgstr "Пули рикошетом с потолка/floorСначала до 10. Лучший из 3 раундов."

#: lib/retro_hex_chat/games/catalog.ex:288
#, elixir-autogen, elixir-format
msgid "Classic co-op Space Invaders — two cannons fighting the same alien waves. "
msgstr ""
"Классический кооператив Space Invaders — две пушки, сражающиеся с "
"одинаковыми инопланетными волнами."

#: lib/retro_hex_chat/games/catalog.ex:279
#, elixir-autogen, elixir-format
msgid "Combos send extra. 10 waves of escalating chaos."
msgstr "Комбо посылают дополнительные 10 волн нарастающего хаоса."

#: lib/retro_hex_chat/games/catalog.ex:130
#, elixir-autogen, elixir-format
msgid "Cooperative Breakout with two paddles — one at the top, one at the bottom. "
msgstr "Кооперативный прорыв с двумя веслами — один вверху, один внизу."

#: lib/retro_hex_chat/games/catalog.ex:34
#, elixir-autogen, elixir-format
msgid "Cyberpunk Pong"
msgstr "Киберпанк-понг"

#: lib/retro_hex_chat/games/catalog.ex:345
#, elixir-autogen, elixir-format
msgid "Daylight sprint — no weather changes, no fuel drain, just speed. "
msgstr ""
"Дневной спринт — нет изменений погоды, нет слива топлива, только скорость."

#: lib/retro_hex_chat/games/catalog.ex:286
#, elixir-autogen, elixir-format
msgid "Defend Earth together"
msgstr "Защитим Землю вместе"

#: lib/retro_hex_chat/games/catalog.ex:144
#, elixir-autogen, elixir-format
msgid "Defend your castle"
msgstr "Защитите свой замок"

#: lib/retro_hex_chat/games/catalog.ex:150
#, elixir-autogen, elixir-format
msgid "Deflect or catch the fireball to smash your opponent's walls. Last king standing wins."
msgstr ""
"Отклоняйте или ловите огненный шар, чтобы разбить стены противника. Победит "
"последний король."

#: lib/retro_hex_chat/games/catalog.ex:221
#, elixir-autogen, elixir-format
msgid "Dodge bullets you can see coming. First to 10. Best of 3 rounds."
msgstr ""
"Уклоняйтесь от пуль, которые вы видите. Сначала до 10. Лучший из 3 раундов."

#: lib/retro_hex_chat/games/catalog.ex:266
#, elixir-autogen, elixir-format
msgid "Dodge freely in your half. First to 10. Best of 3 rounds."
msgstr ""
"Уклоняйтесь свободно в своей половине. Сначала до 10. Лучший из 3 раундов."

#: lib/retro_hex_chat/games/catalog.ex:71
#, elixir-autogen, elixir-format
msgid "Dogfight in the void"
msgstr "Собачий бой в пустоте"

#: lib/retro_hex_chat/games/catalog.ex:47
#, elixir-autogen, elixir-format
msgid "Don't cross the line"
msgstr "Не пересекай линию"

#: lib/retro_hex_chat/games/catalog.ex:218
#, elixir-autogen, elixir-format
msgid "Draw at high noon"
msgstr "Рисуем в полдень"

#: lib/retro_hex_chat/games/catalog.ex:385
#, elixir-autogen, elixir-format
msgid "Every point wins a game — no 15-30-40, no deuce. "
msgstr "Каждое очко выигрывает игру — нет 15-30-40, нет двойки."

#: lib/retro_hex_chat/games/catalog.ex:482
#, elixir-autogen, elixir-format
msgid "Fast and brutal"
msgstr "Быстрый и жестокий"

#: lib/retro_hex_chat/games/catalog.ex:194
#, elixir-autogen, elixir-format
msgid "Fast and furious"
msgstr "Быстрый и яростный"

#: lib/retro_hex_chat/games/catalog.ex:422
#, elixir-autogen, elixir-format
msgid "Fastest time down the mountain wins."
msgstr "Самое быстрое время в горах побеждает."

#: lib/retro_hex_chat/games/catalog.ex:110
#, elixir-autogen, elixir-format
msgid "Fight through a field of floating asteroids that block missiles and kill on contact. "
msgstr ""
"Сражайтесь через поле плавающих астероидов, которые блокируют ракеты и "
"убивают при контакте."

#: lib/retro_hex_chat/games/catalog.ex:40
#, elixir-autogen, elixir-format
msgid "First to 11 points (win by 2). Ball speeds up on each rally."
msgstr "Сначала 11 очков (выигрыш на 2). Шар ускоряется на каждом ралли."

#: lib/retro_hex_chat/games/catalog.ex:373
#, elixir-autogen, elixir-format
msgid "First to 3 games"
msgstr "Первый до 3 игр"

#: lib/retro_hex_chat/games/catalog.ex:386
#, elixir-autogen, elixir-format
msgid "First to 6 games takes the set. Pure pressure."
msgstr "Первая до 6 игр занимает сет. Чистое давление."

#: lib/retro_hex_chat/games/catalog.ex:458
#, elixir-autogen, elixir-format
msgid "First to complete the igloo wins. Fair and square."
msgstr "Сначала доиграем иглу. Справедливо и честно."

#: lib/retro_hex_chat/games/catalog.ex:496
#, elixir-autogen, elixir-format
msgid "First to five"
msgstr "Первый до пяти"

#: lib/retro_hex_chat/games/catalog.ex:205
#, elixir-autogen, elixir-format
msgid "Fists of fury"
msgstr "Кулаки ярости"

#: lib/retro_hex_chat/games/catalog.ex:366
#, elixir-autogen, elixir-format
msgid "Full set with tiebreak at 6-6. Deuce, advantage, the works."
msgstr "Полный комплект с тай-брейком на 6-6. Дьюс, преимущество, работа."

#: lib/retro_hex_chat/games/catalog.ex:326
#, elixir-autogen, elixir-format
msgid "Headlights only"
msgstr "Только фары"

#: lib/retro_hex_chat/games/catalog.ex:50
#, elixir-autogen, elixir-format
msgid "Hit a trail or the wall and you're out. Trap your opponent to win."
msgstr ""
"Ударь по тропе или стене, и ты уйдешь. Поймайте противника, чтобы выиграть."

#: lib/retro_hex_chat/games/catalog.ex:411
#, elixir-autogen, elixir-format
msgid "Infinite descent — the avalanche never stops accelerating. "
msgstr "Бесконечный спуск — лавина никогда не перестает ускоряться."

#: lib/retro_hex_chat/games/catalog.ex:412
#, elixir-autogen, elixir-format
msgid "Last skier standing wins. Pure survival."
msgstr "Победит последний лыжник. Чистое выживание."

#: lib/retro_hex_chat/games/catalog.ex:247
#, elixir-autogen, elixir-format
msgid "Moving cover"
msgstr "Движущаяся крышка"

#: lib/retro_hex_chat/games/catalog.ex:108
#, elixir-autogen, elixir-format
msgid "Navigate the wreckage"
msgstr "Навигация по обломкам"

#: lib/retro_hex_chat/games/catalog.ex:465
#, elixir-autogen, elixir-format
msgid "Neon ice warfare"
msgstr "Неоновая ледяная война"

#: lib/retro_hex_chat/games/catalog.ex:73
#, elixir-autogen, elixir-format
msgid "Newtonian space combat — thrust, rotate, and fire missiles in open vacuum. "
msgstr ""
"Ньютоновское космическое сражение — тяга, вращение и запуск ракет в открытом"
" вакууме."

#: lib/retro_hex_chat/games/catalog.ex:292
#, elixir-autogen, elixir-format
msgid "No alien drop. Survive together or fall together."
msgstr "Никаких инопланетных капель. Выжить вместе или упасть вместе."

#: lib/retro_hex_chat/games/catalog.ex:421
#, elixir-autogen, elixir-format
msgid "No avalanche, no items — just trees, rocks, and gates. "
msgstr "Нет лавины, нет предметов — только деревья, камни и ворота."

#: lib/retro_hex_chat/games/catalog.ex:299
#, elixir-autogen, elixir-format
msgid "No mercy, no delay"
msgstr "Никакой пощады, никакой задержки."

#: lib/retro_hex_chat/games/catalog.ex:181
#, elixir-autogen, elixir-format
msgid "No mines, pure skill"
msgstr "Никаких мин, чистое мастерство"

#: lib/retro_hex_chat/games/catalog.ex:455
#, elixir-autogen, elixir-format
msgid "No stealing, pure race"
msgstr "Нет воровства, чистая раса"

#: lib/retro_hex_chat/games/catalog.ex:498
#, elixir-autogen, elixir-format
msgid "No timer — first to 5 goals wins. Puck speed increases with each goal scored. "
msgstr ""
"Нет таймера — сначала выигрывает 5 голов. Скорость шайбы увеличивается с "
"каждым забитым голом."

#: lib/retro_hex_chat/games/catalog.ex:260
#, elixir-autogen, elixir-format
msgid "Nowhere to hide"
msgstr "Негде спрятаться"

#: lib/retro_hex_chat/games/catalog.ex:445
#, elixir-autogen, elixir-format
msgid "One epic round"
msgstr "Один эпический раунд"

#: lib/retro_hex_chat/games/catalog.ex:484
#, elixir-autogen, elixir-format
msgid "One period of 3 minutes — faster puck, higher tackle success rate. "
msgstr ""
"Один период в 3 минуты — более быстрая шайба, более высокий показатель "
"успеха."

#: lib/retro_hex_chat/games/catalog.ex:383
#, elixir-autogen, elixir-format
msgid "One point, one game"
msgstr "Одно очко, одна игра"

#: lib/retro_hex_chat/games/catalog.ex:91
#, elixir-autogen, elixir-format
msgid "Orbit the dying star"
msgstr "Орбита умирающей звезды"

#: lib/retro_hex_chat/games/catalog.ex:93
#, elixir-autogen, elixir-format
msgid "Orbital combat around a central gravity star. "
msgstr "Орбитальный бой вокруг центральной гравитационной звезды."

#: lib/retro_hex_chat/games/catalog.ex:409
#, elixir-autogen, elixir-format
msgid "Outrun the wasteland"
msgstr "Опередить пустошь"

#: lib/retro_hex_chat/games/catalog.ex:312
#, elixir-autogen, elixir-format
msgid "Overtake AI cars and your opponent, manage fuel, draft in slipstreams. Best of 3 days."
msgstr ""
"Обгоняйте ИИ-автомобили и вашего противника, управляйте топливом, призывайте"
" в слипстримы. Лучше всего 3 дня."

#: lib/retro_hex_chat/games/catalog.ex:36
#, elixir-autogen, elixir-format
msgid "Pong reimagined as cyberpunk arcade — neon glow, CRT scanlines, synth audio. "
msgstr ""
"Pong переосмыслен как аркада киберпанка — неоновое свечение, CRT-"
"сканирование, синтезаторное аудио."

#: lib/retro_hex_chat/games/catalog.ex:311
#, elixir-autogen, elixir-format
msgid "Pseudo-3D racing duel through day, snow, fog, and night. "
msgstr "Псевдо-3D гонки дуэль днем, снегом, туманом и ночью."

#: lib/retro_hex_chat/games/catalog.ex:184
#, elixir-autogen, elixir-format
msgid "Pure competition for points, fuel, and survival across 10 sections."
msgstr "Чистая конкуренция за очки, топливо и выживание в 10 секциях."

#: lib/retro_hex_chat/games/catalog.ex:457
#, elixir-autogen, elixir-format
msgid "Pure construction race — no block stealing allowed. "
msgstr "Чистая строительная гонка — не допускается кража блоков."

#: lib/retro_hex_chat/games/catalog.ex:419
#, elixir-autogen, elixir-format
msgid "Pure downhill duel"
msgstr "Чистая спусковая дуэль"

#: lib/retro_hex_chat/games/catalog.ex:488
#, elixir-autogen, elixir-format
msgid "Pure intensity from start to finish."
msgstr "Чистая интенсивность от начала до конца."

#: lib/retro_hex_chat/games/catalog.ex:329
#, elixir-autogen, elixir-format
msgid "Pure reflexes — most overtakes wins. Headlights only visibility."
msgstr ""
"Чистые рефлексы — большинство обгонов побеждает. Фары только видимость."

#: lib/retro_hex_chat/games/catalog.ex:208
#, elixir-autogen, elixir-format
msgid "Push-and-pull until KO or decision by points. Best of 3 rounds."
msgstr "Нажимайте и тяните до KO или решения по очкам. Лучший из 3 раундов."

#: lib/retro_hex_chat/games/catalog.ex:375
#, elixir-autogen, elixir-format
msgid "Quick tennis match — first to 3 games wins. "
msgstr "Быстрый теннисный матч — сначала до 3-х побед."

#: lib/retro_hex_chat/games/catalog.ex:49
#, elixir-autogen, elixir-format
msgid "Race across a grid arena leaving a glowing trail behind you. "
msgstr "Гонка через сетку, оставляя светящийся след позади вас."

#: lib/retro_hex_chat/games/catalog.ex:393
#, elixir-autogen, elixir-format
msgid "Race the avalanche"
msgstr "Скачайте лавину"

#: lib/retro_hex_chat/games/catalog.ex:309
#, elixir-autogen, elixir-format
msgid "Race through the wasteland"
msgstr "Гонка через пустыню"

#: lib/retro_hex_chat/games/catalog.ex:166
#, elixir-autogen, elixir-format
msgid "River Raid reimagined for two — race through a scrolling toxic canal, destroy enemies, "
msgstr ""
"Речной рейд переосмыслили на двоих — гонка по прокручивающемуся токсическому"
" каналу, уничтожение врагов,"

#: lib/retro_hex_chat/games/catalog.ex:183
#, elixir-autogen, elixir-format
msgid "River Raid without sabotage — no mines allowed. "
msgstr "Рейд без саботажа — мины не допускаются."

#: lib/retro_hex_chat/games/catalog.ex:376
#, elixir-autogen, elixir-format
msgid "Same gameplay, shorter format. No tiebreak needed."
msgstr ""
"Тот же геймплей, более короткий формат. Нет необходимости в тай-брейке."

#: lib/retro_hex_chat/games/catalog.ex:360
#, elixir-autogen, elixir-format
msgid "Serve, rally, win"
msgstr "Служить, ралли, побеждать"

#: lib/retro_hex_chat/games/catalog.ex:63
#, elixir-autogen, elixir-format
msgid "Shots ricochet off walls — use geometry to your advantage."
msgstr "Выстрелы рикошетом со стен — используйте геометрию в своих интересах."

#: lib/retro_hex_chat/games/catalog.ex:275
#, elixir-autogen, elixir-format
msgid "Split-screen Space Invaders — aliens you destroy fall on your opponent as reinforcements. "
msgstr ""
"Space Invaders — инопланетяне, которых вы уничтожаете, падают на вашего "
"противника в качестве подкрепления."

#: lib/retro_hex_chat/games/catalog.ex:435
#, elixir-autogen, elixir-format
msgid "Steal your opponent's blocks for a 2-piece swing. Best of 5 rounds with polar bears, crabs, geese, and clams."
msgstr ""
"Укради блоки противника для качания по 2 штуки. Лучший из 5 раундов с белыми"
" медведями, крабами, гусями и моллюсками."

#: lib/retro_hex_chat/games/catalog.ex:502
#, elixir-autogen, elixir-format
msgid "The pressure builds every time the net shakes."
msgstr "Давление нарастает каждый раз, когда сеть трясется."

#: lib/retro_hex_chat/games/catalog.ex:250
#, elixir-autogen, elixir-format
msgid "Time your shots around the moving obstacle. First to 10. Best of 3 rounds."
msgstr ""
"Пора делать выстрелы вокруг движущегося препятствия. Сначала до 10. Лучший "
"из 3 раундов."

#: lib/retro_hex_chat/games/catalog.ex:395
#, elixir-autogen, elixir-format
msgid "Top-down alpine descent through toxic wastelands — dodge mutant trees, "
msgstr ""
"Нисходящий альпийский спуск через токсичные пустоши — увернуться от "
"мутантных деревьев"

#: lib/retro_hex_chat/games/catalog.ex:207
#, elixir-autogen, elixir-format
msgid "Top-down boxing — close punches score more. "
msgstr "Бокс сверху вниз — ближние удары забивают больше."

#: lib/retro_hex_chat/games/catalog.ex:467
#, elixir-autogen, elixir-format
msgid "Top-down ice hockey in a cyberpunk arena — control your field player, "
msgstr ""
"Сверху вниз хоккей с шайбой на киберпанк-арене — управляйте полевым игроком,"

#: lib/retro_hex_chat/games/catalog.ex:62
#, elixir-autogen, elixir-format
msgid "Top-down tank combat in a destructible maze. "
msgstr "Сверху вниз танковый бой в разрушаемом лабиринте."

#: lib/retro_hex_chat/games/catalog.ex:362
#, elixir-autogen, elixir-format
msgid "Top-down tennis duel — automatic hitting, shot angle depends on ball contact position. "
msgstr ""
"Теннисный поединок сверху вниз — автоматическое ударение, угол выстрела "
"зависит от положения контакта мяча."

#: lib/retro_hex_chat/games/catalog.ex:164
#, elixir-autogen, elixir-format
msgid "Two pilots, one river"
msgstr "Два пилота, одна река"

#: lib/retro_hex_chat/games/catalog.ex:94
#, elixir-autogen, elixir-format
msgid "Use gravity slingshots, but fly too close and the star kills you. First to 7 wins."
msgstr ""
"Используйте гравитационные рогатки, но летите слишком близко, и звезда вас "
"убьет. Сначала 7 побед."

#: lib/retro_hex_chat/games/catalog.ex:114
#, elixir-autogen, elixir-format
msgid "Use the debris for cover — or watch it destroy you. First to 7 wins."
msgstr ""
"Используйте мусор для укрытия или наблюдайте, как он разрушает вас. Сначала "
"7 побед."

#: lib/retro_hex_chat/games/catalog.ex:146
#, elixir-autogen, elixir-format
msgid "Versus Breakout battle — each player defends a brick castle with a king inside. "
msgstr ""
"Versus Breakout Battle — каждый игрок защищает кирпичный замок с королем "
"внутри."

#: lib/retro_hex_chat/games/catalog.ex:262
#, elixir-autogen, elixir-format
msgid "Western duel in open field — no obstacle, full horizontal movement. "
msgstr ""
"Западная дуэль в открытом поле — без препятствий, полное горизонтальное "
"движение."

#: lib/retro_hex_chat/games/catalog.ex:249
#, elixir-autogen, elixir-format
msgid "Western duel with a stagecoach rolling across the arena. "
msgstr "Западный поединок с дилижансом, катящимся по арене."

#: lib/retro_hex_chat/games/catalog.ex:233
#, elixir-autogen, elixir-format
msgid "Western duel with bouncing bullets — fire at angles to bypass the wall. "
msgstr ""
"Западная дуэль с отскакивающими пулями — огонь под углами в обход стены."

#: lib/retro_hex_chat/games/catalog.ex:220
#, elixir-autogen, elixir-format
msgid "Western duel — two gunslingers and a cactus. "
msgstr "Западная дуэль — два стрелка и кактус."

#: lib/retro_hex_chat/games/catalog.ex:134
#, elixir-autogen, elixir-format
msgid "Work together to destroy all blocks before running out of lives."
msgstr ""
"Работайте вместе, чтобы уничтожить все блоки, прежде чем закончится жизнь."

#: lib/retro_hex_chat/games/catalog.ex:77
#, elixir-autogen, elixir-format
msgid "Wraparound edges, hyperspace warp (20% death chance), first to 7 wins."
msgstr ""
"Окружающие края, гиперпространственный варп (20% вероятности смерти), "
"сначала до 7 побед."

#: lib/retro_hex_chat/games/catalog.ex:273
#, elixir-autogen, elixir-format
msgid "Your kills are their problem"
msgstr "Твои убийства - их проблема."

#: lib/retro_hex_chat/games/catalog.ex:399
#, elixir-autogen, elixir-format
msgid "clear slalom gates, outrun the avalanche. Best of 3 runs with rising difficulty."
msgstr ""
"Чистые слаломные ворота, обгоняющие лавину. Лучший из 3-х работает с "
"растущими трудностями."

#: lib/retro_hex_chat/games/catalog.ex:197
#, elixir-autogen, elixir-format
msgid "fuel is scarce, mines recharge faster. Quick and chaotic."
msgstr "Топлива мало, шахты быстрее заряжаются. Быстро и хаотично."

#: lib/retro_hex_chat/games/catalog.ex:471
#, elixir-autogen, elixir-format
msgid "shoot, tackle, and score while your AI goalie defends. 3 periods of 2 minutes."
msgstr ""
"Стреляйте, сражайтесь и забивайте, пока ваш вратарь ИИ защищается. 3 периода"
" по 2 минуты."

#: lib/retro_hex_chat/games/catalog.ex:170
#, elixir-autogen, elixir-format
msgid "steal fuel, and drop mines on your rival. 10 sections of pure chaos."
msgstr "Воруй топливо и бросай мины на соперника. 10 разделов чистого хаоса."

#: lib/retro_hex_chat/games/catalog.ex:448
#, elixir-autogen, elixir-format
msgid "temperature drops slowly. Epic arctic endurance."
msgstr "Температура падает медленно. Эпическая арктическая выносливость."
