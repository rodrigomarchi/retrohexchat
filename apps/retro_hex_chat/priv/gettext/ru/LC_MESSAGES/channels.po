#: lib/retro_hex_chat/channels/modes.ex:216
#, elixir-autogen, elixir-format
msgid "+s and +p are mutually exclusive"
msgstr "+s и +p являются взаимоисключающими"

#: lib/retro_hex_chat/channels/server.ex:1173
#, elixir-autogen, elixir-format
msgid "Already in channel"
msgstr "Уже в канале"

#: lib/retro_hex_chat/channels/policy.ex:47
#, elixir-autogen, elixir-format
msgid "Bad channel key (+k)"
msgstr "Плохой ключ канала (+k)"

#: lib/retro_hex_chat/channels/server.ex:464
#: lib/retro_hex_chat/channels/server.ex:922
#, elixir-autogen, elixir-format
msgid "Banned"
msgstr "запрещенный"

#: lib/retro_hex_chat/channels/policy.ex:153
#, elixir-autogen, elixir-format
msgid "Cannot ban a user with equal or higher rank"
msgstr "Нельзя запретить пользователю с равным или более высоким рангом"

#: lib/retro_hex_chat/channels/policy.ex:126
#, elixir-autogen, elixir-format
msgid "Cannot kick a higher-ranked user"
msgstr "Нельзя пинать высокопоставленного пользователя"

#: lib/retro_hex_chat/channels/policy.ex:63
#, elixir-autogen, elixir-format
msgid "Cannot send to channel (no external messages)"
msgstr "Не может отправлять на канал (без внешних сообщений)"

#: lib/retro_hex_chat/channels/policy.ex:35
#, elixir-autogen, elixir-format
msgid "Channel is full (+l)"
msgstr "Канал заполнен (+l)"

#: lib/retro_hex_chat/channels/policy.ex:41
#, elixir-autogen, elixir-format
msgid "Channel is invite-only (+i)"
msgstr "Канал только для приглашенных (+i)"

#: lib/retro_hex_chat/channels/policy.ex:72
#, elixir-autogen, elixir-format
msgid "Channel is moderated (+m). You need voice (+v) to speak."
msgstr "Канал модерируется (+м). Чтобы говорить, нужен голос (+v)."

#: lib/retro_hex_chat/channels/server.ex:674
#, elixir-autogen, elixir-format
msgid "Channel is not invite-only"
msgstr "Канал не только приглашенный"

#: lib/retro_hex_chat/channels/server.ex:1198
#, elixir-autogen, elixir-format
msgid "Channel join throttle active, please try again shortly"
msgstr "Канал активен, пожалуйста, попробуйте снова в ближайшее время"

#: lib/retro_hex_chat/channels/server.ex:89
#: lib/retro_hex_chat/channels/server.ex:92
#: lib/retro_hex_chat/channels/server.ex:274
#: lib/retro_hex_chat/channels/server.ex:277
#, elixir-autogen, elixir-format
msgid "Channel not found"
msgstr "Канал не найден"

#: lib/retro_hex_chat/channels/policy.ex:116
#: lib/retro_hex_chat/channels/policy.ex:117
#: lib/retro_hex_chat/channels/policy.ex:142
#: lib/retro_hex_chat/channels/policy.ex:143
#: lib/retro_hex_chat/channels/server.ex:717
#: lib/retro_hex_chat/channels/server.ex:731
#: lib/retro_hex_chat/channels/server.ex:734
#, elixir-autogen, elixir-format
msgid "Insufficient privileges"
msgstr "Недостаточные привилегии"

#: lib/retro_hex_chat/channels/policy.ex:169
#: lib/retro_hex_chat/channels/policy.ex:173
#, elixir-autogen, elixir-format
msgid "Insufficient privileges to set channel modes"
msgstr "Недостаточные привилегии для настройки режимов канала"

#: lib/retro_hex_chat/channels/modes.ex:123
#, elixir-autogen, elixir-format
msgid "Invalid mode string: must start with + or -"
msgstr "Недействительная строка режима: должна начинаться с + или -"

#: lib/retro_hex_chat/channels/server.ex:677
#, elixir-autogen, elixir-format
msgid "Knocking is disabled for this channel"
msgstr "Knocking отключен для этого канала"

#: lib/retro_hex_chat/channels/server.ex:369
#, elixir-autogen, elixir-format
msgid "Not in channel"
msgstr "Не в канале"

#: lib/retro_hex_chat/channels/server.ex:785
#, elixir-autogen, elixir-format
msgid "Only the channel owner can transfer ownership"
msgstr "Только владелец канала может передать право собственности"

#: lib/retro_hex_chat/channels/server.ex:993
#, elixir-autogen, elixir-format
msgid "User %{target} is not in channel"
msgstr "Пользователь %{target} Не в канале"

#: lib/retro_hex_chat/channels/server.ex:714
#: lib/retro_hex_chat/channels/server.ex:790
#, elixir-autogen, elixir-format
msgid "User is not in channel"
msgstr "Пользователь не в канале"

#: lib/retro_hex_chat/channels/server.ex:684
#, elixir-autogen, elixir-format
msgid "You are already in that channel"
msgstr "Вы уже находитесь на этом канале."

#: lib/retro_hex_chat/channels/server.ex:681
#, elixir-autogen, elixir-format
msgid "You are banned from that channel"
msgstr "Вам запрещено выходить на этот канал."

#: lib/retro_hex_chat/channels/server.ex:1036
#, elixir-autogen, elixir-format
msgid "You are muted in this channel"
msgstr "Ты приглушен в этом канале"

#: lib/retro_hex_chat/channels/policy.ex:75
#: lib/retro_hex_chat/channels/policy.ex:82
#: lib/retro_hex_chat/channels/policy.ex:97
#, elixir-autogen, elixir-format
msgid "You are not in this channel"
msgstr "Вас нет в этом канале."

#: lib/retro_hex_chat/channels/policy.ex:136
#, elixir-autogen, elixir-format
msgid "You cannot ban yourself"
msgstr "Вы не можете запретить себя"

#: lib/retro_hex_chat/channels/server.ex:525
#: lib/retro_hex_chat/channels/server.ex:551
#: lib/retro_hex_chat/channels/server.ex:577
#: lib/retro_hex_chat/channels/server.ex:603
#, elixir-autogen, elixir-format
msgid "You must be a channel operator"
msgstr "Вы должны быть оператором канала."

#: lib/retro_hex_chat/channels/policy.ex:91
#, elixir-autogen, elixir-format
msgid "You must be a channel operator to change the topic"
msgstr "Вы должны быть оператором канала, чтобы изменить тему."

#: lib/retro_hex_chat/channels/server.ex:622
#: lib/retro_hex_chat/channels/server.ex:938
#, elixir-autogen, elixir-format
msgid "You must be a channel operator to unban users"
msgstr "Вы должны быть оператором канала для запрета пользователей."

#: lib/retro_hex_chat/channels/policy.ex:53
#, elixir-autogen, elixir-format
msgid "You must be registered to join this channel"
msgstr "Вы должны быть зарегистрированы, чтобы присоединиться к этому каналу."
