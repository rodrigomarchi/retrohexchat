msgstr "Список уведомлений (Buddy List)"

#: lib/retro_hex_chat/chat/help_topics/features.ex:2763
#, elixir-autogen, elixir-format
msgid "One intense period of 3 minutes. Puck moves 25% faster, tackles succeed 80% of the time. "
msgstr "Интенсивный период 3 минуты. Шайба движется на 25% быстрее, снасти достигают успеха в 80% случаев."

#: lib/retro_hex_chat/chat/help_topics/features.ex:1484
#, elixir-autogen, elixir-format
msgid "Only one active session per nickname is allowed to prevent conflicts."
msgstr "Для предотвращения конфликтов допускается только один активный сеанс на одно прозвище."

#: lib/retro_hex_chat/chat/help_topics/commands.ex:391
#, elixir-autogen, elixir-format
msgid "Open a private conversation tab with another user."
msgstr "Откройте приватную вкладку разговора с другим пользователем."

#: lib/retro_hex_chat/chat/help_topics/commands.ex:380
#, elixir-autogen, elixir-format
