#: lib/retro_hex_chat/chat/help_topics/features.ex:4485
#, elixir-autogen, elixir-format
msgid "The game room comes with arcade machines, a pool table, a ping-pong table and computers."
msgstr "В игровой комнате есть аркадные автоматы, бильярдный стол, стол для пинг-понга и компьютеры."

#: lib/retro_hex_chat/chat/help_topics/features.ex:4480
#, elixir-autogen, elixir-format
msgid "Its neon door stands on the central island of the End of Time, next to the wooden door of the office."
msgstr "Его неоновая дверь стоит на центральном острове End of Time, рядом с деревянной дверью офиса."

#: lib/retro_hex_chat/chat/help_topics/getting_started.ex:47
#, elixir-autogen, elixir-format
msgid "Open the chat before you have an account: read the public channels live, then sign in to take part."
msgstr "Откройте чат, ещё не имея учётной записи: читайте публичные каналы в прямом эфире, а затем войдите, чтобы участвовать."

#: lib/retro_hex_chat/chat/help_topics/getting_started.ex:35
#, elixir-autogen, elixir-format
msgid "Watching Without an Account"
msgstr "Просмотр без учётной записи"

#: lib/retro_hex_chat/chat/help_topics/getting_started.ex:40
#, elixir-autogen, elixir-format
msgid "guest"
msgstr "гость"

#: lib/retro_hex_chat/chat/help_topics/getting_started.ex:42
#, elixir-autogen, elixir-format
msgid "read only"
msgstr "только чтение"

#: lib/retro_hex_chat/chat/help_topics/getting_started.ex:43
