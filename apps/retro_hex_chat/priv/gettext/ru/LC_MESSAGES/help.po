#, elixir-autogen, elixir-format
msgid "Privacy Settings"
msgstr "Настройки конфиденциальности"

#: lib/retro_hex_chat/chat/help_topics/getting_started.ex:72
#, elixir-autogen, elixir-format
msgid "Private Messages"
msgstr "Личные сообщения"

#: lib/retro_hex_chat/chat/help_topics/features.ex:1785
#, elixir-autogen, elixir-format
msgid "Private message conversations are restored automatically on reconnect, ordered by recency."
msgstr "Диалоги личных сообщений автоматически восстанавливаются при повторном подключении в порядке их актуальности."

#: lib/retro_hex_chat/chat/help_topics/features.ex:486
#, elixir-autogen, elixir-format
msgid "Protect against message flooding with rate limiting and automatic ignore rules."
msgstr "Защита от флуда сообщениями: ограничение частоты и автоматические правила игнорирования."

#: lib/retro_hex_chat/chat/help_topics/features.ex:2840
#, elixir-autogen, elixir-format
msgid "Pseudo-3D racing duel through day, snow, fog, and night. "
msgstr "Псевдо-3D-гоночная дуэль днём, в снегу, в тумане и ночью. "

#: lib/retro_hex_chat/chat/help_topics/features.ex:3145
#, elixir-autogen, elixir-format
msgid "Pure construction race — no block stealing allowed. Stepping on opponent's blocks "
msgstr "Чистая строительная гонка — красть блоки нельзя. Наступать на блоки противника "

#: lib/retro_hex_chat/chat/help_topics/features.ex:3218
#, elixir-autogen, elixir-format
msgid "Pure intensity from start to finish. "
msgstr "Сплошной драйв от начала до конца. "

#: lib/retro_hex_chat/chat/help_topics/commands.ex:739
#, elixir-autogen, elixir-format
msgid "Query the audit log of admin actions with optional filters."
msgstr "Запросить журнал аудита действий администраторов с необязательными фильтрами."

#: lib/retro_hex_chat/chat/help_topics/features.ex:2950
#, elixir-autogen, elixir-format
msgid "Quick tennis match — first to 3 games wins. "
msgstr "Быстрый теннисный матч — побеждает тот, кто первым выиграет 3 гейма. "

#: lib/retro_hex_chat/chat/help_topics/features.ex:822
#, elixir-autogen, elixir-format
msgid "Quit Messages"
msgstr "Сообщения при выходе"

#: lib/retro_hex_chat/chat/help_topics/bots.ex:118
#, elixir-autogen, elixir-format
msgid "RPG dice rolling with standard notation (NdS, modifiers, keep highest/lowest)."
msgstr ""
"РПГ кости катятся со стандартной нотацией (NdS, модификаторы, сохраняйте "
"наивысший уровень)/lowest)."

#: lib/retro_hex_chat/chat/help_topics/features.ex:2327
#, elixir-autogen, elixir-format
msgid "Race across a grid leaving a glowing trail. Hit a trail or wall and you lose."
msgstr "Гонка по сетке с оставлением светящегося следа. Врежетесь в след или стену — проиграете."

#: lib/retro_hex_chat/chat/help_topics/features.ex:1175
#, elixir-autogen, elixir-format
msgid "Real-time latency indicator in the status bar showing network delay to the server."
msgstr "Индикатор задержки в реальном времени в строке состояния, показывающий сетевую задержку до сервера."

#: lib/retro_hex_chat/chat/help_topics/services.ex:54
#, elixir-autogen, elixir-format
msgid "Register and manage channels with ChanServ, including access lists and channel settings."
msgstr "Регистрируйте каналы и управляйте ими с помощью ChanServ, включая списки доступа и настройки каналов."

#: lib/retro_hex_chat/chat/help_topics/services.ex:29
#, elixir-autogen, elixir-format
msgid "Register and protect your nickname with NickServ to prevent others from using it."
msgstr "Зарегистрируйте свой ник и защитите его с помощью NickServ, чтобы другие не могли его использовать."

#: lib/retro_hex_chat/chat/help_topics/commands.ex:561
#, elixir-autogen, elixir-format
msgid "Remove a ban from a channel to allow the user to rejoin."
msgstr "Снять бан с канала, чтобы пользователь мог снова присоединиться."

#: lib/retro_hex_chat/chat/help_topics/commands.ex:884
#, elixir-autogen, elixir-format
msgid "Remove a channel mute from a user, allowing them to send messages again."
msgstr "Снять с пользователя запрет на отправку сообщений в канале, чтобы он снова мог писать."

#: lib/retro_hex_chat/chat/help_topics/commands.ex:207
#, elixir-autogen, elixir-format
msgid "Remove a user from a channel. Requires operator or higher privileges."
msgstr "Удалить пользователя из канала. Требуются права оператора или выше."

#: lib/retro_hex_chat/chat/help_topics/commands.ex:570
#, elixir-autogen, elixir-format
msgid "Remove a user from your ignore list to see their messages again."
msgstr "Удалите пользователя из списка игнорируемых, чтобы снова видеть его сообщения."

#: lib/retro_hex_chat/chat/help_topics/commands.ex:813
#, elixir-autogen, elixir-format
msgid "Remove operator status from a user in the current channel."
msgstr "Снять статус оператора с пользователя в текущем канале."

#: lib/retro_hex_chat/chat/help_topics/special_messages.ex:64
#, elixir-autogen, elixir-format
msgid "Remove the channel welcome message."
msgstr "Удалить приветственное сообщение канала."

#: lib/retro_hex_chat/chat/help_topics/special_messages.ex:43
#, elixir-autogen, elixir-format
msgid "Remove the server's Message of the Day. Requires admin privileges."
msgstr "Удалить сообщение дня сервера. Требуются права администратора."

#: lib/retro_hex_chat/chat/help_topics/commands.ex:840
#, elixir-autogen, elixir-format
msgid "Remove voice status from a user in the current channel."
msgstr "Снять статус голоса с пользователя в текущем канале."

#: lib/retro_hex_chat/chat/help_topics/features.ex:1254
#, elixir-autogen, elixir-format
msgid "Reply to specific messages with quoted context for threaded conversations."
msgstr "Отвечайте на конкретные сообщения с цитатой, чтобы вести ветвистые обсуждения."

#: lib/retro_hex_chat/chat/help_topics/channel_modes.ex:327
#, elixir-autogen, elixir-format
msgid "Request an invitation to join an invite-only channel."
msgstr "Запросить приглашение для входа в канал, доступный только по приглашению."

#: lib/retro_hex_chat/chat/help_topics/channel_modes.ex:165
#, elixir-autogen, elixir-format
msgid "Require a password to join the channel."
msgstr "Требовать пароль для входа в канал."

#: lib/retro_hex_chat/chat/help_topics/channel_modes.ex:130
#, elixir-autogen, elixir-format
msgid "Restrict speaking to voiced users and above in a moderated channel."
msgstr "Разрешить писать в модерируемом канале только пользователям с голосом и выше."

