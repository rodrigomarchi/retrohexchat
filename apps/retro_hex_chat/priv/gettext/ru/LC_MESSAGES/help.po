msgid "resize"
msgstr "изменять размер"

#: lib/retro_hex_chat/chat/help_topics/user_interface.ex:691
#, elixir-autogen, elixir-format
msgid "sort"
msgstr "сортировать"

#: lib/retro_hex_chat/chat/help_topics/user_interface.ex:688
#, elixir-autogen, elixir-format
msgid "table"
msgstr "таблица"

#: lib/retro_hex_chat/chat/help_topics/user_interface.ex:42
#, elixir-autogen, elixir-format
msgid "Connect Window"
msgstr "Окно подключения"

#: lib/retro_hex_chat/chat/help_topics/features.ex:712
#, elixir-autogen, elixir-format
msgid "Clickable nicknames, channels, and URLs, with hover cards and a preview card under any message carrying a link."
msgstr "Кликабельные ники, каналы и URL-адреса, с карточками при наведении и карточкой предпросмотра под любым сообщением со ссылкой."

#: lib/retro_hex_chat/chat/help_topics.ex:61
#: lib/retro_hex_chat/chat/help_topics.ex:91
#: lib/retro_hex_chat/chat/help_topics/commands.ex:337
#: lib/retro_hex_chat/chat/help_topics/commands.ex:350
