msgstr "Управление серверными ботами от Tools Управление ботом, включая статус, возможности, каналы, пользовательские команды и события."

#: lib/retro_hex_chat/chat/help_topics/features.ex:607
#, elixir-autogen, elixir-format
msgid "Message Layout"
msgstr "Расписание сообщений"

#: lib/retro_hex_chat/chat/help_topics/user_interface.ex:331
