msgstr "Навигация по истории команд с помощью Ctrl+ Вверх/Down и поиск с помощью Ctrl+R. Проекты сохраняются на канале."

#: lib/retro_hex_chat/chat/help_topics/features.ex:1938
#, elixir-autogen, elixir-format
msgid "Newtonian space combat in open vacuum. Thrust, rotate, and fire missiles. "
msgstr "Ньютоновские космические бои в открытом вакууме. Тяните, вращайте и стреляйте ракетами."

#: lib/retro_hex_chat/chat/help_topics/features.ex:1491
#, elixir-autogen, elixir-format
msgid "Nick Expiration"
msgstr "Ник Экспирация"

#: lib/retro_hex_chat/chat/help_topics/services.ex:11
#, elixir-autogen, elixir-format
msgid "NickServ Overview"
msgstr "Обзор NickServ"

#: lib/retro_hex_chat/chat/help_topics/commands.ex:572
#, elixir-autogen, elixir-format
msgid "NickServ administration: drop nick registrations, view info, reset passwords."
msgstr "Администрация NickServ: отбрасывать ник-регистрации, просматривать информацию, сбрасывать пароли."

#: lib/retro_hex_chat/chat/help_topics/features.ex:2339
#, elixir-autogen, elixir-format
msgid "No alien drop mechanic. Survive together or fall together. "
msgstr "Никакого инопланетного механика. Выжить вместе или упасть вместе."

#: lib/retro_hex_chat/chat/help_topics/features.ex:2598
#, elixir-autogen, elixir-format
msgid "No avalanche, no items — just trees, rocks, and slalom gates. "
msgstr "Нет лавины, нет предметов — только деревья, скалы и слаломные ворота."

#: lib/retro_hex_chat/chat/help_topics/features.ex:2791
#, elixir-autogen, elixir-format
msgid "No timer — first to 5 goals wins. The puck speeds up after every goal scored, "
msgstr "Нет таймера — сначала выигрывает 5 голов. Шайба ускоряется после каждого забитого гола,"

#: lib/retro_hex_chat/chat/help_topics/features.ex:358
#, elixir-autogen, elixir-format
msgid "Notices"
msgstr "Уведомления"

