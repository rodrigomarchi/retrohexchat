#: lib/retro_hex_chat/chat/help_topics/special_messages.ex:120
#, elixir-autogen, elixir-format
msgid "Overview of special message types including MOTD, welcome messages, wallops, and announcements."
msgstr "Обзор специальных типов сообщений, включая MOTD, приветственные сообщения, валлопы и объявления."

#: lib/retro_hex_chat/chat/help_topics/user_interface.ex:16
#, elixir-autogen, elixir-format
msgid "Overview of the RetroHexChat interface layout including panels, toolbar, and navigation."
msgstr "Обзор макета интерфейса RetroHexChat, включая панели, панель инструментов и навигацию."

