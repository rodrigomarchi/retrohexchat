#: lib/retro_hex_chat/chat/help_topics/features.ex:2365
#, elixir-autogen, elixir-format
msgid "It is also available in Retro Games solo mode against an AI tank."
msgstr "Она также доступна в одиночном режиме «Ретро-игр» против танка с ИИ."

#: lib/retro_hex_chat/chat/help_topics/features.ex:3714
#, elixir-autogen, elixir-format
msgid "Play classic point & click adventures in your browser — "
msgstr "Играйте в классические квесты в стиле point & click прямо в браузере — "

#: lib/retro_hex_chat/chat/help_topics/features.ex:3559
#: lib/retro_hex_chat/chat/help_topics/features.ex:3592
#: lib/retro_hex_chat/chat/help_topics/features.ex:3662
