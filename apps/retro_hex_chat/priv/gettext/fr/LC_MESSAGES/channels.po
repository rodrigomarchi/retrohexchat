#: lib/retro_hex_chat/channels/modes.ex:216
#, elixir-autogen, elixir-format
msgid "+s and +p are mutually exclusive"
msgstr "+s et +p sont mutuellement exclusifs"

#: lib/retro_hex_chat/channels/server.ex:1134
#, elixir-autogen, elixir-format
msgid "Already in channel"
msgstr "Déjà en chaîne"

#: lib/retro_hex_chat/channels/policy.ex:47
#, elixir-autogen, elixir-format
msgid "Bad channel key (+k)"
msgstr "Mauvaise clé de canal (+k)"

#: lib/retro_hex_chat/channels/server.ex:454
#: lib/retro_hex_chat/channels/server.ex:908
#, elixir-autogen, elixir-format
msgid "Banned"
msgstr "Interdit"

#: lib/retro_hex_chat/channels/policy.ex:153
#, elixir-autogen, elixir-format
msgid "Cannot ban a user with equal or higher rank"
msgstr "Impossible d'interdire un utilisateur ayant un rang égal ou supérieur"

#: lib/retro_hex_chat/channels/policy.ex:126
#, elixir-autogen, elixir-format
msgid "Cannot kick a higher-ranked user"
msgstr "Impossible de donner un coup de pied à un utilisateur mieux classé"

#: lib/retro_hex_chat/channels/policy.ex:63
#, elixir-autogen, elixir-format
msgid "Cannot send to channel (no external messages)"
msgstr "Impossible d'envoyer au canal (aucun message externe)"

#: lib/retro_hex_chat/channels/policy.ex:35
#, elixir-autogen, elixir-format
msgid "Channel is full (+l)"
msgstr "Chaîne complète (+l)"

#: lib/retro_hex_chat/channels/policy.ex:41
#, elixir-autogen, elixir-format
msgid "Channel is invite-only (+i)"
msgstr "Channel est uniquement sur invitation (+i)"

#: lib/retro_hex_chat/channels/policy.ex:72
#, elixir-autogen, elixir-format
msgid "Channel is moderated (+m). You need voice (+v) to speak."
msgstr "Le canal est modéré (+m). Vous avez besoin de voix (+v) pour parler."

#: lib/retro_hex_chat/channels/server.ex:662
#, elixir-autogen, elixir-format
msgid "Channel is not invite-only"
msgstr "Channel n'est pas seulement invité"

#: lib/retro_hex_chat/channels/server.ex:1159
#, elixir-autogen, elixir-format
msgid "Channel join throttle active, please try again shortly"
msgstr "Channel rejoindre l'accélérateur actif, veuillez réessayer rapidement"

#: lib/retro_hex_chat/channels/server.ex:79
#: lib/retro_hex_chat/channels/server.ex:82
#: lib/retro_hex_chat/channels/server.ex:264
#: lib/retro_hex_chat/channels/server.ex:267
#, elixir-autogen, elixir-format
msgid "Channel not found"
msgstr "Canal non trouvé"

#: lib/retro_hex_chat/channels/policy.ex:116
#: lib/retro_hex_chat/channels/policy.ex:117
#: lib/retro_hex_chat/channels/policy.ex:142
#: lib/retro_hex_chat/channels/policy.ex:143
#: lib/retro_hex_chat/channels/server.ex:705
#: lib/retro_hex_chat/channels/server.ex:719
#: lib/retro_hex_chat/channels/server.ex:722
#, elixir-autogen, elixir-format
msgid "Insufficient privileges"
msgstr "Privilèges insuffisants"

#: lib/retro_hex_chat/channels/policy.ex:169
#: lib/retro_hex_chat/channels/policy.ex:173
#, elixir-autogen, elixir-format
msgid "Insufficient privileges to set channel modes"
msgstr "Privilèges insuffisants pour définir les modes de canaux"

#: lib/retro_hex_chat/channels/modes.ex:123
#, elixir-autogen, elixir-format
msgid "Invalid mode string: must start with + or -"
msgstr "Chaîne de mode invalide : doit commencer par + ou -"

#: lib/retro_hex_chat/channels/server.ex:665
#, elixir-autogen, elixir-format
msgid "Knocking is disabled for this channel"
msgstr "Knocking est désactivé pour cette chaîne"

#: lib/retro_hex_chat/channels/server.ex:359
#, elixir-autogen, elixir-format
msgid "Not in channel"
msgstr "Pas dans le canal"

#: lib/retro_hex_chat/channels/server.ex:772
#, elixir-autogen, elixir-format
msgid "Only the channel owner can transfer ownership"
msgstr "Seul le propriétaire du canal peut transférer la propriété"

#: lib/retro_hex_chat/channels/server.ex:979
#, elixir-autogen, elixir-format
msgid "User %{target} is not in channel"
msgstr "L'utilisateur %{target} n'est pas dans le canal"

#: lib/retro_hex_chat/channels/server.ex:702
#: lib/retro_hex_chat/channels/server.ex:776
#, elixir-autogen, elixir-format
msgid "User is not in channel"
msgstr "L'utilisateur n'est pas dans le canal"

#: lib/retro_hex_chat/channels/server.ex:672
#, elixir-autogen, elixir-format
msgid "You are already in that channel"
msgstr "Vous êtes déjà dans cette chaîne"

#: lib/retro_hex_chat/channels/server.ex:669
#, elixir-autogen, elixir-format
msgid "You are banned from that channel"
msgstr "Vous êtes interdit de cette chaîne"

#: lib/retro_hex_chat/channels/server.ex:1022
#, elixir-autogen, elixir-format
msgid "You are muted in this channel"
msgstr "Vous êtes muet dans cette chaîne"

#: lib/retro_hex_chat/channels/policy.ex:75
#: lib/retro_hex_chat/channels/policy.ex:82
#: lib/retro_hex_chat/channels/policy.ex:97
#, elixir-autogen, elixir-format
msgid "You are not in this channel"
msgstr "Vous n'êtes pas dans cette chaîne"

#: lib/retro_hex_chat/channels/policy.ex:136
#, elixir-autogen, elixir-format
msgid "You cannot ban yourself"
msgstr "Vous ne pouvez pas vous interdire"

#: lib/retro_hex_chat/channels/server.ex:515
#: lib/retro_hex_chat/channels/server.ex:541
#: lib/retro_hex_chat/channels/server.ex:567
#: lib/retro_hex_chat/channels/server.ex:593
#, elixir-autogen, elixir-format
msgid "You must be a channel operator"
msgstr "Vous devez être un opérateur de canal"

#: lib/retro_hex_chat/channels/policy.ex:91
#, elixir-autogen, elixir-format
msgid "You must be a channel operator to change the topic"
msgstr "Vous devez être un opérateur de canal pour changer le sujet"

#: lib/retro_hex_chat/channels/server.ex:611
#: lib/retro_hex_chat/channels/server.ex:924
#, elixir-autogen, elixir-format
msgid "You must be a channel operator to unban users"
msgstr "Vous devez être un opérateur de canal pour les utilisateurs non interdits"

#: lib/retro_hex_chat/channels/policy.ex:53
#, elixir-autogen, elixir-format
msgid "You must be registered to join this channel"
msgstr "Vous devez être inscrit pour rejoindre cette chaîne"
