msgstr "Course de 3 minutes dans l'obscurité permanente avec rafales de brouillard. "

#: lib/retro_hex_chat/chat/help_topics/features.ex:3152
#, elixir-autogen, elixir-format
msgid "32 deathmatch-focused arena maps for the DOOM engine. BSD license."
msgstr "32 cartes d'aréna axées sur la mort pour le moteur DOOM. Licence BSD."

