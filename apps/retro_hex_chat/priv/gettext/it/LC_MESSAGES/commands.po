msgstr "Mostra la tua lista di autojoin"

#: lib/retro_hex_chat/commands/handlers/notify.ex:44
#, elixir-autogen, elixir-format
msgid "Show your notify list"
msgstr "Mostra la lista degli avvisi"

#: lib/retro_hex_chat/commands/handlers/timer.ex:39
#, elixir-autogen, elixir-format
msgid "Stop a running timer"
msgstr "Ferma un timer in esecuzione"

#: lib/retro_hex_chat/commands/handlers/unignore.ex:15
#, elixir-autogen, elixir-format
msgid "Stop ignoring a user you previously blocked, making their messages visible again."
msgstr ""
"Smettere di ignorare un utente che hai precedentemente bloccato, rendendo i "
"loro messaggi visibili di nuovo."

#: lib/retro_hex_chat/commands/handlers/unignore.ex:20
#, elixir-autogen, elixir-format
msgid "Stop ignoring a user you previously blocked, making their messages visible again.\nNickname is required. Use /ignore with no args to see your ignore list first."
msgstr ""
"Smettere di ignorare un utente che hai precedentemente bloccato, rendendo i loro messaggi visibili di nuovo.\n"
"Nickname è richiesto. Utilizzare /ignore senza args per vedere prima la lista ignorare."

