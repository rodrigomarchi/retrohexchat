#: lib/retro_hex_chat/commands/handlers/unban.ex:17
#, elixir-autogen, elixir-format
msgid "Remove a ban from a user, allowing them to rejoin the channel.\nRequires: channel operator. Must be in a channel."
msgstr ""
"Rimuovere un divieto da un utente, permettendo loro di unirsi al canale.\n"
"Richiede: operatore canale. Dev'essere in un canale."

#: lib/retro_hex_chat/commands/handlers/autojoin.ex:41
#, elixir-autogen, elixir-format
