#: lib/retro_hex_chat/chat/help_topics/features.ex:1576
#, elixir-autogen, elixir-format
msgid "Retro Games"
msgstr "Giochi retro"

#: lib/retro_hex_chat/chat/help_topics/features.ex:1578
#, elixir-autogen, elixir-format
msgid "retro games"
msgstr "giochi retro"

#: lib/retro_hex_chat/chat/help_topics/features.ex:1595
#, elixir-autogen, elixir-format
msgid "Play browser-native RetroHexChat games solo against AI inside the chat desktop. Hex Pong, Light Trails, Star Duel variants, and Hex Outlaw variants are available."
msgstr "Gioca in solitaria contro l'IA ai giochi RetroHexChat nativi del browser dentro il desktop della chat. Hex Pong, Light Trails, le varianti di Star Duel e le varianti di Hex Outlaw sono disponibili."