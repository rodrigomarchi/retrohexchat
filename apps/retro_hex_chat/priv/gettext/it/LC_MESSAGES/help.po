#: lib/retro_hex_chat/chat/help_topics/features.ex:2659
#, elixir-autogen, elixir-format
msgid ""
"1 long epic round — igloo needs 20 pieces, all enemies from the start, "
msgstr ""
"1 giro epico lungo — igloo ha bisogno di 20 pezzi, tutti i nemici "
"dall'inizio,"

#: lib/retro_hex_chat/chat/help_topics/features.ex:2087
#, elixir-autogen, elixir-format
msgid "10 sections of increasing difficulty. Destroy bridges to advance. "
msgstr "10 sezioni di crescente difficoltà. Distruggi ponti per avanzare."

#: lib/retro_hex_chat/chat/help_topics/features.ex:1905
#, elixir-autogen, elixir-format
msgid ""
"2-minute rounds, best of 3. Modes: Classic (open field) and Maze Battle. "
msgstr ""
"2 minuti di giri, meglio di 3. Modalità: Classic (campo aperto) e Maze "
"Battle."

#: lib/retro_hex_chat/chat/help_topics/features.ex:2022
#, elixir-autogen, elixir-format
msgid ""
"3 shared lives, 50 neon blocks (5 rows), ball speeds up. Arrow keys or A/D "
"to move."
msgstr ""
"3 vite condivise, 50 blocchi neon (5 file), la palla accelera. Tasti freccia"
" o A/D per muoversi."

#: lib/retro_hex_chat/chat/help_topics/features.ex:2418
#, elixir-autogen, elixir-format
msgid "3-minute race in permanent darkness with fog bursts. "
msgstr "Gara di 3 minuti nel buio permanente con banchi di nebbia. "

#: lib/retro_hex_chat/chat/help_topics/features.ex:3224
#, elixir-autogen, elixir-format
msgid "32 deathmatch-focused arena maps for the DOOM engine. BSD license."
msgstr ""
"32 mappe dell'arena focalizzate sul deathmatch per il motore DOOM. Patente "
"BSD."

#: lib/retro_hex_chat/chat/help_topics/features.ex:2135
#, elixir-autogen, elixir-format
msgid "5 sections of intense River Raid action — river starts narrow, "
msgstr "5 sezioni di azione intensa del fiume Raid — il fiume inizia stretto,"

#: lib/retro_hex_chat/chat/help_topics/features.ex:2362
#, elixir-autogen, elixir-format
msgid "5 waves of pure chaos from the start. "
msgstr "5 onde di puro caos fin dall'inizio."

#: lib/retro_hex_chat/chat/help_topics/features.ex:1495
#, elixir-autogen, elixir-format
msgid "7 days"
msgstr "7 giorni"

#: lib/retro_hex_chat/chat/help_topics/features.ex:2445
#, elixir-autogen, elixir-format
msgid "90 seconds to score maximum overtakes. "
msgstr "90 secondi per ottenere il massimo superamento."

#: lib/retro_hex_chat/chat/help_topics/features.ex:3311
#, elixir-autogen, elixir-format
msgid ""
"A Viking-themed DOOM total conversion with hand-drawn pixel art — axes, "
"bows, and runic magic. Cacoward 2018 winner."
msgstr ""
"Una conversione totale del DOOM a tema vichingo con pixel art disegnato a "
"mano — assi, archi e magia runica. Cacoward 2018 vincitore."

#: lib/retro_hex_chat/chat/help_topics/features.ex:3195
#, elixir-autogen, elixir-format
msgid ""
"A complete free replacement for DOOM II — 32 levels with the Super Shotgun. "
"Compatible with community PWAD mods."
msgstr ""
"Una sostituzione gratuita completa per DOOM II — 32 livelli con il Super "
"Shotgun. Compatibile con le mod PWAD della comunità."

#: lib/retro_hex_chat/chat/help_topics/features.ex:3366
#, elixir-autogen, elixir-format
msgid ""
"A complete free replacement for Quake — original levels, art, and music "
"under BSD license."
msgstr ""
"Una sostituzione gratuita completa per Quake — livelli originali, arte e "
"musica sotto licenza BSD."

#: lib/retro_hex_chat/chat/help_topics/features.ex:3165
#, elixir-autogen, elixir-format
msgid ""
"A complete free replacement for Ultimate DOOM — 4 episodes, 36 levels with "
"original art and music."
msgstr ""
"Un completo sostituto gratuito per Ultimate DOOM — 4 episodi, 36 livelli con"
" arte originale e musica."

#: lib/retro_hex_chat/chat/help_topics/features.ex:3280
#, elixir-autogen, elixir-format
msgid ""
"A cyberpunk DOOM total conversion with new weapons, enemies, and levels. "
"Standalone v1.2 IWAD."
msgstr ""
"Una conversione totale di DOOM cyberpunk con nuove armi, nemici e livelli. "
"Standalone v1.2 IWAD."

#: lib/retro_hex_chat/chat/help_topics/user_interface.ex:278
#, elixir-autogen, elixir-format
msgid ""
"Access user actions and channel operations through right-click context "
"menus."
msgstr ""
"Accedere alle azioni degli utenti e alle operazioni dei canali tramite menu "
"di scelta rapida."

#: lib/retro_hex_chat/chat/help_topics/commands.ex:146
#, elixir-autogen, elixir-format
msgid "Add a user to your ignore list to hide their messages and actions."
msgstr ""
"Aggiungi un utente alla tua lista ignora per nascondere i loro messaggi e "
"azioni."

#: lib/retro_hex_chat/chat/help_topics/features.ex:498
#, elixir-autogen, elixir-format
msgid ""
"Add custom items to right-click context menus for quick access to commands."
msgstr ""
"Aggiungi elementi personalizzati per fare clic con il pulsante destro del "
"mouse sui menu contestuali per accedere rapidamente ai comandi."

#: lib/retro_hex_chat/chat/help_topics/commands.ex:293
#, elixir-autogen, elixir-format
msgid ""
"Add or remove users from your notify list to track when they connect or "
"disconnect."
msgstr ""
"Aggiungi o rimuovi gli utenti dall'elenco delle notifiche per tracciare "
"quando si collegano o si disconnetteno."

