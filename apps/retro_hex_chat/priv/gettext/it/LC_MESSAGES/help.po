#: lib/retro_hex_chat/chat/help_topics/features.ex:288
#, elixir-autogen, elixir-format
msgid "Send, receive, and manage channel invitations with optional auto-join on invite."
msgstr ""
"Inviare, ricevere e gestire inviti di canale con accesso automatico "
"opzionale su invito."

#: lib/retro_hex_chat/chat/help_topics/features.ex:59
