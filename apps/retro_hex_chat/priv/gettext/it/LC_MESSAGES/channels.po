#: lib/retro_hex_chat/channels/modes.ex:245
#, elixir-autogen, elixir-format
msgid "+s and +p are mutually exclusive"
msgstr "+s e +p sono reciprocamente esclusivi"

#: lib/retro_hex_chat/channels/server.ex:1399
#, elixir-autogen, elixir-format
msgid "Already in channel"
msgstr "Già in canale"

#: lib/retro_hex_chat/channels/policy.ex:47
#, elixir-autogen, elixir-format
msgid "Bad channel key (+k)"
msgstr "Chiave del canale cattivo (+k)"

#: lib/retro_hex_chat/channels/server.ex:569
#: lib/retro_hex_chat/channels/server.ex:1126
#, elixir-autogen, elixir-format
msgid "Banned"
msgstr "Banati"

#: lib/retro_hex_chat/channels/policy.ex:179
#, elixir-autogen, elixir-format
msgid "Cannot ban a user with equal or higher rank"
msgstr "Non può vietare un utente con grado uguale o superiore"

#: lib/retro_hex_chat/channels/policy.ex:152
#, elixir-autogen, elixir-format
msgid "Cannot kick a higher-ranked user"
msgstr "Non può calciare un utente più alto"

#: lib/retro_hex_chat/channels/policy.ex:63
#, elixir-autogen, elixir-format
msgid "Cannot send to channel (no external messages)"
msgstr "Non può inviare al canale (non messaggi esterni)"

#: lib/retro_hex_chat/channels/policy.ex:35
#, elixir-autogen, elixir-format
msgid "Channel is full (+l)"
msgstr "Canale è pieno (+l)"

#: lib/retro_hex_chat/channels/policy.ex:41
#, elixir-autogen, elixir-format
msgid "Channel is invite-only (+i)"
msgstr "Canale è solo invito (+i)"

#: lib/retro_hex_chat/channels/policy.ex:72
#, elixir-autogen, elixir-format
msgid "Channel is moderated (+m). You need voice (+v) to speak."
msgstr "Il canale è moderato (+m). Hai bisogno di voce (+v) per parlare."

#: lib/retro_hex_chat/channels/server.ex:844
#, elixir-autogen, elixir-format
msgid "Channel is not invite-only"
msgstr "Canale non è solo invito"

#: lib/retro_hex_chat/channels/server.ex:1424
#, elixir-autogen, elixir-format
msgid "Channel join throttle active, please try again shortly"
msgstr "Canale unire throttle attivo, si prega di riprovare a breve"

#: lib/retro_hex_chat/channels/server.ex:96
#: lib/retro_hex_chat/channels/server.ex:99
#: lib/retro_hex_chat/channels/server.ex:368
#: lib/retro_hex_chat/channels/server.ex:371
#, elixir-autogen, elixir-format
msgid "Channel not found"
msgstr "Canale non trovato"

#: lib/retro_hex_chat/channels/policy.ex:142
#: lib/retro_hex_chat/channels/policy.ex:143
#: lib/retro_hex_chat/channels/policy.ex:168
#: lib/retro_hex_chat/channels/policy.ex:169
#: lib/retro_hex_chat/channels/server.ex:888
#: lib/retro_hex_chat/channels/server.ex:907
#: lib/retro_hex_chat/channels/server.ex:910
#, elixir-autogen, elixir-format
msgid "Insufficient privileges"
msgstr "privilegi insufficienti"

#: lib/retro_hex_chat/channels/policy.ex:195
#: lib/retro_hex_chat/channels/policy.ex:199
#, elixir-autogen, elixir-format
msgid "Insufficient privileges to set channel modes"
msgstr "privilegi insufficienti per impostare le modalità di canale"

#: lib/retro_hex_chat/channels/modes.ex:152
#, elixir-autogen, elixir-format
msgid "Invalid mode string: must start with + or -"
msgstr "stringa di modalità non valida: deve iniziare con + o -"

#: lib/retro_hex_chat/channels/server.ex:847
#, elixir-autogen, elixir-format
msgid "Knocking is disabled for this channel"
msgstr "Knocking è disabilitato per questo canale"

#: lib/retro_hex_chat/channels/server.ex:470
#, elixir-autogen, elixir-format
msgid "Not in channel"
msgstr "Non nel canale"

#: lib/retro_hex_chat/channels/server.ex:965
#, elixir-autogen, elixir-format
msgid "Only the channel owner can transfer ownership"
msgstr "Solo il proprietario del canale può trasferire la proprietà"

#: lib/retro_hex_chat/channels/server.ex:1212
#, elixir-autogen, elixir-format
msgid "User %{target} is not in channel"
msgstr "Utente %{target} non è in canale"

#: lib/retro_hex_chat/channels/server.ex:885
#: lib/retro_hex_chat/channels/server.ex:970
#, elixir-autogen, elixir-format
msgid "User is not in channel"
msgstr "L'utente non è in canale"

#: lib/retro_hex_chat/channels/server.ex:854
#, elixir-autogen, elixir-format
msgid "You are already in that channel"
msgstr "Sei già in quel canale"

#: lib/retro_hex_chat/channels/server.ex:851
#, elixir-autogen, elixir-format
msgid "You are banned from that channel"
msgstr "Sei vietato da quel canale"

#: lib/retro_hex_chat/channels/server.ex:1255
#, elixir-autogen, elixir-format
msgid "You are muted in this channel"
msgstr "Sei muto in questo canale"

#: lib/retro_hex_chat/channels/policy.ex:75
#: lib/retro_hex_chat/channels/policy.ex:82
#: lib/retro_hex_chat/channels/policy.ex:97
#, elixir-autogen, elixir-format
msgid "You are not in this channel"
msgstr "Tu non sei in questo canale"

#: lib/retro_hex_chat/channels/policy.ex:162
#, elixir-autogen, elixir-format
msgid "You cannot ban yourself"
msgstr "Non puoi vietarti"

#: lib/retro_hex_chat/channels/server.ex:693
#: lib/retro_hex_chat/channels/server.ex:719
#: lib/retro_hex_chat/channels/server.ex:745
#: lib/retro_hex_chat/channels/server.ex:771
#, elixir-autogen, elixir-format
msgid "You must be a channel operator"
msgstr "Devi essere un operatore di canale"

#: lib/retro_hex_chat/channels/policy.ex:91
#, elixir-autogen, elixir-format
msgid "You must be a channel operator to change the topic"
msgstr "Devi essere un operatore di canale per cambiare l'argomento"

#: lib/retro_hex_chat/channels/server.ex:790
#: lib/retro_hex_chat/channels/server.ex:1142
#, elixir-autogen, elixir-format
msgid "You must be a channel operator to unban users"
msgstr "Devi essere un operatore di canale per gli utenti unban"

#: lib/retro_hex_chat/channels/policy.ex:53
#, elixir-autogen, elixir-format
msgid "You must be registered to join this channel"
msgstr "Devi essere registrato per aderire a questo canale"

#: lib/retro_hex_chat/channels/server.ex:892
#, elixir-autogen, elixir-format
msgid "Could not persist channel mute"
msgstr "Impossibile salvare il silenziamento del canale"

#: lib/retro_hex_chat/channels/server.ex:914
#, elixir-autogen, elixir-format
msgid "Could not persist channel unmute"
msgstr "Impossibile salvare la riattivazione dell'audio del canale"

#: lib/retro_hex_chat/channels/departure.ex:30
#, elixir-autogen, elixir-format
msgid "Connection lost"
msgstr "Connessione persa"

#: lib/retro_hex_chat/channels/pins.ex:133
#, elixir-autogen, elixir-format
msgid "That message could not be pinned"
msgstr "Non è stato possibile fissare quel messaggio"

#: lib/retro_hex_chat/channels/pins.ex:161
#: lib/retro_hex_chat/channels/pins.ex:165
#, elixir-autogen, elixir-format
msgid "That message is not in this channel"
msgstr "Quel messaggio non è di questo canale"

#: lib/retro_hex_chat/channels/pins.ex:143
#, elixir-autogen, elixir-format
msgid "This channel already keeps %{count} messages. Unpin one first."
msgstr "Questo canale tiene già %{count} messaggi. Liberane uno prima."

#: lib/retro_hex_chat/channels/policy.ex:122
#, elixir-autogen, elixir-format
msgid "You must be a channel operator to pin messages"
msgstr "Bisogna essere operatori del canale per fissare messaggi"

#: lib/retro_hex_chat/channels/server.ex:1642
#, elixir-autogen, elixir-format
msgid "Only the channel founder can change the public archive"
msgstr "Solo chi ha fondato il canale può cambiare l'archivio pubblico"

#: lib/retro_hex_chat/channels/server.ex:1585
#, elixir-autogen, elixir-format
msgid "%{nickname} scheduled: %{title}"
msgstr "%{nickname} ha programmato: %{title}"

#: lib/retro_hex_chat/channels/server.ex:1617
#, elixir-autogen, elixir-format
msgid "That event belongs to another channel."
msgstr "Quell'evento appartiene a un altro canale."

#: lib/retro_hex_chat/channels/scheduled_events.ex:105
#: lib/retro_hex_chat/channels/scheduled_events.ex:131
#: lib/retro_hex_chat/channels/server.ex:1614
#, elixir-autogen, elixir-format
msgid "That event could not be found."
msgstr "Quell'evento non è stato trovato."

#: lib/retro_hex_chat/channels/policy.ex:132
#, elixir-autogen, elixir-format
msgid "You must be a channel operator to schedule events"
msgstr "Devi essere operatore del canale per programmare eventi"

#: lib/retro_hex_chat/channels/scheduled_events.ex:117
#, elixir-autogen, elixir-format
msgid "Only whoever scheduled it can call it off."
msgstr "Solo chi l'ha programmato può annullarlo."

#: lib/retro_hex_chat/channels/scheduled_events.ex:327
#, elixir-autogen, elixir-format
msgid "That event could not be saved."
msgstr "Impossibile salvare quell'evento."

#: lib/retro_hex_chat/channels/scheduled_events.ex:143
#, elixir-autogen, elixir-format
msgid "That event was called off."
msgstr "Quell'evento è stato annullato."

#: lib/retro_hex_chat/channels/scheduled_events.ex:288
#, elixir-autogen, elixir-format
msgid "That time is already in the past."
msgstr "Quell'orario è già passato."

#: lib/retro_hex_chat/channels/scheduled_events.ex:307
#, elixir-autogen, elixir-format
msgid "This channel already has %{count} events coming up."
msgstr "Questo canale ha già %{count} eventi in programma."

#: lib/retro_hex_chat/channels/scheduled_events.ex:292
#, elixir-autogen, elixir-format
msgid "When does it start?"
msgstr "Quando comincia?"
