#: lib/retro_hex_chat/chat/help_topics/features.ex:2311
#, elixir-autogen, elixir-format
msgid ""
"1 long epic round — igloo needs 20 pieces, all enemies from the start, "
msgstr ""
"1 putaran epik panjang - igloo membutuhkan 20 potong, semua musuh dari awal,"

#: lib/retro_hex_chat/chat/help_topics/features.ex:1740
#, elixir-autogen, elixir-format
msgid "10 sections of increasing difficulty. Destroy bridges to advance. "
msgstr "10 bagian dari peningkatan kesulitan. Hancurkan jembatan untuk maju."

#: lib/retro_hex_chat/chat/help_topics/features.ex:1563
#, elixir-autogen, elixir-format
msgid ""
"2-minute rounds, best of 3. Modes: Classic (open field) and Maze Battle. "
msgstr ""
"2 menit putaran, terbaik dari 3. Mode: Klasik (lapangan terbuka) dan Maze "
"Battle."

#: lib/retro_hex_chat/chat/help_topics/features.ex:1675
#, elixir-autogen, elixir-format
msgid ""
"3 shared lives, 50 neon blocks (5 rows), ball speeds up. Arrow keys or A/D "
"to move."
msgstr ""
"3 kehidupan bersama, 50 blok neon (5 baris), kecepatan bola naik. Kunci "
"panah atau A/D untuk bergerak."

#: lib/retro_hex_chat/chat/help_topics/features.ex:2070
#, elixir-autogen, elixir-format
msgid "3-minute race in permanent darkness with fog bursts. "
msgstr "3 menit balapan dalam kegelapan permanen dengan semburan kabut."

#: lib/retro_hex_chat/chat/help_topics/features.ex:2883
#, elixir-autogen, elixir-format
msgid "32 deathmatch-focused arena maps for the DOOM engine. BSD license."
msgstr "32 pertandingan mematikan. Peta arena untuk mesin DOOM. SIM BSD."

#: lib/retro_hex_chat/chat/help_topics/features.ex:1788
#, elixir-autogen, elixir-format
msgid "5 sections of intense River Raid action — river starts narrow, "
msgstr "5 bagian dari intens tindakan Raid Sungai - sungai mulai sempit,"

#: lib/retro_hex_chat/chat/help_topics/features.ex:2014
#, elixir-autogen, elixir-format
msgid "5 waves of pure chaos from the start. "
msgstr "5 gelombang murni kekacauan dari awal."

#: lib/retro_hex_chat/chat/help_topics/features.ex:1287
#, elixir-autogen, elixir-format
msgid "7 days"
msgstr "7 hari"

#: lib/retro_hex_chat/chat/help_topics/features.ex:2097
#, elixir-autogen, elixir-format
msgid "90 seconds to score maximum overtakes. "
msgstr "90 detik untuk mencetak maksimum menyusul."

#: lib/retro_hex_chat/chat/help_topics/features.ex:2970
#, elixir-autogen, elixir-format
msgid ""
"A Viking-themed DOOM total conversion with hand-drawn pixel art — axes, "
"bows, and runic magic. Cacoward 2018 winner."
msgstr ""
"Sebuah konversi total DOOM bertema Viking dengan seni pixel yang digambar "
"sendiri - kapak, busur, dan sihir unik. Cacoward 2018 pemenang."

#: lib/retro_hex_chat/chat/help_topics/features.ex:2854
#, elixir-autogen, elixir-format
msgid ""
"A complete free replacement for DOOM II — 32 levels with the Super Shotgun. "
"Compatible with community PWAD mods."
msgstr ""
"Sebuah pengganti gratis untuk DOOM II - 32 tingkat dengan Super Shotgun. "
"Compatible with community PWAD mods."

#: lib/retro_hex_chat/chat/help_topics/features.ex:3025
#, elixir-autogen, elixir-format
msgid ""
"A complete free replacement for Quake — original levels, art, and music "
"under BSD license."
msgstr ""
"Sebuah pengganti gratis lengkap untuk Quake - tingkat asli, seni, dan musik "
"di bawah lisensi BSD."

#: lib/retro_hex_chat/chat/help_topics/features.ex:2824
#, elixir-autogen, elixir-format
msgid ""
"A complete free replacement for Ultimate DOOM — 4 episodes, 36 levels with "
"original art and music."
msgstr ""
"Sebuah pengganti bebas lengkap untuk Ultimate DOOM - 4 episode, 36 tingkat "
"dengan seni dan musik asli."

#: lib/retro_hex_chat/chat/help_topics/features.ex:2939
#, elixir-autogen, elixir-format
msgid ""
"A cyberpunk DOOM total conversion with new weapons, enemies, and levels. "
"Standalone v1.2 IWAD."
msgstr ""
"Seorang berandalan total DOOM dengan senjata baru, musuh, dan tingkat. "
"Standalone v1.2 IWAD."

