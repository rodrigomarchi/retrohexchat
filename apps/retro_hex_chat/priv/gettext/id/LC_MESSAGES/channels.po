#, elixir-autogen, elixir-format
msgid "+s and +p are mutually exclusive"
msgstr "+ s dan + p adalah mutually exclusive"

#: lib/retro_hex_chat/channels/server.ex:1418
#, elixir-autogen, elixir-format
msgid "Already in channel"
msgstr "Sudah dalam saluran"

#: lib/retro_hex_chat/channels/policy.ex:47
#, elixir-autogen, elixir-format
msgid "Bad channel key (+k)"
msgstr "Kunci kanal buruk (+ k)"

#: lib/retro_hex_chat/channels/server.ex:588
#: lib/retro_hex_chat/channels/server.ex:1146
#, elixir-autogen, elixir-format
msgid "Banned"
msgstr "Banned"

#: lib/retro_hex_chat/channels/policy.ex:179
#, elixir-autogen, elixir-format
msgid "Cannot ban a user with equal or higher rank"
msgstr ""
"Tidak dapat melarang pengguna dengan peringkat yang sama atau lebih tinggi"

#: lib/retro_hex_chat/channels/policy.ex:152
#, elixir-autogen, elixir-format
msgid "Cannot kick a higher-ranked user"
msgstr "Tidak dapat menendang pengguna peringkat-tinggi"

#: lib/retro_hex_chat/channels/policy.ex:63
#, elixir-autogen, elixir-format
msgid "Cannot send to channel (no external messages)"
msgstr "Tidak dapat mengirim ke saluran (tidak ada pesan eksternal)"

#: lib/retro_hex_chat/channels/policy.ex:35
#, elixir-autogen, elixir-format
msgid "Channel is full (+l)"
msgstr "Saluran penuh (+ l)"

#: lib/retro_hex_chat/channels/policy.ex:41
#, elixir-autogen, elixir-format
msgid "Channel is invite-only (+i)"
msgstr "Kanal invite- hanya (+ i)"

#: lib/retro_hex_chat/channels/policy.ex:72
#, elixir-autogen, elixir-format
msgid "Channel is moderated (+m). You need voice (+v) to speak."
msgstr "Saluran dimoderasi (+ m). Anda perlu suara (+ v) untuk berbicara."

#: lib/retro_hex_chat/channels/server.ex:864
#, elixir-autogen, elixir-format
msgid "Channel is not invite-only"
msgstr "Kanal tidak hanya invite-"

#: lib/retro_hex_chat/channels/server.ex:1441
#, elixir-autogen, elixir-format
msgid "Channel join throttle active, please try again shortly"
msgstr "Kanal bergabung throttle aktif, silakan coba lagi segera"

#: lib/retro_hex_chat/channels/server.ex:97
#: lib/retro_hex_chat/channels/server.ex:100
#: lib/retro_hex_chat/channels/server.ex:243
#: lib/retro_hex_chat/channels/server.ex:250
#: lib/retro_hex_chat/channels/server.ex:387
#: lib/retro_hex_chat/channels/server.ex:390
#, elixir-autogen, elixir-format
msgid "Channel not found"
msgstr "Kanal tak ditemukan"

#: lib/retro_hex_chat/channels/policy.ex:142
#: lib/retro_hex_chat/channels/policy.ex:143
#: lib/retro_hex_chat/channels/policy.ex:168
