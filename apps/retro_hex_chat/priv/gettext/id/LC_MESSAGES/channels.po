#: lib/retro_hex_chat/channels/server.ex:927
#: lib/retro_hex_chat/channels/server.ex:930
#, elixir-autogen, elixir-format
msgid "Insufficient privileges"
msgstr "Hak akses tak mencukupi"

#: lib/retro_hex_chat/channels/policy.ex:226
#: lib/retro_hex_chat/channels/policy.ex:230
#, elixir-autogen, elixir-format
msgid "Insufficient privileges to set channel modes"
msgstr "Tak cukup hak untuk menata mode kanal"

#: lib/retro_hex_chat/channels/modes.ex:152
#, elixir-autogen, elixir-format
msgid "Invalid mode string: must start with + or -"
msgstr "Mode string tidak valid: harus dimulai dengan + atau -"

#: lib/retro_hex_chat/channels/server.ex:867
#, elixir-autogen, elixir-format
msgid "Knocking is disabled for this channel"
msgstr "Mengetuk dinonaktifkan untuk kanal ini"

