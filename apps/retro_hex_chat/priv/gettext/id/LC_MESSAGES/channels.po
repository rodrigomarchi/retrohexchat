#, elixir-autogen, elixir-format
msgid "Not in channel"
msgstr "Tidak dalam saluran"

#: lib/retro_hex_chat/channels/server.ex:985
#, elixir-autogen, elixir-format
msgid "Only the channel owner can transfer ownership"
msgstr "Hanya pemilik saluran yang dapat mentransfer kepemilikan"

#: lib/retro_hex_chat/channels/policy.ex:207
#, elixir-autogen, elixir-format
msgid "User %{target} is not in channel"
msgstr "%{target} pengguna tidak dalam saluran"

#: lib/retro_hex_chat/channels/server.ex:905
