#: lib/retro_hex_chat/channels/modes.ex:258
#, elixir-autogen, elixir-format
msgid "+s and +p are mutually exclusive"
msgstr "+ s dan + p adalah mutually exclusive"

#: lib/retro_hex_chat/channels/server.ex:1597
#, elixir-autogen, elixir-format
msgid "Already in channel"
msgstr "Sudah dalam saluran"

#: lib/retro_hex_chat/channels/policy.ex:47
#, elixir-autogen, elixir-format
msgid "Bad channel key (+k)"
msgstr "Kunci kanal buruk (+ k)"

#: lib/retro_hex_chat/channels/server.ex:695
#: lib/retro_hex_chat/channels/server.ex:1270
#, elixir-autogen, elixir-format
msgid "Banned"
msgstr "Banned"

#: lib/retro_hex_chat/channels/policy.ex:181
#, elixir-autogen, elixir-format
msgid "Cannot ban a user with equal or higher rank"
msgstr ""
"Tidak dapat melarang pengguna dengan peringkat yang sama atau lebih tinggi"

#: lib/retro_hex_chat/channels/policy.ex:154
#, elixir-autogen, elixir-format
msgid "Cannot kick a higher-ranked user"
msgstr "Tidak dapat menendang pengguna peringkat-tinggi"

#: lib/retro_hex_chat/channels/policy.ex:63
#, elixir-autogen, elixir-format
msgid "Cannot send to channel (no external messages)"
msgstr "Tidak dapat mengirim ke saluran (tidak ada pesan eksternal)"

#: lib/retro_hex_chat/channels/policy.ex:35
#, elixir-autogen, elixir-format
msgid "Channel is full (+l)"
msgstr "Saluran penuh (+ l)"

#: lib/retro_hex_chat/channels/policy.ex:41
#, elixir-autogen, elixir-format
msgid "Channel is invite-only (+i)"
msgstr "Kanal invite- hanya (+ i)"

#: lib/retro_hex_chat/channels/policy.ex:74
#, elixir-autogen, elixir-format
msgid "Channel is moderated (+m). You need voice (+v) to speak."
msgstr "Saluran dimoderasi (+ m). Anda perlu suara (+ v) untuk berbicara."

#: lib/retro_hex_chat/channels/server.ex:971
#, elixir-autogen, elixir-format
msgid "Channel is not invite-only"
msgstr "Kanal tidak hanya invite-"

#: lib/retro_hex_chat/channels/server.ex:1620
#, elixir-autogen, elixir-format
msgid "Channel join throttle active, please try again shortly"
msgstr "Kanal bergabung throttle aktif, silakan coba lagi segera"

#: lib/retro_hex_chat/channels/server.ex:100
#: lib/retro_hex_chat/channels/server.ex:103
#: lib/retro_hex_chat/channels/server.ex:246
#: lib/retro_hex_chat/channels/server.ex:253
#: lib/retro_hex_chat/channels/server.ex:390
#: lib/retro_hex_chat/channels/server.ex:393
#, elixir-autogen, elixir-format
msgid "Channel not found"
msgstr "Kanal tak ditemukan"

#: lib/retro_hex_chat/channels/policy.ex:144
#: lib/retro_hex_chat/channels/policy.ex:145
#: lib/retro_hex_chat/channels/policy.ex:170
#: lib/retro_hex_chat/channels/policy.ex:171
#: lib/retro_hex_chat/channels/server.ex:1015
#: lib/retro_hex_chat/channels/server.ex:1034
#: lib/retro_hex_chat/channels/server.ex:1037
#, elixir-autogen, elixir-format
msgid "Insufficient privileges"
msgstr "Hak akses tak mencukupi"

#: lib/retro_hex_chat/channels/policy.ex:228
#: lib/retro_hex_chat/channels/policy.ex:232
#, elixir-autogen, elixir-format
msgid "Insufficient privileges to set channel modes"
msgstr "Tak cukup hak untuk menata mode kanal"

#: lib/retro_hex_chat/channels/modes.ex:165
#, elixir-autogen, elixir-format
msgid "Invalid mode string: must start with + or -"
msgstr "Mode string tidak valid: harus dimulai dengan + atau -"

#: lib/retro_hex_chat/channels/server.ex:974
#, elixir-autogen, elixir-format
msgid "Knocking is disabled for this channel"
msgstr "Mengetuk dinonaktifkan untuk kanal ini"

#: lib/retro_hex_chat/channels/server.ex:567
#, elixir-autogen, elixir-format
msgid "Not in channel"
msgstr "Tidak dalam saluran"

#: lib/retro_hex_chat/channels/server.ex:1092
#, elixir-autogen, elixir-format
msgid "Only the channel owner can transfer ownership"
msgstr "Hanya pemilik saluran yang dapat mentransfer kepemilikan"

#: lib/retro_hex_chat/channels/policy.ex:209
#, elixir-autogen, elixir-format
msgid "User %{target} is not in channel"
msgstr "%{target} pengguna tidak dalam saluran"

#: lib/retro_hex_chat/channels/server.ex:1012
#: lib/retro_hex_chat/channels/server.ex:1097
#, elixir-autogen, elixir-format
msgid "User is not in channel"
msgstr "Pengguna tidak dalam saluran"

#: lib/retro_hex_chat/channels/server.ex:981
#, elixir-autogen, elixir-format
msgid "You are already in that channel"
msgstr "Anda sudah berada di saluran itu"

#: lib/retro_hex_chat/channels/server.ex:978
#, elixir-autogen, elixir-format
msgid "You are banned from that channel"
msgstr "Anda dilarang dari saluran tersebut"

#: lib/retro_hex_chat/channels/server.ex:1398
#, elixir-autogen, elixir-format
msgid "You are muted in this channel"
msgstr "You are muted in this channel"

#: lib/retro_hex_chat/channels/policy.ex:77
#: lib/retro_hex_chat/channels/policy.ex:84
#: lib/retro_hex_chat/channels/policy.ex:99
#, elixir-autogen, elixir-format
msgid "You are not in this channel"
msgstr "Anda tidak dalam saluran ini"

#: lib/retro_hex_chat/channels/policy.ex:164
#, elixir-autogen, elixir-format
msgid "You cannot ban yourself"
msgstr "Anda tidak dapat melarang diri Anda"

#: lib/retro_hex_chat/channels/server.ex:820
#: lib/retro_hex_chat/channels/server.ex:846
#: lib/retro_hex_chat/channels/server.ex:872
#: lib/retro_hex_chat/channels/server.ex:898
#, elixir-autogen, elixir-format
msgid "You must be a channel operator"
msgstr "Anda harus operator saluran"

#: lib/retro_hex_chat/channels/policy.ex:93
#, elixir-autogen, elixir-format
msgid "You must be a channel operator to change the topic"
msgstr "Anda harus menjadi operator saluran untuk mengubah topik"

#: lib/retro_hex_chat/channels/server.ex:917
#: lib/retro_hex_chat/channels/server.ex:1286
#, elixir-autogen, elixir-format
msgid "You must be a channel operator to unban users"
msgstr "Anda harus menjadi operator saluran ke pengguna unban"

#: lib/retro_hex_chat/channels/server.ex:1019
#, elixir-autogen, elixir-format
msgid "Could not persist channel mute"
msgstr "Tidak dapat menyimpan pembisuan kanal"

#: lib/retro_hex_chat/channels/server.ex:1041
#, elixir-autogen, elixir-format
msgid "Could not persist channel unmute"
msgstr "Tidak dapat menyimpan pembatalan bisu kanal"

#: lib/retro_hex_chat/channels/departure.ex:30
#, elixir-autogen, elixir-format
msgid "Connection lost"
msgstr "Koneksi terputus"

#: lib/retro_hex_chat/channels/pins.ex:133
#, elixir-autogen, elixir-format
msgid "That message could not be pinned"
msgstr "Pesan itu tidak dapat disematkan"

#: lib/retro_hex_chat/channels/pins.ex:161
#: lib/retro_hex_chat/channels/pins.ex:165
#, elixir-autogen, elixir-format
msgid "That message is not in this channel"
msgstr "Pesan itu bukan dari kanal ini"

#: lib/retro_hex_chat/channels/pins.ex:143
#, elixir-autogen, elixir-format
msgid "This channel already keeps %{count} messages. Unpin one first."
msgstr "Kanal ini sudah menyimpan %{count} pesan. Lepas satu dulu."

#: lib/retro_hex_chat/channels/policy.ex:124
#, elixir-autogen, elixir-format
msgid "You must be a channel operator to pin messages"
msgstr "Harus jadi operator kanal untuk menyematkan pesan"

#: lib/retro_hex_chat/channels/server.ex:1829
#, elixir-autogen, elixir-format
msgid "Only the channel founder can change the public archive"
msgstr "Hanya pendiri kanal yang dapat mengubah arsip publik"

#: lib/retro_hex_chat/channels/server.ex:1761
#, elixir-autogen, elixir-format
msgid "%{nickname} scheduled: %{title}"
msgstr "%{nickname} menjadwalkan: %{title}"

#: lib/retro_hex_chat/channels/server.ex:1793
#, elixir-autogen, elixir-format
msgid "That event belongs to another channel."
msgstr "Acara itu milik kanal lain."

#: lib/retro_hex_chat/channels/scheduled_events.ex:120
#: lib/retro_hex_chat/channels/scheduled_events.ex:146
#: lib/retro_hex_chat/channels/server.ex:1790
#, elixir-autogen, elixir-format
msgid "That event could not be found."
msgstr "Acara itu tidak ditemukan."

#: lib/retro_hex_chat/channels/policy.ex:134
#, elixir-autogen, elixir-format
msgid "You must be a channel operator to schedule events"
msgstr "Kamu harus menjadi operator kanal untuk menjadwalkan acara"

#: lib/retro_hex_chat/channels/scheduled_events.ex:132
#, elixir-autogen, elixir-format
msgid "Only whoever scheduled it can call it off."
msgstr "Hanya yang menjadwalkannya yang bisa membatalkannya."

#: lib/retro_hex_chat/channels/scheduled_events.ex:345
#, elixir-autogen, elixir-format
msgid "That event could not be saved."
msgstr "Acara itu tidak dapat disimpan."

#: lib/retro_hex_chat/channels/scheduled_events.ex:161
#, elixir-autogen, elixir-format
msgid "That event was called off."
msgstr "Acara itu dibatalkan."

#: lib/retro_hex_chat/channels/scheduled_events.ex:306
#, elixir-autogen, elixir-format
msgid "That time is already in the past."
msgstr "Waktu itu sudah lewat."

#: lib/retro_hex_chat/channels/scheduled_events.ex:325
#, elixir-autogen, elixir-format
msgid "This channel already has %{count} events coming up."
msgstr "Kanal ini sudah punya %{count} acara mendatang."

#: lib/retro_hex_chat/channels/scheduled_events.ex:310
#, elixir-autogen, elixir-format
msgid "When does it start?"
msgstr "Kapan mulainya?"

#: lib/retro_hex_chat/channels/server.ex:1821
#, elixir-autogen, elixir-format
msgid "Identify with NickServ before changing the public archive"
msgstr "Identifikasi diri dengan NickServ sebelum mengubah arsip publik"

#: lib/retro_hex_chat/channels/server.ex:262
#, elixir-autogen, elixir-format
msgid "The archive switch did not answer. Check its state and try again."
msgstr "Sakelar arsip tidak menjawab. Periksa statusnya lalu coba lagi."

#: lib/retro_hex_chat/channels/policy.ex:206
#, elixir-autogen, elixir-format
msgid "Cannot change the role of a user with equal or higher rank"
msgstr "Tidak dapat mengubah peran dari pengguna dengan peringkat yang sama atau lebih tinggi"

#: lib/retro_hex_chat/channels/policy.ex:53
#, elixir-autogen, elixir-format
msgid "You must identify with NickServ to join this channel"
msgstr "Anda harus mengidentifikasi dengan NickServ untuk bergabung saluran ini"
