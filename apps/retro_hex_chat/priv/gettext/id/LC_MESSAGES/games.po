#: lib/retro_hex_chat/games/catalog.ex:52
#, elixir-autogen, elixir-format
msgid "First to 11 points (win by 2). Ball speeds up on each rally."
msgstr ""
"Pertama sampai 11 poin (menang dengan 2). Bola mempercepat pada setiap reli."

#: lib/retro_hex_chat/games/catalog.ex:385
#, elixir-autogen, elixir-format
