msgstr "River Raid tanpa sabotase - tambang tidak diperbolehkan."

#: lib/retro_hex_chat/games/catalog.ex:388
#, elixir-autogen, elixir-format
msgid "Same gameplay, shorter format. No tiebreak needed."
msgstr "Gameplay sama, format pendek. Tidak perlu istirahat."

#: lib/retro_hex_chat/games/catalog.ex:372
#, elixir-autogen, elixir-format
msgid "Serve, rally, win"
msgstr "Melayani, reli, menang"

#: lib/retro_hex_chat/games/catalog.ex:75
#, elixir-autogen, elixir-format
