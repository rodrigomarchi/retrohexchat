#: lib/retro_hex_chat/games/catalog.ex:162
#, elixir-autogen, elixir-format
msgid "Deflect or catch the fireball to smash your opponent's walls. Last king standing wins."
msgstr ""
"Menghina atau menangkap bola api untuk menghancurkan dinding lawan. Raja "
