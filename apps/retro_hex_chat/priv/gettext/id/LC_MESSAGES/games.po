#: lib/retro_hex_chat/games/catalog.ex:397
#, elixir-autogen, elixir-format
msgid "Every point wins a game — no 15-30-40, no deuce. "
msgstr "Setiap poin memenangkan permainan - tidak 15-30-40, tidak ada deuce."

#: lib/retro_hex_chat/games/catalog.ex:494
#, elixir-autogen, elixir-format
msgid "Fast and brutal"
