#: lib/retro_hex_chat/games/catalog.ex:434
#, elixir-autogen, elixir-format
msgid "Fastest time down the mountain wins."
msgstr "Waktu tercepat di gunung menang."

#: lib/retro_hex_chat/games/catalog.ex:122
#, elixir-autogen, elixir-format
msgid "Fight through a field of floating asteroids that block missiles and kill on contact. "
