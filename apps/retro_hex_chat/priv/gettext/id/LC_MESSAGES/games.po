#: lib/retro_hex_chat/games/catalog.ex:59
#, elixir-autogen, elixir-format
msgid "Don't cross the line"
msgstr "Jangan melewati batas."

#: lib/retro_hex_chat/games/catalog.ex:230
#, elixir-autogen, elixir-format
msgid "Draw at high noon"
