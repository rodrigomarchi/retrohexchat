#: lib/retro_hex_chat/games/catalog.ex:220
#, elixir-autogen, elixir-format
msgid "Push-and-pull until KO or decision by points. Best of 3 rounds."
msgstr ""
"Push-dan-tarik sampai KO atau keputusan dengan poin. Terbaik dari 3 putaran."

#: lib/retro_hex_chat/games/catalog.ex:387
#, elixir-autogen, elixir-format
msgid "Quick tennis match — first to 3 games wins. "
msgstr "Pertandingan tenis cepat - pertama sampai 3 pertandingan menang."

#: lib/retro_hex_chat/games/catalog.ex:61
#, elixir-autogen, elixir-format
msgid "Race across a grid arena leaving a glowing trail behind you. "
msgstr "Balapan di arena grid meninggalkan jejak bercahaya di belakang Anda."

#: lib/retro_hex_chat/games/catalog.ex:405
#, elixir-autogen, elixir-format
msgid "Race the avalanche"
msgstr "Balapan longsoran salju"

#: lib/retro_hex_chat/games/catalog.ex:321
#, elixir-autogen, elixir-format
msgid "Race through the wasteland"
msgstr "Balapan melalui gurun"

#: lib/retro_hex_chat/games/catalog.ex:178
#, elixir-autogen, elixir-format
msgid "River Raid reimagined for two — race through a scrolling toxic canal, destroy enemies, "
