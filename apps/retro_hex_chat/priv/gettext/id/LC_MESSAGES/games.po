#: lib/retro_hex_chat/games/catalog.ex:323
#, elixir-autogen, elixir-format
msgid "Pseudo-3D racing duel through day, snow, fog, and night. "
msgstr "Lomba balap Pseudo- 3D melalui hari, salju, kabut, dan malam."

#: lib/retro_hex_chat/games/catalog.ex:196
#, elixir-autogen, elixir-format
msgid "Pure competition for points, fuel, and survival across 10 sections."
msgstr ""
"Kompetisi murni untuk poin, bahan bakar, dan kelangsungan hidup di 10 "
