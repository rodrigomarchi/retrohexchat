#: lib/retro_hex_chat/channels/modes.ex:245
#, elixir-autogen, elixir-format
msgid "+s and +p are mutually exclusive"
msgstr "+s e +p são mutuamente exclusivos"

#: lib/retro_hex_chat/channels/server.ex:1418
#, elixir-autogen, elixir-format
msgid "Already in channel"
msgstr "Já no canal"

#: lib/retro_hex_chat/channels/policy.ex:47
#, elixir-autogen, elixir-format
msgid "Bad channel key (+k)"
msgstr "Chave de canal ruim (+k)"

#: lib/retro_hex_chat/channels/server.ex:588
#: lib/retro_hex_chat/channels/server.ex:1146
#, elixir-autogen, elixir-format
msgid "Banned"
msgstr "Proibido"

#: lib/retro_hex_chat/channels/policy.ex:179
#, elixir-autogen, elixir-format
msgid "Cannot ban a user with equal or higher rank"
msgstr "Não é possível banir um usuário com classificação igual ou superior"

#: lib/retro_hex_chat/channels/policy.ex:152
#, elixir-autogen, elixir-format
msgid "Cannot kick a higher-ranked user"
msgstr "Não é possível chutar um usuário de classificação superior"

#: lib/retro_hex_chat/channels/policy.ex:63
#, elixir-autogen, elixir-format
msgid "Cannot send to channel (no external messages)"
msgstr "Não foi possível enviar para o canal (sem mensagens externas)"

#: lib/retro_hex_chat/channels/policy.ex:35
#, elixir-autogen, elixir-format
msgid "Channel is full (+l)"
msgstr "O canal está cheio (+l)"

#: lib/retro_hex_chat/channels/policy.ex:41
#, elixir-autogen, elixir-format
msgid "Channel is invite-only (+i)"
msgstr "Canal é apenas para convidados (+i)"

#: lib/retro_hex_chat/channels/policy.ex:72
#, elixir-autogen, elixir-format
msgid "Channel is moderated (+m). You need voice (+v) to speak."
msgstr "O canal é moderado (+m). Você precisa de voz (+v) para falar."

#: lib/retro_hex_chat/channels/server.ex:864
#, elixir-autogen, elixir-format
msgid "Channel is not invite-only"
msgstr "Canal não é apenas convite"

#: lib/retro_hex_chat/channels/server.ex:1441
#, elixir-autogen, elixir-format
msgid "Channel join throttle active, please try again shortly"
msgstr "Canal ligado acelerador ativo, por favor tente novamente em breve"

#: lib/retro_hex_chat/channels/server.ex:97
#: lib/retro_hex_chat/channels/server.ex:100
#: lib/retro_hex_chat/channels/server.ex:243
#: lib/retro_hex_chat/channels/server.ex:250
#: lib/retro_hex_chat/channels/server.ex:387
#: lib/retro_hex_chat/channels/server.ex:390
#, elixir-autogen, elixir-format
msgid "Channel not found"
msgstr "Canal não encontrado"

#: lib/retro_hex_chat/channels/policy.ex:142
#: lib/retro_hex_chat/channels/policy.ex:143
#: lib/retro_hex_chat/channels/policy.ex:168
#: lib/retro_hex_chat/channels/policy.ex:169
#: lib/retro_hex_chat/channels/server.ex:908
#: lib/retro_hex_chat/channels/server.ex:927
#: lib/retro_hex_chat/channels/server.ex:930
#, elixir-autogen, elixir-format
msgid "Insufficient privileges"
msgstr "Privilégios insuficientes"

#: lib/retro_hex_chat/channels/policy.ex:226
#: lib/retro_hex_chat/channels/policy.ex:230
#, elixir-autogen, elixir-format
msgid "Insufficient privileges to set channel modes"
msgstr "Privilégios insuficientes para definir os modos de canal"

#: lib/retro_hex_chat/channels/modes.ex:152
#, elixir-autogen, elixir-format
msgid "Invalid mode string: must start with + or -"
msgstr "Texto de modo inválido: deve começar com + ou -"

#: lib/retro_hex_chat/channels/server.ex:867
#, elixir-autogen, elixir-format
msgid "Knocking is disabled for this channel"
msgstr "Bater está desativado para este canal"

#: lib/retro_hex_chat/channels/server.ex:489
#, elixir-autogen, elixir-format
msgid "Not in channel"
msgstr "Não no canal"

#: lib/retro_hex_chat/channels/server.ex:985
#, elixir-autogen, elixir-format
msgid "Only the channel owner can transfer ownership"
msgstr "Somente o proprietário do canal pode transferir propriedade"

#: lib/retro_hex_chat/channels/policy.ex:207
#, elixir-autogen, elixir-format
msgid "User %{target} is not in channel"
msgstr "Usuário %{target} não está no canal"

#: lib/retro_hex_chat/channels/server.ex:905
#: lib/retro_hex_chat/channels/server.ex:990
#, elixir-autogen, elixir-format
msgid "User is not in channel"
msgstr "O usuário não está no canal"

#: lib/retro_hex_chat/channels/server.ex:874
#, elixir-autogen, elixir-format
msgid "You are already in that channel"
msgstr "Você já está nesse canal"

#: lib/retro_hex_chat/channels/server.ex:871
#, elixir-autogen, elixir-format
msgid "You are banned from that channel"
msgstr "Você está banido desse canal"

#: lib/retro_hex_chat/channels/server.ex:1274
#, elixir-autogen, elixir-format
msgid "You are muted in this channel"
msgstr "Você está mudo neste canal"

#: lib/retro_hex_chat/channels/policy.ex:75
#: lib/retro_hex_chat/channels/policy.ex:82
#: lib/retro_hex_chat/channels/policy.ex:97
#, elixir-autogen, elixir-format
msgid "You are not in this channel"
msgstr "Você não está neste canal"

#: lib/retro_hex_chat/channels/policy.ex:162
#, elixir-autogen, elixir-format
msgid "You cannot ban yourself"
msgstr "Não podes banir-te."

#: lib/retro_hex_chat/channels/server.ex:713
#: lib/retro_hex_chat/channels/server.ex:739
#: lib/retro_hex_chat/channels/server.ex:765
#: lib/retro_hex_chat/channels/server.ex:791
#, elixir-autogen, elixir-format
msgid "You must be a channel operator"
msgstr "Você deve ser um operador de canal"

#: lib/retro_hex_chat/channels/policy.ex:91
#, elixir-autogen, elixir-format
msgid "You must be a channel operator to change the topic"
msgstr "Você deve ser um operador de canal para alterar o tópico"

#: lib/retro_hex_chat/channels/server.ex:810
#: lib/retro_hex_chat/channels/server.ex:1162
#, elixir-autogen, elixir-format
msgid "You must be a channel operator to unban users"
msgstr "Você deve ser um operador de canal para desproibir usuários"

#: lib/retro_hex_chat/channels/server.ex:912
#, elixir-autogen, elixir-format
msgid "Could not persist channel mute"
msgstr "Não foi possível guardar o silêncio do canal"

#: lib/retro_hex_chat/channels/server.ex:934
#, elixir-autogen, elixir-format
msgid "Could not persist channel unmute"
msgstr "Não foi possível guardar a remoção do silêncio do canal"

#: lib/retro_hex_chat/channels/departure.ex:30
#, elixir-autogen, elixir-format
msgid "Connection lost"
msgstr "Ligação perdida"

#: lib/retro_hex_chat/channels/pins.ex:133
#, elixir-autogen, elixir-format
msgid "That message could not be pinned"
msgstr "Não foi possível afixar essa mensagem"

#: lib/retro_hex_chat/channels/pins.ex:161
#: lib/retro_hex_chat/channels/pins.ex:165
#, elixir-autogen, elixir-format
msgid "That message is not in this channel"
msgstr "Essa mensagem não é deste canal"

#: lib/retro_hex_chat/channels/pins.ex:143
#, elixir-autogen, elixir-format
msgid "This channel already keeps %{count} messages. Unpin one first."
msgstr "Este canal já mantém %{count} mensagens. Desafixe uma primeiro."

#: lib/retro_hex_chat/channels/policy.ex:122
#, elixir-autogen, elixir-format
msgid "You must be a channel operator to pin messages"
msgstr "É preciso ser operador do canal para afixar mensagens"

#: lib/retro_hex_chat/channels/server.ex:1670
#, elixir-autogen, elixir-format
msgid "Only the channel founder can change the public archive"
msgstr "Só quem fundou o canal pode mudar o arquivo público"

#: lib/retro_hex_chat/channels/server.ex:1602
#, elixir-autogen, elixir-format
msgid "%{nickname} scheduled: %{title}"
msgstr "%{nickname} agendou: %{title}"

#: lib/retro_hex_chat/channels/server.ex:1634
#, elixir-autogen, elixir-format
msgid "That event belongs to another channel."
msgstr "Esse evento é de outro canal."

#: lib/retro_hex_chat/channels/scheduled_events.ex:105
#: lib/retro_hex_chat/channels/scheduled_events.ex:131
#: lib/retro_hex_chat/channels/server.ex:1631
#, elixir-autogen, elixir-format
msgid "That event could not be found."
msgstr "Esse evento não foi encontrado."

#: lib/retro_hex_chat/channels/policy.ex:132
#, elixir-autogen, elixir-format
msgid "You must be a channel operator to schedule events"
msgstr "Tem de ser operador do canal para agendar eventos"

#: lib/retro_hex_chat/channels/scheduled_events.ex:117
#, elixir-autogen, elixir-format
msgid "Only whoever scheduled it can call it off."
msgstr "Só quem agendou pode cancelar."

#: lib/retro_hex_chat/channels/scheduled_events.ex:327
#, elixir-autogen, elixir-format
msgid "That event could not be saved."
msgstr "Não foi possível guardar esse evento."

#: lib/retro_hex_chat/channels/scheduled_events.ex:143
#, elixir-autogen, elixir-format
msgid "That event was called off."
msgstr "Esse evento foi cancelado."

#: lib/retro_hex_chat/channels/scheduled_events.ex:288
#, elixir-autogen, elixir-format
msgid "That time is already in the past."
msgstr "Essa hora já passou."

#: lib/retro_hex_chat/channels/scheduled_events.ex:307
#, elixir-autogen, elixir-format
msgid "This channel already has %{count} events coming up."
msgstr "Este canal já tem %{count} eventos marcados."

#: lib/retro_hex_chat/channels/scheduled_events.ex:292
#, elixir-autogen, elixir-format
msgid "When does it start?"
msgstr "Quando começa?"

#: lib/retro_hex_chat/channels/server.ex:1662
#, elixir-autogen, elixir-format
msgid "Identify with NickServ before changing the public archive"
msgstr "Identifique-se no NickServ antes de alterar o arquivo público"

#: lib/retro_hex_chat/channels/server.ex:259
#, elixir-autogen, elixir-format
msgid "The archive switch did not answer. Check its state and try again."
msgstr "O interruptor do arquivo não respondeu. Confirme o estado dele e tente novamente."

#: lib/retro_hex_chat/channels/policy.ex:204
#, elixir-autogen, elixir-format
msgid "Cannot change the role of a user with equal or higher rank"
msgstr "Não é possível alterar o papel de um utilizador com uma classificação igual ou superior"

#: lib/retro_hex_chat/channels/policy.ex:53
#, elixir-autogen, elixir-format
msgid "You must identify with NickServ to join this channel"
msgstr "Você deve se identificar com o NickServ para entrar neste canal"
