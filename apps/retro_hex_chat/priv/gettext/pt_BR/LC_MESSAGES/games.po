#: lib/retro_hex_chat/games/catalog.ex:359
#, elixir-autogen, elixir-format
msgid "Top-down tennis duel — automatic hitting, shot angle depends on ball contact position. "
msgstr ""
"Duelo de tênis de cima para baixo — batida automática, ângulo de tiro "
"depende da posição de contato da bola. "

#: lib/retro_hex_chat/games/catalog.ex:161
#, elixir-autogen, elixir-format
msgid "Two pilots, one river"
msgstr "Dois pilotos, um rio."

#: lib/retro_hex_chat/games/catalog.ex:91
#, elixir-autogen, elixir-format
msgid "Use gravity slingshots, but fly too close and the star kills you. First to 7 wins."
msgstr ""
"Use estilingues de gravidade, mas voe muito perto e a estrela mata você. O "
"primeiro a sete ganha."

#: lib/retro_hex_chat/games/catalog.ex:111
#, elixir-autogen, elixir-format
msgid "Use the debris for cover — or watch it destroy you. First to 7 wins."
msgstr ""
