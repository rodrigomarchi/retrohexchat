#: lib/retro_hex_chat/games/catalog.ex:496
#, elixir-autogen, elixir-format
msgid "shoot, tackle, and score while your AI goalie defends. 3 periods of 2 minutes."
msgstr "atirar, atacar e marcar enquanto seu goleiro IA defende. 3 períodos de 2 minutos."

#: lib/retro_hex_chat/games/catalog.ex:195
#, elixir-autogen, elixir-format
msgid "steal fuel, and drop mines on your rival. 10 sections of pure chaos."
msgstr "Roubar combustível, e lançar minas sobre o seu rival. 10 secções de puro caos."

#: lib/retro_hex_chat/games/catalog.ex:473
#, elixir-autogen, elixir-format
msgid "temperature drops slowly. Epic arctic endurance."
msgstr "a temperatura cai lentamente. Epic resistência árctica."
