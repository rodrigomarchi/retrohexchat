#: lib/retro_hex_chat/games/catalog.ex:544
#, elixir-autogen, elixir-format
msgid "Neon ice warfare"
msgstr "Guerra no gelo de Neon"

#: lib/retro_hex_chat/games/catalog.ex:368
#, elixir-autogen, elixir-format
