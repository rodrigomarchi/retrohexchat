"um rei dentro. "

#: lib/retro_hex_chat/games/catalog.ex:259
#, elixir-autogen, elixir-format
msgid "Western duel in open field — no obstacle, full horizontal movement. "
msgstr ""
"Duelo ocidental em campo aberto — nenhum obstáculo, movimento horizontal "
"completo. "

#: lib/retro_hex_chat/games/catalog.ex:246
#, elixir-autogen, elixir-format
msgid "Western duel with a stagecoach rolling across the arena. "
msgstr "Duelo ocidental com uma diligência rolando pela arena. "

#: lib/retro_hex_chat/games/catalog.ex:230
#, elixir-autogen, elixir-format
msgid "Western duel with bouncing bullets — fire at angles to bypass the wall. "
msgstr ""
"Duelo ocidental com balas saltitantes — fogo em ângulos para contornar a "
"parede. "

#: lib/retro_hex_chat/games/catalog.ex:217
#, elixir-autogen, elixir-format
msgid "Western duel — two gunslingers and a cactus. "
msgstr "Duelo ocidental — dois pistoleiros e um cacto. "

#: lib/retro_hex_chat/games/catalog.ex:131
#, elixir-autogen, elixir-format
msgid "Work together to destroy all blocks before running out of lives."
msgstr ""
"Trabalhem juntos para destruir todos os blocos antes de acabarem as vidas."

#: lib/retro_hex_chat/games/catalog.ex:74
#, elixir-autogen, elixir-format
msgid "Wraparound edges, hyperspace warp (20% death chance), first to 7 wins."
msgstr ""
"Nas bordas, warp hiperespacial (20% de chance de morte), primeiro a 7 "
