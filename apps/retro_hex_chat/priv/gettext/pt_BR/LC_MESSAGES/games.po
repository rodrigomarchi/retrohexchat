#: lib/retro_hex_chat/games/catalog.ex:102
#, elixir-autogen, elixir-format
msgid "Wraparound edges, hyperspace warp (20% death chance), first to 7 wins."
msgstr "Nas bordas, warp hiperespacial (20% de chance de morte), primeiro a 7 vitórias."

#: lib/retro_hex_chat/games/catalog.ex:298
#, elixir-autogen, elixir-format
msgid "Your kills are their problem"
msgstr "As tuas mortes são problema deles."

#: lib/retro_hex_chat/games/catalog.ex:424
#, elixir-autogen, elixir-format
msgid "clear slalom gates, outrun the avalanche. Best of 3 runs with rising difficulty."
msgstr "Livrem-se dos portões do slalom, fujam da avalanche. Melhor de 3 corridas com dificuldade crescente."

#: lib/retro_hex_chat/games/catalog.ex:222
#, elixir-autogen, elixir-format
