#: lib/retro_hex_chat/games/catalog.ex:194
#, elixir-autogen, elixir-format
msgid "fuel is scarce, mines recharge faster. Quick and chaotic."
msgstr ""
"O combustível é escasso, as minas recarregam mais rápido. Rápido e caótico."

#: lib/retro_hex_chat/games/catalog.ex:468
#, elixir-autogen, elixir-format
msgid "shoot, tackle, and score while your AI goalie defends. 3 periods of 2 minutes."
msgstr ""
"atirar, atacar e marcar enquanto seu goleiro IA defende. 3 períodos de 2 "
