msgstr "Setas ou WASD para mover e subir, a barra de espaço para saltar"

#: lib/retro_hex_chat/games/catalog.ex:587
#, elixir-autogen, elixir-format
msgid "Cross 255 screens of jungle and the tunnels below it. Jump over tree trunks and crocodiles, and find 32 treasures in twenty minutes."
msgstr "Cruze 255 telas de selva e os túneis abaixo dela. Salte sobre troncos de árvores e crocodilos, e encontre 32 tesouros em vinte minutos."

#: lib/retro_hex_chat/games/announcer.ex:181
#, elixir-autogen, elixir-format
