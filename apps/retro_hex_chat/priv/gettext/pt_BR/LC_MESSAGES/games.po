msgid "Use gravity slingshots, but fly too close and the star kills you. First to 7 wins."
msgstr "Use estilingues de gravidade, mas voe muito perto e a estrela mata você. O primeiro a sete ganha."

#: lib/retro_hex_chat/games/catalog.ex:139
#, elixir-autogen, elixir-format
msgid "Use the debris for cover — or watch it destroy you. First to 7 wins."
msgstr "Use os escombros para cobrir — ou veja - os destruí - lo. O primeiro a sete ganha."

#: lib/retro_hex_chat/games/catalog.ex:171
#, elixir-autogen, elixir-format
msgid "Versus Breakout battle — each player defends a brick castle with a king inside. "
msgstr "Contra a batalha Breakout — cada jogador defende um castelo de tijolos com um rei dentro. "

#: lib/retro_hex_chat/games/catalog.ex:287
#, elixir-autogen, elixir-format
msgid "Western duel in open field — no obstacle, full horizontal movement. "
msgstr "Duelo ocidental em campo aberto — nenhum obstáculo, movimento horizontal completo. "

#: lib/retro_hex_chat/games/catalog.ex:274
#, elixir-autogen, elixir-format
msgid "Western duel with a stagecoach rolling across the arena. "
msgstr "Duelo ocidental com uma diligência rolando pela arena. "

#: lib/retro_hex_chat/games/catalog.ex:258
#, elixir-autogen, elixir-format
msgid "Western duel with bouncing bullets — fire at angles to bypass the wall. "
msgstr "Duelo ocidental com balas saltitantes — fogo em ângulos para contornar a parede. "

#: lib/retro_hex_chat/games/catalog.ex:245
#, elixir-autogen, elixir-format
