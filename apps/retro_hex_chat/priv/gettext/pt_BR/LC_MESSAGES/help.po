#: lib/retro_hex_chat/chat/help_topics/features.ex:2677
#, elixir-autogen, elixir-format
msgid "1 long epic round — igloo needs 20 pieces, all enemies from the start, "
msgstr ""
"1 longa rodada épica — iglu precisa de 20 peças, todos os inimigos desde o "
"início, "

#: lib/retro_hex_chat/chat/help_topics/features.ex:2105
#, elixir-autogen, elixir-format
msgid "10 sections of increasing difficulty. Destroy bridges to advance. "
msgstr "10 secções de dificuldade crescente. Destruir pontes para avançar. "

#: lib/retro_hex_chat/chat/help_topics/features.ex:1923
#, elixir-autogen, elixir-format
msgid "2-minute rounds, best of 3. Modes: Classic (open field) and Maze Battle. "
msgstr ""
"2 minutos, melhor de 3. Modos: Clássico (campo aberto) e Batalha de Maze. "

#: lib/retro_hex_chat/chat/help_topics/features.ex:2040
#, elixir-autogen, elixir-format
msgid "3 shared lives, 50 neon blocks (5 rows), ball speeds up. Arrow keys or A/D to move."
msgstr ""
"3 vidas compartilhadas, 50 blocos de néon (5 linhas), a bola acelera. Setas "
"ou A/D para mover."

#: lib/retro_hex_chat/chat/help_topics/features.ex:2436
#, elixir-autogen, elixir-format
msgid "3-minute race in permanent darkness with fog bursts. "
msgstr "Corrida de 3 minutos em escuridão permanente com rajadas de neblina. "

#: lib/retro_hex_chat/chat/help_topics/features.ex:3242
#, elixir-autogen, elixir-format
msgid "32 deathmatch-focused arena maps for the DOOM engine. BSD license."
msgstr ""
"32 mapas de arena focados em deathmatch para o motor DOOM. Licença BSD."

#: lib/retro_hex_chat/chat/help_topics/features.ex:2153
#, elixir-autogen, elixir-format
msgid "5 sections of intense River Raid action — river starts narrow, "
msgstr "5 secções de intensa ação River Raid — rio começa estreito, "

#: lib/retro_hex_chat/chat/help_topics/features.ex:2380
#, elixir-autogen, elixir-format
msgid "5 waves of pure chaos from the start. "
msgstr "5 ondas de puro caos desde o início. "

#: lib/retro_hex_chat/chat/help_topics/features.ex:1513
#, elixir-autogen, elixir-format
msgid "7 days"
msgstr "7 dias"

#: lib/retro_hex_chat/chat/help_topics/features.ex:2463
#, elixir-autogen, elixir-format
msgid "90 seconds to score maximum overtakes. "
msgstr "90 segundos para atingir o máximo. "

#: lib/retro_hex_chat/chat/help_topics/features.ex:3329
#, elixir-autogen, elixir-format
msgid "A Viking-themed DOOM total conversion with hand-drawn pixel art — axes, bows, and runic magic. Cacoward 2018 winner."
msgstr ""
"Uma conversão total de DOOM temática Viking com pixels desenhados à mão — "
"eixos, arcos e magia rúnica. Cacoward 2018 vencedor."

#: lib/retro_hex_chat/chat/help_topics/features.ex:3213
#, elixir-autogen, elixir-format
msgid "A complete free replacement for DOOM II — 32 levels with the Super Shotgun. Compatible with community PWAD mods."
msgstr ""
"Um substituto gratuito completo para DOOM II — 32 níveis com a Super "
"Shotgun. Compatível com mods PWAD comunitários."

#: lib/retro_hex_chat/chat/help_topics/features.ex:3384
#, elixir-autogen, elixir-format
msgid "A complete free replacement for Quake — original levels, art, and music under BSD license."
msgstr ""
"Um substituto gratuito completo para Quake — níveis originais, arte e música"
" sob licença BSD."

#: lib/retro_hex_chat/chat/help_topics/features.ex:3183
#, elixir-autogen, elixir-format
msgid "A complete free replacement for Ultimate DOOM — 4 episodes, 36 levels with original art and music."
msgstr ""
"Um substituto gratuito completo para Ultimate DOOM — 4 episódios, 36 níveis "
"com arte original e música."

#: lib/retro_hex_chat/chat/help_topics/features.ex:3298
#, elixir-autogen, elixir-format
msgid "A cyberpunk DOOM total conversion with new weapons, enemies, and levels. Standalone v1.2 IWAD."
msgstr ""
"Uma conversão total do DOOM cyberpunk com novas armas, inimigos e níveis. "
"Autonomo v1.2 IWAD."

#: lib/retro_hex_chat/chat/help_topics/user_interface.ex:278
#, elixir-autogen, elixir-format
msgid "Access user actions and channel operations through right-click context menus."
msgstr ""
"Acesse as ações do usuário e as operações do canal através de menus de "
"contexto com o botão direito do mouse."

#: lib/retro_hex_chat/chat/help_topics/commands.ex:146
#, elixir-autogen, elixir-format
msgid "Add a user to your ignore list to hide their messages and actions."
msgstr ""
"Adicione um usuário à sua lista de ignore para ocultar suas mensagens e "
"ações."

#: lib/retro_hex_chat/chat/help_topics/features.ex:498
#, elixir-autogen, elixir-format
msgid "Add custom items to right-click context menus for quick access to commands."
msgstr ""
"Adicionar itens personalizados aos menus de contexto com o botão direito do "
"mouse para acesso rápido aos comandos."

#: lib/retro_hex_chat/chat/help_topics/commands.ex:293
#, elixir-autogen, elixir-format
msgid "Add or remove users from your notify list to track when they connect or disconnect."
msgstr ""
"Adicione ou remova usuários de sua lista de notificações para rastrear "
"quando eles se conectam ou desconectam."

