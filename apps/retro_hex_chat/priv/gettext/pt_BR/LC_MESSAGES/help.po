msgstr "Identidade & Presença"

#: lib/retro_hex_chat/chat/help_topics/features.ex:51
#, elixir-autogen, elixir-format
msgid ""
"Look up current or recent user information from a dialog, nickname context "
"menus, or slash commands."
msgstr ""
"Procure informações atuais ou recentes do usuário em uma janela, menus de "
"contexto de apelidos ou comandos de barra."

#: lib/retro_hex_chat/chat/help_topics/features.ex:989
#, elixir-autogen, elixir-format
msgid ""
"Make video calls with camera controls, picture-in-picture, and quality "
"settings. See also: P2P Lobby."
msgstr ""
"Faça chamadas de vídeo com controles de câmera, imagem na imagem e "
"configurações de qualidade. Ver também: Lobby P2P."

#: lib/retro_hex_chat/chat/help_topics/services.ex:97
#, elixir-autogen, elixir-format
msgid "Manage SOP, AOP, and VOP access lists for registered channels."
msgstr "Gerencie listas de acesso SOP, AOP e VOP para canais registrados."

#: lib/retro_hex_chat/chat/help_topics/user_interface.ex:250
#, elixir-autogen, elixir-format
msgid ""
"Manage nickname registration, profile bio, away status, and user modes from "
"the Account dialog."
msgstr ""
"Gerencie o registro de apelidos, perfil bio, status de afastamento e modos "
"de usuário da janela Conta."

#: lib/retro_hex_chat/chat/help_topics/user_interface.ex:290
#, elixir-autogen, elixir-format
msgid ""
"Manage server bots from Tools > Bot Management, including status, "
"capabilities, channels, custom commands, and events."
msgstr ""
"Gerenciar bots de servidores a partir de Ferramentas > Bot Management, "
"incluindo status, capacidades, canais, comandos personalizados e eventos."

#: lib/retro_hex_chat/chat/help_topics/features.ex:548
#, elixir-autogen, elixir-format
