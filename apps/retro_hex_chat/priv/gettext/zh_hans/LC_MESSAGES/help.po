msgstr "FreeCell for one player: all the cards face up, and four free cells. Put every card on its pile, from the ace to the king."

#: lib/retro_hex_chat/chat/help_topics/features.ex:3322
#, elixir-autogen, elixir-format
msgid "Hex Spider"
msgstr "Hex Spider"

#: lib/retro_hex_chat/chat/help_topics/features.ex:3336
#, elixir-autogen, elixir-format
