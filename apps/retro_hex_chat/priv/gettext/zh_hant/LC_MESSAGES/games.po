msgstr "不要越線"

#: lib/retro_hex_chat/games/catalog.ex:291
#, elixir-autogen, elixir-format
msgid "Draw at high noon"
msgstr "正午對決"

#: lib/retro_hex_chat/games/catalog.ex:558
#, elixir-autogen, elixir-format
msgid "Fast and brutal"
msgstr "快速而殘酷"

#: lib/retro_hex_chat/games/catalog.ex:266
#, elixir-autogen, elixir-format
msgid "Fast and furious"
msgstr "又快又猛"

#: lib/retro_hex_chat/games/catalog.ex:443
#, elixir-autogen, elixir-format
