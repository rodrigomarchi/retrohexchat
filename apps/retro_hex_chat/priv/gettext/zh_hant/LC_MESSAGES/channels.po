msgstr "此頻道禁用敲門"

#: lib/retro_hex_chat/channels/server.ex:490
#, elixir-autogen, elixir-format
msgid "Not in channel"
msgstr "不在頻道中"

#: lib/retro_hex_chat/channels/server.ex:990
#, elixir-autogen, elixir-format
