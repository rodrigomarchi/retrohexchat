#: lib/retro_hex_chat/channels/server.ex:1125
#: lib/retro_hex_chat/channels/server.ex:1128
#, elixir-autogen, elixir-format
msgid "Insufficient privileges"
msgstr "權限不足"

#: lib/retro_hex_chat/channels/policy.ex:228
#: lib/retro_hex_chat/channels/policy.ex:232
#, elixir-autogen, elixir-format
msgid "Insufficient privileges to set channel modes"
msgstr "設置頻道模式的權限不足"

#: lib/retro_hex_chat/channels/modes.ex:165
#, elixir-autogen, elixir-format
msgid "Invalid mode string: must start with + or -"
msgstr "無效模式字符串:必須從 + 或 - 開始"

#: lib/retro_hex_chat/channels/server.ex:1065
#, elixir-autogen, elixir-format
msgid "Knocking is disabled for this channel"
msgstr "此頻道禁用敲門"

#: lib/retro_hex_chat/channels/server.ex:634
#, elixir-autogen, elixir-format
msgid "Not in channel"
msgstr "不在頻道中"

#: lib/retro_hex_chat/channels/server.ex:1183
#, elixir-autogen, elixir-format
msgid "Only the channel owner can transfer ownership"
msgstr "只有頻道所有者才能轉讓所有權"

#: lib/retro_hex_chat/channels/policy.ex:209
#, elixir-autogen, elixir-format
msgid "User %{target} is not in channel"
msgstr "用戶 %{target} 未在頻道中"

#: lib/retro_hex_chat/channels/server.ex:1103
#: lib/retro_hex_chat/channels/server.ex:1188
#, elixir-autogen, elixir-format
msgid "User is not in channel"
msgstr "用戶不在頻道"

#: lib/retro_hex_chat/channels/server.ex:1072
#, elixir-autogen, elixir-format
msgid "You are already in that channel"
msgstr "你已經在頻道里了"

#: lib/retro_hex_chat/channels/server.ex:1069
#, elixir-autogen, elixir-format
msgid "You are banned from that channel"
msgstr "禁止您進入頻道"

#: lib/retro_hex_chat/channels/server.ex:1489
#, elixir-autogen, elixir-format
msgid "You are muted in this channel"
msgstr "你在這個頻道里啞了"

#: lib/retro_hex_chat/channels/policy.ex:77
#: lib/retro_hex_chat/channels/policy.ex:84
#: lib/retro_hex_chat/channels/policy.ex:99
#, elixir-autogen, elixir-format
msgid "You are not in this channel"
msgstr "你不在這頻道里"

#: lib/retro_hex_chat/channels/policy.ex:164
#, elixir-autogen, elixir-format
msgid "You cannot ban yourself"
msgstr "你不能禁錮自己"

#: lib/retro_hex_chat/channels/server.ex:894
#: lib/retro_hex_chat/channels/server.ex:920
#: lib/retro_hex_chat/channels/server.ex:946
#: lib/retro_hex_chat/channels/server.ex:972
#, elixir-autogen, elixir-format
msgid "You must be a channel operator"
msgstr "您必須是頻道操作員"

#: lib/retro_hex_chat/channels/policy.ex:93
#, elixir-autogen, elixir-format
msgid "You must be a channel operator to change the topic"
msgstr "您必須是頻道操作員才能更改話題"

#: lib/retro_hex_chat/channels/server.ex:991
#: lib/retro_hex_chat/channels/server.ex:1377
#, elixir-autogen, elixir-format
msgid "You must be a channel operator to unban users"
msgstr "您必須是取消禁用用戶的頻道操作員"

#: lib/retro_hex_chat/channels/server.ex:1110
#, elixir-autogen, elixir-format
msgid "Could not persist channel mute"
msgstr "無法儲存頻道靜音"

#: lib/retro_hex_chat/channels/server.ex:1132
#, elixir-autogen, elixir-format
msgid "Could not persist channel unmute"
msgstr "無法儲存頻道解除靜音"

#: lib/retro_hex_chat/channels/departure.ex:30
#, elixir-autogen, elixir-format
msgid "Connection lost"
msgstr "連線已中斷"

#: lib/retro_hex_chat/channels/pins.ex:133
#, elixir-autogen, elixir-format
msgid "That message could not be pinned"
msgstr "無法置頂那則訊息"

#: lib/retro_hex_chat/channels/pins.ex:161
#: lib/retro_hex_chat/channels/pins.ex:165
#, elixir-autogen, elixir-format
msgid "That message is not in this channel"
msgstr "那則訊息不屬於這個頻道"

#: lib/retro_hex_chat/channels/pins.ex:143
#, elixir-autogen, elixir-format
msgid "This channel already keeps %{count} messages. Unpin one first."
msgstr "這個頻道已經保留了 %{count} 則訊息。請先取消一則。"

#: lib/retro_hex_chat/channels/policy.ex:124
#, elixir-autogen, elixir-format
msgid "You must be a channel operator to pin messages"
msgstr "只有頻道管理員可以置頂訊息"

#: lib/retro_hex_chat/channels/server.ex:1977
#, elixir-autogen, elixir-format
msgid "Only the channel founder can change the public archive"
msgstr "只有頻道創建者才能更改公開封存"

#: lib/retro_hex_chat/channels/server.ex:1891
#, elixir-autogen, elixir-format
msgid "%{nickname} scheduled: %{title}"
msgstr "%{nickname} 安排了：%{title}"

#: lib/retro_hex_chat/channels/server.ex:1923
#, elixir-autogen, elixir-format
msgid "That event belongs to another channel."
msgstr "該活動屬於另一個頻道。"

#: lib/retro_hex_chat/channels/scheduled_events.ex:120
#: lib/retro_hex_chat/channels/scheduled_events.ex:146
#: lib/retro_hex_chat/channels/server.ex:1920
#, elixir-autogen, elixir-format
msgid "That event could not be found."
msgstr "找不到該活動。"

#: lib/retro_hex_chat/channels/policy.ex:134
#, elixir-autogen, elixir-format
msgid "You must be a channel operator to schedule events"
msgstr "你必須是頻道管理員才能安排活動"

#: lib/retro_hex_chat/channels/scheduled_events.ex:132
#, elixir-autogen, elixir-format
msgid "Only whoever scheduled it can call it off."
msgstr "只有安排它的人才能取消。"

#: lib/retro_hex_chat/channels/scheduled_events.ex:345
#, elixir-autogen, elixir-format
msgid "That event could not be saved."
msgstr "無法儲存該活動。"

#: lib/retro_hex_chat/channels/scheduled_events.ex:161
#, elixir-autogen, elixir-format
msgid "That event was called off."
msgstr "該活動已取消。"

#: lib/retro_hex_chat/channels/scheduled_events.ex:306
#, elixir-autogen, elixir-format
msgid "That time is already in the past."
msgstr "那個時間已經過去了。"

#: lib/retro_hex_chat/channels/scheduled_events.ex:325
#, elixir-autogen, elixir-format
msgid "This channel already has %{count} events coming up."
msgstr "該頻道已經有 %{count} 個即將到來的活動。"

#: lib/retro_hex_chat/channels/scheduled_events.ex:310
#, elixir-autogen, elixir-format
msgid "When does it start?"
msgstr "什麼時候開始？"

#: lib/retro_hex_chat/channels/server.ex:1971
#, elixir-autogen, elixir-format
msgid "Identify with NickServ before changing the public archive"
msgstr "變更公開存檔前請先向 NickServ 驗證身分"

#: lib/retro_hex_chat/channels/server.ex:275
#, elixir-autogen, elixir-format
msgid "The archive switch did not answer. Check its state and try again."
msgstr "存檔開關沒有回應。請檢查其狀態後重試。"

#: lib/retro_hex_chat/channels/policy.ex:206
#, elixir-autogen, elixir-format
msgid "Cannot change the role of a user with equal or higher rank"
msgstr "無法更改相同或更高級別用戶的角色"

#: lib/retro_hex_chat/channels/policy.ex:53
#, elixir-autogen, elixir-format
msgid "You must identify with NickServ to join this channel"
msgstr "您必須識別 NickServ 才能加入此頻道"

#: lib/retro_hex_chat/channels/server.ex:1974
#, elixir-autogen, elixir-format
msgid "Identify with NickServ before changing the channel's language"
msgstr "變更頻道語言前請先向 NickServ 驗證身分"

#: lib/retro_hex_chat/channels/server.ex:1980
#, elixir-autogen, elixir-format
msgid "Only the founder of a registered channel can set its language"
msgstr "只有已註冊頻道的創建者才能設定其語言"

#: lib/retro_hex_chat/channels/server.ex:300
#, elixir-autogen, elixir-format
msgid "The channel did not answer. Try again."
msgstr "頻道沒有回應。請重試。"

#: lib/retro_hex_chat/channels/server.ex:308
#, elixir-autogen, elixir-format
msgid "Unknown language: %{code}"
msgstr "未知語言：%{code}"
