msgstr "你不在這頻道里"

#: lib/retro_hex_chat/channels/policy.ex:152
#, elixir-autogen, elixir-format
msgid "You cannot ban yourself"
msgstr "你不能禁錮自己"

#: lib/retro_hex_chat/channels/server.ex:611
#: lib/retro_hex_chat/channels/server.ex:637
#: lib/retro_hex_chat/channels/server.ex:663
#: lib/retro_hex_chat/channels/server.ex:689
#, elixir-autogen, elixir-format
msgid "You must be a channel operator"
msgstr "您必須是頻道操作員"

#: lib/retro_hex_chat/channels/policy.ex:91
#, elixir-autogen, elixir-format
msgid "You must be a channel operator to change the topic"
msgstr "您必須是頻道操作員才能更改話題"

#: lib/retro_hex_chat/channels/server.ex:708
#: lib/retro_hex_chat/channels/server.ex:1043
#, elixir-autogen, elixir-format
msgid "You must be a channel operator to unban users"
msgstr "您必須是取消禁用用戶的頻道操作員"

#: lib/retro_hex_chat/channels/policy.ex:53
#, elixir-autogen, elixir-format
msgid "You must be registered to join this channel"
msgstr "您必須註冊加入此頻道"

#: lib/retro_hex_chat/channels/server.ex:810
#, elixir-autogen, elixir-format
msgid "Could not persist channel mute"
msgstr "無法儲存頻道靜音"

#: lib/retro_hex_chat/channels/server.ex:832
#, elixir-autogen, elixir-format
msgid "Could not persist channel unmute"
msgstr "無法儲存頻道解除靜音"

#: lib/retro_hex_chat/channels/departure.ex:30
#, elixir-autogen, elixir-format
