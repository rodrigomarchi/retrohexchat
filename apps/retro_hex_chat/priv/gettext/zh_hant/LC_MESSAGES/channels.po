msgstr "只有頻道所有者才能轉讓所有權"

#: lib/retro_hex_chat/channels/policy.ex:207
#, elixir-autogen, elixir-format
msgid "User %{target} is not in channel"
msgstr "用戶 %{target} 未在頻道中"

#: lib/retro_hex_chat/channels/server.ex:910
