msgid "Use / open doors"
msgstr "使用/開門"

#: lib/retro_hex_chat/arcade/content/doom_shareware.ex:31
#, elixir-autogen, elixir-format
msgid "Use F6 for quicksave and F9 for quickload — save often, especially before new areas."
msgstr "用 F6 快速存檔、F9 快速讀檔——要經常存檔,尤其是進入新區域之前。"

#: lib/retro_hex_chat/arcade/content/freedm.ex:32
#, elixir-autogen, elixir-format
msgid "Use IDCLEV## cheat (e.g., IDCLEV01) to jump between the 32 maps."
msgstr "Use IDCLEV## cheat (e.g., IDCLEV01) to jump between the 32 maps."

#: lib/retro_hex_chat/arcade/content/halflife_uplink.ex:44
#, elixir-autogen, elixir-format
msgid "Use the flashlight (F) in dark areas — but note it shares power with your HEV suit's sprint."
msgstr "在黑暗區域使用手電筒(F)——但請注意,它與你的 HEV 防護服衝刺共用電力。"

#: lib/retro_hex_chat/arcade/catalog.ex:110
#, elixir-autogen, elixir-format
msgid "Viking-themed standalone"
msgstr "維京主題的獨立遊戲"

