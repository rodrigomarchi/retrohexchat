msgstr "頻道名稱旁的彩色標籤說明該頻道的主題。頻道建立者可以用 /cs category 或在頻道中心設定。"

#: lib/retro_hex_chat/chat/help_topics/channel_modes.ex:93
#: lib/retro_hex_chat/chat/help_topics/commands.ex:123
#, elixir-autogen, elixir-format
msgid "channel category"
msgstr "頻道分類"

#: lib/retro_hex_chat/chat/help_topics/channel_modes.ex:94
