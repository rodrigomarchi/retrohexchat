#: lib/retro_hex_chat/channels/server.ex:438
#: lib/retro_hex_chat/channels/server.ex:441
#, elixir-autogen, elixir-format
msgid "Channel not found"
msgstr "Canal no encontrado"

#: lib/retro_hex_chat/channels/policy.ex:144
#: lib/retro_hex_chat/channels/policy.ex:145
#: lib/retro_hex_chat/channels/policy.ex:170
