#, elixir-autogen, elixir-format
msgid "+s and +p are mutually exclusive"
msgstr "+s y +p son mutuamente excluyentes"

#: lib/retro_hex_chat/channels/server.ex:1727
#, elixir-autogen, elixir-format
msgid "Already in channel"
msgstr "Ya en canal"

#: lib/retro_hex_chat/channels/policy.ex:47
#, elixir-autogen, elixir-format
msgid "Bad channel key (+k)"
msgstr "Llave de mal canal (+k)"

#: lib/retro_hex_chat/channels/server.ex:769
#: lib/retro_hex_chat/channels/server.ex:1361
#, elixir-autogen, elixir-format
msgid "Banned"
msgstr "Banned"

#: lib/retro_hex_chat/channels/policy.ex:181
#, elixir-autogen, elixir-format
msgid "Cannot ban a user with equal or higher rank"
msgstr "No puede prohibir un usuario con rango igual o superior"

#: lib/retro_hex_chat/channels/policy.ex:154
#, elixir-autogen, elixir-format
msgid "Cannot kick a higher-ranked user"
msgstr "No puede patear a un usuario de mayor rango"

#: lib/retro_hex_chat/channels/policy.ex:63
#, elixir-autogen, elixir-format
msgid "Cannot send to channel (no external messages)"
msgstr "No se puede enviar al canal (sin mensajes externos)"

#: lib/retro_hex_chat/channels/policy.ex:35
#, elixir-autogen, elixir-format
msgid "Channel is full (+l)"
msgstr "El canal está lleno (+l)"

#: lib/retro_hex_chat/channels/policy.ex:41
#, elixir-autogen, elixir-format
msgid "Channel is invite-only (+i)"
msgstr "El canal es solo de invitación (+i)"

#: lib/retro_hex_chat/channels/policy.ex:74
#, elixir-autogen, elixir-format
msgid "Channel is moderated (+m). You need voice (+v) to speak."
msgstr "El canal es moderado (+m). Necesitas voz (+v) para hablar."

#: lib/retro_hex_chat/channels/server.ex:1062
#, elixir-autogen, elixir-format
msgid "Channel is not invite-only"
msgstr "El canal no es solo de invitación"

#: lib/retro_hex_chat/channels/server.ex:1750
#, elixir-autogen, elixir-format
msgid "Channel join throttle active, please try again shortly"
msgstr "Canal únete a acelerador activo, por favor intente de nuevo en breve"

#: lib/retro_hex_chat/channels/server.ex:103
#: lib/retro_hex_chat/channels/server.ex:106
