msgstr "WASDで移動、マウスで照準、左クリックで発射、Eで使う、スペースでジャンプ、Cでしゃがむ、Rでリロード"

#: lib/retro_hex_chat/arcade/catalog.ex:192
#, elixir-autogen, elixir-format
msgid "WASD move, Mouse aim, Left click fire, E use, Space jump, Shift crouch, R reload"
msgstr "WASDで移動、マウスで照準、左クリックで発射、Eで使う、スペースでジャンプ、Shiftでしゃがむ、Rでリロード"

#: lib/retro_hex_chat/arcade/content/scummvm_dreamweb.ex:28
#: lib/retro_hex_chat/arcade/content/scummvm_lure.ex:28
#, elixir-autogen, elixir-format
