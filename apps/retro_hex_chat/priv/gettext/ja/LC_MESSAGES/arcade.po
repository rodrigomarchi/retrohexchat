#: lib/retro_hex_chat/arcade/content/doom_shareware.ex:34
#: lib/retro_hex_chat/arcade/content/freedm.ex:34
#: lib/retro_hex_chat/arcade/content/freedoom1.ex:34
#: lib/retro_hex_chat/arcade/content/freedoom2.ex:34
