msgstr "ファイル、サーバー、スクリプト"

#: lib/retro_hex_chat/commands/mirc_parity.ex:36
#, elixir-autogen, elixir-format
msgid "NickServ and ChanServ"
msgstr "NickServとChanServ"

#: lib/retro_hex_chat/commands/mirc_parity.ex:53
#, elixir-autogen, elixir-format
msgid "Open the private conversation and use /me there."
msgstr "プライベートな会話を開き、そこで/meを使ってください。"

#: lib/retro_hex_chat/commands/mirc_parity.ex:61
#, elixir-autogen, elixir-format
