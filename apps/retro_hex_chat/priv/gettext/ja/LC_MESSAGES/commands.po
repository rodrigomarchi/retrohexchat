msgstr "会話"

#: lib/retro_hex_chat/commands/mirc_parity.ex:67
#, elixir-autogen, elixir-format
msgid "The nick list beside every channel shows who is there."
msgstr "各チャンネルの横にあるニックネームリストには、そこにいる人が表示されます。"

#: lib/retro_hex_chat/commands/mirc_parity.ex:126
#, elixir-autogen, elixir-format
