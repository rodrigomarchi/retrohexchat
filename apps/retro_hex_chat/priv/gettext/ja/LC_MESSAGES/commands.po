#: lib/retro_hex_chat/commands/handler/guards.ex:123
#, elixir-autogen, elixir-format
msgid "Use this in a game's own channel, like %{channel}."
msgstr "%{channel} のようなゲームのチャンネルでこれを使用してください。"

#: lib/retro_hex_chat/commands/handlers/challenge.ex:39
#, elixir-autogen, elixir-format
