#: lib/retro_hex_chat/games/catalog.ex:575
#, elixir-autogen, elixir-format
msgid "Klondike solitaire, one card at a time"
msgstr "ソリティア、一度に1枚のカード"

#: lib/retro_hex_chat/games/catalog.ex:592
#, elixir-autogen, elixir-format
