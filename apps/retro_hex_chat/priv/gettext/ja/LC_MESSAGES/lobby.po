#: lib/retro_hex_chat/lobby/policy.ex:117
#, elixir-autogen, elixir-format
msgid "Cannot create a session with yourself"
msgstr "自分自身とのセッションは作成できません"

#: lib/retro_hex_chat/lobby/service.ex:239
#: lib/retro_hex_chat/lobby/service.ex:256
#: lib/retro_hex_chat/lobby/service.ex:280
#, elixir-autogen, elixir-format
msgid "Failed to create lobby"
msgstr "ロビーの作成に失敗しました"

#: lib/retro_hex_chat/lobby/session_server.ex:318
#, elixir-autogen, elixir-format
msgid "Invalid transition from %{from} to %{to}"
msgstr "%{from} から %{to} への遷移は無効です"

#: lib/retro_hex_chat/lobby/policy.ex:310
#, elixir-autogen, elixir-format
msgid "Invite is no longer pending"
msgstr "招待は保留中ではなくなりました"

#: lib/retro_hex_chat/lobby/policy.ex:314
#, elixir-autogen, elixir-format
msgid "Lobby is no longer active"
msgstr "ロビーはすでに終了しています"

#: lib/retro_hex_chat/lobby/service.ex:290
#, elixir-autogen, elixir-format
msgid "Lobby not found"
msgstr "ロビーが見つかりません"

#: lib/retro_hex_chat/lobby/session_server.ex:245
#, elixir-autogen, elixir-format
msgid "Not a participant"
msgstr "参加者ではありません"

#: lib/retro_hex_chat/lobby/policy.ex:271
#, elixir-autogen, elixir-format
msgid "Only the invited user can decline"
msgstr "招待されたユーザーだけが拒否できます"

#: lib/retro_hex_chat/lobby/policy.ex:279
#, elixir-autogen, elixir-format
msgid "Only the inviter can cancel the invite"
msgstr "招待をキャンセルできるのは招待した本人だけです"

#: lib/retro_hex_chat/lobby/service.ex:221
#: lib/retro_hex_chat/lobby/session_server.ex:148
#: lib/retro_hex_chat/lobby/session_server.ex:1099
#: lib/retro_hex_chat/lobby/session_server.ex:1100
#: lib/retro_hex_chat/lobby/session_server.ex:1101
#, elixir-autogen, elixir-format
msgid "Session process not running"
msgstr "セッションのプロセスが実行されていません"

#: lib/retro_hex_chat/lobby/policy.ex:127
#, elixir-autogen, elixir-format
msgid "Target user must be registered"
msgstr "対象のユーザーは登録済みである必要があります"

#: lib/retro_hex_chat/lobby/policy.ex:153
#, elixir-autogen, elixir-format
msgid "User not available"
msgstr "このユーザーは利用できません"

#: lib/retro_hex_chat/lobby/policy.ex:263
#, elixir-autogen, elixir-format
msgid "You are not a participant in this lobby"
msgstr "あなたはこのロビーの参加者ではありません"

#: lib/retro_hex_chat/lobby/policy.ex:126
#, elixir-autogen, elixir-format
msgid "You must be registered to use the lobby"
msgstr "ロビーを使用するには登録が必要です"

#: lib/retro_hex_chat/lobby/policy.ex:286
#, elixir-autogen, elixir-format
msgid "This match is already full"
msgstr "この対戦はすでに満員です"

#: lib/retro_hex_chat/lobby/policy.ex:290
#, elixir-autogen, elixir-format
msgid "This match link has expired"
msgstr "この対戦リンクは期限切れです"

#: lib/retro_hex_chat/lobby/policy.ex:299
#, elixir-autogen, elixir-format
msgid "You cannot join your own match"
msgstr "自分の対戦には参加できません"

#: lib/retro_hex_chat/lobby/service.ex:314
#, elixir-autogen, elixir-format
msgid "Too many lobbies created. Try again in %{count} second"
msgid_plural "Too many lobbies created. Try again in %{count} seconds"
msgstr[0] "ロビーの作成回数が多すぎます。%{count} 秒後にもう一度お試しください"

#: lib/retro_hex_chat/lobby/policy.ex:135
#, elixir-autogen, elixir-format
msgid "A session with this person is already open. Its card is in this conversation."
msgstr "この人とのセッションはすでに開いています。そのカードはこの会話の中にあります。"
