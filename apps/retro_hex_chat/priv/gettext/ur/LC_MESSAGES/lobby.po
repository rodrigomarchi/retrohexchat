#: lib/retro_hex_chat/lobby/policy.ex:81
#, elixir-autogen, elixir-format
msgid "An active lobby already exists with this user"
msgstr "اس صارف کے ساتھ پہلے ہی فعال پلگ ان موجود ہے"

#: lib/retro_hex_chat/lobby/policy.ex:60
#, elixir-autogen, elixir-format
msgid "Cannot create a session with yourself"
msgstr "سیشن اپنے ساتھ نہیں بنا سکتے"

#: lib/retro_hex_chat/lobby/service.ex:134
#, elixir-autogen, elixir-format
msgid "Failed to create lobby"
msgstr "غیر متصل"

#: lib/retro_hex_chat/lobby/session_server.ex:223
#, elixir-autogen, elixir-format
msgid "Invalid transition from %{from} to %{to}"
msgstr "غیرمتوقع تبدیلی %{from} جگہ %{to}"

#: lib/retro_hex_chat/lobby/policy.ex:135
#, elixir-autogen, elixir-format
msgid "Invite is no longer pending"
msgstr "اب دعوت جاری نہیں ہے"

#: lib/retro_hex_chat/lobby/policy.ex:139
#, elixir-autogen, elixir-format
msgid "Lobby is no longer active"
msgstr "لوبی اب فعال نہیں ہے۔"

#: lib/retro_hex_chat/lobby/service.ex:140
#, elixir-autogen, elixir-format
msgid "Lobby not found"
msgstr "لوبی نہیں پائی"

#: lib/retro_hex_chat/lobby/session_server.ex:180
#, elixir-autogen, elixir-format
msgid "Not a participant"
msgstr "کوئی مسئلہ نہیں"

#: lib/retro_hex_chat/lobby/policy.ex:120
#, elixir-autogen, elixir-format
msgid "Only the invited user can decline"
msgstr "صرف دعوتی صارف ہی کمی کر سکتا ہے۔"

#: lib/retro_hex_chat/lobby/policy.ex:128
#, elixir-autogen, elixir-format
msgid "Only the inviter can cancel the invite"
msgstr "صرف دعوت ختم کر سکتے ہیں"

#: lib/retro_hex_chat/lobby/service.ex:117
#: lib/retro_hex_chat/lobby/session_server.ex:94
#: lib/retro_hex_chat/lobby/session_server.ex:704
#: lib/retro_hex_chat/lobby/session_server.ex:705
#: lib/retro_hex_chat/lobby/session_server.ex:706
#, elixir-autogen, elixir-format
msgid "Session process not running"
msgstr "کارکردگی کا عمل"

#: lib/retro_hex_chat/lobby/policy.ex:74
#, elixir-autogen, elixir-format
msgid "Target user must be registered"
msgstr "نئے صارف کو رجسٹر کرنا لازمی ہے"

#: lib/retro_hex_chat/lobby/service.ex:171
#, elixir-autogen, elixir-format
msgid "Too many lobbies created. Try again in %{minutes} minutes"
msgstr "بہت سارے لو گ پیدا ہوئے۔ دوبارہ کوشش کریں %{minutes} منٹ"

#: lib/retro_hex_chat/lobby/policy.ex:102
#, elixir-autogen, elixir-format
msgid "User not available"
msgstr "صارف دستیاب نہیں ہے"

#: lib/retro_hex_chat/lobby/policy.ex:112
#, elixir-autogen, elixir-format
msgid "You are not a participant in this lobby"
msgstr "کہ تم اس دنیا میں تو نہیں ہو۔"

#: lib/retro_hex_chat/lobby/policy.ex:73
#, elixir-autogen, elixir-format
msgid "You must be registered to use the lobby"
msgstr "لاگ ان استعمال کر نے کے لیے آپ کو نامزد کرنا ہوگا"
