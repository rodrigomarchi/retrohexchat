#: lib/retro_hex_chat/group_call.ex:68
#, elixir-autogen, elixir-format
msgid "Group call rate limit reached. Try again in %{count} second."
msgid_plural "Group call rate limit reached. Try again in %{count} seconds."
msgstr[0] "گروپ شرح حدیث کہلاتا ہے۔ دوبارہ کوشش کریں %{count} دوم."
msgstr[1] "گروپ شرح حدیث کہلاتا ہے۔ دوبارہ کوشش کریں %{count} سیکنڈ"

#: lib/retro_hex_chat/group_call.ex:397
#, elixir-autogen, elixir-format
