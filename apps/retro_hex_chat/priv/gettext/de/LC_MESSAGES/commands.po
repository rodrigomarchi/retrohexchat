msgstr "Führt einen Befehl einmal nach einer Verzögerung oder immer wieder aus."

#: lib/retro_hex_chat/commands/mirc_parity.ex:93
#, elixir-autogen, elixir-format
msgid "Takes $1 to $9, $nick and $chan. There is no scripting language behind it."
msgstr "Akzeptiert $1 bis $9, $nick und $chan. Dahinter steckt keine Skriptsprache."

#: lib/retro_hex_chat/commands/mirc_parity.ex:112
#, elixir-autogen, elixir-format
msgid "Takes a type and a duration."
msgstr "Erwartet einen Typ und eine Dauer."

#: lib/retro_hex_chat/commands/mirc_parity.ex:63
#: lib/retro_hex_chat/commands/mirc_parity.ex:73
#: lib/retro_hex_chat/commands/mirc_parity.ex:77
