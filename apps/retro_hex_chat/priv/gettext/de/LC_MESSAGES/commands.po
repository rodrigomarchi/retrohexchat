#: lib/retro_hex_chat/commands/handlers/mode.ex:15
#: lib/retro_hex_chat/commands/handlers/mode.ex:20
#, elixir-autogen, elixir-format
msgid "Change channel settings and user privileges using mode flags.\nFlags: +o (operator), +v (voice), +b (ban), +h (half-op), +m (moderated), +i (invite-only), +t (topic protected), +k (key/password), +l (user limit), +n (no external messages), +j (join throttle), +K (no knock).\nRequires: channel operator. Half-operators can only set +v/-v. Must be in a channel."
msgstr ""
"Ändern Sie die Kanaleinstellungen und Benutzerrechte mithilfe von Mode-Flags.\n"
"Flaggen: +o (Operator), +v (Sprache), +b (ban), +h (half-op), +m (modifiziert), +i (nur eingeladen), +t (topisch geschützt), +k (key/password), +l (Benutzergrenze), +n (keine externe Nachrichten), +j (Joindrossel), +K (kein Klopf).\n"
"Anforderungen: Kanalbetreiber. Halbbediener können nur +v/-v einstellen. Muss in einem Kanal sein."

#: lib/retro_hex_chat/commands/handlers/nick.ex:15
#, elixir-autogen, elixir-format
msgid "Change your display name in the chat. A confirmation dialog appears before the change takes effect."
msgstr "Ändere deinen Anzeigenamen im Chat. Vor dem Wirksamwerden der Änderung erscheint ein Bestätigungsdialog."

#: lib/retro_hex_chat/commands/handlers/nick.ex:20
#, elixir-autogen, elixir-format
msgid "Change your display name. A confirmation dialog appears before the change takes effect.\nRules: 1-16 characters, no spaces. Must start with a letter or [ ] \\ ^ _ { | }.\nAllowed characters: letters, numbers, [ ] \\ ^ _ ` { | } and hyphens.\nCannot change to your current nickname or one already in use."
msgstr ""
"Ändere deinen Anzeigenamen. Vor dem Wirksamwerden der Änderung erscheint ein Bestätigungsdialog.\n"
"Regeln: 1-16 Zeichen, keine Leerzeichen. Muss mit einem Buchstaben oder [ ] \\ ^ _ { | } beginnen.\n"
"Erlaubte Zeichen: Buchstaben, Zahlen, [ ] \\ ^ _ ` { | } und Bindestriche.\n"
"Du kannst nicht zu deinem aktuellen Nick oder einem bereits verwendeten Nick wechseln."

