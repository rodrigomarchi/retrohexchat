#, elixir-autogen, elixir-format
msgid "You are already in that channel"
msgstr "Sie sind bereits in diesem Kanal"

#: lib/retro_hex_chat/channels/server.ex:978
#, elixir-autogen, elixir-format
msgid "You are banned from that channel"
msgstr "Sie sind von diesem Kanal verboten"

#: lib/retro_hex_chat/channels/server.ex:1398
#, elixir-autogen, elixir-format
msgid "You are muted in this channel"
msgstr "Sie sind in diesem Kanal mutiert"

#: lib/retro_hex_chat/channels/policy.ex:77
#: lib/retro_hex_chat/channels/policy.ex:84
#: lib/retro_hex_chat/channels/policy.ex:99
#, elixir-autogen, elixir-format
msgid "You are not in this channel"
msgstr "Sie sind nicht in diesem Kanal"

#: lib/retro_hex_chat/channels/policy.ex:164
#, elixir-autogen, elixir-format
msgid "You cannot ban yourself"
msgstr "Du kannst dich nicht verbieten"

#: lib/retro_hex_chat/channels/server.ex:820
#: lib/retro_hex_chat/channels/server.ex:846
#: lib/retro_hex_chat/channels/server.ex:872
#: lib/retro_hex_chat/channels/server.ex:898
#, elixir-autogen, elixir-format
msgid "You must be a channel operator"
msgstr "Sie müssen ein Kanalbetreiber sein"

#: lib/retro_hex_chat/channels/policy.ex:93
#, elixir-autogen, elixir-format
msgid "You must be a channel operator to change the topic"
msgstr "Sie müssen ein Kanalbetreiber sein, um das Thema zu ändern"

#: lib/retro_hex_chat/channels/server.ex:917
#: lib/retro_hex_chat/channels/server.ex:1286
#, elixir-autogen, elixir-format
msgid "You must be a channel operator to unban users"
msgstr "Sie müssen ein Channel Operator für unban Benutzer sein"

#: lib/retro_hex_chat/channels/server.ex:1019
#, elixir-autogen, elixir-format
msgid "Could not persist channel mute"
msgstr "Stummschaltung des Kanals konnte nicht gespeichert werden"

#: lib/retro_hex_chat/channels/server.ex:1041
#, elixir-autogen, elixir-format
msgid "Could not persist channel unmute"
msgstr "Aufheben der Stummschaltung des Kanals konnte nicht gespeichert werden"

#: lib/retro_hex_chat/channels/departure.ex:30
#, elixir-autogen, elixir-format
msgid "Connection lost"
msgstr "Verbindung verloren"

#: lib/retro_hex_chat/channels/pins.ex:133
#, elixir-autogen, elixir-format
msgid "That message could not be pinned"
msgstr "Diese Nachricht konnte nicht angeheftet werden"

#: lib/retro_hex_chat/channels/pins.ex:161
#: lib/retro_hex_chat/channels/pins.ex:165
#, elixir-autogen, elixir-format
msgid "That message is not in this channel"
msgstr "Diese Nachricht gehört nicht zu diesem Kanal"

#: lib/retro_hex_chat/channels/pins.ex:143
#, elixir-autogen, elixir-format
msgid "This channel already keeps %{count} messages. Unpin one first."
msgstr "Dieser Kanal behält bereits %{count} Nachrichten. Löse zuerst eine."

#: lib/retro_hex_chat/channels/policy.ex:124
#, elixir-autogen, elixir-format
msgid "You must be a channel operator to pin messages"
msgstr "Zum Anheften musst du Kanaloperator sein"

#: lib/retro_hex_chat/channels/server.ex:1829
#, elixir-autogen, elixir-format
msgid "Only the channel founder can change the public archive"
msgstr "Nur die Gründerin oder der Gründer des Kanals kann das öffentliche Archiv ändern"

#: lib/retro_hex_chat/channels/server.ex:1761
#, elixir-autogen, elixir-format
msgid "%{nickname} scheduled: %{title}"
msgstr "%{nickname} hat angesetzt: %{title}"

#: lib/retro_hex_chat/channels/server.ex:1793
#, elixir-autogen, elixir-format
msgid "That event belongs to another channel."
msgstr "Dieses Ereignis gehört zu einem anderen Kanal."

#: lib/retro_hex_chat/channels/scheduled_events.ex:120
#: lib/retro_hex_chat/channels/scheduled_events.ex:146
#: lib/retro_hex_chat/channels/server.ex:1790
#, elixir-autogen, elixir-format
