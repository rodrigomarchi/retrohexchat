msgstr "Kanal ist nicht einladend"

#: lib/retro_hex_chat/channels/server.ex:1441
#, elixir-autogen, elixir-format
msgid "Channel join throttle active, please try again shortly"
msgstr "Kanal verbinden drossel aktiv, bitte versuchen Sie es bald"

