#, elixir-autogen, elixir-format
msgctxt "game category"
msgid "Cards"
msgstr "Karten"

#: lib/retro_hex_chat/games/catalog.ex:106
#, elixir-autogen, elixir-format
msgctxt "game category"
msgid "Puzzles"
msgstr "Denkspiele"

#: lib/retro_hex_chat/games/catalog.ex:97
#, elixir-autogen, elixir-format
msgctxt "game category"
msgid "Shooters"
msgstr "Shooter"

