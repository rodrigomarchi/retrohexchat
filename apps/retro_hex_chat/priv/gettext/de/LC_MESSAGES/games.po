#: lib/retro_hex_chat/games/catalog.ex:478
#, elixir-autogen, elixir-format
msgid "Neon ice warfare"
msgstr "Neon-Eis-Warfare"

#: lib/retro_hex_chat/games/catalog.ex:302
#, elixir-autogen, elixir-format
