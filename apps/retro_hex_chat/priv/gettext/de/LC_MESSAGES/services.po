#: lib/retro_hex_chat/services/nick_email.ex:79
#, elixir-autogen, elixir-format
msgid "Somebody added this address to the RetroHexChat nickname %{nickname}. Open this link to confirm it:\n\n%{link}\n\nIf this was not you, ignore this message — nothing has changed and the address will stay unconfirmed."
msgstr "Jemand hat diese Adresse zum RetroHexChat-Spitznamen %{nickname} hinzugefügt. Öffne diesen Link, um sie zu bestätigen:\n\n%{link}\n\nWarst du das nicht, ignoriere diese Nachricht — es hat sich nichts geändert und die Adresse bleibt unbestätigt."


#: lib/retro_hex_chat/services/nick_email.ex:150
#, elixir-autogen, elixir-format
msgid "Somebody asked to reset the password for the RetroHexChat nickname %{nickname}. Open this link to choose a new one:\n\n%{link}\n\nIf this was not you, ignore this message — your password has not changed."
msgstr "Jemand hat darum gebeten, das Passwort des RetroHexChat-Spitznamens %{nickname} zurückzusetzen. Öffne diesen Link, um ein neues zu wählen:\n\n%{link}\n\nWarst du das nicht, ignoriere diese Nachricht — dein Passwort hat sich nicht geändert."


