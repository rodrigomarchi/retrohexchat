#: lib/retro_hex_chat/commands/handlers/mode.ex:39
#: lib/retro_hex_chat/commands/handlers/mode.ex:96
#, elixir-autogen, elixir-format
msgid "Change channel settings and user privileges using mode flags.\nFlags: +o (operator), +v (voice), +b (ban), +h (half-op), +m (moderated), +i (invite-only), +t (topic protected), +k (key/password), +l (user limit), +n (no external messages), +j (join throttle), +K (no knock).\nRequires: channel operator. Half-operators can only set +v/-v. Must be in a channel."
msgstr ""
"Zmień ustawienia kanału i uprawnienia użytkownika za pomocą flag trybu.\n"
"Flagi: + o (operator), + v (głos), + b (zakaz), + h (połowa-op), + m (moderowane), + i (invite- only), + t (chroniony temat), + k (key/password), + l (limit użytkownika), + n (brak zewnętrznych wiadomości), + j (połączenie przepustnicy), + K (brak pukania).\n"
"Wymaga: operatora kanału. Half- operatorzy mogą ustawić tylko + v / -v. Musi być w kanale."

#: lib/retro_hex_chat/commands/handlers/nick.ex:82
#, elixir-autogen, elixir-format
msgid "Change your display name in the chat. A confirmation dialog appears before the change takes effect."
msgstr ""
"Zmień nazwę ekranu w czacie. Pojawia się okno z potwierdzeniem przed "
"wejściem zmiany w życie."

#: lib/retro_hex_chat/commands/handlers/nick.ex:61
#, elixir-autogen, elixir-format
msgid "Change your display name. A confirmation dialog appears before the change takes effect.\nRules: 1-16 characters, no spaces. Must start with a letter or [ ] \\ ^ _ { | }.\nAllowed characters: letters, numbers, [ ] \\ ^ _ ` { | } and hyphens.\nCannot change to your current nickname or one already in use."
msgstr ""
"Zmień nazwę wyświetlacza. Pojawia się okno z potwierdzeniem przed wejściem zmiany w życie.\n"
"Zasady: 1-16 znaków, bez spacji. Musi zacząć się od litery lub []\\ ^ _ {< 124;}.\n"
"Dozwolone znaki: litery, liczby, []\\ ^ _ '{< 124;} i hyphens.\n"
"Nie można zmienić aktualnego pseudonimu lub już używanego."

