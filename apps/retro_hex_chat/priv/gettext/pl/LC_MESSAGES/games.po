#: lib/retro_hex_chat/games/catalog.ex:346
#, elixir-autogen, elixir-format
msgid "3-minute race in permanent darkness with fog bursts. "
msgstr "3-minutowy wyścig w stałej ciemności z podmuchami mgły. "

#: lib/retro_hex_chat/games/catalog.ex:214
#, elixir-autogen, elixir-format
msgid "5 sections of intense River Raid action — river starts narrow, "
msgstr "5 odcinków intensywnej akcji River Raid - rzeka zaczyna wąskie,"

#: lib/retro_hex_chat/games/catalog.ex:320
#, elixir-autogen, elixir-format
msgid "5 waves of pure chaos from the start."
msgstr "5 fal czystego chaosu od początku."

#: lib/retro_hex_chat/games/catalog.ex:361
#, elixir-autogen, elixir-format
msgid "90 seconds of fury"
msgstr "90 sekund furii"

#: lib/retro_hex_chat/games/catalog.ex:367
#, elixir-autogen, elixir-format
msgid "90 seconds to score maximum overtakes."
msgstr "90 sekund na jak najwięcej wyprzedzeń."

#: lib/retro_hex_chat/games/catalog.ex:449
#, elixir-autogen, elixir-format
msgid "Arctic construction race — jump on floating ice blocks to build your igloo. "
msgstr ""
"Arktyczny wyścig budowlany - skok na pływające bloki lodu, aby zbudować "
"igloo."

#: lib/retro_hex_chat/games/catalog.ex:84
#, elixir-autogen, elixir-format
msgid "Arrow keys (Left/Right rotate, Up forward), Space to fire"
msgstr "Strzałki (Left/Right obrócić, Do przodu), Przestrzeń do ognia"

#: lib/retro_hex_chat/games/catalog.ex:157
#, elixir-autogen, elixir-format
msgid "Arrow keys (Left/Right) to move paddle"
msgstr "Strzałki (Left/Right) do poruszania wiosła"

#: lib/retro_hex_chat/games/catalog.ex:174
#, elixir-autogen, elixir-format
msgid "Arrow keys (Up/Down) to move shield, Space to catch/release fireball"
msgstr ""
"Strzałki (UP/Down), aby przenieść tarczę, Przestrzeń do chwytacza /release "
"fireball"

#: lib/retro_hex_chat/games/catalog.ex:336
#: lib/retro_hex_chat/games/catalog.ex:353
#: lib/retro_hex_chat/games/catalog.ex:370
#, elixir-autogen, elixir-format
msgid "Arrow keys (←/→ lane, ↑ accel, ↓ brake), Space or Shift for turbo"
msgstr "Strzałki (←/→ pas, ↑ gaz, ↓ hamulec), Space lub Shift dla turbo"

#: lib/retro_hex_chat/games/catalog.ex:422
#: lib/retro_hex_chat/games/catalog.ex:432
#: lib/retro_hex_chat/games/catalog.ex:442
#, elixir-autogen, elixir-format
msgid "Arrow keys (←/→) or A/D to steer"
msgstr "Strzałki (←/→) albo A/D do sterowania"

#: lib/retro_hex_chat/games/catalog.ex:299
#: lib/retro_hex_chat/games/catalog.ex:312
#: lib/retro_hex_chat/games/catalog.ex:322
#, elixir-autogen, elixir-format
msgid "Arrow keys or A/D to move, Space to fire"
msgstr "Strzałki lub A/D przenieść, Przestrzeń do ognia"

#: lib/retro_hex_chat/games/catalog.ex:60
#, elixir-autogen, elixir-format
msgid "Arrow keys or W/S to move paddle"
msgstr "Strzałki lub W/S przenieść wiosła"

#: lib/retro_hex_chat/games/catalog.ex:244
#: lib/retro_hex_chat/games/catalog.ex:273
#: lib/retro_hex_chat/games/catalog.ex:286
#, elixir-autogen, elixir-format
msgid "Arrow keys or WASD to move, Space or Shift to fire"
msgstr "Strzałki lub WASD, aby przenieść, Przestrzeń lub Shift do ognia"

#: lib/retro_hex_chat/games/catalog.ex:231
#, elixir-autogen, elixir-format
msgid "Arrow keys or WASD to move, Space or Shift to punch"
msgstr "Strzałki lub WASD, aby przenieść, Przestrzeń lub Shift, aby poncz"

#: lib/retro_hex_chat/games/catalog.ex:386
#: lib/retro_hex_chat/games/catalog.ex:396
#: lib/retro_hex_chat/games/catalog.ex:406
#, elixir-autogen, elixir-format
msgid "Arrow keys or WASD to move, Space or Shift to serve"
msgstr "Strzałki lub WASD, aby przenieść, Spacja lub Shift służyć"

#: lib/retro_hex_chat/games/catalog.ex:495
#: lib/retro_hex_chat/games/catalog.ex:509
#: lib/retro_hex_chat/games/catalog.ex:523
#, elixir-autogen, elixir-format
msgid "Arrow keys or WASD to move, Space or Shift to shoot/tackle"
msgstr "Strzałki lub WASD do ruchu, Space lub Shift do strzału/odbioru"

#: lib/retro_hex_chat/games/catalog.ex:458
#: lib/retro_hex_chat/games/catalog.ex:468
#: lib/retro_hex_chat/games/catalog.ex:478
#, elixir-autogen, elixir-format
msgid "Arrow keys or WASD to move, Up/Down to jump between rows"
msgstr "Strzałki lub WASD przenieść, UP/Down do skoku między wierszami"

#: lib/retro_hex_chat/games/catalog.ex:260
#, elixir-autogen, elixir-format
msgid "Arrow keys or WASD to move/aim, Space or Shift to fire"
msgstr "Strzałki lub WASD przenieść /aim, Przestrzeń lub Shift do ognia"

#: lib/retro_hex_chat/games/catalog.ex:101
#: lib/retro_hex_chat/games/catalog.ex:118
#: lib/retro_hex_chat/games/catalog.ex:138
#, elixir-autogen, elixir-format
msgid "Arrow keys or WASD to thrust/rotate, Space to fire, Down/S to warp"
msgstr ""
"Strzałki lub WASD do thrust/rotate, Przestrzeń do ognia, Down/S do warp"

#: lib/retro_hex_chat/games/catalog.ex:73
#, elixir-autogen, elixir-format
msgid "Arrow keys to change direction"
msgstr "Strzałki, aby zmienić kierunek"

#: lib/retro_hex_chat/games/catalog.ex:207
#, elixir-autogen, elixir-format
msgid "Arrow keys to move/speed, Space to fire"
msgstr "Strzałki do ruchu /speed, Przestrzeń do ognia"

#: lib/retro_hex_chat/games/catalog.ex:194
#: lib/retro_hex_chat/games/catalog.ex:218
#, elixir-autogen, elixir-format
msgid "Arrow keys to move/speed, Space to fire, Shift to drop mine"
msgstr "Strzałki do ruchu /speed, Space to fire, Shift to drop mine"

#: lib/retro_hex_chat/games/catalog.ex:78
#, elixir-autogen, elixir-format
msgid "Blast through the maze"
msgstr "Blast przez labirynt"

#: lib/retro_hex_chat/games/catalog.ex:319
#, elixir-autogen, elixir-format
msgid "Blitz Space Invaders — instant alien drops, easier combos, "
msgstr "Blitz Space Invaders - błyskawiczne krople obcych, łatwiejsze combo,"

#: lib/retro_hex_chat/games/catalog.ex:146
#, elixir-autogen, elixir-format
msgid "Break blocks together"
msgstr "Przerwać bloki razem"

#: lib/retro_hex_chat/games/catalog.ex:447
#, elixir-autogen, elixir-format
msgid "Build or be frozen"
msgstr "Zbuduj lub bądź zamrożony"

#: lib/retro_hex_chat/games/catalog.ex:249
#, elixir-autogen, elixir-format
msgid "Bullets bounce back"
msgstr "Kule odbijają się"

#: lib/retro_hex_chat/games/catalog.ex:255
#, elixir-autogen, elixir-format
msgid "Bullets ricochet once off ceiling/floor. First to 10. Best of 3 rounds."
msgstr ""
"Kule rykoszetu raz z Ceiling/floor. Najpierw 10. Najlepsze trzy rundy."

#: lib/retro_hex_chat/games/catalog.ex:306
#, elixir-autogen, elixir-format
msgid "Classic co-op Space Invaders — two cannons fighting the same alien waves. "
msgstr ""
"Klasyczny koop Space Invaders - dwie armaty walczące z tymi samymi falami "
"obcych."

#: lib/retro_hex_chat/games/catalog.ex:297
#, elixir-autogen, elixir-format
msgid "Combos send extra. 10 waves of escalating chaos."
msgstr "Kombos wysyła dodatkowe 10 fal narastającego chaosu."

#: lib/retro_hex_chat/games/catalog.ex:148
#, elixir-autogen, elixir-format
msgid "Cooperative Breakout with two paddles — one at the top, one at the bottom. "
msgstr ""
"Cooperative Breakout z dwoma łopatkami - jeden na górze, jeden na dole."

#: lib/retro_hex_chat/games/catalog.ex:52
#, elixir-autogen, elixir-format
msgid "Cyberpunk Pong"
msgstr "Cyberpunk Pong"

#: lib/retro_hex_chat/games/catalog.ex:363
#, elixir-autogen, elixir-format
msgid "Daylight sprint — no weather changes, no fuel drain, just speed. "
msgstr "Dzienny sprint: bez zmian pogody, bez zużycia paliwa, tylko prędkość. "

#: lib/retro_hex_chat/games/catalog.ex:304
#, elixir-autogen, elixir-format
msgid "Defend Earth together"
msgstr "Bronić Ziemi razem"

#: lib/retro_hex_chat/games/catalog.ex:162
#, elixir-autogen, elixir-format
msgid "Defend your castle"
msgstr "Broń swojego zamku"

#: lib/retro_hex_chat/games/catalog.ex:168
#, elixir-autogen, elixir-format
msgid "Deflect or catch the fireball to smash your opponent's walls. Last king standing wins."
msgstr ""
"Deflekt lub złapać kulę ognia, aby zniszczyć ściany przeciwnika. Ostatni "
"stojący król wygrywa."

#: lib/retro_hex_chat/games/catalog.ex:239
#, elixir-autogen, elixir-format
msgid "Dodge bullets you can see coming. First to 10. Best of 3 rounds."
msgstr ""
"Dodge kule można zobaczyć nadchodzi. Najpierw 10. Najlepsze trzy rundy."

#: lib/retro_hex_chat/games/catalog.ex:284
#, elixir-autogen, elixir-format
msgid "Dodge freely in your half. First to 10. Best of 3 rounds."
msgstr "Dodge swobodnie w swojej połowie. Najpierw 10. Najlepsze trzy rundy."

#: lib/retro_hex_chat/games/catalog.ex:89
#, elixir-autogen, elixir-format
msgid "Dogfight in the void"
msgstr "Walka psów w pustce"

#: lib/retro_hex_chat/games/catalog.ex:65
#, elixir-autogen, elixir-format
msgid "Don't cross the line"
msgstr "Nie przekraczaj granicy."

#: lib/retro_hex_chat/games/catalog.ex:236
#, elixir-autogen, elixir-format
msgid "Draw at high noon"
msgstr "Narysuj w południe"

#: lib/retro_hex_chat/games/catalog.ex:403
#, elixir-autogen, elixir-format
msgid "Every point wins a game — no 15-30-40, no deuce. "
msgstr "Każdy punkt wygrywa mecz - nie 15-30-40, nie ma dwójki."

#: lib/retro_hex_chat/games/catalog.ex:500
#, elixir-autogen, elixir-format
msgid "Fast and brutal"
msgstr "Szybko i brutalnie"

#: lib/retro_hex_chat/games/catalog.ex:212
#, elixir-autogen, elixir-format
msgid "Fast and furious"
msgstr "Szybki i wściekły"

#: lib/retro_hex_chat/games/catalog.ex:440
#, elixir-autogen, elixir-format
msgid "Fastest time down the mountain wins."
msgstr "Najszybszy czas w dół góry wygrywa."

#: lib/retro_hex_chat/games/catalog.ex:128
#, elixir-autogen, elixir-format
msgid "Fight through a field of floating asteroids that block missiles and kill on contact. "
msgstr ""
"Walczyć przez pole pływających asteroidów, które blokują rakiety i zabić w "
"kontakcie."

#: lib/retro_hex_chat/games/catalog.ex:58
#, elixir-autogen, elixir-format
msgid "First to 11 points (win by 2). Ball speeds up on each rally."
msgstr ""
"Pierwszy do 11 punktów (wygraj przez 2). Piłka przyspiesza na każdym wiecu."

#: lib/retro_hex_chat/games/catalog.ex:391
#, elixir-autogen, elixir-format
msgid "First to 3 games"
msgstr "Pierwszy do 3 gier"

#: lib/retro_hex_chat/games/catalog.ex:404
#, elixir-autogen, elixir-format
msgid "First to 6 games takes the set. Pure pressure."
msgstr "Pierwszy do 6 gry bierze zestaw. Czyste ciśnienie."

#: lib/retro_hex_chat/games/catalog.ex:476
#, elixir-autogen, elixir-format
msgid "First to complete the igloo wins. Fair and square."
msgstr "Pierwszy, który dokończy igloo wygrywa. Sprawiedliwie."

#: lib/retro_hex_chat/games/catalog.ex:514
#, elixir-autogen, elixir-format
msgid "First to five"
msgstr "Pierwszy do pięciu"

#: lib/retro_hex_chat/games/catalog.ex:223
#, elixir-autogen, elixir-format
msgid "Fists of fury"
msgstr "Pięści wściekłości"

#: lib/retro_hex_chat/games/catalog.ex:384
#, elixir-autogen, elixir-format
msgid "Full set with tiebreak at 6-6. Deuce, advantage, the works."
msgstr "Pełny zestaw z tiebreak na 6- 6. Deuce, przewaga, praca."

#: lib/retro_hex_chat/games/catalog.ex:344
#, elixir-autogen, elixir-format
msgid "Headlights only"
msgstr "Tylko reflektory"

#: lib/retro_hex_chat/games/catalog.ex:68
#, elixir-autogen, elixir-format
msgid "Hit a trail or the wall and you're out. Trap your opponent to win."
msgstr ""
"Uderz w ślad albo ścianę i wylatujesz. Uchwyć przeciwnika, aby wygrać."

#: lib/retro_hex_chat/games/catalog.ex:429
#, elixir-autogen, elixir-format
msgid "Infinite descent — the avalanche never stops accelerating. "
msgstr "Nieskończone opadanie - lawina nigdy nie przestaje przyspieszać."

#: lib/retro_hex_chat/games/catalog.ex:430
#, elixir-autogen, elixir-format
msgid "Last skier standing wins. Pure survival."
msgstr "Ostatni narciarz wygrywa. Czyste przetrwanie."

#: lib/retro_hex_chat/games/catalog.ex:265
#, elixir-autogen, elixir-format
msgid "Moving cover"
msgstr "Pokrywa ruchoma"

#: lib/retro_hex_chat/games/catalog.ex:126
#, elixir-autogen, elixir-format
msgid "Navigate the wreckage"
msgstr "Nawiguj wrak"

#: lib/retro_hex_chat/games/catalog.ex:483
#, elixir-autogen, elixir-format
msgid "Neon ice warfare"
msgstr "Neonowa wojna lodowa"

#: lib/retro_hex_chat/games/catalog.ex:91
#, elixir-autogen, elixir-format
msgid "Newtonian space combat — thrust, rotate, and fire missiles in open vacuum. "
msgstr ""
"Newtoński kosmiczny bój - pchnięcie, obrót, i ogień pociski w otwartym "
"próżni."

#: lib/retro_hex_chat/games/catalog.ex:310
#, elixir-autogen, elixir-format
msgid "No alien drop. Survive together or fall together."
msgstr "Żadnych kosmitów. Przetrwajcie razem albo upadnijcie razem."

#: lib/retro_hex_chat/games/catalog.ex:439
#, elixir-autogen, elixir-format
msgid "No avalanche, no items — just trees, rocks, and gates. "
msgstr "Żadnej lawiny, żadnych przedmiotów - tylko drzewa, skały i bramy."

#: lib/retro_hex_chat/games/catalog.ex:317
#, elixir-autogen, elixir-format
msgid "No mercy, no delay"
msgstr "Bez litości, bez zwłoki"

#: lib/retro_hex_chat/games/catalog.ex:199
#, elixir-autogen, elixir-format
msgid "No mines, pure skill"
msgstr "Brak min, czyste umiejętności"

#: lib/retro_hex_chat/games/catalog.ex:473
#, elixir-autogen, elixir-format
msgid "No stealing, pure race"
msgstr "Bez kradzieży, czysta rasa"

#: lib/retro_hex_chat/games/catalog.ex:516
#, elixir-autogen, elixir-format
msgid "No timer — first to 5 goals wins. Puck speed increases with each goal scored. "
msgstr ""
"Brak zegara - pierwszy do 5 goli wygrywa. Prędkość Puck zwiększa się z "
"każdym bramką."

#: lib/retro_hex_chat/games/catalog.ex:278
#, elixir-autogen, elixir-format
msgid "Nowhere to hide"
msgstr "Nie ma gdzie się ukryć."

#: lib/retro_hex_chat/games/catalog.ex:463
#, elixir-autogen, elixir-format
msgid "One epic round"
msgstr "Jedna epicka runda"

#: lib/retro_hex_chat/games/catalog.ex:502
#, elixir-autogen, elixir-format
msgid "One period of 3 minutes — faster puck, higher tackle success rate. "
msgstr "Jeden okres 3 minut - szybszy krążek, wyższy wskaźnik sukcesu."

#: lib/retro_hex_chat/games/catalog.ex:401
#, elixir-autogen, elixir-format
msgid "One point, one game"
msgstr "Jeden punkt, jeden gry"

#: lib/retro_hex_chat/games/catalog.ex:109
#, elixir-autogen, elixir-format
msgid "Orbit the dying star"
msgstr "Orbit umierająca gwiazda"

#: lib/retro_hex_chat/games/catalog.ex:111
#, elixir-autogen, elixir-format
msgid "Orbital combat around a central gravity star. "
msgstr "Walka orbitalna wokół centralnej gwiazdy grawitacji."

#: lib/retro_hex_chat/games/catalog.ex:427
#, elixir-autogen, elixir-format
msgid "Outrun the wasteland"
msgstr "Outrun the wasteland"

#: lib/retro_hex_chat/games/catalog.ex:330
#, elixir-autogen, elixir-format
msgid "Overtake AI cars and your opponent, manage fuel, draft in slipstreams. Best of 3 days."
msgstr "Wyprzedzaj auta SI i rywala, zarządzaj paliwem i korzystaj z tunelu aerodynamicznego. Do 3 dni."

#: lib/retro_hex_chat/games/catalog.ex:54
#, elixir-autogen, elixir-format
msgid "Pong reimagined as cyberpunk arcade — neon glow, CRT scanlines, synth audio. "
msgstr ""
"Pong ponownie wyobrażony jako cyberpunk arcade - neon blask, CRT scanlines, "
"synth audio."

#: lib/retro_hex_chat/games/catalog.ex:329
#, elixir-autogen, elixir-format
msgid "Pseudo-3D racing duel through day, snow, fog, and night. "
msgstr "Pseudo-3D pojedynek wyścigowy przez dzień, śnieg, mgłę i noc. "

#: lib/retro_hex_chat/games/catalog.ex:202
#, elixir-autogen, elixir-format
msgid "Pure competition for points, fuel, and survival across 10 sections."
msgstr "Czysta konkurencja o punkty, paliwo i przetrwanie w 10 sekcjach."

#: lib/retro_hex_chat/games/catalog.ex:475
#, elixir-autogen, elixir-format
msgid "Pure construction race — no block stealing allowed. "
msgstr "Czysty wyścig budowlany - nie wolno kraść bloków."

#: lib/retro_hex_chat/games/catalog.ex:437
#, elixir-autogen, elixir-format
msgid "Pure downhill duel"
msgstr "Pure downhill pojedynek"

#: lib/retro_hex_chat/games/catalog.ex:506
#, elixir-autogen, elixir-format
msgid "Pure intensity from start to finish."
msgstr "Czysta intensywność od początku do końca."

#: lib/retro_hex_chat/games/catalog.ex:347
#, elixir-autogen, elixir-format
msgid "Pure reflexes — most overtakes wins. Headlights only visibility."
msgstr "Czysty refleks: wygrywa najwięcej wyprzedzeń. Widoczność tylko z reflektorów."

#: lib/retro_hex_chat/games/catalog.ex:226
#, elixir-autogen, elixir-format
msgid "Push-and-pull until KO or decision by points. Best of 3 rounds."
msgstr "Push- and- pull do KO lub decyzji przez punkty. Najlepsze trzy rundy."

#: lib/retro_hex_chat/games/catalog.ex:393
#, elixir-autogen, elixir-format
msgid "Quick tennis match — first to 3 games wins. "
msgstr "Szybki mecz tenisowy - pierwszy do 3 meczów wygrywa."

#: lib/retro_hex_chat/games/catalog.ex:67
#, elixir-autogen, elixir-format
msgid "Race across a grid arena leaving a glowing trail behind you. "
msgstr "Wyścig przez arenę siatki pozostawiając świecący ślad za tobą."

#: lib/retro_hex_chat/games/catalog.ex:411
#, elixir-autogen, elixir-format
msgid "Race the avalanche"
msgstr "Wyścig lawina"

#: lib/retro_hex_chat/games/catalog.ex:327
#, elixir-autogen, elixir-format
msgid "Race through the wasteland"
msgstr "Pędź przez pustkowie"

#: lib/retro_hex_chat/games/catalog.ex:184
#, elixir-autogen, elixir-format
msgid "River Raid reimagined for two — race through a scrolling toxic canal, destroy enemies, "
msgstr ""
"Rzeka Raid przeobraziła się dla dwóch - wyścig przez scrolling toksyczny "
"kanał, zniszczyć wrogów,"

#: lib/retro_hex_chat/games/catalog.ex:201
#, elixir-autogen, elixir-format
msgid "River Raid without sabotage — no mines allowed. "
msgstr "Rzeka Raid bez sabotażu - nie wolno kopalń."

#: lib/retro_hex_chat/games/catalog.ex:394
#, elixir-autogen, elixir-format
msgid "Same gameplay, shorter format. No tiebreak needed."
msgstr "Ta sama gra, krótszy format. Nie ma takiej potrzeby."

#: lib/retro_hex_chat/games/catalog.ex:378
#, elixir-autogen, elixir-format
msgid "Serve, rally, win"
msgstr "Służ, zjeżdżaj, wygrywaj"

#: lib/retro_hex_chat/games/catalog.ex:81
#, elixir-autogen, elixir-format
msgid "Shots ricochet off walls — use geometry to your advantage."
msgstr "Strzela rykoszetem ze ścian - użyj geometrii na swoją korzyść."

#: lib/retro_hex_chat/games/catalog.ex:293
#, elixir-autogen, elixir-format
msgid "Split-screen Space Invaders — aliens you destroy fall on your opponent as reinforcements. "
msgstr ""
"Split- screen Space Invaders - kosmitów można zniszczyć upadek na "
"przeciwnika jako wzmocnienie."

#: lib/retro_hex_chat/games/catalog.ex:453
#, elixir-autogen, elixir-format
msgid "Steal your opponent's blocks for a 2-piece swing. Best of 5 rounds with polar bears, crabs, geese, and clams."
msgstr ""
"Ukradnij bloki przeciwnika dla 2-częściowej huśtawki. Najlepsze 5 rund z "
"niedźwiedziami polarnymi, krabami, gęsiami i małżami."

#: lib/retro_hex_chat/games/catalog.ex:520
#, elixir-autogen, elixir-format
msgid "The pressure builds every time the net shakes."
msgstr "Ciśnienie rośnie za każdym razem, gdy sieć się trzęsie."

#: lib/retro_hex_chat/games/catalog.ex:268
#, elixir-autogen, elixir-format
msgid "Time your shots around the moving obstacle. First to 10. Best of 3 rounds."
msgstr ""
"Czas rzutów wokół przeszkody ruchu. Najpierw 10. Najlepsze trzy rundy."

