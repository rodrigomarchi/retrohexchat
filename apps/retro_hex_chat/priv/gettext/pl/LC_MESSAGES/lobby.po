#, elixir-autogen, elixir-format
msgid "Cannot create a session with yourself"
msgstr "Nie można utworzyć sesji z samym sobą"

#: lib/retro_hex_chat/lobby/service.ex:239
#: lib/retro_hex_chat/lobby/service.ex:256
#: lib/retro_hex_chat/lobby/service.ex:280
