msgstr[2] "Utworzono zbyt wiele lobby. Spróbuj ponownie za %{count} sekund"

#: lib/retro_hex_chat/lobby/policy.ex:135
#, elixir-autogen, elixir-format
msgid "A session with this person is already open. Its card is in this conversation."
msgstr "Sesja z tą osobą jest już otwarta. Jej karta jest w tej rozmowie."
