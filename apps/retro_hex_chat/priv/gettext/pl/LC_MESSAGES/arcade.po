#: lib/retro_hex_chat/arcade/content/doom_shareware.ex:35
#, elixir-autogen, elixir-format
msgid "Secrets are everywhere — look for misaligned wall textures and listen for hidden doors."
msgstr "Sekrety są wszędzie — szukaj źle dopasowanych tekstur ścian i nasłuchuj ukrytych drzwi."

#: lib/retro_hex_chat/arcade/content/chex_quest.ex:30
