msgstr "Gry retro"

#: lib/retro_hex_chat/chat/help_topics/features.ex:2076
#, elixir-autogen, elixir-format
msgid "retro games"
msgstr "gry retro"

#: lib/retro_hex_chat/chat/help_topics/features.ex:2138
#, elixir-autogen, elixir-format
msgid "Hex Boxing is also available."
msgstr "Hex Boxing jest także dostępny."

#: lib/retro_hex_chat/chat/help_topics/features.ex:2218
#, elixir-autogen, elixir-format
msgid "It is also available in Retro Games solo mode against an AI tank."
msgstr "Jest też dostępna w trybie solo gier retro przeciw czołgowi SI."

#: lib/retro_hex_chat/chat/help_topics/features.ex:2139
#, elixir-autogen, elixir-format
msgid "Pixel Tanks is also available."
msgstr "Pixel Tanks jest także dostępny."

#: lib/retro_hex_chat/chat/help_topics/features.ex:3407
#, elixir-autogen, elixir-format
msgid "Play classic point & click adventures in your browser — "
msgstr "Graj w klasyczne przygodówki point & click w przeglądarce — "

#: lib/retro_hex_chat/chat/help_topics/features.ex:3252
#: lib/retro_hex_chat/chat/help_topics/features.ex:3285
#: lib/retro_hex_chat/chat/help_topics/features.ex:3355
#, elixir-autogen, elixir-format
msgid "Powered by"
msgstr "Obsługiwane przez"

#: lib/retro_hex_chat/chat/help_topics/features.ex:3150
#: lib/retro_hex_chat/chat/help_topics/features.ex:3411
