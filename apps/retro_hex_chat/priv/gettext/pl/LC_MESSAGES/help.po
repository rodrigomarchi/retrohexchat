msgstr "Zapobiegać użytkownikom wysyłania próśb pukania na kanał."

#: lib/retro_hex_chat/chat/help_topics/features.ex:1702
#, elixir-autogen, elixir-format
msgid "Privacy Settings"
msgstr "Ustawienia prywatności"

#: lib/retro_hex_chat/chat/help_topics/getting_started.ex:52
#, elixir-autogen, elixir-format
msgid "Private Messages"
msgstr "Wiadomości prywatne"

#: lib/retro_hex_chat/chat/help_topics/features.ex:1740
#, elixir-autogen, elixir-format
msgid "Private message conversations are restored automatically on reconnect, ordered by recency."
msgstr ""
"Prywatne rozmowy wiadomości są automatycznie przywracane po ponownym "
"połączeniu, uporządkowane przez regencję."

#: lib/retro_hex_chat/chat/help_topics/features.ex:471
#, elixir-autogen, elixir-format
msgid "Protect against message flooding with rate limiting and automatic ignore rules."
msgstr ""
"Chronić przed powodzią komunikatów z ograniczonymi szybkościami i "
"automatycznie ignorować zasady."

#: lib/retro_hex_chat/chat/help_topics/features.ex:2690
#, elixir-autogen, elixir-format
msgid "Pseudo-3D racing duel through day, snow, fog, and night. "
msgstr "Pseudo-3D pojedynek wyścigowy przez dzień, śnieg, mgłę i noc. "

#: lib/retro_hex_chat/chat/help_topics/features.ex:2417
#, elixir-autogen, elixir-format
msgid "Pure competition for points, fuel, and survival across 10 sections. "
msgstr "Czysta konkurencja o punkty, paliwo i przetrwanie w 10 sekcjach."

#: lib/retro_hex_chat/chat/help_topics/features.ex:2995
#, elixir-autogen, elixir-format
msgid "Pure construction race — no block stealing allowed. Stepping on opponent's blocks "
msgstr ""
"Czysty wyścig budowlany - nie wolno kraść bloków. Deptanie bloków "
"przeciwnika"

#: lib/retro_hex_chat/chat/help_topics/features.ex:3068
#, elixir-autogen, elixir-format
msgid "Pure intensity from start to finish. "
msgstr "Czysta intensywność od początku do końca."

#: lib/retro_hex_chat/chat/help_topics/commands.ex:673
#, elixir-autogen, elixir-format
msgid "Query the audit log of admin actions with optional filters."
msgstr ""
"Sprawdź dziennik audytowy działań administracyjnych z opcjonalnymi filtrami."

#: lib/retro_hex_chat/chat/help_topics/features.ex:997
#, elixir-autogen, elixir-format
msgid "Quick reference overlay showing all keyboard shortcuts, opened with Ctrl+/."
msgstr ""
"Szybkie narzucenie odniesienia pokazujące wszystkie skróty klawiszowe, "
"otwarte za pomocą Ctrl + /."

#: lib/retro_hex_chat/chat/help_topics/features.ex:2800
#, elixir-autogen, elixir-format
msgid "Quick tennis match — first to 3 games wins. "
msgstr "Szybki mecz tenisowy - pierwszy do 3 meczów wygrywa."

#: lib/retro_hex_chat/chat/help_topics/features.ex:807
#, elixir-autogen, elixir-format
msgid "Quit Messages"
msgstr "Zakończ wiadomości"

#: lib/retro_hex_chat/chat/help_topics/bots.ex:117
#, elixir-autogen, elixir-format
msgid "RPG dice rolling with standard notation (NdS, modifiers, keep highest/lowest)."
msgstr ""
"RPG kości toczenia ze standardowym notacji (NdS, modyfikatory, zachować "
"highest/lowest)."

#: lib/retro_hex_chat/chat/help_topics/features.ex:2180
#, elixir-autogen, elixir-format
msgid "Race across a grid leaving a glowing trail. Hit a trail or wall and you lose."
msgstr ""
"Wyścig przez siatkę pozostawiając świecący ślad. Uderz w ślad lub ścianę i "
"przegrasz."

#: lib/retro_hex_chat/chat/help_topics/features.ex:1160
#, elixir-autogen, elixir-format
msgid "Real-time latency indicator in the status bar showing network delay to the server."
msgstr ""
"Wskaźnik opóźnienia w czasie rzeczywistym w pasku stanu pokazującym "
"opóźnienie sieciowe serwera."

#: lib/retro_hex_chat/chat/help_topics/services.ex:54
#, elixir-autogen, elixir-format
msgid "Register and manage channels with ChanServ, including access lists and channel settings."
msgstr ""
"Zarejestruj się i zarządzaj kanałami za pomocą ChanServ, w tym listami "
"dostępu i ustawieniami kanałów."

#: lib/retro_hex_chat/chat/help_topics/services.ex:29
#, elixir-autogen, elixir-format
msgid "Register and protect your nickname with NickServ to prevent others from using it."
msgstr ""
"Zarejestruj się i chroń swoją ksywkę NickServ, aby zapobiec jej używaniu "
"przez innych."

#: lib/retro_hex_chat/chat/help_topics/commands.ex:497
#, elixir-autogen, elixir-format
msgid "Remove a ban from a channel to allow the user to rejoin."
msgstr "Usuń zakaz z kanału, aby umożliwić użytkownikowi powrót."

#: lib/retro_hex_chat/chat/help_topics/commands.ex:818
#, elixir-autogen, elixir-format
msgid "Remove a channel mute from a user, allowing them to send messages again."
msgstr ""
"Usuń kanał wyciszony od użytkownika, pozwalając im wysyłać wiadomości "
"ponownie."

#: lib/retro_hex_chat/chat/help_topics/commands.ex:204
#, elixir-autogen, elixir-format
msgid "Remove a user from a channel. Requires operator or higher privileges."
msgstr "Usuń użytkownika z kanału. Wymaga operatora lub wyższych przywilejów."

#: lib/retro_hex_chat/chat/help_topics/commands.ex:506
#, elixir-autogen, elixir-format
msgid "Remove a user from your ignore list to see their messages again."
msgstr ""
"Usuń użytkownika z listy ignorowanych, aby zobaczyć ich wiadomości ponownie."

#: lib/retro_hex_chat/chat/help_topics/commands.ex:747
#, elixir-autogen, elixir-format
msgid "Remove operator status from a user in the current channel."
msgstr "Usuń status operatora z użytkownika w bieżącym kanale."

#: lib/retro_hex_chat/chat/help_topics/special_messages.ex:64
#, elixir-autogen, elixir-format
msgid "Remove the channel welcome message."
msgstr "Usuń wiadomość powitalną kanału."

#: lib/retro_hex_chat/chat/help_topics/special_messages.ex:43
#, elixir-autogen, elixir-format
msgid "Remove the server's Message of the Day. Requires admin privileges."
msgstr "Usuń wiadomość dnia serwera. Wymaga uprawnień administratora."

#: lib/retro_hex_chat/chat/help_topics/commands.ex:774
#, elixir-autogen, elixir-format
msgid "Remove voice status from a user in the current channel."
msgstr "Usuń status głosu użytkownika w bieżącym kanale."

#: lib/retro_hex_chat/chat/help_topics/features.ex:1239
#, elixir-autogen, elixir-format
msgid "Reply to specific messages with quoted context for threaded conversations."
msgstr ""
"Odpowiadaj na konkretne wiadomości z cytowanym kontekstem dla konwersacji "
"gwintowanych."

#: lib/retro_hex_chat/chat/help_topics/channel_modes.ex:307
#, elixir-autogen, elixir-format
msgid "Request an invitation to join an invite-only channel."
msgstr "Poproś o zaproszenie, by dołączyć do kanału invite."

#: lib/retro_hex_chat/chat/help_topics/channel_modes.ex:145
#, elixir-autogen, elixir-format
msgid "Require a password to join the channel."
msgstr "Wymagane hasło, aby dołączyć do kanału."

#: lib/retro_hex_chat/chat/help_topics/channel_modes.ex:110
#, elixir-autogen, elixir-format
