msgstr "A Viking- themed DOOM całkowita konwersja z ręcznie rysowanych pikseli sztuki - osie, łuki, i runic magii. Zwycięzca Cacoward 2018."

#: lib/retro_hex_chat/chat/help_topics/features.ex:2654
#, elixir-autogen, elixir-format
msgid "A complete free replacement for DOOM II — 32 levels with the Super Shotgun. Compatible with community PWAD mods."
msgstr "Kompletny darmowy zamiennik dla DOOM II - 32 poziomów z Super Shotgun. Kompatybilny z modami PWAD."

#: lib/retro_hex_chat/chat/help_topics/features.ex:2825
#, elixir-autogen, elixir-format
msgid "A complete free replacement for Quake — original levels, art, and music under BSD license."
msgstr "Kompletna darmowa wymiana Quake - oryginalne poziomy, sztuka i muzyka na licencji BSD."

#: lib/retro_hex_chat/chat/help_topics/features.ex:2624
#, elixir-autogen, elixir-format
msgid "A complete free replacement for Ultimate DOOM — 4 episodes, 36 levels with original art and music."
msgstr "Kompletna darmowa wymiana Ultimate DOOM - 4 odcinki, 36 poziomów z oryginalną sztuką i muzyką."

#: lib/retro_hex_chat/chat/help_topics/features.ex:2739
#, elixir-autogen, elixir-format
