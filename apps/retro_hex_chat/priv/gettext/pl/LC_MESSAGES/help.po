msgstr ""
"Pokaż powiadomienie systemowe dla rozmowy, na którą nie patrzysz, osobno dla"
" każdego zdarzenia."

#: lib/retro_hex_chat/chat/help_topics/features.ex:486
#, elixir-autogen, elixir-format
msgid "background tab"
msgstr "karta w tle"

#: lib/retro_hex_chat/chat/help_topics/features.ex:481
#: lib/retro_hex_chat/chat/help_topics/features.ex:527
#, elixir-autogen, elixir-format
