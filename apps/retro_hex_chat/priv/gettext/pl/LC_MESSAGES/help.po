#: lib/retro_hex_chat/chat/help_topics/features.ex:2239
#, elixir-autogen, elixir-format
msgid "Newtonian space combat in open vacuum. Thrust, rotate, and fire missiles. "
msgstr ""
"Nowonarodzona walka kosmiczna w otwartej próżni. Pchnięcie, obrót i "
"wystrzelenie pocisków."

#: lib/retro_hex_chat/chat/help_topics/features.ex:1791
#, elixir-autogen, elixir-format
