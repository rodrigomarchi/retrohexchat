msgstr "Konferencja we własnej karcie"

#: lib/retro_hex_chat/chat/help_topics/features.ex:1441
#, elixir-autogen, elixir-format
msgid "Sharing a Conference Link"
msgstr "Udostępnianie linku do konferencji"

