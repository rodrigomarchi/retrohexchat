#: lib/retro_hex_chat/chat/help_topics/user_interface.ex:35
#, elixir-autogen, elixir-format
msgid "Give RetroHexChat its own icon and window from the browser, with no store and no download."
msgstr ""
"Daj RetroHexChat własną ikonę i własne okno prosto z przeglądarki, bez "
"sklepu i bez pobierania."

#: lib/retro_hex_chat/chat/help_topics/user_interface.ex:23
