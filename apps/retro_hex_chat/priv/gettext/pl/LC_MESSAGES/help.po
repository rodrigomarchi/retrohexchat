msgstr "kolumna"

#: lib/retro_hex_chat/chat/help_topics/user_interface.ex:600
#, elixir-autogen, elixir-format
msgid "resize"
msgstr "zmiana rozmiaru"

#: lib/retro_hex_chat/chat/help_topics/user_interface.ex:601
#, elixir-autogen, elixir-format
msgid "sort"
msgstr "sortuj"

#: lib/retro_hex_chat/chat/help_topics/user_interface.ex:598
#, elixir-autogen, elixir-format
msgid "table"
msgstr "tabela"

#: lib/retro_hex_chat/chat/help_topics/user_interface.ex:42
#, elixir-autogen, elixir-format
msgid "Connect Window"
msgstr "Połącz okno"

#: lib/retro_hex_chat/chat/help_topics/user_interface.ex:56
#, elixir-autogen, elixir-format
msgid "Sign in from the Connect window, which appears both on its own screen and on every public page. It carries the whole flow: pick a nickname, register a new one or enter a password for a registered one, and choose whether to remember the terminal. A remembered terminal signs you in with a single click, and one set to auto-login takes you straight to the chat."
msgstr ""
"Zaloguj się z okna Connect, które pojawia się zarówno na własnym ekranie, "
"jak i na każdej stronie publicznej. Przenosi cały przepływ: wybrać "
"pseudonim, zarejestrować nowy lub wprowadzić hasło dla zarejestrowanego i "
"wybrać, czy pamiętać terminal. Zapamiętany terminal zapisuje Cię jednym "
"kliknięciem, a jeden zestaw do autologowania przenosi Cię prosto na czat."

#: lib/retro_hex_chat/chat/help_topics/features.ex:697
#, elixir-autogen, elixir-format
msgid "Clickable nicknames, channels, and URLs, with hover cards and a preview card under any message carrying a link."
msgstr ""
"Kliknięcie pseudonimów, kanałów i adresów URL, z kartami podręcznymi i kartą"
" podglądu pod każdym komunikatem z linkiem."

#: lib/retro_hex_chat/chat/help_topics.ex:61
#: lib/retro_hex_chat/chat/help_topics.ex:91
#: lib/retro_hex_chat/chat/help_topics/features.ex:2030
#: lib/retro_hex_chat/chat/help_topics/features.ex:2053
