#: lib/retro_hex_chat/chat/help_topics/features.ex:4090
#, elixir-autogen, elixir-format
msgid "Cyberpunk masterpiece by Revolution Software (1994) — escape Union City with your robot companion Joey."
msgstr "Cyberpunkowe arcydzieło Revolution Software (1994) — uciekaj z Union City ze swoim robotem Joeyem."

#: lib/retro_hex_chat/chat/help_topics/features.ex:4148
#, elixir-autogen, elixir-format
msgid "Dark cyberpunk top-down adventure by Creative Reality (1994) — explore the Dreamweb to save reality."
msgstr "Mroczna cyberpunkowa przygodówka z widokiem z góry od Creative Reality (1994) — odkrywaj Dreamweb, aby uratować rzeczywistość."

#: lib/retro_hex_chat/chat/help_topics/features.ex:2898
#, elixir-autogen, elixir-format
msgid "Daylight sprint — no weather changes, no fuel drain, just speed. "
msgstr ""
"Dzienny sprint: bez zmian pogody, bez zużycia paliwa, tylko prędkość. "

#: lib/retro_hex_chat/chat/help_topics/features.ex:2428
