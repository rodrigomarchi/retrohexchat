#, elixir-autogen, elixir-format
msgid "1 long epic round — igloo needs 20 pieces, all enemies from the start, "
msgstr ""
"1 długa runda epicka - igloo potrzebuje 20 sztuk, wszyscy wrogowie od "
"początku,"

#: lib/retro_hex_chat/chat/help_topics/features.ex:2391
#, elixir-autogen, elixir-format
msgid "10 sections of increasing difficulty. Destroy bridges to advance. "
msgstr "10 części rosnących trudności. Zniszczyć mosty."

#: lib/retro_hex_chat/chat/help_topics/features.ex:2209
#, elixir-autogen, elixir-format
msgid "2-minute rounds, best of 3. Modes: Classic (open field) and Maze Battle. "
msgstr ""
"2-minutowe rundy, najlepsze z 3. Tryby: Classic (pole otwarte) i Maze "
"Battle."

#: lib/retro_hex_chat/chat/help_topics/features.ex:2326
#, elixir-autogen, elixir-format
msgid "3 shared lives, 50 neon blocks (5 rows), ball speeds up. Arrow keys or A/D to move."
msgstr ""
"3 wspólne życia, 50 bloków neonowych (5 rzędów), piłka przyspiesza. Strzałki"
" lub A/D przenieść."

#: lib/retro_hex_chat/chat/help_topics/features.ex:2722
#, elixir-autogen, elixir-format
msgid "3-minute race in permanent darkness with fog bursts. "
msgstr "3-minutowy wyścig w stałej ciemności z podmuchami mgły. "

#: lib/retro_hex_chat/chat/help_topics/features.ex:3529
#, elixir-autogen, elixir-format
msgid "32 deathmatch-focused arena maps for the DOOM engine. BSD license."
msgstr "32 mapy arenowe dla silnika DOOM. Licencja BSD."

#: lib/retro_hex_chat/chat/help_topics/features.ex:2439
#, elixir-autogen, elixir-format
msgid "5 sections of intense River Raid action — river starts narrow, "
msgstr "5 odcinków intensywnej akcji River Raid - rzeka zaczyna wąskie,"

#: lib/retro_hex_chat/chat/help_topics/features.ex:2666
#, elixir-autogen, elixir-format
msgid "5 waves of pure chaos from the start. "
msgstr "5 fal czystego chaosu od początku."

#: lib/retro_hex_chat/chat/help_topics/features.ex:2749
#, elixir-autogen, elixir-format
msgid "90 seconds to score maximum overtakes. "
msgstr "90 sekund, aby zdobyć maksymalną przewagę."

#: lib/retro_hex_chat/chat/help_topics/features.ex:3616
#, elixir-autogen, elixir-format
msgid "A Viking-themed DOOM total conversion with hand-drawn pixel art — axes, bows, and runic magic. Cacoward 2018 winner."
msgstr ""
"A Viking- themed DOOM całkowita konwersja z ręcznie rysowanych pikseli "
"sztuki - osie, łuki, i runic magii. Zwycięzca Cacoward 2018."

#: lib/retro_hex_chat/chat/help_topics/features.ex:3500
#, elixir-autogen, elixir-format
msgid "A complete free replacement for DOOM II — 32 levels with the Super Shotgun. Compatible with community PWAD mods."
msgstr ""
"Kompletny darmowy zamiennik dla DOOM II - 32 poziomów z Super Shotgun. "
"Kompatybilny z modami PWAD."

#: lib/retro_hex_chat/chat/help_topics/features.ex:3671
#, elixir-autogen, elixir-format
msgid "A complete free replacement for Quake — original levels, art, and music under BSD license."
msgstr ""
"Kompletna darmowa wymiana Quake - oryginalne poziomy, sztuka i muzyka na "
"licencji BSD."

#: lib/retro_hex_chat/chat/help_topics/features.ex:3470
#, elixir-autogen, elixir-format
msgid "A complete free replacement for Ultimate DOOM — 4 episodes, 36 levels with original art and music."
msgstr ""
"Kompletna darmowa wymiana Ultimate DOOM - 4 odcinki, 36 poziomów z "
"oryginalną sztuką i muzyką."

#: lib/retro_hex_chat/chat/help_topics/features.ex:3585
#, elixir-autogen, elixir-format
msgid "A cyberpunk DOOM total conversion with new weapons, enemies, and levels. Standalone v1.2 IWAD."
msgstr ""
"Cyberpunk DOOM całkowita konwersja z nowych broni, wrogów i poziomów. "
"Standalone v1.2 IWAD."

#: lib/retro_hex_chat/chat/help_topics/user_interface.ex:358
#, elixir-autogen, elixir-format
msgid "Access user actions and channel operations through right-click context menus."
msgstr ""
"Dostęp do akcji użytkowników i operacji kanału poprzez menu kontekstowe "
"prawym przyciskiem myszy."

#: lib/retro_hex_chat/chat/help_topics/commands.ex:155
#, elixir-autogen, elixir-format
msgid "Add a user to your ignore list to hide their messages and actions."
msgstr ""
"Dodaj użytkownika do listy ignorowanych, aby ukryć swoje wiadomości i "
"działania."

#: lib/retro_hex_chat/chat/help_topics/features.ex:618
#, elixir-autogen, elixir-format
msgid "Add custom items to right-click context menus for quick access to commands."
msgstr ""
"Dodaj niestandardowe elementy do menu kontekstowego prawym przyciskiem "
"myszy, aby uzyskać szybki dostęp do poleceń."

#: lib/retro_hex_chat/chat/help_topics/commands.ex:304
#, elixir-autogen, elixir-format
msgid "Add or remove users from your notify list to track when they connect or disconnect."
msgstr ""
"Dodaj lub usuń użytkowników z listy powiadomień, aby śledzić, kiedy się "
"połączą lub odłączą."

