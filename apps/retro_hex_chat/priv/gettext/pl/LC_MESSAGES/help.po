msgstr "Odpowiadaj na wybrane wiadomości z zacytowanym kontekstem w rozmowach wątkowych."

#: lib/retro_hex_chat/chat/help_topics/channel_modes.ex:327
#, elixir-autogen, elixir-format
msgid "Request an invitation to join an invite-only channel."
msgstr "Poproś o zaproszenie, aby dołączyć do kanału tylko na zaproszenie."

#: lib/retro_hex_chat/chat/help_topics/channel_modes.ex:165
#, elixir-autogen, elixir-format
msgid "Require a password to join the channel."
msgstr "Wymagaj hasła, aby dołączyć do kanału."

#: lib/retro_hex_chat/chat/help_topics/channel_modes.ex:130
#, elixir-autogen, elixir-format
msgid "Restrict speaking to voiced users and above in a moderated channel."
msgstr "Ogranicz możliwość pisania do użytkowników z voice i wyżej na kanale moderowanym."

#: lib/retro_hex_chat/chat/help_topics/channel_modes.ex:279
#, elixir-autogen, elixir-format
msgid "Restrict the channel to users who have identified with NickServ."
msgstr "Ogranicz kanał do użytkowników zidentyfikowanych w NickServ."

#: lib/retro_hex_chat/chat/help_topics/features.ex:803
#, elixir-autogen, elixir-format
msgid "Review and confirm multi-line pastes before sending to prevent accidental flooding."
msgstr "Przeglądaj i potwierdzaj wklejanie wielu linii przed wysłaniem, aby zapobiec przypadkowemu floodowi."

#: lib/retro_hex_chat/chat/help_topics/features.ex:4206
#, elixir-autogen, elixir-format
