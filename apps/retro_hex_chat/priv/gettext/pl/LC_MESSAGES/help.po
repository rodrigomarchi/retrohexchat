#: lib/retro_hex_chat/chat/help_topics/features.ex:875
#, elixir-autogen, elixir-format
msgid "Answer a message with one click, without writing anything and without notifying anyone."
msgstr ""
"Odpowiedz na wiadomość jednym kliknięciem, bez pisania i bez powiadamiania "
"kogokolwiek."

#: lib/retro_hex_chat/chat/help_topics/features.ex:864
