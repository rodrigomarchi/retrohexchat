  "main": "index.js",
  "scripts": {
    "test": "vitest run",
    "test:changed": "vitest run --changed",
    "test:related": "vitest related",
    "test:watch": "vitest",
    "lint": "eslint --cache --cache-location node_modules/.cache/eslint js/ test/ scripts/",
    "lint:changed": "eslint --cache --cache-location node_modules/.cache/eslint",
    "lint:hooks": "node scripts/enforce_hooks_contract.cjs",
    "lint:fix": "eslint --cache --cache-location node_modules/.cache/eslint --fix js/ test/ scripts/",
    "format": "prettier --write js/ test/ scripts/ eslint.config.mjs vitest.config.js",
    "format:check": "prettier --check js/ test/ scripts/ eslint.config.mjs vitest.config.js",
    "bundle:budget": "node scripts/bundle_budget.cjs"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.0.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.3.0",
    "jsdom": "^28.0.0",
    "prettier": "^3.8.1",
    "tailwindcss": "^3.4.19",
    "vitest": "^4.0.18"
  },
  "dependencies": {
    "@grafana/faro-web-sdk": "^1.19.0",
    "@grafana/faro-web-tracing": "^1.19.0",
    "@opentelemetry/instrumentation-document-load": "0.47.0",
    "highlight.js": "^11.11.1"
  }
