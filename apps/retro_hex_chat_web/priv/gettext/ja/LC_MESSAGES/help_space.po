#: lib/retro_hex_chat_web/controllers/help_content/feature_virtual_spaces.html.heex:85
#: lib/retro_hex_chat_web/controllers/help_content/feature_virtual_spaces.html.heex:97
#, elixir-autogen, elixir-format
msgctxt "space room"
