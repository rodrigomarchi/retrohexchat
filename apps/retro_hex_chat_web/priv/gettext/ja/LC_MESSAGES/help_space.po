msgstr "最初からあるもの"

#: lib/retro_hex_chat_web/controllers/help_content/feature_virtual_spaces.html.heex:70
#: lib/retro_hex_chat_web/controllers/help_content/feature_virtual_spaces.html.heex:81
#, elixir-autogen, elixir-format
msgctxt "space room"
