#: lib/retro_hex_chat_web/controllers/help_content/feature_gravity_well.html.heex:23
#: lib/retro_hex_chat_web/controllers/help_content/feature_star_duel.html.heex:23
#, elixir-autogen, elixir-format
msgid "— Rotate right"
msgstr "— 右に回転"

#: lib/retro_hex_chat_web/controllers/help_content/feature_pixel_tanks.html.heex:19
#, elixir-autogen, elixir-format
msgid "— Rotate tank"
msgstr "— タンクを回転させる"

#: lib/retro_hex_chat_web/controllers/help_content/feature_debris_field.html.heex:89
#, elixir-autogen, elixir-format
msgid "— Spend the first few seconds memorizing asteroid positions. The layout stays fixed for the entire match."
msgstr "— 最初の数秒で小惑星の位置を覚えておきましょう。配置は試合の間ずっと変わりません。"

#: lib/retro_hex_chat_web/controllers/help_content/feature_debris_field.html.heex:11
#: lib/retro_hex_chat_web/controllers/help_content/feature_gravity_well.html.heex:11
#: lib/retro_hex_chat_web/controllers/help_content/feature_star_duel.html.heex:11
#, elixir-autogen, elixir-format
msgid "— Thrust forward"
msgstr "— 前方へ推進する"

#: lib/retro_hex_chat_web/controllers/help_content/feature_gravity_well.html.heex:70
#, elixir-autogen, elixir-format
msgid "— Use lateral thrust to orbit the star instead of burning away from it. Orbiting conserves fuel and keeps you moving unpredictably."
msgstr "— 星から離れるように噴射するのではなく、横方向のスラストを使って星の周りを周回しましょう。周回すれば燃料を節約でき、動きも予測されにくくなります。"

#: lib/retro_hex_chat_web/controllers/help_content/feature_debris_field.html.heex:82
#, elixir-autogen, elixir-format
msgid "— Use missiles to force your opponent toward asteroid clusters where they have less room to maneuver."
msgstr "— ミサイルを使用して、敵を操縦する部屋が少ない小惑星のクラスターに向かって強制します。"

