msgstr "只有对话中的人才能进入。"

#: lib/retro_hex_chat_web/controllers/help_content/feature_space_game_room.html.heex:35
#: lib/retro_hex_chat_web/controllers/help_content/feature_space_office.html.heex:42
#, elixir-autogen, elixir-format
msgid "This furniture cannot be moved, turned or removed."
msgstr "这件家具不能移动、旋转或移除。"

#: lib/retro_hex_chat_web/controllers/help_content/feature_space_office.html.heex:37
#, elixir-autogen, elixir-format
msgid "Press E next to a glass door to open it, and again to close it."
msgstr "在玻璃门旁按 E 打开,再按一次关闭。"

