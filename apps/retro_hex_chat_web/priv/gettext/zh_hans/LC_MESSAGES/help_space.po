msgid "This furniture is part of the office."
msgstr "这件家具是办公室的一部分。"

#: lib/retro_hex_chat_web/controllers/help_content/feature_space_game_room.html.heex:15
#: lib/retro_hex_chat_web/controllers/help_content/feature_space_office.html.heex:15
