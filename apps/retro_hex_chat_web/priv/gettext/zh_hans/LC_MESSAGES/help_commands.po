msgstr "— 在这个频道中发出的某条消息的编号。"

#: lib/retro_hex_chat_web/controllers/help_content/cmd_unpin.html.heex:16
#, elixir-autogen, elixir-format
msgid "— The number of a message this channel is keeping."
msgstr "— 这个频道中已置顶的某条消息的编号。"

