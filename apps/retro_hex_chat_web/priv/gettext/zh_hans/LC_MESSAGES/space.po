#: lib/retro_hex_chat_web/live/app/space_live.ex:65
#, elixir-autogen, elixir-format
msgid "SPACE ENDED — %{status}"
msgstr "空间已结束 — %{status}"

#: lib/retro_hex_chat_web/live/app/space_live.ex:70
#, elixir-autogen, elixir-format
msgid "SPACE FULL"
msgstr "空间已满"

#: lib/retro_hex_chat_web/live/app/space_live.ex:59
#, elixir-autogen, elixir-format
msgid "SPACE NOT FOUND"
msgstr "未找到空间"

#: lib/retro_hex_chat_web/live/app/space_live.ex:71
#, elixir-autogen, elixir-format
msgid "This virtual space is at capacity. Try again later."
msgstr "这个虚拟空间已满员。请稍后再试。"

#: lib/retro_hex_chat_web/live/app/space_live.ex:67
#, elixir-autogen, elixir-format
msgid "This virtual space is no longer active."
msgstr "这个虚拟空间已不再活跃。"

#: lib/retro_hex_chat_web/live/app/space_live.ex:60
#, elixir-autogen, elixir-format
msgid "This virtual space link is invalid or was removed."
msgstr "这个虚拟空间链接无效或已被删除。"

#: lib/retro_hex_chat_web/live/app/space_live.ex:196 lib/retro_hex_chat_web/live/app/space_live.ex:201 lib/retro_hex_chat_web/live/app/space_live.ex:221
#, elixir-autogen, elixir-format
msgid "Virtual space"
msgstr "虚拟空间"

#: lib/retro_hex_chat_web/live/app/space_live.ex:75
#, elixir-autogen, elixir-format
msgid "You do not have access to this virtual space. You must be registered, identified and allowed into its channel."
msgstr "你无权访问这个虚拟空间。你必须已注册、已验证身份并获准进入其频道。"

#: lib/retro_hex_chat_web/live/app/space_live.ex:149
#, elixir-autogen, elixir-format
msgid "Arrows/WASD to move · E to use · F to sit · Esc to close"
msgstr "方向键/WASD 移动 · E 使用 · F 坐下 · Esc 关闭"

#: lib/retro_hex_chat_web/live/app/space_live.ex:111
#, elixir-autogen, elixir-format
msgid "Say something… (Enter to send)"
msgstr "说点什么…（回车发送）"

#: lib/retro_hex_chat_web/live/app/space_live.ex:98
#, elixir-autogen, elixir-format
msgid "here"
msgstr "人"

#: lib/retro_hex_chat_web/live/app/space_live.ex:118
#, elixir-autogen, elixir-format
msgid "Host controls"
msgstr "主持人控制"

#: lib/retro_hex_chat_web/live/app/space_live.ex:127
#, elixir-autogen, elixir-format
msgid "REMOVED FROM SPACE"
msgstr "已被移出空间"

#: lib/retro_hex_chat_web/live/app/space_live.ex:140
#, elixir-autogen, elixir-format
