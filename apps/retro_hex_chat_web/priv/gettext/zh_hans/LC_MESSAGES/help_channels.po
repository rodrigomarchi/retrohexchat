msgid "\"Alice\" and \"alice\" are the same nickname."
msgstr "“Alice”和“alice”是同一个昵称。"

#: lib/retro_hex_chat_web/controllers/help_content/nickserv.html.heex:37
#, elixir-autogen, elixir-format
msgid "Capital letters do not matter"
msgstr "大写字母不重要"

#: lib/retro_hex_chat_web/controllers/help_content/nickserv.html.heex:40
#, elixir-autogen, elixir-format
msgid "It is shown as you type it."
msgstr "输入时会直接显示出来。"

