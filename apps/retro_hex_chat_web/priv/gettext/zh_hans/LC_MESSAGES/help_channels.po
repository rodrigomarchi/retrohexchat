msgstr "添加和移除执行的动作与 /cs <level> add <nick> 和 /cs <level> del <nick> 相同。"

#: lib/retro_hex_chat_web/controllers/help_content/chanserv_access.html.heex:42
#, elixir-autogen, elixir-format
msgid "All write actions require NickServ identification."
msgstr "所有写入操作都需要通过 NickServ 识别身份。"

#: lib/retro_hex_chat_web/controllers/help_content/channel_welcome_message.html.heex:69
#, elixir-autogen, elixir-format
msgid "Applies only to the current channel"
msgstr "仅适用于当前频道"

#: lib/retro_hex_chat_web/controllers/help_content/chanserv_register.html.heex:46
#, elixir-autogen, elixir-format
msgid "ChanServ Access Lists"
msgstr "ChanServ 访问列表"

#: lib/retro_hex_chat_web/controllers/help_content/chanserv_access.html.heex:2
#, elixir-autogen, elixir-format
msgid "ChanServ access lists grant persistent channel privileges to identified users when they join a registered channel."
msgstr "ChanServ 访问列表会在已识别身份的用户加入已注册频道时,授予其持久的频道权限。"

#: lib/retro_hex_chat_web/controllers/help_content/chanserv_register.html.heex:2
#, elixir-autogen, elixir-format
msgid "ChanServ registration assigns a founder to the current channel and keeps channel ownership, access lists, bans, and settings available after the channel empties or restarts."
msgstr "ChanServ 注册会为当前频道指定创建者,并在频道清空或重启后继续保留频道所有权、访问列表、封禁和设置。"

#: lib/retro_hex_chat_web/controllers/help_content/channel_transfer_ownership.html.heex:16
#: lib/retro_hex_chat_web/controllers/help_content/channel_transfer_ownership.html.heex:74
