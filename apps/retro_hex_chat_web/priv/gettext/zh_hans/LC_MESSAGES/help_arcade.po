#: lib/retro_hex_chat_web/controllers/help_content/feature_arcade_scummvm_bass.html.heex:59
#: lib/retro_hex_chat_web/controllers/help_content/feature_arcade_scummvm_drascula.html.heex:47
#: lib/retro_hex_chat_web/controllers/help_content/feature_arcade_scummvm_dreamweb.html.heex:47
#: lib/retro_hex_chat_web/controllers/help_content/feature_arcade_scummvm_fotaq.html.heex:47
