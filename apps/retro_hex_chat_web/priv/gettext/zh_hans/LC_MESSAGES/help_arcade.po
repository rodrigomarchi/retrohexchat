#: lib/retro_hex_chat_web/controllers/help_content/feature_arcade.html.heex:80
#, elixir-autogen, elixir-format
msgid "(%{engine} compiled to WebAssembly). All support keyboard, mouse, and gamepad input."
msgstr "（%{engine} 已编译为 WebAssembly）。全部支持键盘、鼠标和手柄输入。"

#: lib/retro_hex_chat_web/controllers/help_content/feature_arcade.html.heex:64
#, elixir-autogen, elixir-format
