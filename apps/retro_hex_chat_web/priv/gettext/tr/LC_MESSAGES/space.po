#: lib/retro_hex_chat_web/live/app/space_live.ex:196 lib/retro_hex_chat_web/live/app/space_live.ex:201 lib/retro_hex_chat_web/live/app/space_live.ex:221
#, elixir-autogen, elixir-format
msgid "Virtual space"
msgstr "Sanal alan"

#: lib/retro_hex_chat_web/live/app/space_live.ex:75
#, elixir-autogen, elixir-format
msgid "You do not have access to this virtual space. You must be registered, identified and allowed into its channel."
msgstr "Bu sanal alana erişiminiz yok. Kayıtlı, kimliği doğrulanmış ve kanalına kabul edilmiş olmalısınız."

#: lib/retro_hex_chat_web/live/app/space_live.ex:149
#, elixir-autogen, elixir-format
msgid "Arrows/WASD to move · E to use · F to sit · Esc to close"
msgstr "Ok tuşları/WASD hareket · E kullan · F otur · Esc kapat"

#: lib/retro_hex_chat_web/live/app/space_live.ex:111
#, elixir-autogen, elixir-format
msgid "Say something… (Enter to send)"
msgstr "Bir şeyler söyle… (Göndermek için Enter)"

#: lib/retro_hex_chat_web/live/app/space_live.ex:98
#, elixir-autogen, elixir-format
msgid "here"
msgstr "burada"

#: lib/retro_hex_chat_web/live/app/space_live.ex:118
#, elixir-autogen, elixir-format
msgid "Host controls"
msgstr "Sunucu kontrolleri"

#: lib/retro_hex_chat_web/live/app/space_live.ex:127
#, elixir-autogen, elixir-format
msgid "REMOVED FROM SPACE"
msgstr "ALANDAN ÇIKARILDIN"

#: lib/retro_hex_chat_web/live/app/space_live.ex:140
#, elixir-autogen, elixir-format
