#: lib/retro_hex_chat_web/controllers/help_content/feature_audio_call.html.heex:29
#, elixir-autogen, elixir-format
msgid "The timer shows the call duration. The quality indicator shows 4 levels: Excellent, Good, Fair, Poor."
msgstr "Zamanlayıcı çağrı süresini gösterir. Kaliteli gösterge 4 seviyeleri gösteriyor: Mükemmel, İyi, Adil, Zavallı."

