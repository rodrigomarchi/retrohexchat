msgid ""
"/mode +o Alice — Give operator to Alice /mode -o Alice — Remove operator "
"from Alice"
msgstr ""
"/mode +o Alice — Give operator to Alice /mode -o Alice — Remove operator "
"from Alice"

#: lib/retro_hex_chat_web/controllers/help_content/mode_p.html.heex:8
#, elixir-autogen, elixir-format
msgid "/mode +p — Make channel private /mode -p — Remove private mode"
msgstr "/mode +p — Make channel private /mode -p — Remove private mode"

#: lib/retro_hex_chat_web/controllers/help_content/mode_q.html.heex:12
#, elixir-autogen, elixir-format
msgid ""
"/mode +q Alice — Make Alice an owner /mode -q Alice — Remove owner from "
"Alice"
msgstr ""
"/mode +q Alice — Make Alice an owner /mode -q Alice — Remove owner from "
"Alice"

#: lib/retro_hex_chat_web/controllers/help_content/mode_s.html.heex:8
#, elixir-autogen, elixir-format
msgid "/mode +s — Make channel secret /mode -s — Remove secret mode"
msgstr "/mode +s — Make channel secret /mode -s — Remove secret mode"

#: lib/retro_hex_chat_web/controllers/help_content/mode_t.html.heex:8
#, elixir-autogen, elixir-format
msgid "/mode +t — Enable topic lock /mode -t — Disable topic lock"
msgstr "/mode +t — Enable topic lock /mode -t — Disable topic lock"

#: lib/retro_hex_chat_web/controllers/help_content/mode_v.html.heex:8
#, elixir-autogen, elixir-format
msgid ""
"/mode +v Alice — Give voice to Alice /mode -v Alice — Remove voice from "
"Alice"
msgstr ""
"/mode +v Alice — Give voice to Alice /mode -v Alice — Remove voice from "
"Alice"

