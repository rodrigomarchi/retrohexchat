msgstr ""
"/mode +k secretpass — Set channel key /mode -k — Remove channel key /join "
"#channel secretpass — Join with key"

#: lib/retro_hex_chat_web/controllers/help_content/mode_l.html.heex:5
#, elixir-autogen, elixir-format
msgid "/mode +l 25 — Set limit to 25 users /mode -l — Remove user limit"
msgstr "/mode +l 25 — Set limit to 25 users /mode -l — Remove user limit"

