msgstr "/mode +i — Enable invite only /mode -i — Disable invite only"

#: lib/retro_hex_chat_web/controllers/help_content/mode_j.html.heex:8
#, elixir-autogen, elixir-format
msgid ""
"/mode +j 5:10 — Allow 5 joins per 10 seconds /mode +j 3:60 — Allow 3 joins "
"per minute /mode -j — Remove join throttle"
msgstr ""
"/mode +j 5:10 — Allow 5 joins per 10 seconds /mode +j 3:60 — Allow 3 joins "
"per minute /mode -j — Remove join throttle"

#: lib/retro_hex_chat_web/controllers/help_content/mode_k.html.heex:5
