msgstr "重設所有格式"

#: lib/retro_hex_chat_web/controllers/help_content/formatting_overview.html.heex:88
#, elixir-autogen, elixir-format
msgid "Reverse. Swaps the text and background colors."
msgstr "反轉。交換文字色彩與背景色彩。"

#: lib/retro_hex_chat_web/controllers/help_content/ui_pinned_window.html.heex:30
#, elixir-autogen, elixir-format
