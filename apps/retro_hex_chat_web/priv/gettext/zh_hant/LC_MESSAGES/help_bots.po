msgstr "在設定之前，沒有機器人會歡迎訪客。"

#: lib/retro_hex_chat_web/controllers/help_content/bot_greeter.html.heex:74
#, elixir-autogen, elixir-format
msgid "Set %{setting} to welcome them."
msgstr "設定 %{setting} 來歡迎他們。"

#: lib/retro_hex_chat_web/controllers/help_content/bot_greeter.html.heex:37
#, elixir-autogen, elixir-format
msgid "The visitor alone"
msgstr "只有訪客"

#: lib/retro_hex_chat_web/controllers/help_content/bot_greeter.html.heex:67
#, elixir-autogen, elixir-format
msgid "A visitor without an account can read a channel."
msgstr "沒有帳號的訪客可以閱讀頻道。"

