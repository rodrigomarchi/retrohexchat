msgid "Hex Paint open on a pixel-art heart over a starry night"
msgstr "Hex Paint terbuka pada pixel-art jantung selama malam berbintang"

#: lib/retro_hex_chat_web/site/pages/paint.ex:39
#, elixir-autogen, elixir-format
msgid "Hex Paint: draw pixel art online and share it in a chat"
msgstr "Hex Paint: gambar pixel secara online dan bagikan dalam percakapan"

#: lib/retro_hex_chat_web/site/pages/accessory.ex:69
