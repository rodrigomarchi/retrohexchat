#: lib/retro_hex_chat_web/controllers/help_content/cmd_announce.html.heex:2
#, elixir-autogen, elixir-format
msgid "Send an urgent broadcast message to every connected user. This is for critical server-wide announcements that everyone must see."
msgstr "Sendet eine dringende Rundnachricht an alle verbundenen Benutzer. Dies ist für kritische serverweite Ankündigungen gedacht, die jeder sehen muss."

#: lib/retro_hex_chat_web/controllers/help_content/cmd_admin.html.heex:2
#, elixir-autogen, elixir-format
msgid "Server administration commands for managing users, channels, services, and settings. Only available to server administrators and operators."
msgstr "Server-Verwaltungsbefehle zur Verwaltung von Benutzern, Kanälen, Diensten und Einstellungen. Nur für Server-Administratoren und -Operatoren verfügbar."

#: lib/retro_hex_chat_web/controllers/help_content/cmd_clearmotd.html.heex:39
#: lib/retro_hex_chat_web/controllers/help_content/cmd_setmotd.html.heex:40
#, elixir-autogen, elixir-format
