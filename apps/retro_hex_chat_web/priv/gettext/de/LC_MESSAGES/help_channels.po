#: lib/retro_hex_chat_web/controllers/help_content/mode_o.html.heex:2
#, elixir-autogen, elixir-format
msgid "Grants channel operator status to a user (prefix @). Operators can change channel modes, kick/ban users, and set the topic. They cannot kick owners."
msgstr "Gibt einem Benutzer den Kanal-Operator-Status (Präfix @). Operatoren können Kanalmodi ändern, Benutzer kicken/bannen und das Thema festlegen. Sie können Eigentümer nicht kicken."

#: lib/retro_hex_chat_web/controllers/help_content/mode_q.html.heex:2
#, elixir-autogen, elixir-format
msgid "Grants channel owner status to a user (prefix ~). Owners have the highest privilege level and can set any mode, including +o and +q. The first user to join an unregistered channel is automatically made owner."
msgstr "Gibt einem Benutzer den Kanal-Eigentümerstatus (Präfix ~). Eigentümer haben die höchste Berechtigungsstufe und können jeden Modus setzen, einschließlich +o und +q. Der erste Benutzer, der einem nicht registrierten Kanal beitritt, wird automatisch Eigentümer."

#: lib/retro_hex_chat_web/controllers/help_content/mode_h.html.heex:2
#, elixir-autogen, elixir-format
msgid "Grants half-operator status to a user (prefix %). Half-operators can kick users of lower rank and grant/revoke voice (+v), but cannot set channel modes or ban users."
msgstr ""
"Ermöglicht den halben Status eines Benutzers (Prefix %). Half-Operatoren "
"können Benutzer von niedrigeren Rang und Grant/revoke Stimme (+v) treten, "
"können aber keine Channel-Modi setzen oder Benutzer verbieten."

#: lib/retro_hex_chat_web/controllers/help_content/mode_v.html.heex:2
#, elixir-autogen, elixir-format
msgid "Grants voice to a user (prefix +), allowing them to speak in moderated (+m) channels. Half-operators and above can grant voice."
msgstr "Gibt einem Benutzer Voice (Präfix +), sodass er in moderierten (+m) Kanälen sprechen darf. Halb-Operatoren und höher können Voice vergeben."

#: lib/retro_hex_chat_web/controllers/help_content/mode_o.html.heex:82
#: lib/retro_hex_chat_web/controllers/help_content/mode_q.html.heex:60
#: lib/retro_hex_chat_web/controllers/help_content/mode_v.html.heex:61
#, elixir-autogen, elixir-format
msgid "Half-Operator (+h)"
msgstr "Halb-Operator (+h)"

#: lib/retro_hex_chat_web/controllers/help_content/mode_q.html.heex:7
#, elixir-autogen, elixir-format
msgid "Hierarchy"
msgstr "Hierarchie"

#: lib/retro_hex_chat_web/controllers/help_content/mode_i.html.heex:83
#, elixir-autogen, elixir-format
