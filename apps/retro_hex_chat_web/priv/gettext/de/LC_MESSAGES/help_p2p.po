#: lib/retro_hex_chat_web/controllers/help_content/feature_universal_lobby.html.heex:8
#, elixir-autogen, elixir-format
msgid "One Connection, Every Feature"
msgstr "Eine Verbindung, alle Funktionen"

#: lib/retro_hex_chat_web/controllers/help_content/feature_p2p_starting_room.html.heex:37
#: lib/retro_hex_chat_web/controllers/help_content/feature_p2p_tab.html.heex:27
#: lib/retro_hex_chat_web/controllers/help_content/feature_universal_lobby.html.heex:37
#, elixir-autogen, elixir-format
msgid "P2P Sessions in Chat"
msgstr "P2P-Sitzungen im Chat"

#: lib/retro_hex_chat_web/controllers/help_content/feature_channel_conference.html.heex:50
#, elixir-autogen, elixir-format
msgid "Participant tiles and the participant panel highlight the current speaker when browser audio levels are available. Quality badges summarize recent browser connection stats such as RTT, packet loss, bitrate, frame rate and freezes for each remote participant."
msgstr "Teilnehmerkacheln und das Teilnehmerpanel heben den aktuellen Sprecher hervor, wenn Audiopegel des Browsers verfügbar sind. Qualitäts-Badges fassen aktuelle Verbindungsstatistiken des Browsers wie RTT, Paketverlust, Bitrate, Framerate und Standbilder für jeden entfernten Teilnehmer zusammen."

#: lib/retro_hex_chat_web/controllers/help_content/feature_video_call.html.heex:2
#, elixir-autogen, elixir-format
msgid "Peer-to-peer video calls with rich 1:1 layouts, self-view control, screen sharing, PiP, reactions and live quality indicators."
msgstr "Peer-to-Peer-Videoanrufe mit vielseitigen 1:1-Layouts, Eigenansicht-Steuerung, Bildschirmfreigabe, PiP, Reaktionen und Live-Qualitätsanzeigen."

#: lib/retro_hex_chat_web/controllers/help_content/feature_channel_conference.html.heex:16
#, elixir-autogen, elixir-format
msgid "Pre-join and Devices"
msgstr "Vor dem Beitritt und Geräte"

#: lib/retro_hex_chat_web/controllers/help_content/feature_video_call.html.heex:49
#, elixir-autogen, elixir-format
msgid "Reaction buttons send short visual effects over the active P2P session. They appear on the call tiles and do not create private-message rows."
msgstr "Reaktionsschaltflächen senden kurze visuelle Effekte über die aktive P2P-Sitzung. Sie erscheinen auf den Anrufkacheln und erzeugen keine Zeilen in privaten Nachrichten."

#: lib/retro_hex_chat_web/controllers/help_content/feature_channel_conference.html.heex:56
#: lib/retro_hex_chat_web/controllers/help_content/feature_video_call.html.heex:47
#, elixir-autogen, elixir-format
msgid "Reactions"
msgstr "Reaktionen"

#: lib/retro_hex_chat_web/controllers/help_content/feature_channel_conference.html.heex:72
#, elixir-autogen, elixir-format
msgid "Recovery"
msgstr "Wiederherstellung"

#: lib/retro_hex_chat_web/controllers/help_content/feature_video_call.html.heex:34
#, elixir-autogen, elixir-format
msgid "Screen Share"
msgstr "Bildschirm teilen"

#: lib/retro_hex_chat_web/controllers/help_content/feature_channel_conference.html.heex:40
#, elixir-autogen, elixir-format
msgid "Screen Sharing"
msgstr "Bildschirmfreigabe"

#: lib/retro_hex_chat_web/controllers/help_content/feature_channel_conference.html.heex:97
#: lib/retro_hex_chat_web/controllers/help_content/feature_conference_share.html.heex:17
