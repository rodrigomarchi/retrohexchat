#: lib/retro_hex_chat_web/controllers/help_content/feature_file_transfer.html.heex:24
#, elixir-autogen, elixir-format
msgid "The progress bar shows: percentage, speed, and estimated time. You can cancel at any time."
msgstr "Thanh tiến trình cho thấy: tỷ lệ phần trăm, tốc độ và thời gian ước tính. Anh có thể hủy bất cứ lúc nào."

#: lib/retro_hex_chat_web/controllers/help_content/feature_video_call.html.heex:16
