msgstr "Igloo & Winning"

#: lib/retro_hex_chat_web/controllers/help_content/feature_hex_frost_blizzard.html.heex:32
#, elixir-autogen, elixir-format
msgid "Igloo requires 20 pieces (vs 15 in Arctic Race)"
msgstr "Igloo требует 20 штук (против 15 в Арктической гонке)"

#: lib/retro_hex_chat_web/controllers/help_content/feature_hex_skiing_escape.html.heex:19
