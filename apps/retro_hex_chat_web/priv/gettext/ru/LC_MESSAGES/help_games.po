#: lib/retro_hex_chat_web/controllers/help_content/feature_hex_frost.html.heex:29
#, elixir-autogen, elixir-format
msgid "Block Mechanics"
msgstr "Блок механики"

#: lib/retro_hex_chat_web/controllers/help_content/feature_hex_frost_peaceful.html.heex:32
#, elixir-autogen, elixir-format
msgid "Block stealing disabled — opponent's blocks are untouchable"
msgstr "Кража блоков отключена — блоки противника неприкасаемы"

#: lib/retro_hex_chat_web/controllers/help_content/feature_hex_frost_blizzard.html.heex:35
#, elixir-autogen, elixir-format
msgid "Block stealing is active — expect chaos!"
msgstr "Кража блоков активна — ждите хаоса!"

#: lib/retro_hex_chat_web/controllers/help_content/feature_hex_frost_blizzard.html.heex:54
#, elixir-autogen, elixir-format
msgid "Block stealing is everything"
msgstr "Кража блоков - это все"

#: lib/retro_hex_chat_web/controllers/help_content/feature_hex_hockey.html.heex:88
#, elixir-autogen, elixir-format
msgid "Blocked shots ricochet back into play"
msgstr "Заблокированные рикошеты возвращаются в игру"

#: lib/retro_hex_chat_web/controllers/help_content/feature_hex_enduro.html.heex:41
#, elixir-autogen, elixir-format
msgid "Both players race on a 3-lane pseudo-3D road with AI traffic"
msgstr "Оба игрока соревнуются на 3-полосной псевдо-3D дороге с ИИ-трафиком"

#: lib/retro_hex_chat_web/controllers/help_content/feature_hex_invaders_coop.html.heex:29
#, elixir-autogen, elixir-format
msgid "Both players share the same screen and fight the same alien waves"
msgstr ""
"Оба игрока имеют одинаковый экран и сражаются с одинаковыми инопланетными "
"волнами."

#: lib/retro_hex_chat_web/controllers/help_content/feature_hex_boxing.html.heex:56
#, elixir-autogen, elixir-format
msgid "Boxers cannot pass through each other — body collision pushes the mover back"
msgstr ""
"Боксеры не могут пройти друг через друга — столкновение тела толкает "
"движитель назад"

#: lib/retro_hex_chat_web/controllers/help_content/feature_hex_enduro_night.html.heex:61
#, elixir-autogen, elixir-format
msgid "Brake before fog"
msgstr "Тормоз перед туманом"

#: lib/retro_hex_chat_web/controllers/help_content/feature_hex_frost.html.heex:117
#, elixir-autogen, elixir-format
msgid "Build fast to maximize your temperature bonus!"
msgstr "Стройте быстро, чтобы максимизировать температурный бонус!"

#: lib/retro_hex_chat_web/controllers/help_content/feature_hex_frost.html.heex:55
#, elixir-autogen, elixir-format
msgid "Build your igloo by collecting 15 pieces from ice blocks"
msgstr "Постройте иглу, собирая 15 штук из ледяных блоков."

#: lib/retro_hex_chat_web/controllers/help_content/feature_hex_outlaw.html.heex:40
#, elixir-autogen, elixir-format
msgid "Bullets are visible — dodge by moving vertically"
msgstr "Пули видны — уклоняться, двигаясь вертикально"

#: lib/retro_hex_chat_web/controllers/help_content/feature_hex_outlaw_ricochet.html.heex:34
#, elixir-autogen, elixir-format
msgid "Bullets fire at a fixed 30-degree angle, aimed up or down based on your last vertical input"
msgstr ""
"Пули стреляют под постоянным углом 30 градусов, направленным вверх или вниз "
"на основе вашего последнего вертикального входа."

#: lib/retro_hex_chat_web/controllers/help_content/feature_hex_outlaw.html.heex:33
#, elixir-autogen, elixir-format
msgid "Bullets travel horizontally and are blocked by obstacles"
msgstr "Пули перемещаются горизонтально и блокируются препятствиями."

#: lib/retro_hex_chat_web/controllers/help_content/feature_hex_outlaw_stagecoach.html.heex:37
#, elixir-autogen, elixir-format
msgid "Bullets travel straight horizontally (no ricochet)"
msgstr "Пули движутся прямо горизонтально (без рикошета)"

#: lib/retro_hex_chat_web/controllers/help_content/feature_hex_hockey.html.heex:32
#, elixir-autogen, elixir-format
msgid "Capture"
msgstr "захват"

#: lib/retro_hex_chat_web/controllers/help_content/feature_hex_warlords.html.heex:52
#, elixir-autogen, elixir-format
msgid "Castles fully rebuild between rounds after a king hit"
msgstr "Замки полностью перестраиваются между раундами после удара короля"

#: lib/retro_hex_chat_web/controllers/help_content/feature_hex_warlords.html.heex:60
#, elixir-autogen, elixir-format
msgid "Catch mechanic: hold Space when the fireball touches your shield to grab it, release to aim and launch"
msgstr ""
"Механика ловли: удерживайте пространство, когда огненный шар касается вашего"
" щита, чтобы захватить его, отпустите, чтобы прицелиться и запустить"

#: lib/retro_hex_chat_web/controllers/help_content/feature_hex_invaders_blitz.html.heex:43
#, elixir-autogen, elixir-format
msgid "Chain kills relentlessly"
msgstr "Цепь безжалостно убивает"

#: lib/retro_hex_chat_web/controllers/help_content/feature_hex_frost.html.heex:86
#, elixir-autogen, elixir-format
msgid "Clams"
msgstr "хлопья"

#: lib/retro_hex_chat_web/controllers/help_content/feature_hex_invaders_coop.html.heex:2
#, elixir-autogen, elixir-format
msgid "Classic co-op Space Invaders — two cannons fighting the same alien waves on a shared screen. No alien drop mechanic. Survive together or fall together. Communication and coordination are everything — divide the screen and cover each other's blind spots."
msgstr ""
"Классический кооператив Space Invaders — две пушки, сражающиеся с "
"одинаковыми инопланетными волнами на общем экране. Никакого инопланетного "
"механика. Выжить вместе или упасть вместе. Связь и координация — это все: "
"разделите экран и покройте слепые пятна друг друга."

#: lib/retro_hex_chat_web/controllers/help_content/feature_hex_skiing.html.heex:46
#, elixir-autogen, elixir-format
msgid "Clean Run"
msgstr "Чистый бег"

#: lib/retro_hex_chat_web/controllers/help_content/feature_hex_invaders_blitz.html.heex:50
#, elixir-autogen, elixir-format
msgid "Clear bottom rows first"
msgstr "Сначала чистые нижние ряды"

#: lib/retro_hex_chat_web/controllers/help_content/feature_hex_invaders.html.heex:68
#, elixir-autogen, elixir-format
msgid "Co-op"
msgstr "кооператив"

#: lib/retro_hex_chat_web/controllers/help_content/feature_hex_enduro.html.heex:46
#, elixir-autogen, elixir-format
msgid "Collect fuel stations for 3 points and to refuel your tank"
msgstr "Соберите заправочные станции на 3 балла и заправьте свой бак"

#: lib/retro_hex_chat_web/controllers/help_content/feature_hex_skiing.html.heex:23
#, elixir-autogen, elixir-format
msgid "Collect speed boosts (lightning bolt) for a 3-second burst"
msgstr ""
"Соберите ускорения скорости (молниеносный болт) для 3-секундного всплеска"

#: lib/retro_hex_chat_web/controllers/help_content/feature_hex_skiing_escape.html.heex:28
#, elixir-autogen, elixir-format
msgid "Collisions are devastating — even a brief stun can mean engulfment"
msgstr ""
"Столкновения разрушительны — даже короткое оглушение может означать "
"поглощение."

#: lib/retro_hex_chat_web/controllers/help_content/feature_hex_skiing_clean.html.heex:23
#, elixir-autogen, elixir-format
msgid "Collisions still stun, costing precious seconds"
msgstr "Столкновения все еще оглушительны, стоят драгоценных секунд"

#: lib/retro_hex_chat_web/controllers/help_content/feature_hex_skiing.html.heex:27
#, elixir-autogen, elixir-format
msgid "Collisions stun you for 1-1.5 seconds (timer keeps running)"
msgstr ""
"Столкновения оглушают вас в течение 1-1,5 секунд (таймер продолжает "
"работать)"

#: lib/retro_hex_chat_web/controllers/help_content/feature_hex_enduro.html.heex:51
#, elixir-autogen, elixir-format
msgid "Collisions with AI cars slow you down temporarily"
msgstr "Столкновения с автомобилями AI временно замедляют вас"

#: lib/retro_hex_chat_web/controllers/help_content/feature_hex_invaders.html.heex:41
#, elixir-autogen, elixir-format
msgid "Combo system: 3 rapid kills = 1 extra drop, 5 = 2 + armored, 8+ = 3 + armored"
msgstr ""
"Комбосистема: 3 быстрых убийства = 1 дополнительная капля, 5 = 2 + "
"бронированная, 8 + = 3 + бронированная"

#: lib/retro_hex_chat_web/controllers/help_content/feature_hex_invaders_blitz.html.heex:32
#, elixir-autogen, elixir-format
msgid "Combo thresholds lowered: 2 kills = extra drop, 4 = 2 + armored, 6+ = 3 + armored"
msgstr ""
"Комбо пороги снижены: 2 убийства = дополнительная капля, 4 = 2 + "
"бронированный, 6 + = 3 + бронированный"

#: lib/retro_hex_chat_web/controllers/help_content/feature_hex_outlaw_nml.html.heex:63
#, elixir-autogen, elixir-format
msgid "Commit to aggression or patience"
msgstr "Приверженность агрессии или терпению"

#: lib/retro_hex_chat_web/controllers/help_content/feature_hex_outlaw_nml.html.heex:42
#, elixir-autogen, elixir-format
