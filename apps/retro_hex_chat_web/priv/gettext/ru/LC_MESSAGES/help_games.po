#, elixir-autogen, elixir-format
msgid "Horizontal speed is slightly slower than vertical to prevent easy dodging"
msgstr ""
"Горизонтальная скорость немного медленнее, чем вертикальная, чтобы "
"предотвратить легкое уклонение"

#: lib/retro_hex_chat_web/controllers/help_content/feature_hex_outlaw_ricochet.html.heex:64
