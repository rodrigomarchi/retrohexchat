msgstr "Ночная гонка"

#: lib/retro_hex_chat_web/controllers/help_content/feature_hex_outlaw.html.heex:67
#: lib/retro_hex_chat_web/controllers/help_content/feature_hex_outlaw.html.heex:88
#: lib/retro_hex_chat_web/controllers/help_content/feature_hex_outlaw_ricochet.html.heex:87
#: lib/retro_hex_chat_web/controllers/help_content/feature_hex_outlaw_stagecoach.html.heex:81
#, elixir-autogen, elixir-format
