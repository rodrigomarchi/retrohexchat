#, elixir-autogen, elixir-format
msgid "(limit) — Channel cannot exceed the user limit."
msgstr "(лимит) — число пользователей на канале не может превышать лимит."

#: lib/retro_hex_chat_web/controllers/help_content/channel_permissions.html.heex:188
#, elixir-autogen, elixir-format
msgid "(moderated) — Only Voiced, Half-Operator, Operator, and Owner can speak."
msgstr "(модерируемый) — писать могут только пользователи с голосом, полуоператоры, операторы и владелец."

#: lib/retro_hex_chat_web/controllers/help_content/channel_permissions.html.heex:194
#, elixir-autogen, elixir-format
msgid "(no external) — Only channel members can send messages."
msgstr "(без внешних сообщений) — отправлять сообщения могут только участники канала."

#: lib/retro_hex_chat_web/controllers/help_content/chanserv.html.heex:114
#, elixir-autogen, elixir-format
msgid "(no joins or messages)"
msgstr "(без входов и сообщений)"

#: lib/retro_hex_chat_web/controllers/help_content/channel_permissions.html.heex:172
#, elixir-autogen, elixir-format
msgid "(registered-only) — Only registered and identified users can join."
msgstr "(только для зарегистрированных) — присоединиться могут только зарегистрированные и идентифицированные пользователи."

#: lib/retro_hex_chat_web/controllers/help_content/channel_permissions.html.heex:178
#, elixir-autogen, elixir-format
msgid "(throttle) — Limits the rate of joins (anti-flood)."
msgstr "(ограничение частоты) — ограничивает частоту входов на канал (защита от флуда)."

