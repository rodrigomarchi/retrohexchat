#: lib/retro_hex_chat_web/components/ui/dialogs/admin_channels_dialog.ex:122
#, elixir-autogen, elixir-format
msgid "A channel exists only while somebody is in it, unless it is registered. Registration gives it an owner and keeps its settings after the last person has gone. If you delete a channel here, the people inside it lose the room."
msgstr ""
"A channel exists only while somebody is in it, unless it is registered. "
"Registration gives it an owner and keeps its settings after the last person "
"has gone. If you delete a channel here, the people inside it lose the room."

#: lib/retro_hex_chat_web/components/ui/dialogs/admin_audit_log_dialog.ex:80
#, elixir-autogen, elixir-format
msgid "Every privileged action writes a line here. A rejected action is written here too. The Danger Zone leaves this log alone, so the record survives the data."
msgstr ""
"Every privileged action writes a line here. A rejected action is written "
"here too. The Danger Zone leaves this log alone, so the record survives the "
"data."

#: lib/retro_hex_chat_web/components/ui/dialogs/admin_broadcast_dialog.ex:68
#, elixir-autogen, elixir-format
msgid "People who set user mode +w receive a wallops. Everybody on the server receives an announce. You cannot take back either one after you send it."
msgstr ""
"People who set user mode +w receive a wallops. Everybody on the server "
"receives an announce. You cannot take back either one after you send it."

#: lib/retro_hex_chat_web/components/ui/dialogs/admin_server_settings_dialog.ex:83
#, elixir-autogen, elixir-format
msgid "The name and the description are read on the page where people arrive, before anybody creates a nickname. Closing registration stops new nicknames. The ones that already exist still work."
msgstr ""
"The name and the description are read on the page where people arrive, "
"before anybody creates a nickname. Closing registration stops new nicknames."
" The ones that already exist still work."

#: lib/retro_hex_chat_web/components/ui/dialogs/admin_danger_zone_dialog.ex:83
#, elixir-autogen, elixir-format
msgid "This action deletes the conversations, the channels and the nicknames. Four lists are kept: the administrators, the bans, the settings and the audit log. Everything else is deleted permanently."
msgstr ""
"This action deletes the conversations, the channels and the nicknames. Four "
"lists are kept: the administrators, the bans, the settings and the audit "
"log. Everything else is deleted permanently."

#: lib/retro_hex_chat_web/components/ui/dialogs/admin_users_dialog.ex:119
#, elixir-autogen, elixir-format
msgid "This is every account on the server, not the people in one channel. A green lamp means that person is connected right now. Anything you do here reaches the whole server. A ban blocks the nickname on the whole server. If you remove a registration, the name becomes free for somebody else."
msgstr ""
"This is every account on the server, not the people in one channel. A green "
"lamp means that person is connected right now. Anything you do here reaches "
"the whole server. A ban blocks the nickname on the whole server. If you "
"remove a registration, the name becomes free for somebody else."

#: lib/retro_hex_chat_web/components/ui/dialogs/highlight_dialog.ex:128
#, elixir-autogen, elixir-format
msgid "A miniature of a channel where the matching line wears its highlight"
msgstr "A miniature of a channel where the matching line wears its highlight"

#: lib/retro_hex_chat_web/components/ui/dialogs/ignore_list_dialog.ex:282
#, elixir-autogen, elixir-format
msgid "Anyway, where were we?"
msgstr "Anyway, where were we?"

#: lib/retro_hex_chat_web/components/ui/dialogs/highlight_dialog.ex:410
#: lib/retro_hex_chat_web/components/ui/dialogs/highlight_dialog.ex:418
#, elixir-autogen, elixir-format
msgid "I will be there."
msgstr "I will be there."

#: lib/retro_hex_chat_web/components/ui/dialogs/highlight_dialog.ex:408
#: lib/retro_hex_chat_web/components/ui/dialogs/highlight_dialog.ex:416
#, elixir-autogen, elixir-format
msgid "So are we still on for tonight?"
msgstr "So are we still on for tonight?"

#: lib/retro_hex_chat_web/components/ui/dialogs/ignore_list_dialog.ex:280
#, elixir-autogen, elixir-format
msgid "That is the third time today."
msgstr "That is the third time today."

#: lib/retro_hex_chat_web/components/ui/dialogs/ignore_list_dialog.ex:61
#, elixir-autogen, elixir-format
msgid "A miniature of a channel with a grey bar where the ignored line was"
msgstr "A miniature of a channel with a grey bar where the ignored line was"

#: lib/retro_hex_chat_web/components/ui/dialogs/admin_channels_dialog.ex:114
#, elixir-autogen, elixir-format
msgid "A miniature of the channel list, each name beside the number of people in it"
msgstr ""
"A miniature of the channel list, each name beside the number of people in it"

#: lib/retro_hex_chat_web/components/ui/dialogs/nick_change_dialog.ex:65
#, elixir-autogen, elixir-format
msgid "Everybody in your channels sees the change immediately. Your old name becomes available to other people, unless you registered it."
msgstr ""
"Everybody in your channels sees the change immediately. Your old name "
"becomes available to other people, unless you registered it."

#: lib/retro_hex_chat_web/components/ui/dialogs/knock_request_dialog.ex:62
#, elixir-autogen, elixir-format
msgid "The people who run this channel see your request and decide. Nothing happens until one of them accepts it."
msgstr ""
"The people who run this channel see your request and decide. Nothing happens"
" until one of them accepts it."

#: lib/retro_hex_chat_web/components/ui/dialogs/invite_dialog.ex:64
#, elixir-autogen, elixir-format
msgid "If you accept, the channel opens as a tab. Everybody in it is told that you joined. If you decline, nobody is told."
msgstr ""
"If you accept, the channel opens as a tab. Everybody in it is told that you "
"joined. If you decline, nobody is told."

#: lib/retro_hex_chat_web/components/ui/dialogs/mute_duration_dialog.ex:40
#, elixir-autogen, elixir-format
msgid "This person stays in the channel and can still read it. They cannot write until the time is over, or until you let them write again."
msgstr ""
"This person stays in the channel and can still read it. They cannot write "
"until the time is over, or until you let them write again."

#: lib/retro_hex_chat_web/components/ui/dialogs/invite_channel_picker_dialog.ex:48
#, elixir-autogen, elixir-format
msgid "This person can join the channel with the invitation, even when the channel is closed. It reaches them wherever they are, and they choose whether to use it."
msgstr ""
"This person can join the channel with the invitation, even when the channel "
"is closed. It reaches them wherever they are, and they choose whether to use"
" it."

#: lib/retro_hex_chat_web/components/ui/dialogs/admin_danger_zone_dialog.ex:93
#, elixir-autogen, elixir-format
msgid "This cannot be undone."
msgstr "This cannot be undone."
