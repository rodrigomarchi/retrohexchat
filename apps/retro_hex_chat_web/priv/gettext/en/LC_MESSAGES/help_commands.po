msgstr "Half-operators cannot use this command"

#: lib/retro_hex_chat_web/controllers/help_content/cmd_admin_log.html.heex:83
#, elixir-autogen, elixir-format
msgid "If the %{option} value is not a number, the default of 20 is used"
msgstr "If the %{option} value is not a number, the default of 20 is used"

#: lib/retro_hex_chat_web/controllers/help_content/cmd_admin_turn.html.heex:40
#, elixir-autogen, elixir-format
msgid "If the TURN server is not configured on this server, both subcommands reply only that it is not configured."
msgstr "If the TURN server is not configured on this server, both subcommands reply only that it is not configured."

#: lib/retro_hex_chat_web/controllers/help_content/cmd_deop.html.heex:32
#, elixir-autogen, elixir-format
msgid "If the channel is registered and the user is on its ChanServ access list, they get the status from that list back the next time they join."
msgstr "If the channel is registered and the user is on its ChanServ access list, they get the status from that list back the next time they join."

#: lib/retro_hex_chat_web/controllers/help_content/cmd_unignore.html.heex:45
#, elixir-autogen, elixir-format
msgid "If the nickname is not on your ignore list, you get an error that says so"
msgstr "If the nickname is not on your ignore list, you get an error that says so"

#: lib/retro_hex_chat_web/controllers/help_content/cmd_unignore.html.heex:34
#, elixir-autogen, elixir-format
msgid "If you are identified with NickServ, your ignore list is saved with your account, so the change lasts into your next session. If the user was ignored automatically for flooding, they are not ignored automatically again for one minute."
msgstr "If you are identified with NickServ, your ignore list is saved with your account, so the change lasts into your next session. If the user was ignored automatically for flooding, they are not ignored automatically again for one minute."

#: lib/retro_hex_chat_web/controllers/help_content/cmd_quit.html.heex:32
#, elixir-autogen, elixir-format
msgid "In each channel you were in, the other members see a line that you left, with your message in brackets after it. If you give no message, a default reason is used. The app does not reconnect you or rejoin your channels by itself after you quit."
msgstr "In each channel you were in, the other members see a line that you left, with your message in brackets after it. If you give no message, a default reason is used. The app does not reconnect you or rejoin your channels by itself after you quit."

#: lib/retro_hex_chat_web/controllers/help_content/cmd_motd.html.heex:42
#, elixir-autogen, elixir-format
msgid "Only server administrators can change the MOTD, with %{set} or %{clear}."
msgstr "Only server administrators can change the MOTD, with %{set} or %{clear}."

#: lib/retro_hex_chat_web/controllers/help_content/cmd_clear.html.heex:24
#, elixir-autogen, elixir-format
msgid "Only the conversation on screen is cleared. Your other channels and private conversations keep their messages. If you switch to another window and come back, the cleared messages stay hidden. New messages appear as they arrive."
msgstr "Only the conversation on screen is cleared. Your other channels and private conversations keep their messages. If you switch to another window and come back, the cleared messages stay hidden. New messages appear as they arrive."

#: lib/retro_hex_chat_web/controllers/help_content/cmd_deop.html.heex:44
#: lib/retro_hex_chat_web/controllers/help_content/cmd_devoice.html.heex:43
#: lib/retro_hex_chat_web/controllers/help_content/cmd_op.html.heex:44
#: lib/retro_hex_chat_web/controllers/help_content/cmd_unban.html.heex:47
#: lib/retro_hex_chat_web/controllers/help_content/cmd_unignore.html.heex:52
#: lib/retro_hex_chat_web/controllers/help_content/cmd_unmute.html.heex:49
#: lib/retro_hex_chat_web/controllers/help_content/cmd_voice.html.heex:47
#, elixir-autogen, elixir-format
msgid "Only the first nickname is used. Extra words are ignored."
msgstr "Only the first nickname is used. Extra words are ignored."

#: lib/retro_hex_chat_web/controllers/help_content/cmd_help.html.heex:54
#, elixir-autogen, elixir-format
msgid "Only the first word after the command is used"
msgstr "Only the first word after the command is used"

#: lib/retro_hex_chat_web/controllers/help_content/cmd_clearmotd.html.heex:46
#: lib/retro_hex_chat_web/controllers/help_content/cmd_setmotd.html.heex:48
#, elixir-autogen, elixir-format
msgid "Other users get a permission denied error"
msgstr "Other users get a permission denied error"

#: lib/retro_hex_chat_web/controllers/help_content/cmd_admin_debug.html.heex:77
#, elixir-autogen, elixir-format
msgid "Other users get an error and nothing is shown"
msgstr "Other users get an error and nothing is shown"

#: lib/retro_hex_chat_web/controllers/help_content/cmd_quit.html.heex:58
#, elixir-autogen, elixir-format
msgid "Quit Messages"
msgstr "Quit Messages"

#: lib/retro_hex_chat_web/controllers/help_content/cmd_deop.html.heex:10
#, elixir-autogen, elixir-format
msgid "Remove operator status when someone no longer helps run the channel. You can also use it on your own nickname to step down."
msgstr "Remove operator status when someone no longer helps run the channel. You can also use it on your own nickname to step down."

#: lib/retro_hex_chat_web/controllers/help_content/cmd_setmotd.html.heex:20
#, elixir-autogen, elixir-format
msgid "Sets or replaces the server MOTD. After setting it, all newly connecting users will see this message in the Status tab when they join. Any previous MOTD is replaced."
msgstr "Sets or replaces the server MOTD. After setting it, all newly connecting users will see this message in the Status tab when they join. Any previous MOTD is replaced."

#: lib/retro_hex_chat_web/controllers/help_content/cmd_op.html.heex:32
#, elixir-autogen, elixir-format
msgid "Status given with this command lasts until the user leaves the channel. When they join again in a registered channel, their status comes from the ChanServ access list. In an unregistered channel, they come back as a regular member."
msgstr "Status given with this command lasts until the user leaves the channel. When they join again in a registered channel, their status comes from the ChanServ access list. In an unregistered channel, they come back as a regular member."

#: lib/retro_hex_chat_web/controllers/help_content/cmd_admin_debug.html.heex:58
#, elixir-autogen, elixir-format
msgid "The %{sub} subcommand lists each running channel by name, with its process id. An unregistered channel stops its process when its last member leaves, so it drops off this list."
msgstr "The %{sub} subcommand lists each running channel by name, with its process id. An unregistered channel stops its process when its last member leaves, so it drops off this list."

#: lib/retro_hex_chat_web/controllers/help_content/cmd_admin_turn.html.heex:53
#, elixir-autogen, elixir-format
msgid "The %{sub} subcommand prints one line per allocation: the client address and port, and the relay port it holds. The list contains client IP addresses, so treat it as private data."
msgstr "The %{sub} subcommand prints one line per allocation: the client address and port, and the relay port it holds. The list contains client IP addresses, so treat it as private data."

#: lib/retro_hex_chat_web/controllers/help_content/cmd_admin_debug.html.heex:65
#, elixir-autogen, elixir-format
msgid "The %{sub} subcommand shows sizes in megabytes for total memory, processes, ETS, atoms, binaries and loaded code."
msgstr "The %{sub} subcommand shows sizes in megabytes for total memory, processes, ETS, atoms, binaries and loaded code."

#: lib/retro_hex_chat_web/controllers/help_content/cmd_admin_turn.html.heex:46
#, elixir-autogen, elixir-format
msgid "The %{sub} subcommand shows the status, the relay IP, the listen port, the number of listeners, the active allocations, how many relay ports are in use out of the total, and the relay port range."
msgstr "The %{sub} subcommand shows the status, the relay IP, the listen port, the number of listeners, the active allocations, how many relay ports are in use out of the total, and the relay port range."

#: lib/retro_hex_chat_web/controllers/help_content/cmd_clear.html.heex:30
#, elixir-autogen, elixir-format
msgid "The Clear Window item in the Edit menu runs the same command."
msgstr "The Clear Window item in the Edit menu runs the same command."

#: lib/retro_hex_chat_web/controllers/help_content/cmd_clearmotd.html.heex:25
#, elixir-autogen, elixir-format
msgid "The MOTD is deleted from the server settings. Connected users get a short note in their Status window that the MOTD changed. After that, %{command} answers that no MOTD has been set."
msgstr "The MOTD is deleted from the server settings. Connected users get a short note in their Status window that the MOTD changed. After that, %{command} answers that no MOTD has been set."

#: lib/retro_hex_chat_web/controllers/help_content/cmd_admin_turn.html.heex:10
#, elixir-autogen, elixir-format
msgid "The TURN server relays call traffic for users whose networks block a direct peer-to-peer connection. Use this command when calls fail for some users, to see whether the relay is running and how busy it is."
msgstr "The TURN server relays call traffic for users whose networks block a direct peer-to-peer connection. Use this command when calls fail for some users, to see whether the relay is running and how busy it is."

#: lib/retro_hex_chat_web/controllers/help_content/cmd_slow.html.heex:42
#, elixir-autogen, elixir-format
msgid "The channel allows at most 5 joins in any period of the length you give. For example, %{example} allows 5 joins every 10 seconds. It sets mode %{mode}. Anyone who tries to join after the limit is reached is refused and asked to try again shortly. Bots are not limited."
msgstr "The channel allows at most 5 joins in any period of the length you give. For example, %{example} allows 5 joins every 10 seconds. It sets mode %{mode}. Anyone who tries to join after the limit is reached is refused and asked to try again shortly. Bots are not limited."

#: lib/retro_hex_chat_web/controllers/help_content/cmd_op.html.heex:26
#, elixir-autogen, elixir-format
msgid "The command acts on the channel you are viewing. A member holds one channel role at a time, so the new operator role replaces any voice or half-operator status the user had. Everyone in the channel sees a mode change line, and the user moves to the Operator group in the nick list."
msgstr "The command acts on the channel you are viewing. A member holds one channel role at a time, so the new operator role replaces any voice or half-operator status the user had. Everyone in the channel sees a mode change line, and the user moves to the Operator group in the nick list."

#: lib/retro_hex_chat_web/controllers/help_content/cmd_unban.html.heex:23
#, elixir-autogen, elixir-format
msgid "The command acts on the channel you are viewing. Everyone in the channel sees a line that names the user and who lifted the ban. Unbanning does not invite the user or bring them back. They must join again themselves."
msgstr "The command acts on the channel you are viewing. Everyone in the channel sees a line that names the user and who lifted the ban. Unbanning does not invite the user or bring them back. They must join again themselves."

#: lib/retro_hex_chat_web/controllers/help_content/cmd_voice.html.heex:29
#, elixir-autogen, elixir-format
msgid "The command acts on the channel you are viewing. Everyone in the channel sees a mode change line, and the user moves to the Voiced group in the nick list."
msgstr "The command acts on the channel you are viewing. Everyone in the channel sees a mode change line, and the user moves to the Voiced group in the nick list."

#: lib/retro_hex_chat_web/controllers/help_content/cmd_unmute.html.heex:26
#, elixir-autogen, elixir-format
msgid "The command acts on the channel you are viewing. It lifts every active mute for that nickname in this channel. A timed mute also stops its countdown. You see a confirmation line, and the user can talk in the channel again at once."
msgstr "The command acts on the channel you are viewing. It lifts every active mute for that nickname in this channel. A timed mute also stops its countdown. You see a confirmation line, and the user can talk in the channel again at once."

#: lib/retro_hex_chat_web/controllers/help_content/cmd_devoice.html.heex:26
#, elixir-autogen, elixir-format
msgid "The command acts on the channel you are viewing. The user becomes a regular member and moves to the Users group in the nick list. Everyone in the channel sees a mode change line. In a channel that is not moderated, the user can still talk as before."
msgstr "The command acts on the channel you are viewing. The user becomes a regular member and moves to the Users group in the nick list. Everyone in the channel sees a mode change line. In a channel that is not moderated, the user can still talk as before."

#: lib/retro_hex_chat_web/controllers/help_content/cmd_deop.html.heex:26
#, elixir-autogen, elixir-format
msgid "The command acts on the channel you are viewing. The user becomes a regular member. Any voice they had before is not restored, so in a moderated (+m) channel they cannot speak until they get voice again. Everyone in the channel sees a mode change line, and the user moves to the Users group in the nick list."
msgstr "The command acts on the channel you are viewing. The user becomes a regular member. Any voice they had before is not restored, so in a moderated (+m) channel they cannot speak until they get voice again. Everyone in the channel sees a mode change line, and the user moves to the Users group in the nick list."

#: lib/retro_hex_chat_web/controllers/help_content/cmd_clearwelcome.html.heex:25
#, elixir-autogen, elixir-format
msgid "The command acts on the channel you are viewing. The welcome is also deleted from storage, so it does not come back later. You see a confirmation line that names the channel. Other members get no message about the change."
msgstr "The command acts on the channel you are viewing. The welcome is also deleted from storage, so it does not come back later. You see a confirmation line that names the channel. Other members get no message about the change."

#: lib/retro_hex_chat_web/controllers/help_content/cmd_notice_routing.html.heex:38
#, elixir-autogen, elixir-format
msgid "The command replies with one line in the current window that names the policy. Notices from users you ignore for notices, or for all message types, are not shown at all."
msgstr "The command replies with one line in the current window that names the policy. Notices from users you ignore for notices, or for all message types, are not shown at all."

#: lib/retro_hex_chat_web/controllers/help_content/cmd_clear.html.heex:47
#: lib/retro_hex_chat_web/controllers/help_content/cmd_clearmotd.html.heex:48
#: lib/retro_hex_chat_web/controllers/help_content/cmd_clearwelcome.html.heex:46
#: lib/retro_hex_chat_web/controllers/help_content/cmd_motd.html.heex:36
#: lib/retro_hex_chat_web/controllers/help_content/cmd_notice_routing.html.heex:55
#, elixir-autogen, elixir-format
msgid "The command takes no parameters. Anything you type after it is ignored."
msgstr "The command takes no parameters. Anything you type after it is ignored."

#: lib/retro_hex_chat_web/controllers/help_content/cmd_unpin.html.heex:54
#, elixir-autogen, elixir-format
msgid "The id must be a whole number greater than zero. Anything else gets an error that it is not a message id."
msgstr "The id must be a whole number greater than zero. Anything else gets an error that it is not a message id."

#: lib/retro_hex_chat_web/controllers/help_content/cmd_admin_log.html.heex:90
#, elixir-autogen, elixir-format
msgid "The log is read-only. This command does not change or delete entries."
msgstr "The log is read-only. This command does not change or delete entries."

#: lib/retro_hex_chat_web/controllers/help_content/cmd_quit.html.heex:44
#, elixir-autogen, elixir-format
msgid "The message is shown in your channels, not in private conversations"
msgstr "The message is shown in your channels, not in private conversations"

#: lib/retro_hex_chat_web/controllers/help_content/cmd_clear.html.heex:41
#, elixir-autogen, elixir-format
msgid "The messages are not deleted from the server. Other people still see them."
msgstr "The messages are not deleted from the server. Other people still see them."

#: lib/retro_hex_chat_web/controllers/help_content/cmd_unban.html.heex:29
#, elixir-autogen, elixir-format
msgid "The name must match the ban entry exactly, with the same upper and lower case. A ban set as a wildcard mask, such as %{mask}, is removed only by typing that same mask. If no ban entry matches, the command still reports the unban and nothing changes."
msgstr "The name must match the ban entry exactly, with the same upper and lower case. A ban set as a wildcard mask, such as %{mask}, is removed only by typing that same mask. If no ban entry matches, the command still reports the unban and nothing changes."

#: lib/retro_hex_chat_web/controllers/help_content/cmd_unignore.html.heex:28
#, elixir-autogen, elixir-format
msgid "The nickname is matched without regard to upper or lower case. Every ignore entry for that nickname is removed, and a timed ignore stops its countdown. You see a confirmation line."
msgstr "The nickname is matched without regard to upper or lower case. Every ignore entry for that nickname is removed, and a timed ignore stops its countdown. You see a confirmation line."

#: lib/retro_hex_chat_web/controllers/help_content/cmd_slow.html.heex:60
#, elixir-autogen, elixir-format
msgid "The number of seconds is required. Without it, you see the usage line."
msgstr "The number of seconds is required. Without it, you see the usage line."

#: lib/retro_hex_chat_web/controllers/help_content/cmd_notice_routing.html.heex:49
#, elixir-autogen, elixir-format
msgid "The routing policy is fixed. There is no option to send notices to another window."
msgstr "The routing policy is fixed. There is no option to send notices to another window."

#: lib/retro_hex_chat_web/controllers/help_content/cmd_unmute.html.heex:32
#, elixir-autogen, elixir-format
msgid "The user does not need to be in the channel, so you can lift a mute after they leave. If the user was not muted, the command still reports success and nothing changes."
msgstr "The user does not need to be in the channel, so you can lift a mute after they leave. If the user was not muted, the command still reports success and nothing changes."

#: lib/retro_hex_chat_web/controllers/help_content/cmd_slow.html.heex:66
#, elixir-autogen, elixir-format
msgid "The value must be a whole number. Text or a negative number gets the usage line."
msgstr "The value must be a whole number. Text or a negative number gets the usage line."

#: lib/retro_hex_chat_web/controllers/help_content/cmd_help.html.heex:52
#, elixir-autogen, elixir-format
msgid "Type the command name in lowercase and without the slash"
msgstr "Type the command name in lowercase and without the slash"

#: lib/retro_hex_chat_web/controllers/help_content/cmd_clearwelcome.html.heex:31
#, elixir-autogen, elixir-format
msgid "Typing %{command} with no text does the same thing as this command."
msgstr "Typing %{command} with no text does the same thing as this command."

#: lib/retro_hex_chat_web/controllers/help_content/cmd_devoice.html.heex:10
#, elixir-autogen, elixir-format
msgid "Use it in a moderated (+m) channel to stop someone from speaking without removing them from the channel. They can still read the conversation."
msgstr "Use it in a moderated (+m) channel to stop someone from speaking without removing them from the channel. They can still read the conversation."

#: lib/retro_hex_chat_web/controllers/help_content/cmd_admin_debug.html.heex:10
#, elixir-autogen, elixir-format
msgid "Use it to check a running server: how many channels are live right now, which ones they are, and how the server uses memory. Nothing is changed, so it is safe to run at any time."
msgstr "Use it to check a running server: how many channels are live right now, which ones they are, and how the server uses memory. Nothing is changed, so it is safe to run at any time."

#: lib/retro_hex_chat_web/controllers/help_content/cmd_admin_log.html.heex:10
#, elixir-autogen, elixir-format
msgid "Use it to find out who changed what on the server. For example, check who banned a user, dropped a nickname or changed a server setting."
msgstr "Use it to find out who changed what on the server. For example, check who banned a user, dropped a nickname or changed a server setting."

#: lib/retro_hex_chat_web/controllers/help_content/cmd_setmotd.html.heex:9
#, elixir-autogen, elixir-format
msgid "Use it to greet people, point them to the server rules, or share news that everyone should see when they connect."
msgstr "Use it to greet people, point them to the server rules, or share news that everyone should see when they connect."

#: lib/retro_hex_chat_web/controllers/help_content/cmd_motd.html.heex:9
#, elixir-autogen, elixir-format
msgid "Use it to read the server news or rules again after they scrolled out of the Status window. It is also the way to read a new MOTD that was posted while you were connected."
msgstr "Use it to read the server news or rules again after they scrolled out of the Status window. It is also the way to read a new MOTD that was posted while you were connected."

#: lib/retro_hex_chat_web/controllers/help_content/cmd_unban.html.heex:6
#, elixir-autogen, elixir-format
msgid "Use it when a ban has served its purpose, or when someone was banned by mistake."
msgstr "Use it when a ban has served its purpose, or when someone was banned by mistake."

#: lib/retro_hex_chat_web/controllers/help_content/cmd_clear.html.heex:9
#, elixir-autogen, elixir-format
msgid "Use it when a busy window is hard to read, or when you want an empty screen before a new discussion starts."
msgstr "Use it when a busy window is hard to read, or when you want an empty screen before a new discussion starts."

#: lib/retro_hex_chat_web/controllers/help_content/cmd_unmute.html.heex:10
#, elixir-autogen, elixir-format
msgid "Use it when a mute has done its job early, or when you muted the wrong person. A timed mute ends by itself. A permanent mute stays until someone removes it with this command."
msgstr "Use it when a mute has done its job early, or when you muted the wrong person. A timed mute ends by itself. A permanent mute stays until someone removes it with this command."

#: lib/retro_hex_chat_web/controllers/help_content/cmd_notice_routing.html.heex:9
#, elixir-autogen, elixir-format
msgid "Use it when a notice shows up in a window you did not expect and you want to know why. The command only reports the policy. It does not change anything."
msgstr "Use it when a notice shows up in a window you did not expect and you want to know why. The command only reports the policy. It does not change anything."

#: lib/retro_hex_chat_web/controllers/help_content/cmd_unpin.html.heex:6
#, elixir-autogen, elixir-format
msgid "Use it when a pinned message is out of date, such as old rules or an event that is over. It also frees a place, because a channel keeps at most 50 pinned messages."
msgstr "Use it when a pinned message is out of date, such as old rules or an event that is over. It also frees a place, because a channel keeps at most 50 pinned messages."

#: lib/retro_hex_chat_web/controllers/help_content/cmd_slow.html.heex:11
#, elixir-autogen, elixir-format
msgid "Use it when many users or bots join in a short time, for example during a join flood. It slows down new arrivals without closing the channel."
msgstr "Use it when many users or bots join in a short time, for example during a join flood. It slows down new arrivals without closing the channel."

#: lib/retro_hex_chat_web/controllers/help_content/cmd_clearmotd.html.heex:9
#, elixir-autogen, elixir-format
msgid "Use it when the MOTD is out of date and you have nothing to put in its place. If you only want to change the text, use %{command} instead. It replaces the old message in one step."
msgstr "Use it when the MOTD is out of date and you have nothing to put in its place. If you only want to change the text, use %{command} instead. It replaces the old message in one step."

#: lib/retro_hex_chat_web/controllers/help_content/cmd_clearwelcome.html.heex:9
#, elixir-autogen, elixir-format
msgid "Use it when the welcome text is out of date and you have nothing to put in its place yet. If you only want new text, use %{command} with the new message. It replaces the old one in one step."
msgstr "Use it when the welcome text is out of date and you have nothing to put in its place yet. If you only want new text, use %{command} with the new message. It replaces the old one in one step."

#: lib/retro_hex_chat_web/controllers/help_content/cmd_quit.html.heex:9
#, elixir-autogen, elixir-format
msgid "Use it when you are done chatting and want to leave every channel at once. To leave only one channel and stay connected, use %{command} instead."
msgstr "Use it when you are done chatting and want to leave every channel at once. To leave only one channel and stay connected, use %{command} instead."

#: lib/retro_hex_chat_web/controllers/help_content/cmd_help.html.heex:9
#, elixir-autogen, elixir-format
msgid "Use it when you forget how a command works, or when you want to see which commands exist without leaving the chat."
msgstr "Use it when you forget how a command works, or when you want to see which commands exist without leaving the chat."

#: lib/retro_hex_chat_web/controllers/help_content/cmd_unignore.html.heex:9
#, elixir-autogen, elixir-format
msgid "Use it when you want to hear from someone again, for example after an argument is over or when you ignored the wrong person."
msgstr "Use it when you want to hear from someone again, for example after an argument is over or when you ignored the wrong person."

#: lib/retro_hex_chat_web/controllers/help_content/cmd_voice.html.heex:13
#, elixir-autogen, elixir-format
msgid "Use voice in a moderated (+m) channel to choose who may speak. Regular members cannot send messages there, and voiced members can. Outside a moderated channel, voice gives no extra rights."
msgstr "Use voice in a moderated (+m) channel to choose who may speak. Regular members cannot send messages there, and voiced members can. Outside a moderated channel, voice gives no extra rights."

#: lib/retro_hex_chat_web/controllers/help_content/cmd_setmotd.html.heex:26
#, elixir-autogen, elixir-format
msgid "Users who are already connected get a short note in their Status window that the MOTD changed. They can read the new text with %{command}."
msgstr "Users who are already connected get a short note in their Status window that the MOTD changed. They can read the new text with %{command}."

#: lib/retro_hex_chat_web/controllers/help_content/cmd_voice.html.heex:35
