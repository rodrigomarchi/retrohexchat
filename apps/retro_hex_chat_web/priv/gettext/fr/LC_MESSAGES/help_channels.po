#: lib/retro_hex_chat_web/controllers/help_content/chanserv_ui.html.heex:2
#, elixir-autogen, elixir-format
msgid ""
"Channel Central includes a Registration tab that maps ChanServ registration "
"and access-list commands to dialog controls."
msgstr ""
"Channel Central comprend un onglet d'enregistrement qui maquille les "
"commandes d'enregistrement et de liste d'accès à des commandes de dialogue."

#: lib/retro_hex_chat_web/controllers/help_content/chanserv.html.heex:131
#: lib/retro_hex_chat_web/controllers/help_content/chanserv_access.html.heex:50
#: lib/retro_hex_chat_web/controllers/help_content/chanserv_ui.html.heex:57
#, elixir-autogen, elixir-format
msgid "Channel Registration"
msgstr "Enregistrement des canaux"

#: lib/retro_hex_chat_web/controllers/help_content/channel_transfer_ownership.html.heex:2
#, elixir-autogen, elixir-format
msgid ""
"Channel ownership can be transferred to another member. The current owner "
"becomes an operator and the target receives owner status."
msgstr ""
"La propriété de la chaîne peut être transférée à un autre membre. Le "
"propriétaire actuel devient un opérateur et la cible reçoit le statut de "
"propriétaire."

#: lib/retro_hex_chat_web/controllers/help_content/channel_welcome_message.html.heex:2
#, elixir-autogen, elixir-format
msgid ""
"Channel welcome messages are shown once to each user when they join a "
"channel. Operators can set or clear the message from Channel Central's "
"General tab or with commands."
msgstr ""
"Les messages d'accueil sont affichés une fois à chaque utilisateur lorsqu'il"
" rejoint un canal. Les opérateurs peuvent définir ou effacer le message "
"depuis l'onglet Général de Channel Central ou avec des commandes."

#: lib/retro_hex_chat_web/controllers/help_content/channel_transfer_ownership.html.heex:16
#, elixir-autogen, elixir-format
msgid "Command"
msgstr "Commande"

#: lib/retro_hex_chat_web/controllers/help_content/chanserv_ui.html.heex:18
#, elixir-autogen, elixir-format
msgid "Controls"
msgstr "Contrôles"

#: lib/retro_hex_chat_web/controllers/help_content/chanserv_ui.html.heex:41
#, elixir-autogen, elixir-format
msgid "Disabled Controls"
msgstr "Contrôle des personnes handicapées"

#: lib/retro_hex_chat_web/controllers/help_content/chanserv_ui.html.heex:22
#, elixir-autogen, elixir-format
msgid "Drop Registration confirms before running the same action as /cs drop."
msgstr ""
"Drop Registration confirme avant d'exécuter la même action que /cs drop."

#: lib/retro_hex_chat_web/controllers/help_content/chanserv_access.html.heex:39
#, elixir-autogen, elixir-format
msgid "Founders can manage SOP, AOP, and VOP lists."
msgstr "Les fondateurs peuvent gérer les listes SOP, AOP et VOP."

#: lib/retro_hex_chat_web/controllers/help_content/nickserv.html.heex:64
#, elixir-autogen, elixir-format
