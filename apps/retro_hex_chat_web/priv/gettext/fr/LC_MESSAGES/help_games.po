msgstr "— Déplacer le joueur"

#: lib/retro_hex_chat_web/controllers/help_content/feature_hex_warlords.html.heex:19
#, elixir-autogen, elixir-format
msgid "— Move shield vertically"
msgstr "— Déplacer le bouclier verticalement"

#: lib/retro_hex_chat_web/controllers/help_content/feature_hex_outlaw_ricochet.html.heex:13
#, elixir-autogen, elixir-format
msgid "— Move vertically and set aim direction (last pressed determines angle)"
msgstr ""
"— Déplacer verticalement et régler la direction de visée (le dernier pressé "
"détermine l'angle)"

#: lib/retro_hex_chat_web/controllers/help_content/feature_hex_frost.html.heex:32
#, elixir-autogen, elixir-format
msgid "— Neutral. Step on it to claim it (+1 igloo piece)"
msgstr "— Neutre. Étape dessus pour la réclamer (+1 pièce d'igloo)"

#: lib/retro_hex_chat_web/controllers/help_content/feature_hex_skiing.html.heex:56
#, elixir-autogen, elixir-format
msgid "— No avalanche, no items, pure time trial racing"
msgstr "— Pas d'avalanche, pas d'articles, pur contre-la-montre"

#: lib/retro_hex_chat_web/controllers/help_content/feature_hex_frost.html.heex:116
#, elixir-autogen, elixir-format
msgid "— No block stealing, pure construction race"
msgstr "— Pas de vol de bloc, pure course de construction"

#: lib/retro_hex_chat_web/controllers/help_content/feature_hex_enduro_sprint.html.heex:51
#, elixir-autogen, elixir-format
msgid "— No fuel means no reason to brake unless you're about to crash. Keep the pedal down."
msgstr ""
"— Aucun carburant ne signifie aucune raison de freiner à moins que vous ne "
"soyez sur le point de s'écraser. Baisse la pédale."

#: lib/retro_hex_chat_web/controllers/help_content/feature_hex_raid.html.heex:69
#, elixir-autogen, elixir-format
msgid "— No mines, pure skill competition"
msgstr "— Pas de mines, pure compétition de compétences"

#: lib/retro_hex_chat_web/controllers/help_content/feature_hex_outlaw.html.heex:69
#, elixir-autogen, elixir-format
msgid "— No obstacle, but players can advance horizontally within their half"
msgstr ""
"— Aucun obstacle, mais les joueurs peuvent avancer horizontalement dans leur"
" moitié"

#: lib/retro_hex_chat_web/controllers/help_content/feature_hex_hockey.html.heex:117
#, elixir-autogen, elixir-format
msgid "— No timer, first to 5 goals, puck speeds up with each goal"
msgstr ""
"— Pas de minuterie, premier à 5 buts, la rondelle accélère avec chaque but"

#: lib/retro_hex_chat_web/controllers/help_content/feature_hex_frost_blizzard.html.heex:48
#, elixir-autogen, elixir-format
msgid "— Not all ice rows are equal. Focus on rows with predictable patterns first."
msgstr ""
"— Toutes les rangées de glace ne sont pas égales. Concentrez-vous d'abord "
"sur les lignes à motifs prévisibles."

#: lib/retro_hex_chat_web/controllers/help_content/feature_hex_outlaw_stagecoach.html.heex:66
#, elixir-autogen, elixir-format
msgid "— One bullet at a time. A wasted shot on the stagecoach gives your opponent a free window to reposition."
msgstr ""
"— Une balle à la fois. Un tir gaspillé sur l'entrainement donne à votre "
"adversaire une fenêtre libre pour repositionner."

#: lib/retro_hex_chat_web/controllers/help_content/feature_hex_frost.html.heex:92
#, elixir-autogen, elixir-format
msgid "— Open/close on blocks. Open = dangerous, closed = safe (from round 4)"
msgstr ""
"— Open/close sur blocs. Ouvert = dangereux, fermé = sûr (à partir du "
"quatrième tour)"

#: lib/retro_hex_chat_web/controllers/help_content/feature_hex_frost.html.heex:74
#, elixir-autogen, elixir-format
msgid "— Patrols the shore. Dodge to reach your igloo!"
msgstr "— Patrouille le rivage. Dodge pour atteindre votre igloo !"

#: lib/retro_hex_chat_web/controllers/help_content/feature_hex_frost_peaceful.html.heex:55
#, elixir-autogen, elixir-format
msgid "— Perfect your jump timing between rows to minimize time between block collections."
msgstr ""
"— Perfectionnez votre temps de saut entre les lignes pour minimiser le temps"
" entre les collections de blocs."

#: lib/retro_hex_chat_web/controllers/help_content/feature_hex_hockey.html.heex:44
#, elixir-autogen, elixir-format
msgid "— Puck reflects off top/bottom walls"
msgstr "— Puck réfléchit sur les murs /bottom"

#: lib/retro_hex_chat_web/controllers/help_content/feature_hex_frost.html.heex:80
#, elixir-autogen, elixir-format
msgid "— Ride the ice blocks (from round 2)"
msgstr "— Rouler sur les blocs de glace (à partir du deuxième tour)"

#: lib/retro_hex_chat_web/controllers/help_content/feature_hex_tennis_sudden.html.heex:51
#, elixir-autogen, elixir-format
msgid "— Risky shots that go out cost you a whole game. Consistency beats flash in Sudden Death."
msgstr ""
"— Des tirs risqués qui sortent vous coûtent tout un jeu. La cohérence bat en"
" éclair dans la mort soudaine."

#: lib/retro_hex_chat_web/controllers/help_content/feature_hex_enduro_night.html.heex:69
#, elixir-autogen, elixir-format
msgid "— Save your turbo boost for fog-free moments when you can actually see the road."
msgstr ""
"— Gardez votre turbo boost pour des moments sans brouillard quand vous "
"pouvez réellement voir la route."

#: lib/retro_hex_chat_web/controllers/help_content/feature_hex_raid_blitz.html.heex:50
#, elixir-autogen, elixir-format
msgid "— Scarce fuel means every depot matters. Plan your path to hit fuel depots even if it means fewer enemy kills."
msgstr ""
"— L'épouvantable carburant signifie que chaque dépôt est important. "
"Planifiez votre chemin pour frapper les dépôts de carburant même si cela "
"signifie moins de morts ennemis."

#: lib/retro_hex_chat_web/controllers/help_content/feature_hex_tennis.html.heex:17
#: lib/retro_hex_chat_web/controllers/help_content/feature_hex_tennis_quick.html.heex:17
#: lib/retro_hex_chat_web/controllers/help_content/feature_hex_tennis_sudden.html.heex:17
#, elixir-autogen, elixir-format
msgid "— Serve (during serving phase)"
msgstr "— Servir (pendant la phase de service)"

#: lib/retro_hex_chat_web/controllers/help_content/feature_hex_tennis_sudden.html.heex:58
#, elixir-autogen, elixir-format
msgid "— Server alternates after every point. Know when you're serving to maximize advantage."
msgstr ""
"— Le serveur alterne après chaque point. Sachez quand vous servir pour "
"maximiser l'avantage."

#: lib/retro_hex_chat_web/controllers/help_content/feature_hex_invaders.html.heex:68
#, elixir-autogen, elixir-format
msgid "— Shared screen, no alien drops, fight together"
msgstr "— Écran partagé, pas de gouttes extraterrestres, combattez ensemble"

#: lib/retro_hex_chat_web/controllers/help_content/feature_hex_skiing_clean.html.heex:38
#, elixir-autogen, elixir-format
msgid "— Sharp turns slow you down. Plan your path 2-3 obstacles ahead for the smoothest line."
msgstr ""
"- Les virages Sharp vous ralentissent. Planifiez votre chemin 2-3 obstacles "
"en avant pour la ligne la plus lisse."

#: lib/retro_hex_chat_web/controllers/help_content/feature_hex_hockey.html.heex:17
#: lib/retro_hex_chat_web/controllers/help_content/feature_hex_hockey_blitz.html.heex:17
#: lib/retro_hex_chat_web/controllers/help_content/feature_hex_hockey_showdown.html.heex:17
#, elixir-autogen, elixir-format
msgid "— Shoot in your facing direction"
msgstr "— Tirez dans votre direction"

#: lib/retro_hex_chat_web/controllers/help_content/feature_hex_skiing.html.heex:62
#, elixir-autogen, elixir-format
msgid "— Sparse obstacles, slow avalanche, wide gates"
msgstr "— Obstacles escarpés, avalanche lente, portes larges"

#: lib/retro_hex_chat_web/controllers/help_content/feature_hex_skiing_escape.html.heex:50
#, elixir-autogen, elixir-format
msgid "— Speed boosts keep you ahead of the avalanche. Missing one could be fatal later."
msgstr ""
"— Les accélérations vous tiennent en avance sur l'avalanche. Un disparu "
"pourrait être fatal plus tard."

#: lib/retro_hex_chat_web/controllers/help_content/feature_hex_hockey_showdown.html.heex:69
#, elixir-autogen, elixir-format
msgid "— Standard 60% success rate. Don't commit to a tackle unless you're sure you're close enough."
msgstr ""
"— Taux de réussite standard de 60 %. Ne vous engagez pas à une attaque à "
"moins d'être sûr que vous êtes assez proche."

#: lib/retro_hex_chat_web/controllers/help_content/feature_hex_outlaw_ricochet.html.heex:65
#, elixir-autogen, elixir-format
msgid "— Standing near the ceiling or floor gives your bullets a shorter bounce path, making them harder to dodge."
msgstr ""
"— Se tenir près du plafond ou du plancher donne à vos balles un chemin de "
"rebond plus court, ce qui les rend plus difficiles à esquiver."

#: lib/retro_hex_chat_web/controllers/help_content/feature_hex_raid.html.heex:11
#: lib/retro_hex_chat_web/controllers/help_content/feature_hex_raid_blitz.html.heex:11
#: lib/retro_hex_chat_web/controllers/help_content/feature_hex_raid_pacifist.html.heex:11
#, elixir-autogen, elixir-format
msgid "— Steer jet laterally"
msgstr "— Fuite latérale"

#: lib/retro_hex_chat_web/controllers/help_content/feature_hex_skiing.html.heex:11
#: lib/retro_hex_chat_web/controllers/help_content/feature_hex_skiing_clean.html.heex:11
#: lib/retro_hex_chat_web/controllers/help_content/feature_hex_skiing_escape.html.heex:11
#, elixir-autogen, elixir-format
msgid "— Steer left/right"
msgstr "— Steer gauche/right"

#: lib/retro_hex_chat_web/controllers/help_content/feature_hex_frost.html.heex:38
#, elixir-autogen, elixir-format
msgid "— Step on your own block to undo it (-1 piece)"
msgstr "— Marchez sur votre propre bloc pour le défaire (-1 pièce)"

#: lib/retro_hex_chat_web/controllers/help_content/feature_hex_frost.html.heex:45
#, elixir-autogen, elixir-format
msgid "— Step to steal it! You +1 piece, they -1 piece (2-piece swing!)"
msgstr "— Marchez pour le voler! Toi +1 pièce, ils -1 pièce (2-pièce swing!)"

#: lib/retro_hex_chat_web/controllers/help_content/feature_hex_frost_blizzard.html.heex:55
#, elixir-autogen, elixir-format
msgid "— Stepping on your opponent's blocks steals them. Use it offensively when you're ahead."
msgstr ""
"— En marchant sur les blocs de votre adversaire les vole. Utilisez-le de "
"manière offensive quand vous êtes devant."

#: lib/retro_hex_chat_web/controllers/help_content/feature_hex_hockey.html.heex:23
#: lib/retro_hex_chat_web/controllers/help_content/feature_hex_hockey_blitz.html.heex:23
#: lib/retro_hex_chat_web/controllers/help_content/feature_hex_hockey_showdown.html.heex:23
#, elixir-autogen, elixir-format
msgid "— Tackle opponent to steal puck"
msgstr "— Tackle adversaire pour voler la rondelle"

#: lib/retro_hex_chat_web/controllers/help_content/feature_hex_hockey_blitz.html.heex:69
#, elixir-autogen, elixir-format
msgid "— The 25% speed boost makes long-range shots more effective. Catch the opponent off guard."
msgstr ""
"— L'accélération de 25 % rend les tirs à longue portée plus efficaces. "
"Attrapez l'adversaire hors garde."

#: lib/retro_hex_chat_web/controllers/help_content/feature_hex_hockey_blitz.html.heex:62
#, elixir-autogen, elixir-format
msgid "— The 80% success rate means tackling is almost always worth it. Chase the puck carrier relentlessly."
msgstr ""
"— Le taux de réussite de 80% signifie que la lutte en vaut presque toujours "
"la peine. Chase le porte- rondelle sans relâche."

#: lib/retro_hex_chat_web/controllers/help_content/feature_hex_tennis_quick.html.heex:60
#, elixir-autogen, elixir-format
msgid "— The ball angle depends on where it hits your player. Position yourself to control shot direction."
msgstr ""
"— L'angle de balle dépend de l'endroit où il frappe votre joueur. "
"Positionnez-vous pour contrôler la direction du tir."

#: lib/retro_hex_chat_web/controllers/help_content/feature_hex_skiing_escape.html.heex:43
#, elixir-autogen, elixir-format
msgid "— The center of the course gives you the most options to dodge left or right as obstacles appear."
msgstr ""
"— Le centre du cours vous donne le plus d'options pour éviter les obstacles "
"à gauche ou à droite."

#: lib/retro_hex_chat_web/controllers/help_content/feature_hex_hockey_showdown.html.heex:55
#, elixir-autogen, elixir-format
msgid "— The first few goals are at normal puck speed. Build a lead before the puck becomes a missile."
msgstr ""
"— Les premiers buts sont à la vitesse normale de la rondelle. Construire une"
" avance avant que la rondelle devienne un missile."

#: lib/retro_hex_chat_web/controllers/help_content/feature_hex_outlaw_stagecoach.html.heex:45
#, elixir-autogen, elixir-format
msgid "— The stagecoach bounces at a constant speed. Count the timing and fire during the gap windows."
msgstr ""
"— La diligence rebondit à une vitesse constante. Comptez le timing et le feu"
" pendant les fenêtres d'écart."

#: lib/retro_hex_chat_web/controllers/help_content/feature_hex_outlaw_stagecoach.html.heex:52
#, elixir-autogen, elixir-format
msgid "— The stagecoach spends the least time at the top and bottom of its bounce, creating wider shooting windows."
msgstr ""
"— La diligence passe le moins de temps en haut et en bas de son rebond, "
"créant des fenêtres de tir plus larges."

#: lib/retro_hex_chat_web/controllers/help_content/feature_hex_skiing_clean.html.heex:52
#, elixir-autogen, elixir-format
msgid "— Tight gaps require micro-adjustments. Don't overcorrect and bounce between obstacles."
msgstr ""
"— Les écarts étroits exigent des microajustements. Ne pas trop corriger et "
"rebondir entre les obstacles."

#: lib/retro_hex_chat_web/controllers/help_content/feature_hex_raid_pacifist.html.heex:59
#, elixir-autogen, elixir-format
msgid "— Touching the riverbank kills you instantly. Stay centered when the river narrows."
msgstr ""
"— Toucher la rive vous tue instantanément. Restez centré quand la rivière se"
" rétrécit."

#: lib/retro_hex_chat_web/controllers/help_content/feature_hex_hockey.html.heex:32
#, elixir-autogen, elixir-format
msgid "— Walk into the free puck to pick it up automatically"
msgstr "— Marchez dans la rondelle libre pour la ramasser automatiquement"

#: lib/retro_hex_chat_web/controllers/help_content/feature_hex_enduro_sprint.html.heex:65
#, elixir-autogen, elixir-format
msgid "— Weave through tight gaps between AI cars. Each overtake counts — even risky ones."
msgstr ""
"— Tisser des écarts étroits entre les voitures IA. Chaque dépassement "
"compte, même les plus risqués."

#: lib/retro_hex_chat_web/controllers/help_content/feature_hex_hockey_showdown.html.heex:62
#, elixir-autogen, elixir-format
msgid "— When the puck is fast, stay between the puck and your goal. Reaction time shrinks."
msgstr ""
"— Lorsque la rondelle est rapide, restez entre la rondelle et votre but. Le "
"temps de réaction diminue."

#: lib/retro_hex_chat_web/controllers/help_content/feature_hex_frost_blizzard.html.heex:41
#, elixir-autogen, elixir-format
msgid "— With 60° on the clock, you have time. Don't rush jumps and fall into the water."
msgstr ""
"— Avec 60° sur l'horloge, vous avez le temps. Ne saute pas et tombe dans "
"l'eau."

#: lib/retro_hex_chat_web/controllers/help_content/feature_hex_hockey_blitz.html.heex:55
#, elixir-autogen, elixir-format
msgid "— With 80% tackle success, holding the puck is dangerous. Shoot on sight."
msgstr "— Avec 80 % de succès, tenir la rondelle est dangereux. Tirez à vue."

#: lib/retro_hex_chat_web/controllers/help_content/feature_hex_raid_blitz.html.heex:43
#, elixir-autogen, elixir-format
msgid "— With a 3-second cooldown, you can drop mines much more frequently. Use them to disrupt your opponent's rhythm."
msgstr ""
"— Avec un refroidissement de 3 secondes, vous pouvez déposer les mines "
"beaucoup plus fréquemment. Utilisez-les pour perturber le rythme de votre "
"adversaire."

#: lib/retro_hex_chat_web/controllers/help_content/feature_hex_enduro_sprint.html.heex:58
#, elixir-autogen, elixir-format
msgid "— With clear visibility, use turbo when the road ahead is clear for maximum overtakes."
msgstr ""
"— Avec une visibilité claire, utiliser le turbo lorsque la route à l'avant "
"est libre pour les dépassements maximums."

#: lib/retro_hex_chat_web/controllers/help_content/feature_hex_invaders_blitz.html.heex:44
#, elixir-autogen, elixir-format
msgid "— With lowered combo thresholds (2 kills for a drop), rapid-fire is your best weapon against the opponent."
msgstr ""
"— Avec des seuils combo abaissés (2 morts pour une chute), le feu rapide est"
" votre meilleure arme contre l'adversaire."

#: lib/retro_hex_chat_web/controllers/help_content/feature_hex_outlaw_nml.html.heex:57
#, elixir-autogen, elixir-format
msgid "— With no obstacles, vertical movement is your only defense. Never stand still."
msgstr ""
"— Sans obstacles, le mouvement vertical est votre seule défense. Ne restez "
"jamais immobile."

#: lib/retro_hex_chat_web/controllers/help_content/feature_hex_tennis_sudden.html.heex:44
#, elixir-autogen, elixir-format
msgid "— With one-point games, an ace or unreturnable serve is an instant game win."
msgstr ""
"— Avec des jeux en un seul point, un as ou un service infaillible est une "
"victoire de jeu instantanée."

#: lib/retro_hex_chat_web/controllers/help_content/feature_hex_tennis_quick.html.heex:39
#, elixir-autogen, elixir-format
msgid "— With only 3 games needed, losing even one game puts you at a serious disadvantage."
msgstr ""
"— Avec seulement 3 jeux nécessaires, perdre même un jeu vous met dans un "
"grave désavantage."

#: lib/retro_hex_chat_web/controllers/help_content/feature_hex_frost_peaceful.html.heex:41
#, elixir-autogen, elixir-format
msgid "— Without block stealing, the fastest path through the ice rows wins. Plan your circuit."
msgstr ""
"— Sans block vol, le chemin le plus rapide à travers les rangées de glace "
"gagne. Préparez votre circuit."

#: lib/retro_hex_chat_web/controllers/help_content/feature_hex_raid_pacifist.html.heex:45
#, elixir-autogen, elixir-format
msgid "— Without mines to worry about, you can fly more aggressively. But don't forget to refuel — fuel depots are your lifeline."
msgstr ""
"— Sans mines, vous pouvez voler plus agressivement. Mais n'oubliez pas de "
"ravitailler — les dépôts de carburant sont votre ligne de vie."

#: lib/retro_hex_chat_web/controllers/help_content/feature_hex_outlaw_ricochet.html.heex:72
#, elixir-autogen, elixir-format
msgid "— You can only fire one bullet at a time. Don't waste shots — wait for a clear angle."
msgstr ""
"— Vous ne pouvez tirer qu'une balle à la fois. Ne gaspillez pas les tirs — "
"attendez un angle clair."

#: lib/retro_hex_chat_web/controllers/help_content/feature_hex_outlaw_ricochet.html.heex:58
#, elixir-autogen, elixir-format
msgid "— Your last directional input sets your aim. Keep moving up and down to make your shots unpredictable."
msgstr ""
"— Votre dernière entrée directionnelle définit votre objectif. Continuez à "
"monter et descendre pour rendre vos tirs imprévisibles."

#: lib/retro_hex_chat_web/controllers/help_content/feature_hex_hockey_blitz.html.heex:44
#, elixir-autogen, elixir-format
msgid "— more aggressive, less risk"
msgstr "— plus agressifs, moins risqués"

#: lib/retro_hex_chat_web/controllers/help_content/feature_hex_hockey_showdown.html.heex:32
#, elixir-autogen, elixir-format
msgid "— play until someone reaches 5 goals"
msgstr "— jouer jusqu'à ce que quelqu'un atteigne 5 buts"

#: lib/retro_hex_chat_web/controllers/help_content/feature_hex_hockey_showdown.html.heex:38
#, elixir-autogen, elixir-format
msgid "— puck gets faster with each goal scored"
msgstr "— la rondelle devient plus rapide avec chaque but marqué"

#: lib/retro_hex_chat_web/controllers/help_content/feature_hex_hockey.html.heex:68
#, elixir-autogen, elixir-format
msgid "— puck is freed at opponent's position"
msgstr "— la rondelle est libérée à la position de l'opposant"

#: lib/retro_hex_chat_web/controllers/help_content/feature_hex_hockey.html.heex:74
#, elixir-autogen, elixir-format
msgid "— you are stunned for 300ms (can't move or act)"
msgstr "— vous êtes stupéfait pendant 300 ms (ne pouvez pas bouger ou agir)"

#: lib/retro_hex_chat_web/controllers/help_content/feature_star_duel.html.heex:69
#, elixir-autogen, elixir-format
msgid "2 seconds of invulnerability after each respawn"
msgstr "2 secondes d'invulnérabilité après chaque remise en suspension"

#: lib/retro_hex_chat_web/controllers/help_content/feature_block_breakers.html.heex:25
#, elixir-autogen, elixir-format
msgid "3 shared lives — if the ball exits top or bottom, both players lose a life"
msgstr ""
"3 vies partagées — si la balle sort en haut ou en bas, les deux joueurs "
"perdent une vie"

#: lib/retro_hex_chat_web/controllers/help_content/feature_block_breakers.html.heex:31
#, elixir-autogen, elixir-format
msgid "50 blocks arranged in 5 rows of 10 with different point values"
msgstr ""
"50 blocs disposés en 5 lignes de 10 avec différentes valeurs ponctuelles"

#: lib/retro_hex_chat_web/controllers/help_content/feature_debris_field.html.heex:40
#, elixir-autogen, elixir-format
msgid "8 asteroids of varying sizes are scattered across the arena"
msgstr "8 astéroïdes de différentes tailles sont dispersés dans l'arène"

#: lib/retro_hex_chat_web/controllers/help_content/feature_block_breakers.html.heex:19
#: lib/retro_hex_chat_web/controllers/help_content/feature_pixel_tanks.html.heex:19
#, elixir-autogen, elixir-format
msgid "A / D"
msgstr "A / D"

#: lib/retro_hex_chat_web/controllers/help_content/feature_gravity_well.html.heex:41
#, elixir-autogen, elixir-format
msgid "A central star exerts gravitational pull on all ships and missiles"
msgstr ""
"Une étoile centrale exerce une traction gravitationnelle sur tous les "
"navires et missiles"

#: lib/retro_hex_chat_web/controllers/help_content/feature_pixel_tanks.html.heex:55
#, elixir-autogen, elixir-format
msgid "After each hit, both tanks respawn at starting positions with 2 seconds of invulnerability"
msgstr ""
"Après chaque coup, les deux chars se remettent en position de départ avec 2 "
"secondes d'invulnérabilité"

#: lib/retro_hex_chat_web/controllers/help_content/feature_debris_field.html.heex:58
#: lib/retro_hex_chat_web/controllers/help_content/feature_gravity_well.html.heex:60
#, elixir-autogen, elixir-format
msgid "All other rules are identical to Star Duel (first to 7, wraparound, hyperspace warp)"
msgstr ""
"Toutes les autres règles sont identiques à Star Duel (premier à 7, "
"enveloppage, chaîne hyperspatiale)"

#: lib/retro_hex_chat_web/controllers/help_content/feature_block_breakers.html.heex:17
#: lib/retro_hex_chat_web/controllers/help_content/feature_pixel_tanks.html.heex:17
#, elixir-autogen, elixir-format
msgid "Arrow Left / Right"
msgstr "Flèche gauche / droite"

#: lib/retro_hex_chat_web/controllers/help_content/feature_light_trails.html.heex:11
#, elixir-autogen, elixir-format
msgid "Arrow keys"
msgstr "Clés flèche"

#: lib/retro_hex_chat_web/controllers/help_content/feature_debris_field.html.heex:51
#, elixir-autogen, elixir-format
msgid "Asteroids are static — same layout for both players, randomly generated per match"
msgstr ""
"Les astéroïdes sont statiques — même disposition pour les deux joueurs, "
"générés aléatoirement par match"

#: lib/retro_hex_chat_web/controllers/help_content/feature_sessions.html.heex:42
#, elixir-autogen, elixir-format
msgid "Auto-Reconnect"
msgstr "Connexion automatique"

#: lib/retro_hex_chat_web/controllers/help_content/feature_block_breakers.html.heex:50
#, elixir-autogen, elixir-format
msgid "Ball bounces off left/right walls but NOT top/bottom — that's your job"
msgstr ""
"Balle rebondit sur les murs gauche/right mais PAS dessus/bottom — c'est "
"votre travail"

#: lib/retro_hex_chat_web/controllers/help_content/feature_block_breakers.html.heex:42
#, elixir-autogen, elixir-format
msgid "Ball speed resets after each life lost"
msgstr "La vitesse du ballon se réinitialise après chaque perte de vie"

#: lib/retro_hex_chat_web/controllers/help_content/feature_block_breakers.html.heex:40
#, elixir-autogen, elixir-format
msgid "Ball speeds up with each paddle hit and every 5 blocks destroyed"
msgstr "La balle s'accélère avec chaque pagaie et tous les 5 blocs détruits"

#: lib/retro_hex_chat_web/controllers/help_content/feature_block_breakers.html.heex:64
#, elixir-autogen, elixir-format
msgid "Based on Atari's Breakout (1976) — cooperative brick-breaking for two players."
msgstr ""
"D'après le Breakout d'Atari (1976), une coopérative de brick-breaking pour "
"deux joueurs."

#: lib/retro_hex_chat_web/controllers/help_content/feature_pixel_tanks.html.heex:67
#, elixir-autogen, elixir-format
msgid "Based on Atari's Combat (1977) — the quintessential tank battle game."
msgstr ""
"Basé sur le combat d'Atari (1977) — le jeu de bataille de chars "
"quintessence."

#: lib/retro_hex_chat_web/controllers/help_content/feature_light_trails.html.heex:50
#, elixir-autogen, elixir-format
msgid "Based on Atari's Surround (1977) and Tron's Light Cycles — the original trail game."
msgstr ""
"Basé sur Surround d'Atari (1977) et Light Cycles de Tron — le jeu de piste "
"original."

#: lib/retro_hex_chat_web/controllers/help_content/feature_star_duel.html.heex:85
#, elixir-autogen, elixir-format
msgid "Based on Spacewar! (1962) — the grandfather of space combat games."
msgstr ""
"Basé sur Spacewar! (1962) — le grand - père des jeux de combat spatial."

#: lib/retro_hex_chat_web/controllers/help_content/feature_light_trails.html.heex:26
#, elixir-autogen, elixir-format
msgid "Both players move one cell per tick on a 60x40 grid (10 ticks per second)"
msgstr ""
"Les deux joueurs déplacent une cellule par tique sur une grille 60x40 (10 "
"tiques par seconde)"

#: lib/retro_hex_chat_web/controllers/help_content/feature_debris_field.html.heex:42
#, elixir-autogen, elixir-format
msgid "Colliding with an asteroid is instant death (scores a point for your opponent)"
msgstr ""
"Collider avec un astéroïde est la mort instantanée (score un point pour "
"votre adversaire)"

#: lib/retro_hex_chat_web/controllers/help_content/feature_block_breakers.html.heex:2
#, elixir-autogen, elixir-format
msgid "Cooperative Breakout — Player 1 controls the bottom paddle, Player 2 controls the top. Work together to destroy all 50 neon blocks before running out of lives. The ball bounces between your paddles — miss it and both players lose a life."
msgstr ""
"Coopérative Breakout — Le joueur 1 contrôle la palette inférieure, le joueur"
" 2 contrôle le haut. Travailler ensemble pour détruire les 50 blocs de néons"
" avant de manquer de vies. Le ballon rebondit entre vos pagaies — manquez-le"
" et les deux joueurs perdent une vie."

#: lib/retro_hex_chat_web/controllers/help_content/feature_light_trails.html.heex:33
#, elixir-autogen, elixir-format
msgid "Crashing into any trail (yours or opponent's) or the arena wall kills you"
msgstr ""
"Crashing dans n'importe quel sentier (votre ou adversaire) ou le mur de "
"l'arène vous tue"

#: lib/retro_hex_chat_web/controllers/help_content/feature_gravity_well.html.heex:100
#: lib/retro_hex_chat_web/controllers/help_content/feature_star_duel.html.heex:79
#: lib/retro_hex_chat_web/controllers/help_content/feature_star_duel.html.heex:90
#, elixir-autogen, elixir-format
msgid "Debris Field"
msgstr "Champ des débris"

#: lib/retro_hex_chat_web/controllers/help_content/feature_block_breakers.html.heex:56
#, elixir-autogen, elixir-format
msgid "Destroy all 50 blocks to win (max 1500 points), or lose all 3 lives for game over"
msgstr ""
"Détruisez tous les 50 blocs pour gagner (max 1500 points), ou perdez toutes "
"les 3 vies pour le match plus"

#: lib/retro_hex_chat_web/controllers/help_content/feature_light_trails.html.heex:31
#, elixir-autogen, elixir-format
msgid "Every cell you cross becomes part of your trail permanently"
msgstr ""
"Chaque cellule que vous croisez devient une partie permanente de votre "
"sentier"

#: lib/retro_hex_chat_web/controllers/help_content/feature_light_trails.html.heex:45
#, elixir-autogen, elixir-format
msgid "First to 3 round wins takes the match"
msgstr "Première à 3 victoires de tour prend le match"

#: lib/retro_hex_chat_web/controllers/help_content/feature_star_duel.html.heex:70
#, elixir-autogen, elixir-format
msgid "First to 7 kills wins the match"
msgstr "Première à 7 morts gagne le match"

#: lib/retro_hex_chat_web/controllers/help_content/feature_gravity_well.html.heex:51
#, elixir-autogen, elixir-format
msgid "Flying into the star's danger zone is instant death (scores a point for your opponent)"
msgstr ""
"Voler dans la zone de danger de l'étoile est la mort instantanée (score un "
"point pour votre adversaire)"

#: lib/retro_hex_chat_web/controllers/help_content/feature_sessions.html.heex:44
#, elixir-autogen, elixir-format
msgid "GHOST Command"
msgstr "Commande GHOST"

#: lib/retro_hex_chat_web/controllers/help_content/feature_debris_field.html.heex:98
#: lib/retro_hex_chat_web/controllers/help_content/feature_star_duel.html.heex:75
#: lib/retro_hex_chat_web/controllers/help_content/feature_star_duel.html.heex:89
#, elixir-autogen, elixir-format
msgid "Gravity Well"
msgstr "Bien Gravité"

#: lib/retro_hex_chat_web/controllers/help_content/feature_gravity_well.html.heex:44
#, elixir-autogen, elixir-format
msgid "Gravity curves missile trajectories — use the star to bend shots around obstacles"
msgstr ""
"Courbes de gravité Trajectoires de missiles — utiliser l'étoile pour plier "
"les tirs autour des obstacles"

#: lib/retro_hex_chat_web/controllers/help_content/feature_gravity_well.html.heex:76
#, elixir-autogen, elixir-format
msgid "Gravity-bent shots"
msgstr "Tirs gravitationnels"

#: lib/retro_hex_chat_web/controllers/help_content/feature_pixel_tanks.html.heex:47
#, elixir-autogen, elixir-format
msgid "Half-second cooldown after each missile expires"
msgstr "Refroidissement de demi-seconde après l'expiration de chaque missile"

#: lib/retro_hex_chat_web/controllers/help_content/feature_debris_field.html.heex:81
#, elixir-autogen, elixir-format
msgid "Herd your opponent"
msgstr "Protège ton adversaire"

#: lib/retro_hex_chat_web/controllers/help_content/feature_block_breakers.html.heex:73
#, elixir-autogen, elixir-format
msgid "Hex Pong"
msgstr "Hex Pong"

#: lib/retro_hex_chat_web/controllers/help_content/feature_pixel_tanks.html.heex:49
#, elixir-autogen, elixir-format
msgid "Hits score 1 point — most hits when the 2-minute timer runs out wins the round"
msgstr ""
"Hits score 1 point — la plupart des résultats lorsque le chronomètre de 2 "
"minutes s'épuise gagne la ronde"

#: lib/retro_hex_chat_web/controllers/help_content/feature_star_duel.html.heex:64
#, elixir-autogen, elixir-format
msgid "Hyperspace warp: random position, 20% death chance, 3-second cooldown"
msgstr ""
"Hyperespace chaîne: position aléatoire, 20% de risque de mort, 3 secondes de"
" refroidissement"

#: lib/retro_hex_chat_web/controllers/help_content/feature_light_trails.html.heex:40
#, elixir-autogen, elixir-format
msgid "If both players collide head-on in the same cell, the round is a draw (no points)"
msgstr ""
"Si les deux joueurs se heurtent de front dans la même cellule, le tour est "
"un tirage au sort (pas de points)"

#: lib/retro_hex_chat_web/controllers/help_content/feature_sessions.html.heex:30
#, elixir-autogen, elixir-format
msgid "If your connection drops unexpectedly, the client attempts to reconnect automatically with exponential backoff (up to 10 attempts). If all attempts fail, the session is considered"
msgstr ""
"Si votre connexion baisse de façon inattendue, le client tente de se "
"reconnecter automatiquement avec une sauvegarde exponentielle (jusqu'à 10 "
"tentatives). Si toutes les tentatives échouent, la session est considérée"

#: lib/retro_hex_chat_web/controllers/help_content/feature_debris_field.html.heex:88
#, elixir-autogen, elixir-format
msgid "Learn the layout fast"
msgstr "Apprenez la mise en page rapidement"

#: lib/retro_hex_chat_web/controllers/help_content/feature_pixel_tanks.html.heex:63
#, elixir-autogen, elixir-format
msgid "Maze is randomly selected from 5 symmetrical layouts"
msgstr "La Maze est sélectionnée au hasard dans 5 plans symétriques"

#: lib/retro_hex_chat_web/controllers/help_content/feature_debris_field.html.heex:74
#, elixir-autogen, elixir-format
msgid "Mind your warp"
msgstr "Attention à votre distorsion"

#: lib/retro_hex_chat_web/controllers/help_content/feature_debris_field.html.heex:48
#, elixir-autogen, elixir-format
msgid "Missiles are destroyed when they hit asteroids — use them as cover"
msgstr ""
"Les missiles sont détruits lorsqu'ils frappent des astéroïdes — les utiliser"
" comme couverture"

#: lib/retro_hex_chat_web/controllers/help_content/feature_star_duel.html.heex:58
#, elixir-autogen, elixir-format
msgid "Missiles expire after 1.5 seconds if they don't hit anything"
msgstr "Les missiles expirent après 1,5 seconde s'ils ne frappent rien"

#: lib/retro_hex_chat_web/controllers/help_content/feature_star_duel.html.heex:56
#, elixir-autogen, elixir-format
msgid "Missiles inherit your ship's velocity plus their own thrust"
msgstr ""
"Les missiles héritent de la vitesse de votre vaisseau plus leur propre "
"poussée"

#: lib/retro_hex_chat_web/controllers/help_content/feature_pixel_tanks.html.heex:40
#, elixir-autogen, elixir-format
msgid "Missiles travel at 2.5x tank speed with a 2-second lifetime"
msgstr ""
"Les missiles voyagent à 2,5x vitesse du réservoir avec une durée de vie de 2"
" secondes"

#: lib/retro_hex_chat_web/controllers/help_content/feature_star_duel.html.heex:2
#, elixir-autogen, elixir-format
msgid "Newtonian space combat in open vacuum. Thrust, rotate, and fire missiles while drifting through wraparound space. Use hyperspace warp to escape — but there's a 20% chance it kills you. First to 7 wins."
msgstr ""
"Combat spatial newtonien sous vide. Pousser, tourner et tirer des missiles "
"tout en dérivant dans l'espace. Utilisez la chaîne hyperspatiale pour vous "
"échapper, mais il y a 20 % de chances qu'elle vous tue. Première à 7 "
"victoires."

#: lib/retro_hex_chat_web/controllers/help_content/feature_pixel_tanks.html.heex:62
#, elixir-autogen, elixir-format
msgid "No backward movement — plan your approach carefully"
msgstr "Pas de mouvement en arrière — planifiez votre approche avec soin"

#: lib/retro_hex_chat_web/controllers/help_content/feature_pixel_tanks.html.heex:35
#, elixir-autogen, elixir-format
msgid "One missile per player at a time — you can't fire again until it expires or hits"
msgstr ""
"Un missile par joueur à la fois — vous ne pouvez plus tirer avant qu'il "
"expire ou frappe"

#: lib/retro_hex_chat_web/controllers/help_content/feature_gravity_well.html.heex:69
#, elixir-autogen, elixir-format
msgid "Orbit, don't fight"
msgstr "Orbite, ne te bats pas."

#: lib/retro_hex_chat_web/controllers/help_content/feature_block_breakers.html.heex:44
#, elixir-autogen, elixir-format
msgid "Paddle hit angle affects ball direction — edges create steeper bounces (up to 60 degrees)"
msgstr ""
"L'angle de frappe de paddle affecte la direction de la balle — les bords "
"créent des rebonds plus raides (jusqu'à 60 degrés)"

#: lib/retro_hex_chat_web/controllers/help_content/feature_light_trails.html.heex:2
#, elixir-autogen, elixir-format
msgid "Race across a neon grid leaving a glowing trail behind you. Hit any trail or the wall and you're out. Trap your opponent to win. Both players move continuously at a fixed pace — there's no stopping, only choosing where to turn next. First to 3 round wins takes the match."
msgstr ""
"Course à travers une grille de néons laissant un sentier lumineux derrière "
"vous. Frappez n'importe quelle piste ou le mur et vous êtes dehors. Tracez "
"votre adversaire pour gagner. Les deux joueurs se déplacent en continu à un "
"rythme fixe — il n'y a pas d'arrêt, seulement choisir où tourner ensuite. "
"Première à 3 victoires de ronde prend le match."

#: lib/retro_hex_chat_web/controllers/help_content/feature_sessions.html.heex:28
#, elixir-autogen, elixir-format
msgid "Session Expiry"
msgstr "Ouverture de la session"

#: lib/retro_hex_chat_web/controllers/help_content/feature_sessions.html.heex:37
#, elixir-autogen, elixir-format
msgid "Session expired"
msgstr "Session expirée"

#: lib/retro_hex_chat_web/controllers/help_content/feature_star_duel.html.heex:61
#, elixir-autogen, elixir-format
msgid "Ship-to-ship collision kills both players (no point awarded)"
msgstr ""
"La collision entre navires tue les deux joueurs (aucun point n'a été "
"attribué)"

#: lib/retro_hex_chat_web/controllers/help_content/feature_star_duel.html.heex:41
#, elixir-autogen, elixir-format
msgid "Ships have full Newtonian inertia — you keep drifting after thrusting"
msgstr ""
"Les navires ont une inertie newtonienne complète — vous continuez à dériver "
"après avoir poussé"

#: lib/retro_hex_chat_web/controllers/help_content/feature_star_duel.html.heex:46
#, elixir-autogen, elixir-format
msgid "Slight drag slows you gradually, but momentum is king"
msgstr "Légère traînée vous ralentit progressivement, mais l'élan est roi"

#: lib/retro_hex_chat_web/controllers/help_content/feature_gravity_well.html.heex:83
#, elixir-autogen, elixir-format
msgid "Slingshot ambush"
msgstr "Une embuscade de slingshot"

#: lib/retro_hex_chat_web/controllers/help_content/feature_debris_field.html.heex:97
#: lib/retro_hex_chat_web/controllers/help_content/feature_gravity_well.html.heex:99
#, elixir-autogen, elixir-format
msgid "Star Duel"
msgstr "Duel Étoile"

#: lib/retro_hex_chat_web/controllers/help_content/feature_debris_field.html.heex:2
#, elixir-autogen, elixir-format
msgid "Star Duel variant with 8 floating asteroids that block missiles and destroy ships on contact. Use the debris as cover — or watch it destroy you. The asteroid layout changes every match, forcing you to adapt your strategy on the fly."
msgstr ""
"Variante Star Duel avec 8 astéroïdes flottants qui bloquent les missiles et "
"détruisent les navires en contact. Utilisez les débris comme couverture — ou"
" regardez - les vous détruire. La disposition de l'astéroïde change chaque "
"match, vous forçant à adapter votre stratégie à la volée."

#: lib/retro_hex_chat_web/controllers/help_content/feature_gravity_well.html.heex:2
#, elixir-autogen, elixir-format
msgid "Star Duel variant with a central gravity star that pulls ships and missiles into curved trajectories. Use gravity slingshots for speed — but fly too close and the star kills you. Mastering orbital mechanics is the key to victory — every thrust and shot must account for the star's relentless pull."
msgstr ""
"Variante Star Duel avec une étoile de gravité centrale qui tire les navires "
"et les missiles en trajectoires courbes. Utilisez des slingshots de gravité "
"pour la vitesse — mais volez trop près et l'étoile vous tue. La maîtrise de "
"la mécanique orbitale est la clé de la victoire — chaque poussée et tir doit"
" tenir compte de la traction incessante de l'étoile."

#: lib/retro_hex_chat_web/controllers/help_content/feature_light_trails.html.heex:46
#, elixir-autogen, elixir-format
msgid "Starting positions swap each round for fairness"
msgstr "Positions de départ swap chaque tour pour l'équité"

#: lib/retro_hex_chat_web/controllers/help_content/feature_star_duel.html.heex:48
#, elixir-autogen, elixir-format
msgid "The arena wraps around — fly off one edge, appear on the other"
msgstr "L'arène s'enroule, s'envole d'un côté, apparaît de l'autre"

#: lib/retro_hex_chat_web/controllers/help_content/feature_gravity_well.html.heex:57
#, elixir-autogen, elixir-format
msgid "Thrust fights gravity, not friction — orbit management is critical"
msgstr ""
"La poussée combat la gravité, pas le frottement — la gestion de l'orbite est"
" critique"

#: lib/retro_hex_chat_web/controllers/help_content/feature_pixel_tanks.html.heex:61
#, elixir-autogen, elixir-format
msgid "Tied round? No round win awarded to either player"
msgstr "Une liaison ? Aucune victoire ronde n'a été attribuée à aucun joueur"

#: lib/retro_hex_chat_web/controllers/help_content/feature_block_breakers.html.heex:34
#, elixir-autogen, elixir-format
msgid "Top rows are worth more: 50 (red), 40 (orange), 30 (yellow), 20 (green), 10 (cyan)"
msgstr ""
"Les rangs supérieurs valent plus: 50 (rouge), 40 (orange), 30 (jaune), 20 "
"(vert), 10 (cyan)"

#: lib/retro_hex_chat_web/controllers/help_content/feature_star_duel.html.heex:51
#, elixir-autogen, elixir-format
msgid "Up to 3 missiles in flight per player, with a brief cooldown between shots"
msgstr ""
"Jusqu'à 3 missiles en vol par joueur, avec un bref refroidissement entre les"
" tirs"

#: lib/retro_hex_chat_web/controllers/help_content/feature_debris_field.html.heex:67
#, elixir-autogen, elixir-format
msgid "Use asteroids as shields"
msgstr "Utiliser des astéroïdes comme boucliers"

#: lib/retro_hex_chat_web/controllers/help_content/feature_gravity_well.html.heex:49
#, elixir-autogen, elixir-format
msgid "Use gravity slingshots to accelerate without thrust"
msgstr "Utiliser des slingshots de gravité pour accélérer sans poussée"

#: lib/retro_hex_chat_web/controllers/help_content/feature_light_trails.html.heex:17
#, elixir-autogen, elixir-format
msgid "WASD"
msgstr "DÉCHETS"

#: lib/retro_hex_chat_web/controllers/help_content/feature_debris_field.html.heex:56
#, elixir-autogen, elixir-format
msgid "Warp is extra risky — you might teleport onto an asteroid"
msgstr ""
"La distorsion est très risquée — vous pourriez téléporter sur un astéroïde"

#: lib/retro_hex_chat_web/controllers/help_content/feature_gravity_well.html.heex:90
#, elixir-autogen, elixir-format
msgid "Warp is suicide"
msgstr "La distorsion est un suicide"

#: lib/retro_hex_chat_web/controllers/help_content/feature_sessions.html.heex:38
#, elixir-autogen, elixir-format
msgid "You can then reconnect manually."
msgstr "Vous pouvez ensuite vous reconnecter manuellement."

#: lib/retro_hex_chat_web/controllers/help_content/feature_light_trails.html.heex:38
#, elixir-autogen, elixir-format
msgid "You cannot reverse direction — 180-degree turns are blocked"
msgstr ""
"Vous ne pouvez pas inverser la direction — les virages à 180 degrés sont "
"bloqués"

#: lib/retro_hex_chat_web/controllers/help_content/feature_sessions.html.heex:35
#, elixir-autogen, elixir-format
msgid "and you are redirected to the Connect screen with the message:"
msgstr "et vous êtes redirigé vers l'écran Connect avec le message:"

#: lib/retro_hex_chat_web/controllers/help_content/feature_star_duel.html.heex:80
#, elixir-autogen, elixir-format
msgid "— 8 asteroids block missiles and kill ships on contact"
msgstr "— 8 astéroïdes bloquent des missiles et tuent des navires en contact"

#: lib/retro_hex_chat_web/controllers/help_content/feature_star_duel.html.heex:76
#, elixir-autogen, elixir-format
msgid "— Central star pulls ships and missiles into orbital trajectories"
msgstr ""
"— L'étoile centrale tire des navires et des missiles dans des trajectoires "
"orbitales"

#: lib/retro_hex_chat_web/controllers/help_content/feature_light_trails.html.heex:11
#, elixir-autogen, elixir-format
msgid "— Change direction (Up, Down, Left, Right)"
msgstr "— Changer de direction (en haut, en bas, à gauche, à droite)"

#: lib/retro_hex_chat_web/controllers/help_content/feature_gravity_well.html.heex:84
#, elixir-autogen, elixir-format
msgid "— Dive toward the star for a speed boost, then slingshot around for a high-speed attack run. Risky but devastating."
msgstr ""
"— Plongez vers l'étoile pour un boost de vitesse, puis slingshot autour pour"
" une course d'attaque à grande vitesse. Risque mais dévastateur."

#: lib/retro_hex_chat_web/controllers/help_content/feature_pixel_tanks.html.heex:23
#, elixir-autogen, elixir-format
msgid "— Drive forward"
msgstr "— Rouler vers l'avant"

#: lib/retro_hex_chat_web/controllers/help_content/feature_gravity_well.html.heex:77
#, elixir-autogen, elixir-format
msgid "— Fire missiles on curved paths by shooting tangentially past the star. Your opponent can't dodge what they can't predict."
msgstr ""
"— Tirez des missiles sur des trajectoires courbes en tirant tangentiellement"
" sur l'étoile. Votre adversaire ne peut pas éviter ce qu'il ne peut prédire."

#: lib/retro_hex_chat_web/controllers/help_content/feature_debris_field.html.heex:75
#, elixir-autogen, elixir-format
msgid "— Hyperspace has a chance of dropping you on an asteroid. The more debris, the more dangerous warping becomes."
msgstr ""
"— Hyperspace a une chance de vous faire tomber sur un astéroïde. Plus il y a"
" de débris, plus il devient dangereux."

#: lib/retro_hex_chat_web/controllers/help_content/feature_debris_field.html.heex:32
#: lib/retro_hex_chat_web/controllers/help_content/feature_gravity_well.html.heex:32
#: lib/retro_hex_chat_web/controllers/help_content/feature_star_duel.html.heex:32
#, elixir-autogen, elixir-format
msgid "— Hyperspace warp (random teleport, 20% death chance)"
msgstr ""
"— Chaîne hyperspatiale (téléportage aléatoire, 20 % de risque de mort)"

#: lib/retro_hex_chat_web/controllers/help_content/feature_gravity_well.html.heex:91
#, elixir-autogen, elixir-format
msgid "— Hyperspace warp can teleport you onto the star's danger zone. Only use it as an absolute last resort."
msgstr ""
"— Hyperspace distorsion peut vous téléporter sur la zone de danger de "
"l'étoile. Ne l'utilisez qu'en dernier recours absolu."

#: lib/retro_hex_chat_web/controllers/help_content/feature_debris_field.html.heex:68
#, elixir-autogen, elixir-format
msgid "— Park behind a large asteroid and force your opponent to come to you. Patience wins in the debris field."
msgstr ""
"— Garez-vous derrière un grand astéroïde et forcez votre adversaire à venir "
"à vous. La patience gagne dans le domaine des débris."

#: lib/retro_hex_chat_web/controllers/help_content/feature_debris_field.html.heex:17
#: lib/retro_hex_chat_web/controllers/help_content/feature_gravity_well.html.heex:17
#: lib/retro_hex_chat_web/controllers/help_content/feature_star_duel.html.heex:17
#, elixir-autogen, elixir-format
msgid "— Rotate left"
msgstr "— Tourner à gauche"

#: lib/retro_hex_chat_web/controllers/help_content/feature_debris_field.html.heex:23
#: lib/retro_hex_chat_web/controllers/help_content/feature_gravity_well.html.heex:23
#: lib/retro_hex_chat_web/controllers/help_content/feature_star_duel.html.heex:23
#, elixir-autogen, elixir-format
msgid "— Rotate right"
msgstr "— Rotation à droite"

#: lib/retro_hex_chat_web/controllers/help_content/feature_pixel_tanks.html.heex:19
#, elixir-autogen, elixir-format
msgid "— Rotate tank"
msgstr "— Réservoir rotatif"

#: lib/retro_hex_chat_web/controllers/help_content/feature_debris_field.html.heex:89
#, elixir-autogen, elixir-format
msgid "— Spend the first few seconds memorizing asteroid positions. The layout stays fixed for the entire match."
msgstr ""
"- Passez les premières secondes à mémoriser les positions d'astéroïde. La "
"disposition reste fixe pour toute la correspondance."

#: lib/retro_hex_chat_web/controllers/help_content/feature_debris_field.html.heex:11
#: lib/retro_hex_chat_web/controllers/help_content/feature_gravity_well.html.heex:11
#: lib/retro_hex_chat_web/controllers/help_content/feature_star_duel.html.heex:11
#, elixir-autogen, elixir-format
msgid "— Thrust forward"
msgstr "— Pousser vers l'avant"

#: lib/retro_hex_chat_web/controllers/help_content/feature_gravity_well.html.heex:70
#, elixir-autogen, elixir-format
msgid "— Use lateral thrust to orbit the star instead of burning away from it. Orbiting conserves fuel and keeps you moving unpredictably."
msgstr ""
"— Utilisez la poussée latérale pour orbiter l'étoile au lieu de la brûler. "
"Orbiting conserve le carburant et vous permet de bouger de façon "
"imprévisible."

#: lib/retro_hex_chat_web/controllers/help_content/feature_debris_field.html.heex:82
#, elixir-autogen, elixir-format
msgid "— Use missiles to force your opponent toward asteroid clusters where they have less room to maneuver."
msgstr ""
"— Utilisez des missiles pour forcer votre adversaire vers des astéroïdes où "
"ils ont moins de marge de manoeuvre."

