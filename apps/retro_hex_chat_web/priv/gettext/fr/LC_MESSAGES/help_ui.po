#: lib/retro_hex_chat_web/controllers/help_content/keyboard_shortcuts.html.heex:14
#: lib/retro_hex_chat_web/controllers/help_content/keyboard_shortcuts.html.heex:14
#, elixir-autogen, elixir-format
msgid ""
"Enter — Send message / select autocomplete item Shift+Enter — Insert newline"
" in input Up — Edit last message (when input is empty) / command history Up "
"/ Down — Command history / navigate autocomplete dropdown Ctrl+Up — Browse "
"history (saves draft) Ctrl+Down — Browse history forward (restores draft) "
"Ctrl+R — Reverse search history Tab — Select autocomplete item / cycle nick "
"completion Escape — Cancel edit mode / dismiss autocomplete / tooltip / — "
"Open command autocomplete (at start of input) @ — Open nick autocomplete (at"
" word boundary) # — Open channel autocomplete (at word boundary)"
msgstr ""
"Entrer — Envoyer un message / sélectionner un élément autocomplet "
"Shift+Enter — Insérer une nouvelle ligne dans l'entrée En haut — Modifier le"
" dernier message (lorsque l'entrée est vide) / Historique de la commande En "
"haut / En bas — Historique de la commande / Naviguer dans le menu déroulant "
"autocomplet Ctrl+Up — Parcourir l'historique (brefs d'enregistrement) "
"Ctrl+Down — Parcourir l'historique en avant (restauration de l'ébauche) "
"Ctrl+R — Historique de la recherche inversée Tab — Sélectionnez l'élément "
"autocomplete / cycle nick completing Escape — Annuler le mode d'édition / "
"rejeter autocomplete / tooltip / — Ouvrir la commande autocomplete (au début"
" de l'entrée) @ — Ouvrir nick autocomplete (à la limite du mot) # — Ouvrir "
"le canal autocomplete (à la limite du mot)"

