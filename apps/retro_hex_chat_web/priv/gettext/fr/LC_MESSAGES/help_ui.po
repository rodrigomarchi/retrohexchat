#: lib/retro_hex_chat_web/controllers/help_content/ui_start_menu.html.heex:25
#: lib/retro_hex_chat_web/controllers/help_content/ui_start_menu.html.heex:25
#, elixir-autogen, elixir-format
msgid ""
"— Address Book, Notify List, Ignore List, Highlight Words, User Lookup, URL "
"Catcher, Channel List and Channel Central."
msgstr ""
"— carnet d'adresses, liste d'alerte, liste d'exclusion, mots en évidence, "
"recherche utilisateur, captureur d'URL, liste de canaux et central de "
"canaux."

#: lib/retro_hex_chat_web/controllers/help_content/ui_start_menu.html.heex:43
#: lib/retro_hex_chat_web/controllers/help_content/ui_start_menu.html.heex:43
#, elixir-autogen, elixir-format
msgid ""
"— Audio and video calls, sending a file, playing a game, connection stats "
"and ending the session. Live only while you have a peer session."
msgstr ""
"— Appels audio et vidéo, envoi d'un fichier, jeu, statistiques de connexion "
"et fin de session. Ne vivez que pendant que vous avez une session de pairs."

#: lib/retro_hex_chat_web/controllers/help_content/ui_start_menu.html.heex:73
#: lib/retro_hex_chat_web/controllers/help_content/ui_start_menu.html.heex:73
