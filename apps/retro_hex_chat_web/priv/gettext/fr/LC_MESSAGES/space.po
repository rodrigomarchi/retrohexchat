msgstr "ESPACE TERMINÉ — %{status}"

#: lib/retro_hex_chat_web/live/app/space_live.ex:70
#, elixir-autogen, elixir-format
msgid "SPACE FULL"
msgstr "ESPACE COMPLET"

#: lib/retro_hex_chat_web/live/app/space_live.ex:59
#, elixir-autogen, elixir-format
msgid "SPACE NOT FOUND"
msgstr "ESPACE INTROUVABLE"

#: lib/retro_hex_chat_web/live/app/space_live.ex:71
#, elixir-autogen, elixir-format
msgid "This virtual space is at capacity. Try again later."
msgstr "Cet espace virtuel est complet. Réessayez plus tard."

#: lib/retro_hex_chat_web/live/app/space_live.ex:67
#, elixir-autogen, elixir-format
msgid "This virtual space is no longer active."
msgstr "Cet espace virtuel n'est plus actif."

#: lib/retro_hex_chat_web/live/app/space_live.ex:60
#, elixir-autogen, elixir-format
msgid "This virtual space link is invalid or was removed."
msgstr "Ce lien d'espace virtuel est invalide ou a été supprimé."

#: lib/retro_hex_chat_web/live/app/space_live.ex:163 lib/retro_hex_chat_web/live/app/space_live.ex:167 lib/retro_hex_chat_web/live/app/space_live.ex:187
#, elixir-autogen, elixir-format
msgid "Virtual space"
msgstr "Espace virtuel"

#: lib/retro_hex_chat_web/live/app/space_live.ex:75
#, elixir-autogen, elixir-format
msgid "You do not have access to this virtual space. You must be registered, identified and allowed into its channel."
msgstr "Vous n'avez pas accès à cet espace virtuel. Il faut être enregistré, identifié et autorisé dans son canal."

#: lib/retro_hex_chat_web/live/app/space_live.ex:116
#, elixir-autogen, elixir-format
msgid "Arrows/WASD to move · E to use · F to sit · Esc to close"
msgstr "Flèches/WASD pour se déplacer · E pour utiliser · F pour s'asseoir · Échap pour fermer"

#: lib/retro_hex_chat_web/live/app/space_live.ex:111
#, elixir-autogen, elixir-format
msgid "Say something… (Enter to send)"
msgstr "Dites quelque chose… (Entrée pour envoyer)"

