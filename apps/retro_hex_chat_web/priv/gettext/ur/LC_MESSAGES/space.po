#: lib/retro_hex_chat_web/live/app/space_live.ex:74
#, elixir-autogen, elixir-format
msgid "ACCESS DENIED"
msgstr "رسائی مسترد"

#: lib/retro_hex_chat_web/live/app/space_live.ex:116
#, elixir-autogen, elixir-format
msgid "Back to chat"
msgstr "چیٹ پر واپس جائیں"

#: lib/retro_hex_chat_web/live/app/space_live.ex:65
#, elixir-autogen, elixir-format
msgid "SPACE ENDED — %{status}"
msgstr "اسپیس ختم — %{status}"

#: lib/retro_hex_chat_web/live/app/space_live.ex:70
#, elixir-autogen, elixir-format
msgid "SPACE FULL"
msgstr "اسپیس بھری ہوئی ہے"

#: lib/retro_hex_chat_web/live/app/space_live.ex:59
#, elixir-autogen, elixir-format
msgid "SPACE NOT FOUND"
msgstr "اسپیس نہیں ملی"

#: lib/retro_hex_chat_web/live/app/space_live.ex:71
#, elixir-autogen, elixir-format
msgid "This virtual space is at capacity. Try again later."
msgstr "یہ ورچوئل اسپیس بھری ہوئی ہے۔ بعد میں دوبارہ کوشش کریں۔"

#: lib/retro_hex_chat_web/live/app/space_live.ex:67
#, elixir-autogen, elixir-format
msgid "This virtual space is no longer active."
msgstr "یہ ورچوئل اسپیس اب فعال نہیں ہے۔"

#: lib/retro_hex_chat_web/live/app/space_live.ex:60
#, elixir-autogen, elixir-format
msgid "This virtual space link is invalid or was removed."
msgstr "یہ ورچوئل اسپیس لنک غلط ہے یا ہٹا دیا گیا ہے۔"

#: lib/retro_hex_chat_web/live/app/space_live.ex:142 lib/retro_hex_chat_web/live/app/space_live.ex:146 lib/retro_hex_chat_web/live/app/space_live.ex:166
#, elixir-autogen, elixir-format
msgid "Virtual space"
msgstr "ورچوئل اسپیس"

#: lib/retro_hex_chat_web/live/app/space_live.ex:75
#, elixir-autogen, elixir-format
msgid "You do not have access to this virtual space. You must be registered, identified and allowed into its channel."
msgstr "آپ کو اس ورچوئل اسپیس تک رسائی نہیں۔ آپ کا رجسٹرڈ، شناخت شدہ اور اس کے چینل میں اجازت یافتہ ہونا ضروری ہے۔"
