#: lib/retro_hex_chat_web/controllers/help_content/feature_file_transfer.html.heex:24
#, elixir-autogen, elixir-format
msgid "The progress bar shows: percentage, speed, and estimated time. You can cancel at any time."
msgstr "Pasek postępu pokazuje: procent, prędkość i szacowany czas. Możesz odwołać w każdej chwili."

#: lib/retro_hex_chat_web/controllers/help_content/feature_video_call.html.heex:16
#, elixir-autogen, elixir-format
msgid "The remote video occupies the main area. Your local video appears in the bottom-right corner."
msgstr "Zdalne wideo zajmuje główny obszar. Twoje lokalne wideo pojawia się w prawym dolnym rogu."

#: lib/retro_hex_chat_web/controllers/help_content/feature_audio_call.html.heex:29
#, elixir-autogen, elixir-format
msgid "The timer shows the call duration. The quality indicator shows 4 levels: Excellent, Good, Fair, Poor."
msgstr "Zegar pokazuje czas trwania rozmowy. Wskaźnik jakości pokazuje 4 poziomy: Excellent, Good, Fair, Poor."

