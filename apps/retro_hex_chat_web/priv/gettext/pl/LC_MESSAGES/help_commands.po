msgid "/pin <message id>"
msgstr "/pin <id wiadomości>"

#: lib/retro_hex_chat_web/controllers/help_content/cmd_unpin.html.heex:64
#, elixir-autogen, elixir-format
msgid "/unpin 1284"
msgstr "/unpin 1284"

#: lib/retro_hex_chat_web/controllers/help_content/cmd_unpin.html.heex:12
#, elixir-autogen, elixir-format
msgid "/unpin <message id>"
msgstr "/unpin <id wiadomości>"

#: lib/retro_hex_chat_web/controllers/help_content/cmd_pin.html.heex:30
#, elixir-autogen, elixir-format
msgid "A channel keeps up to 50 messages, newest first"
msgstr "Kanał zachowuje do 50 wiadomości, od najnowszych"

#: lib/retro_hex_chat_web/controllers/help_content/cmd_pin.html.heex:33
#, elixir-autogen, elixir-format
msgid "A message can only be pinned by the channel it was said in"
msgstr "Wiadomość może przypiąć tylko kanał, na którym ją napisano"

#: lib/retro_hex_chat_web/controllers/help_content/cmd_pin.html.heex:35
#, elixir-autogen, elixir-format
msgid "Deleting the message removes the pin with it"
msgstr "Usunięcie wiadomości usuwa wraz z nią przypięcie"

#: lib/retro_hex_chat_web/controllers/help_content/cmd_pin.html.heex:16
#, elixir-autogen, elixir-format
msgid "Easier than the id: right-click the message and choose Pin. The command exists for when you already have the id in front of you. Either way the channel checks again when the pin arrives, and a Pinned button appears in the conversation toolbar as soon as there is something to show."
msgstr "Prościej niż przez id: kliknij wiadomość prawym przyciskiem i wybierz Przypnij. Polecenie służy do sytuacji, gdy id masz już przed sobą. Tak czy inaczej kanał sprawdza ponownie, gdy przypięcie dociera, a na pasku rozmowy pojawia się przycisk Przypięte, gdy tylko jest co pokazać."

#: lib/retro_hex_chat_web/controllers/help_content/cmd_pin.html.heex:42
#: lib/retro_hex_chat_web/controllers/help_content/cmd_unpin.html.heex:68
#, elixir-autogen, elixir-format
msgid "Pinned Window"
msgstr "Okno przypiętych"

#: lib/retro_hex_chat_web/controllers/help_content/cmd_pin.html.heex:31
#, elixir-autogen, elixir-format
msgid "Pinning the same message twice is the same pin"
msgstr "Przypięcie tej samej wiadomości dwa razy to to samo przypięcie"

#: lib/retro_hex_chat_web/controllers/help_content/cmd_pin.html.heex:12
#, elixir-autogen, elixir-format
msgid "— The number of a message said in this channel."
msgstr "— Numer wiadomości napisanej na tym kanale."

#: lib/retro_hex_chat_web/controllers/help_content/cmd_unpin.html.heex:16
#, elixir-autogen, elixir-format
