#: lib/retro_hex_chat_web/controllers/help_content/cmd_event.html.heex:53
#, elixir-autogen, elixir-format
msgid "/event 3d Film night in the space"
msgstr "/event 3d Film night in the space"

#: lib/retro_hex_chat_web/controllers/help_content/cmd_event.html.heex:8
#, elixir-autogen, elixir-format
msgid "/event [<when> <title> | cancel <id>]"
msgstr "/event [<when> <title> | cancel <id>]"

#: lib/retro_hex_chat_web/controllers/help_content/cmd_event.html.heex:54
