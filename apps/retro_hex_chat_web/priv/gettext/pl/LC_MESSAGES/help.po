#: lib/retro_hex_chat_web/components/ui/help/help_viewer.ex:153
#, elixir-autogen, elixir-format
msgid "Coming from mIRC? See which of its commands work the same here"
msgstr "Z mIRC? Zobacz, które z jego poleceń działa tak samo tutaj"

#: lib/retro_hex_chat_web/controllers/help_content/welcome.html.heex:106
#, elixir-autogen, elixir-format
