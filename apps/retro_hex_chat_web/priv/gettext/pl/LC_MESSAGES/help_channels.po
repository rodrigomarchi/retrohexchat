msgid "(registered-only) — Only registered and identified users can join."
msgstr "(tylko zarejestrowani) — Dołączyć mogą tylko zarejestrowani i zidentyfikowani użytkownicy."

#: lib/retro_hex_chat_web/controllers/help_content/channel_permissions.html.heex:178
