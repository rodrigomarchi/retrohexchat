#: lib/retro_hex_chat_web/controllers/help_content/feature_arcade_librequake.html.heex:38
#: lib/retro_hex_chat_web/controllers/help_content/feature_arcade_quake2_shareware.html.heex:38
#: lib/retro_hex_chat_web/controllers/help_content/feature_arcade_quake_shareware.html.heex:38
#, elixir-autogen, elixir-format
msgid "— Fire weapon"
msgstr "— Strzał z broni"

#: lib/retro_hex_chat_web/controllers/help_content/feature_arcade_halflife_uplink.html.heex:57
#, elixir-autogen, elixir-format
msgid "— Flashlight"
msgstr "- Latarka"

#: lib/retro_hex_chat_web/controllers/help_content/feature_arcade_freedm.html.heex:83
#, elixir-autogen, elixir-format
msgid "— Great for learning weapon behavior and movement techniques before tackling Phase 1 or Phase 2."
msgstr "— Świetne do nauki zachowania broni i technik poruszania się przed przejściem do Fazy 1 lub Fazy 2."

#: lib/retro_hex_chat_web/controllers/help_content/feature_arcade_halflife_uplink.html.heex:77
#, elixir-autogen, elixir-format
msgid "— Headcrabs are weak to melee. Save bullets for tougher enemies."
msgstr "— Headcrabs są wrażliwe na walkę w zwarciu. Oszczędzaj kule na silniejszych wrogów."

#: lib/retro_hex_chat_web/controllers/help_content/feature_arcade_scummvm_drascula.html.heex:64
#, elixir-autogen, elixir-format
msgid "— Heavy on pop culture references, horror movie parodies, and Spanish comedy."
msgstr "— Mnóstwo odniesień do popkultury, parodii horrorów i hiszpańskiego humoru."

#: lib/retro_hex_chat_web/controllers/help_content/feature_arcade_chex_quest.html.heex:64
#, elixir-autogen, elixir-format
msgid "— Hidden areas contain extra Zorcher energy. Check suspicious walls."
msgstr ""
"- Ukryte obszary zawierają dodatkową energię Zorchera. Sprawdź podejrzane "
"ściany."

#: lib/retro_hex_chat_web/controllers/help_content/feature_arcade_halflife.html.heex:61
#, elixir-autogen, elixir-format
msgid "— Hold crouch while jumping to reach higher ledges. Essential for navigation in Uplink."
msgstr "— Przytrzymaj kucanie podczas skoku, aby dosięgnąć wyższych półek. Niezbędne do poruszania się po Uplinku."

#: lib/retro_hex_chat_web/controllers/help_content/feature_arcade_halflife_uplink.html.heex:81
#, elixir-autogen, elixir-format
msgid "— Hold crouch while jumping to reach higher ledges. Essential for navigation."
msgstr "— Przytrzymaj kucanie podczas skoku, aby dosięgnąć wyższych półek. Niezbędne do poruszania się po mapie."

#: lib/retro_hex_chat_web/controllers/help_content/feature_arcade_scummvm_fotaq.html.heex:78
#, elixir-autogen, elixir-format
msgid "— If you enjoy Monkey Island or Day of the Tentacle, you'll love this."
msgstr "— Jeśli lubisz Monkey Island albo Day of the Tentacle, ta gra przypadnie ci do gustu."

#: lib/retro_hex_chat_web/controllers/help_content/feature_arcade_scummvm.html.heex:136
#, elixir-autogen, elixir-format
msgid "— If you're stuck, try combining items in your inventory. The solution is often creative."
msgstr "— Jeśli utkniesz, spróbuj łączyć przedmioty w ekwipunku. Rozwiązanie bywa kreatywne."

#: lib/retro_hex_chat_web/controllers/help_content/feature_arcade_halflife_uplink.html.heex:49
#: lib/retro_hex_chat_web/controllers/help_content/feature_arcade_librequake.html.heex:43
#: lib/retro_hex_chat_web/controllers/help_content/feature_arcade_quake2_shareware.html.heex:49
#: lib/retro_hex_chat_web/controllers/help_content/feature_arcade_quake_shareware.html.heex:43
#, elixir-autogen, elixir-format
msgid "— Interact"
msgstr "— Użyj"

#: lib/retro_hex_chat_web/controllers/help_content/feature_arcade_scummvm.html.heex:76
#, elixir-autogen, elixir-format
msgid "— Interact / walk"
msgstr "— Interakcja / chodzenie"

#: lib/retro_hex_chat_web/controllers/help_content/feature_arcade_quake2_shareware.html.heex:55
#, elixir-autogen, elixir-format
msgid "— Inventory"
msgstr "— Ekwipunek"

#: lib/retro_hex_chat_web/controllers/help_content/feature_arcade_scummvm_drascula.html.heex:71
#, elixir-autogen, elixir-format
msgid "— Item descriptions are often funny and sometimes contain puzzle hints."
msgstr "— Opisy przedmiotów bywają zabawne, a czasem zawierają wskazówki do łamigłówek."

