#: lib/retro_hex_chat_web/controllers/help_content/feature_user_lookup.html.heex:25
#, elixir-autogen, elixir-format
msgid ""
"Nickname context menus include Whois and Last Seen (Whowas). Whois cards "
"include buttons for Whowas and Query (PM). Last Seen cards include a Whois "
"button when the user is currently online."
msgstr ""
"Menu kontekstowe nickname obejmują Whois i Last Seen (Whowas). Karty Whois "
"zawierają przyciski dla Whowas i Query (PM). Karty Last Seen zawierają "
"przycisk Whois, kiedy użytkownik jest aktualnie online."

#: lib/retro_hex_chat_web/controllers/help_content/feature_notify_list.html.heex:11
#, elixir-autogen, elixir-format
msgid "Open it from View > Notify List, the Options dropdown, or by typing"
msgstr "Otwórz z widoku > Lista powiadomień, Opcje rozwijane lub wpisując"

#: lib/retro_hex_chat_web/controllers/help_content/feature_highlight_words.html.heex:16
