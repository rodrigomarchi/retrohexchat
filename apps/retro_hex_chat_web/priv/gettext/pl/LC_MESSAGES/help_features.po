#, elixir-autogen, elixir-format
msgid "More Keys in the Input"
msgstr "Więcej kluczy w wejściu"

#: lib/retro_hex_chat_web/controllers/help_content/feature_display_settings.html.heex:38
#, elixir-autogen, elixir-format
msgid "More Options in the View Menu"
msgstr "Więcej opcji w menu widoku"

#: lib/retro_hex_chat_web/controllers/help_content/feature_char_counter.html.heex:57
#, elixir-autogen, elixir-format
msgid "Multi-Line Paste Dialog"
msgstr "Okno wklej wieloliniowe"

#: lib/retro_hex_chat_web/controllers/help_content/feature_mute.html.heex:33
#, elixir-autogen, elixir-format
msgid "Mute silences every sound the chat plays, such as the sounds for new messages, private messages, joins and kicks."
msgstr "Mute milczy każdy dźwięk, który gra czat, takie jak dźwięki na nowe wiadomości, prywatne wiadomości, przyłącza się i kopie."

#: lib/retro_hex_chat_web/controllers/help_content/feature_key_bindings.html.heex:101
#, elixir-autogen, elixir-format
msgid "No function key is bound. The browser keeps them, including the key that opens the browser help."
msgstr "Brak klucza funkcyjnego. Przeglądarka je przechowuje, w tym klucz, który otwiera pomoc przeglądarki."

#: lib/retro_hex_chat_web/controllers/help_content/feature_lag_indicator.html.heex:9
#, elixir-autogen, elixir-format
msgid "Normal:"
msgstr "Normalne:"

#: lib/retro_hex_chat_web/controllers/help_content/feature_mute.html.heex:52
#, elixir-autogen, elixir-format
msgid "Not the Same as /mute"
msgstr "Nie to samo co /mute"

#: lib/retro_hex_chat_web/controllers/help_content/feature_smart_input.html.heex:110
#, elixir-autogen, elixir-format
msgid "On a narrow screen such as a phone, the input grows up to 3 lines instead of 5. A message can be edited only within 5 minutes after you send it."
msgstr "Na wąskim ekranie, takim jak telefon, wejście rośnie do 3 linii zamiast 5. Wiadomość może być edytowana tylko w ciągu 5 minut od wysłania."

#: lib/retro_hex_chat_web/controllers/help_content/feature_lag_indicator.html.heex:74
#, elixir-autogen, elixir-format
msgid "On narrow screens such as phones, the reading is hidden to keep the taskbar short. Measuring continues while the page is open, and stops while the connection is down."
msgstr "Na wąskich ekranach, takich jak telefony, czytanie jest ukryte, aby utrzymać pasek zadań krótki. Pomiar trwa, gdy strona jest otwarta, i zatrzymuje się, gdy połączenie jest w dół."

#: lib/retro_hex_chat_web/controllers/help_content/feature_away_reply.html.heex:75
#, elixir-autogen, elixir-format
msgid "Only private messages trigger the reply. Channel messages and mentions do not. Setting a new away message also starts a new round, so each sender gets the new text once."
msgstr "Only private messages trigger the reply. Channel messages and mentions do not. Setting a new away message also starts a new round, so each sender gets the new text once."

#: lib/retro_hex_chat_web/controllers/help_content/feature_quit_message.html.heex:63
#, elixir-autogen, elixir-format
msgid "Only the first %{count} characters of the message are shown to others."
msgstr "Tylko pierwsze znaki %{count} wiadomości są pokazywane innym."

#: lib/retro_hex_chat_web/controllers/help_content/feature_key_bindings.html.heex:39
#, elixir-autogen, elixir-format
msgid "Open or close the address book."
msgstr "Otwórz lub zamknij książkę adresową."

#: lib/retro_hex_chat_web/controllers/help_content/feature_away_reply.html.heex:31
#, elixir-autogen, elixir-format
msgid "Open the File menu and choose Set Away..."
msgstr "Otwórz menu Plik i wybierz Set Away..."

#: lib/retro_hex_chat_web/controllers/help_content/feature_cheatsheet.html.heex:44
#, elixir-autogen, elixir-format
msgid "Open the Help menu and choose Shortcut Cheatsheet."
msgstr "Otwórz menu Pomoc i wybierz skrót Cheatsheet."

#: lib/retro_hex_chat_web/controllers/help_content/feature_server_broadcasts.html.heex:27
#, elixir-autogen, elixir-format
msgid "Open the Start menu, then Admin, then Broadcast. The Admin group appears only for server operators and administrators."
msgstr "Otwórz menu Start, admin, Broadcast. Grupa Admin pojawia się tylko dla operatorów serwerów i administratorów."

#: lib/retro_hex_chat_web/controllers/help_content/feature_admin_turn.html.heex:30
#, elixir-autogen, elixir-format
msgid "Open the Start menu, then Admin, then TURN."
msgstr "Otwórz menu Start, następnie Admin, a następnie TURN."

#: lib/retro_hex_chat_web/controllers/help_content/feature_cheatsheet.html.heex:46
#, elixir-autogen, elixir-format
msgid "Open the Start menu, then Help, then Shortcut Cheatsheet."
msgstr "Otwórz menu Start, a następnie Pomoc, a następnie Shortcut Cheatsheet."

#: lib/retro_hex_chat_web/controllers/help_content/feature_key_bindings.html.heex:51
#, elixir-autogen, elixir-format
msgid "Open the URL catcher."
msgstr "Otwórz łapacz URL."

#: lib/retro_hex_chat_web/controllers/help_content/feature_display_settings.html.heex:23
#, elixir-autogen, elixir-format
msgid "Open the View menu in the chat window."
msgstr "Otwórz menu Widok w oknie czatu."

#: lib/retro_hex_chat_web/controllers/help_content/feature_key_bindings.html.heex:55
#, elixir-autogen, elixir-format
msgid "Open the auto-perform settings."
msgstr "Otwórz ustawienia autowykonania."

#: lib/retro_hex_chat_web/controllers/help_content/feature_key_bindings.html.heex:47
#, elixir-autogen, elixir-format
msgid "Open the highlight word settings."
msgstr "Otwórz ustawienia słowa podświetlania."

#: lib/retro_hex_chat_web/controllers/help_content/feature_key_bindings.html.heex:43
#, elixir-autogen, elixir-format
msgid "Open the ignore list."
msgstr "Otwórz listę ignorowanych."

#: lib/retro_hex_chat_web/controllers/help_content/feature_key_bindings.html.heex:35
#, elixir-autogen, elixir-format
msgid "Open the search bar."
msgstr "Otwórz pasek wyszukiwania."

#: lib/retro_hex_chat_web/controllers/help_content/feature_quit_message.html.heex:31
#, elixir-autogen, elixir-format
msgid "Other Ways to Leave"
msgstr "Inne sposoby opuszczenia"

#: lib/retro_hex_chat_web/controllers/help_content/feature_cheatsheet.html.heex:42
#, elixir-autogen, elixir-format
msgid "Other Ways to Open It"
msgstr "Inne sposoby otwarcia"

#: lib/retro_hex_chat_web/controllers/help_content/feature_emoji.html.heex:46
#, elixir-autogen, elixir-format
msgid "Pick a category tab, or type at least two letters in the Search emoji box."
msgstr "Wybierz kartę kategorii lub wpisz co najmniej dwie litery w polu Szukaj emoji."

#: lib/retro_hex_chat_web/controllers/help_content/feature_emoji.html.heex:52
#, elixir-autogen, elixir-format
msgid "Point at an emoji to preview it in the bar at the bottom of the picker."
msgstr "Point at an emoji to preview it in the bar at the bottom of the picker."

#: lib/retro_hex_chat_web/controllers/help_content/feature_key_bindings.html.heex:78
#, elixir-autogen, elixir-format
msgid "Press %{key} to close the topmost dialog or menu. In the chat input, the arrow keys, %{tab} and %{enter} have their own jobs. The Smart Input topic explains them."
msgstr "Naciśnij %{key}, aby zamknąć okno dialogowe lub menu. W wejściu czatu, klawisze strzałek, %{tab} i %{enter} mają swoje własne zadania. Temat inteligentnego wejścia wyjaśnia je."

#: lib/retro_hex_chat_web/controllers/help_content/feature_emoji.html.heex:59
#, elixir-autogen, elixir-format
msgid "Press %{key} to send the message as usual."
msgstr "Naciśnij %{key}, aby wysłać wiadomość jak zwykle."

#: lib/retro_hex_chat_web/controllers/help_content/feature_emoji.html.heex:77
#, elixir-autogen, elixir-format
msgid "Reacting With an Emoji"
msgstr "Reagując z Emoji"

#: lib/retro_hex_chat_web/controllers/help_content/feature_emoji.html.heex:87
#, elixir-autogen, elixir-format
msgid "Reacting to a Message"
msgstr "Odpowiadając na wiadomość"

#: lib/retro_hex_chat_web/controllers/help_content/feature_smart_input.html.heex:106
#, elixir-autogen, elixir-format
msgid "Reset formatting"
msgstr "Przywróć formatowanie"

#: lib/retro_hex_chat_web/controllers/help_content/feature_smart_input.html.heex:105
#, elixir-autogen, elixir-format
msgid "Reverse"
msgstr "Cofnij"

#: lib/retro_hex_chat_web/controllers/help_content/feature_lag_indicator.html.heex:46
#, elixir-autogen, elixir-format
msgid "Right after you connect it shows a dash, because the first measurement is taken after the first 30 seconds. A question mark means the last ping got no answer."
msgstr "Zaraz po podłączeniu wyświetla się myślnik, ponieważ pierwszy pomiar jest wykonywany po pierwszych 30 sekundach. Znak zapytania oznacza, że ostatni ping nie ma odpowiedzi."

#: lib/retro_hex_chat_web/controllers/help_content/feature_copy.html.heex:43
#, elixir-autogen, elixir-format
msgid "Right-click a message, or press and hold it on a touch screen, to open its context menu. You do not need to select anything first."
msgstr "Right- click wiadomość, lub naciśnij i przytrzymaj na ekranie dotykowym, aby otworzyć menu kontekstowe. Nie musisz niczego najpierw wybierać."

#: lib/retro_hex_chat_web/controllers/help_content/feature_copy.html.heex:64
#, elixir-autogen, elixir-format
msgid "Right-click a nickname, a link or a channel name to get Copy Nick, Copy URL or Copy Channel Name."
msgstr "Kliknij prawym przydomek, link lub nazwę kanału, aby otrzymać Kopiuj Nick, Kopiuj URL lub Kopiuj nazwę kanału."

#: lib/retro_hex_chat_web/controllers/help_content/feature_away_reply.html.heex:73
#, elixir-autogen, elixir-format
msgid "Rules"
msgstr "Zasady"

#: lib/retro_hex_chat_web/controllers/help_content/feature_admin_turn.html.heex:45
#: lib/retro_hex_chat_web/controllers/help_content/feature_key_bindings.html.heex:86
#: lib/retro_hex_chat_web/controllers/help_content/feature_paste_dialog.html.heex:67
#: lib/retro_hex_chat_web/controllers/help_content/feature_quit_message.html.heex:60
#: lib/retro_hex_chat_web/controllers/help_content/feature_server_broadcasts.html.heex:74
#: lib/retro_hex_chat_web/controllers/help_content/feature_typing_indicator.html.heex:61
#, elixir-autogen, elixir-format
msgid "Rules and Limits"
msgstr "Zasady i ograniczenia"

#: lib/retro_hex_chat_web/controllers/help_content/feature_emoji.html.heex:62
#, elixir-autogen, elixir-format
msgid "Search Tips"
msgstr "Porady wyszukiwania"

#: lib/retro_hex_chat_web/controllers/help_content/feature_emoji.html.heex:64
#, elixir-autogen, elixir-format
msgid "Search looks at each emoji's name and keywords, in English and in your chosen language. While a search is active, the results replace the category grid. Clear the box or pick a category tab to go back."
msgstr "Szukaj patrzy na imię i słowa kluczowe każdej emoji, w języku angielskim i w wybranym języku. Podczas aktywnego wyszukiwania wyniki zastępują siatkę kategorii. Wyczyść pole lub wybierz kartę kategorii, aby wrócić."

#: lib/retro_hex_chat_web/controllers/help_content/feature_smart_input.html.heex:71
#, elixir-autogen, elixir-format
msgid "Search your input history."
msgstr "Przeszukaj historię danych wejściowych."

#: lib/retro_hex_chat_web/controllers/help_content/feature_copy.html.heex:2
#, elixir-autogen, elixir-format
msgid "Select text in the chat area by clicking and dragging. Then choose Copy in the Edit menu, or use your browser's copy shortcut, such as %{keys}."
msgstr "Wybierz tekst w obszarze czatu klikając i przeciągając. Następnie wybierz Kopiuj w menu Edycja lub użyj skrótu kopiującego przeglądarki, np. %{keys}."

#: lib/retro_hex_chat_web/controllers/help_content/feature_server_broadcasts.html.heex:24
#, elixir-autogen, elixir-format
msgid "Sending a Broadcast"
msgstr "Wysyłanie transmisji"

#: lib/retro_hex_chat_web/controllers/help_content/feature_typing_indicator.html.heex:49
#, elixir-autogen, elixir-format
msgid "Sending the message also clears the indicator at once."
msgstr "Wysyłanie wiadomości również oczyszcza wskaźnik na raz."

#: lib/retro_hex_chat_web/controllers/help_content/feature_server_broadcasts.html.heex:2
#, elixir-autogen, elixir-format
msgid "Server Broadcasts covers operator wallops and administrator announcements. They are sent from the Broadcast window or with slash commands."
msgstr "Serwer Broadcasts obejmuje operatorów wallopów i ogłoszeń administratora. Są one wysyłane z okna Broadcast lub z komendami slash."

#: lib/retro_hex_chat_web/controllers/help_content/feature_emoji.html.heex:91
#, elixir-autogen, elixir-format
msgid "Server Emoji"
msgstr "Serwer Emoji"

#: lib/retro_hex_chat_web/controllers/help_content/feature_display_settings.html.heex:43
#, elixir-autogen, elixir-format
msgid "Shows messages without their colors, bold and other formatting codes."
msgstr "Pokazuje wiadomości bez ich kolorów, śmiałe i inne kody formatowania."

#: lib/retro_hex_chat_web/controllers/help_content/feature_display_settings.html.heex:50
#, elixir-autogen, elixir-format
msgid "Shows or hides the chosen character picture beside each nickname."
msgstr "Pokazuje lub ukrywa obrazek wybranego znaku obok każdej ksywki."

#: lib/retro_hex_chat_web/controllers/help_content/feature_emoji.html.heex:37
#, elixir-autogen, elixir-format
msgid "Step by Step"
msgstr "Krok po kroku"

#: lib/retro_hex_chat_web/controllers/help_content/feature_display_settings.html.heex:42
#, elixir-autogen, elixir-format
msgid "Strip Formatting:"
msgstr "Formatowanie taśmy:"

#: lib/retro_hex_chat_web/controllers/help_content/feature_key_bindings.html.heex:63
#, elixir-autogen, elixir-format
msgid "Switch to the channel or PM at that position."
msgstr "Przełącz na kanał lub PM w tej pozycji."

#: lib/retro_hex_chat_web/controllers/help_content/feature_key_bindings.html.heex:59
#, elixir-autogen, elixir-format
msgid "Switch to the next or previous channel or PM."
msgstr "Przełącz na następny lub poprzedni kanał lub PM."

#: lib/retro_hex_chat_web/controllers/help_content/feature_typing_indicator.html.heex:55
#, elixir-autogen, elixir-format
msgid "Text that starts with a slash is a command, so it does not count as typing."
msgstr "Tekst zaczynający się ukośnikiem jest poleceniem, więc nie liczy się jako wpisanie."

#: lib/retro_hex_chat_web/controllers/help_content/feature_admin_turn.html.heex:38
#, elixir-autogen, elixir-format
msgid "The Allocations pane lists each active allocation: the client address and the relay port it holds."
msgstr "Panel Allokations zawiera listę każdej aktywnej alokacji: adres klienta i port przekaźnika, który posiada."

#: lib/retro_hex_chat_web/controllers/help_content/feature_copy.html.heex:28
#, elixir-autogen, elixir-format
msgid "The Edit menu of the chat window has a Copy item. The View group of the Start menu has the same item. Both copy the text you selected in the message area."
msgstr "Menu Edycja okna czatu posiada element Kopiuj. Grupa Widok menu Start ma ten sam element. Obie kopie tekstu wybranego w obszarze wiadomości."

#: lib/retro_hex_chat_web/controllers/help_content/feature_paste_dialog.html.heex:33
#, elixir-autogen, elixir-format
msgid "The Paste Confirmation dialog shows how many lines will be sent."
msgstr "Okno Potwierdzenia Wklej pokazuje ile linii zostanie wysłanych."

#: lib/retro_hex_chat_web/controllers/help_content/feature_char_counter.html.heex:39
#, elixir-autogen, elixir-format
msgid "The Send button stays disabled while the input is empty, unless a file is attached."
msgstr "Przycisk Wyślij pozostaje wyłączony, gdy wejście jest puste, chyba że plik jest dołączony."

#: lib/retro_hex_chat_web/controllers/help_content/feature_admin_turn.html.heex:32
#, elixir-autogen, elixir-format
msgid "The Stats pane shows the relay address, the listen port, the number of listeners, the active allocations and how many relay ports are in use."
msgstr "Tafla Stan pokazuje adres przekaźnika, port słuchania, liczbę słuchaczy, aktywne przydziały i ile portów przekaźników jest w użyciu."

#: lib/retro_hex_chat_web/controllers/help_content/feature_paste_dialog.html.heex:83
#, elixir-autogen, elixir-format
msgid "The Status window does not accept text. Pasted lines sent there are rejected."
msgstr "Okno Status nie akceptuje tekstu. Przesłane tam linie są odrzucane."

#: lib/retro_hex_chat_web/controllers/help_content/feature_cheatsheet.html.heex:75
#, elixir-autogen, elixir-format
msgid "The arrow keys browse what you sent before. The Smart Input topic covers them."
msgstr "Klucze strzałek przeglądają to, co wysłałeś wcześniej. Temat inteligentnego wejścia obejmuje je."

#: lib/retro_hex_chat_web/controllers/help_content/feature_kick_notifications.html.heex:33
#, elixir-autogen, elixir-format
msgid "The channel tab closes, and you stop receiving its messages."
msgstr "Karta kanału zamyka się i przestajesz odbierać wiadomości."

#: lib/retro_hex_chat_web/controllers/help_content/feature_away_reply.html.heex:55
#, elixir-autogen, elixir-format
msgid "The chat confirms that you are now away, and later that you are no longer away."
msgstr "Czat potwierdza, że jesteś teraz daleko, a później, że nie jesteś już daleko."

#: lib/retro_hex_chat_web/controllers/help_content/feature_char_counter.html.heex:47
#, elixir-autogen, elixir-format
msgid "The counter is shown on wider screens only. On a phone it is hidden to save space, but the same limit still applies. A message that contains only spaces or formatting codes is treated as empty and is not sent."
msgstr "Licznik jest wyświetlany tylko na szerszych ekranach. W telefonie jest ukryte, aby zaoszczędzić miejsce, ale ten sam limit nadal ma zastosowanie. Wiadomość zawierająca tylko spacje lub kody formatowania jest traktowana jako pusta i nie jest wysyłana."

#: lib/retro_hex_chat_web/controllers/help_content/feature_char_counter.html.heex:8
#, elixir-autogen, elixir-format
msgid "The counter tells you how much room is left before you write a long message. You can shorten your text in time, or split it into two messages, instead of finding out at the end."
msgstr "The counter tells you how much room is left before you write a long message. You can shorten your text in time, or split it into two messages, instead of finding out at the end."

#: lib/retro_hex_chat_web/controllers/help_content/feature_paste_dialog.html.heex:48
#, elixir-autogen, elixir-format
msgid "The dialog appears only when the pasted text has two or more lines with text. A single line is pasted into the input as usual."
msgstr "Okno dialogowe pojawia się tylko wtedy, gdy wklejony tekst ma dwie lub więcej linii z tekstem. Pojedyncza linia jest wklejona do wejścia jak zwykle."

#: lib/retro_hex_chat_web/controllers/help_content/feature_kick_notifications.html.heex:9
#, elixir-autogen, elixir-format
msgid "The dialog shows the channel name, who kicked you, and the reason if one was given."
msgstr "Okno dialogowe pokazuje nazwę kanału, kto cię kopnął i powód, dla którego został podany."

#: lib/retro_hex_chat_web/controllers/help_content/feature_quit_message.html.heex:25
#, elixir-autogen, elixir-format
msgid "The first example quits with the default message. The others show your own text to the people in your channels."
msgstr "Pierwszy przykład kończy się domyślną wiadomością. Inni pokazują twój własny tekst ludziom w twoich kanałach."

#: lib/retro_hex_chat_web/controllers/help_content/feature_away_reply.html.heex:47
#, elixir-autogen, elixir-format
msgid "The first line sets you away with a message. The second line, with no text, marks you as back."
msgstr "Pierwsza linia wyprowadza cię z wiadomością. Druga linia, bez tekstu, oznacza, że wracasz."

#: lib/retro_hex_chat_web/controllers/help_content/feature_key_bindings.html.heex:95
#, elixir-autogen, elixir-format
msgid "The global shortcuts avoid combinations that the browser needs, such as copy, paste and new tab."
msgstr "Globalne skróty unikają kombinacji, których potrzebuje przeglądarka, takich jak kopiowanie, wklejanie i nowa karta."

#: lib/retro_hex_chat_web/controllers/help_content/feature_typing_indicator.html.heex:63
#, elixir-autogen, elixir-format
msgid "The indicator is never stored. Only the person in the PM can see it. There is no setting to turn it off."
msgstr "Wskaźnik nigdy nie jest przechowywany. Tylko osoba z Premiera może to zobaczyć. Nie ma możliwości wyłączenia go."

#: lib/retro_hex_chat_web/controllers/help_content/feature_cheatsheet.html.heex:53
#, elixir-autogen, elixir-format
msgid "The item is grayed out until you are connected to the chat. The cheatsheet opens as a window titled Keyboard Shortcuts. You can move it, resize it, or minimize it to the taskbar while you practice."
msgstr "Element jest szary, dopóki nie jest podłączony do czatu. Zeszyt otwiera się jako okno zatytułowane Skróty klawiszowe. Możesz go przesunąć, zmienić rozmiar lub zminimalizować do paska zadań podczas treningu."

#: lib/retro_hex_chat_web/controllers/help_content/feature_kick_notifications.html.heex:45
#, elixir-autogen, elixir-format
msgid "The kick sound plays, unless you have muted sounds. You can pick a different sound for kicks in the Sounds window."
msgstr "Dźwięk kopnięcia gra, chyba że masz tłumione dźwięki. Można wybrać inny dźwięk dla kopnięć w oknie Sounds."

#: lib/retro_hex_chat_web/controllers/help_content/feature_lag_indicator.html.heex:2
#, elixir-autogen, elixir-format
msgid "The lag indicator in the taskbar tray shows the round-trip latency between your browser and the server, measured every 30 seconds."
msgstr "Wskaźnik opóźnienia w tacce paska zadań pokazuje opóźnienie pomiędzy przeglądarką a serwerem, mierzone co 30 sekund."

#: lib/retro_hex_chat_web/controllers/help_content/feature_char_counter.html.heex:16
#, elixir-autogen, elixir-format
msgid "The limit is %{max} characters per message."
msgstr "Limit to znaki %{max} na wiadomość."

#: lib/retro_hex_chat_web/controllers/help_content/feature_typing_indicator.html.heex:29
#, elixir-autogen, elixir-format
msgid "The line appears just above the chat input, in small italic text. You see it only while that PM is the conversation on screen. If you are looking at another channel or PM, it does not appear."
msgstr "Linia pojawia się tuż nad wejściem czatu, w małym tekście kursywnym. Widzisz to tylko wtedy, gdy premier jest rozmową na ekranie. Jeśli patrzysz na inny kanał lub PM, nie pojawia się."

#: lib/retro_hex_chat_web/controllers/help_content/feature_paste_dialog.html.heex:55
#, elixir-autogen, elixir-format
msgid "The lines go to the active channel or PM in their original order, with a short pause between them."
msgstr "Linie idą do aktywnego kanału lub PM w ich pierwotnej kolejności, z krótką pauzą między nimi."

#: lib/retro_hex_chat_web/controllers/help_content/feature_quit_message.html.heex:70
#, elixir-autogen, elixir-format
msgid "The message is used once. The next time you quit, you type it again or get the default."
msgstr "Wiadomość jest używana raz. Następnym razem, gdy zrezygnujesz, wpisz to jeszcze raz lub otrzymasz domyślne."

#: lib/retro_hex_chat_web/controllers/help_content/feature_mute.html.heex:18
#, elixir-autogen, elixir-format
msgid "The mute button is the speaker icon in the taskbar tray, next to the clock. Point at it to see its tooltip. It reads Mute while sounds are on and Unmute while they are off. When sounds are off, the icon changes to a muted speaker."
msgstr "Przycisk wyciszenia jest ikoną głośnika w tacce na pasku zadań, obok zegara. Wskaż na to, żeby zobaczyć jego podpowiedź. Czyta Mute, podczas gdy dźwięki są włączone i Unmute, gdy są wyłączone. Kiedy dźwięk jest wyłączony, ikona zmienia się na wyciszony głośnik."

#: lib/retro_hex_chat_web/controllers/help_content/feature_char_counter.html.heex:19
#, elixir-autogen, elixir-format
msgid "The number updates on every key press, paste or deletion. It counts every character in the input, including spaces and formatting codes."
msgstr "Liczba aktualizacji na każdym klawiszu naciśnij, wklej lub usuń. Liczy każdy znak wejścia, w tym spacje i kody formatowania."

#: lib/retro_hex_chat_web/controllers/help_content/feature_smart_input.html.heex:42
#, elixir-autogen, elixir-format
msgid "The placeholder always names the conversation your message will go to. In the Status window it reminds you that only commands work there."
msgstr "Posiadacz plakietki zawsze podaje nazwę rozmowy, do której trafi wiadomość. W oknie Status przypomina, że działają tam tylko polecenia."

#: lib/retro_hex_chat_web/controllers/help_content/feature_away_reply.html.heex:67
#, elixir-autogen, elixir-format
msgid "The reply appears in the private conversation, so the sender sees it right after their own message."
msgstr "Odpowiedź pojawia się w prywatnej rozmowie, więc nadawca widzi ją zaraz po ich własnym przesłaniu."

#: lib/retro_hex_chat_web/controllers/help_content/feature_admin_turn.html.heex:59
#, elixir-autogen, elixir-format
msgid "The same numbers are available as commands:"
msgstr "Te same liczby są dostępne jako polecenia:"

#: lib/retro_hex_chat_web/controllers/help_content/feature_emoji.html.heex:79
#, elixir-autogen, elixir-format
msgid "The same picker opens when you choose React... in a message's context menu. In that case the emoji you pick is added as a reaction to the message, not to your input."
msgstr "Ten sam picker otwiera się, gdy wybierasz React... w menu kontekstowym wiadomości. W takim przypadku emoji, które wybrałeś jest dodawany jako reakcja na wiadomość, a nie do twojego wejścia."

#: lib/retro_hex_chat_web/controllers/help_content/feature_key_bindings.html.heex:89
#, elixir-autogen, elixir-format
msgid "The shortcuts cannot be changed. Every user has the same set."
msgstr "Nie można zmienić skrótów. Każdy użytkownik ma ten sam zestaw."

#: lib/retro_hex_chat_web/controllers/help_content/feature_cheatsheet.html.heex:24
#, elixir-autogen, elixir-format
msgid "The shortcuts listed are the same for every user. The cheatsheet only shows them. It does not let you change them."
msgstr "Wymienione skróty są takie same dla każdego użytkownika. Zeszyt tylko je pokazuje. Nie pozwala ci ich zmieniać."

#: lib/retro_hex_chat_web/controllers/help_content/feature_copy_feedback.html.heex:23
#, elixir-autogen, elixir-format
msgid "The toast appears after these items in the chat context menu:"
msgstr "Toast pojawia się po tych elementach w menu kontekstowym czatu:"

#: lib/retro_hex_chat_web/controllers/help_content/feature_copy_feedback.html.heex:44
#, elixir-autogen, elixir-format
msgid "The toast is a small window titled Info with an OK button. Click OK to close it at once."
msgstr "Toast jest małym oknem zatytułowanym Info z przyciskiem OK. Kliknij OK, aby go natychmiast zamknąć."

#: lib/retro_hex_chat_web/controllers/help_content/feature_lag_indicator.html.heex:66
#, elixir-autogen, elixir-format
msgid "The value measures your link to the server only. It does not measure a call between two people."
msgstr "Wartość mierzy tylko link do serwera. Nie mierzy połączenia pomiędzy dwoma osobami."

#: lib/retro_hex_chat_web/controllers/help_content/feature_kick_notifications.html.heex:25
#, elixir-autogen, elixir-format
msgid "The window is titled Kicked from Channel. It names the channel, then lists By, with the operator's nickname, and Reason, when one was given. A note at the bottom says that the channel tab was closed."
msgstr "Okno jest zatytułowane Kopiowane z kanału. Wymienia kanał, a następnie wymienia przez operatora pseudonim i Powód, kiedy został podany. Notatka na dole mówi, że zakładka kanału była zamknięta."

#: lib/retro_hex_chat_web/controllers/help_content/feature_admin_turn.html.heex:48
#, elixir-autogen, elixir-format
msgid "The window opens with a snapshot taken when it opened. Only server administrators can press Refresh."
msgstr "Okno otwiera się z migawką zrobioną po jego otwarciu. Tylko administratorzy serwerów mogą nacisnąć Refresh."

#: lib/retro_hex_chat_web/controllers/help_content/feature_smart_input.html.heex:95
#, elixir-autogen, elixir-format
msgid "These keys insert an IRC formatting code at the cursor. Type your text after the code."
msgstr "Klucze te wstawiają kod formatujący IRC na kursor. Wpisz tekst po kodzie."

#: lib/retro_hex_chat_web/controllers/help_content/feature_copy.html.heex:71
#, elixir-autogen, elixir-format
msgid "These menu items show a short Copied! confirmation when they finish."
msgstr "Te pozycje menu pokazują krótki Kopia! Potwierdzenie po zakończeniu."

#: lib/retro_hex_chat_web/controllers/help_content/feature_copy.html.heex:34
#, elixir-autogen, elixir-format
msgid "This Copy item is enabled only while you have a selection inside the message area. Text selected elsewhere on the page, such as in a menu or a dialog, does not count."
msgstr "Ten element Kopiuj jest włączony tylko wtedy, gdy masz wybór wewnątrz obszaru wiadomości. Tekst wybrany gdzie indziej na stronie, np. w menu lub oknie dialogowym, nie liczy się."

#: lib/retro_hex_chat_web/controllers/help_content/feature_emoji.html.heex:69
#, elixir-autogen, elixir-format
msgid "This Server's Emoji"
msgstr "Emoji tego serwera"

#: lib/retro_hex_chat_web/controllers/help_content/feature_mute.html.heex:55
#, elixir-autogen, elixir-format
msgid "This button only affects your own speakers. The command below is a different feature. Channel operators use it to stop a user from talking in a channel."
msgstr "Ten przycisk wpływa tylko na własne głośniki. Polecenie poniżej jest inną funkcją. Operatorzy kanałów używają go, aby uniemożliwić użytkownikowi rozmowę w kanale."

#: lib/retro_hex_chat_web/controllers/help_content/feature_server_broadcasts.html.heex:67
#, elixir-autogen, elixir-format
msgid "To receive wallops, open the File menu, choose User Modes..., check Receive wallops (+w) and click Apply."
msgstr "Aby otrzymać wallopy, otwórz menu Plik, wybierz tryby użytkownika..., sprawdź Odbieraj wallopy (+w) i kliknij Zastosuj."

#: lib/retro_hex_chat_web/controllers/help_content/feature_smart_input.html.heex:21
#, elixir-autogen, elixir-format
msgid "Type a command — / for list"
msgstr "Wpisz polecenie - / dla listy"

#: lib/retro_hex_chat_web/controllers/help_content/feature_server_broadcasts.html.heex:38
#, elixir-autogen, elixir-format
msgid "Type the text in the Message box."
msgstr "Wpisz tekst w polu Wiadomość."

#: lib/retro_hex_chat_web/controllers/help_content/feature_smart_input.html.heex:103
#, elixir-autogen, elixir-format
msgid "Underline"
msgstr "Podkreślenie"

#: lib/retro_hex_chat_web/controllers/help_content/feature_mute.html.heex:25
#, elixir-autogen, elixir-format
msgid "Use it in a meeting, at night, or in any place where chat sounds would disturb people. You keep reading and writing as usual, and you can still see new activity on screen."
msgstr "Użyj go na spotkaniu, w nocy, lub w każdym miejscu, gdzie dźwięki czatu mogłyby przeszkadzać ludziom. Czytasz i piszesz jak zwykle, a na ekranie wciąż widać nową aktywność."

#: lib/retro_hex_chat_web/controllers/help_content/feature_away_reply.html.heex:28
#, elixir-autogen, elixir-format
msgid "Using the Set Away Dialog"
msgstr "Korzystanie z okna Set Away"

#: lib/retro_hex_chat_web/controllers/help_content/feature_lag_indicator.html.heex:12
#, elixir-autogen, elixir-format
msgid "Warning (orange):"
msgstr "Ostrzeżenie (pomarańczowe):"

#: lib/retro_hex_chat_web/controllers/help_content/feature_kick_notifications.html.heex:30
#, elixir-autogen, elixir-format
msgid "What Else Happens"
msgstr "Co innego się dzieje"

#: lib/retro_hex_chat_web/controllers/help_content/feature_quit_message.html.heex:48
#, elixir-autogen, elixir-format
msgid "What Happens When You Quit"
msgstr "Co się dzieje, kiedy odchodzisz?"

#: lib/retro_hex_chat_web/controllers/help_content/feature_cheatsheet.html.heex:59
#, elixir-autogen, elixir-format
msgid "What It Does Not List"
msgstr "Co nie zawiera listy"

#: lib/retro_hex_chat_web/controllers/help_content/feature_admin_turn.html.heex:21
#, elixir-autogen, elixir-format
msgid "What TURN Is For"
msgstr "Co TURN jest dla"

#: lib/retro_hex_chat_web/controllers/help_content/feature_away_reply.html.heex:52
#, elixir-autogen, elixir-format
msgid "What You See"
msgstr "Co widzisz"

#: lib/retro_hex_chat_web/controllers/help_content/feature_kick_notifications.html.heex:22
#, elixir-autogen, elixir-format
msgid "What the Dialog Looks Like"
msgstr "Jak wygląda dialog"

#: lib/retro_hex_chat_web/controllers/help_content/feature_char_counter.html.heex:6
#: lib/retro_hex_chat_web/controllers/help_content/feature_copy_feedback.html.heex:14
#: lib/retro_hex_chat_web/controllers/help_content/feature_display_settings.html.heex:14
#: lib/retro_hex_chat_web/controllers/help_content/feature_mute.html.heex:23
#: lib/retro_hex_chat_web/controllers/help_content/feature_typing_indicator.html.heex:20
#, elixir-autogen, elixir-format
msgid "When It Helps"
msgstr "Kiedy pomaga"

#: lib/retro_hex_chat_web/controllers/help_content/feature_display_settings.html.heex:58
#, elixir-autogen, elixir-format
msgid "When the conversations panel is hidden, the Conversations button shows a number if another conversation has new messages. On a phone, the two panels open as drawers over the messages. Tap outside a drawer to close it."
msgstr "Kiedy panel rozmów jest ukryty, przycisk Rozmowy pokazuje liczbę, jeśli inna rozmowa ma nowe wiadomości. W telefonie dwa panele otwierają się jak szuflady na wiadomości. Stuknij pod szufladę, żeby ją zamknąć."

#: lib/retro_hex_chat_web/controllers/help_content/feature_paste_dialog.html.heex:77
#, elixir-autogen, elixir-format
msgid "When the input is in Markdown mode, a multi-line paste goes into the input without the dialog, so you can send it as one message."
msgstr "Kiedy wejście jest w trybie Markdown, pasta wieloliniowa wchodzi do wejścia bez okna dialogowego, więc możesz wysłać go jako jedną wiadomość."

#: lib/retro_hex_chat_web/controllers/help_content/feature_away_reply.html.heex:40
#, elixir-autogen, elixir-format
msgid "When you are back, open the dialog again and click Clear Away."
msgstr "Po powrocie otwórz ponownie okno dialogowe i kliknij Clear Away."

#: lib/retro_hex_chat_web/controllers/help_content/feature_copy_feedback.html.heex:9
#, elixir-autogen, elixir-format
msgid "When you copy something with a Copy item in a chat context menu, a short Copied! message appears and then closes by itself."
msgstr "Po skopiowaniu czegoś z pozycji Kopiuj w menu kontekstowym czatu, krótki Kopiowany! wiadomość pojawia się i zamyka się sama."

#: lib/retro_hex_chat_web/controllers/help_content/feature_char_counter.html.heex:33
#, elixir-autogen, elixir-format
msgid "When you reach the limit, the input stops accepting more text. The server also rejects any message that is longer than the limit."
msgstr "Po osiągnięciu limitu, wejście przestaje akceptować więcej tekstu. Serwer odrzuca również każdą wiadomość dłuższą niż limit."

#: lib/retro_hex_chat_web/controllers/help_content/feature_typing_indicator.html.heex:27
#, elixir-autogen, elixir-format
msgid "Where It Appears"
msgstr "Where It appears"

#: lib/retro_hex_chat_web/controllers/help_content/feature_lag_indicator.html.heex:37
#: lib/retro_hex_chat_web/controllers/help_content/feature_mute.html.heex:16
#, elixir-autogen, elixir-format
msgid "Where to Find It"
msgstr "Gdzie go znaleźć"

#: lib/retro_hex_chat_web/controllers/help_content/feature_copy_feedback.html.heex:21
#, elixir-autogen, elixir-format
msgid "Which Actions Show It"
msgstr "Które działania go pokazują"

#: lib/retro_hex_chat_web/controllers/help_content/feature_key_bindings.html.heex:19
#, elixir-autogen, elixir-format
msgid "You can also open it from the Help menu. Choose Shortcut Cheatsheet."
msgstr "Można go również otworzyć z menu Pomoc. Wybierz skrót Cheatsheet."

#: lib/retro_hex_chat_web/controllers/help_content/feature_display_settings.html.heex:31
#, elixir-autogen, elixir-format
msgid "You can also use the Conversations and Users buttons in the chat window toolbar, or the View group in the Start menu."
msgstr "Możesz również użyć przycisków Konwersacje i Użytkownicy w pasku narzędzi okna czatu lub grupy Widok w menu Start."

#: lib/retro_hex_chat_web/controllers/help_content/feature_quit_message.html.heex:51
#, elixir-autogen, elixir-format
msgid "You leave every channel you are in."
msgstr "Opuszczasz każdy kanał."

#: lib/retro_hex_chat_web/controllers/help_content/feature_quit_message.html.heex:58
#, elixir-autogen, elixir-format
msgid "Your browser returns to the connect screen."
msgstr "Twoja przeglądarka wraca do ekranu połączenia."

#: lib/retro_hex_chat_web/controllers/help_content/feature_typing_indicator.html.heex:37
#, elixir-autogen, elixir-format
msgid "Your first key press in a PM tells the other person that you are typing."
msgstr "Twoja pierwsza prasa w PM mówi drugiej osobie, że piszesz."

#: lib/retro_hex_chat_web/controllers/help_content/feature_away_reply.html.heex:13
#, elixir-autogen, elixir-format
msgid "YourNick is away: Gone for lunch"
msgstr "YourNick wyjechał na lunch"

#: lib/retro_hex_chat_web/controllers/help_content/feature_cheatsheet.html.heex:72
#, elixir-autogen, elixir-format
msgid "completes a nickname, or picks the selected suggestion."
msgstr "kończy nick lub wybiera wybraną sugestię."

#: lib/retro_hex_chat_web/controllers/help_content/feature_copy.html.heex:51
#, elixir-autogen, elixir-format
msgid "copies the line with its time and the author's nickname."
msgstr "kopiuje linię z jej czasem i pseudonimem autora."

#: lib/retro_hex_chat_web/controllers/help_content/feature_copy.html.heex:58
#, elixir-autogen, elixir-format
msgid "copies the original text with its formatting codes. It appears only when the source differs from what you see."
msgstr "kopiuje oryginalny tekst za pomocą kodów formatujących. Pojawia się tylko wtedy, gdy źródło różni się od tego, co widzisz."

#: lib/retro_hex_chat_web/controllers/help_content/feature_cheatsheet.html.heex:68
#, elixir-autogen, elixir-format
msgid "sends the message."
msgstr "wysyła wiadomość."

#: lib/retro_hex_chat_web/controllers/help_content/feature_cheatsheet.html.heex:69
#, elixir-autogen, elixir-format
msgid "starts a new line."
msgstr "zaczyna nową linię."

#: lib/retro_hex_chat_web/controllers/help_content/feature_char_counter.html.heex:25
#, elixir-autogen, elixir-format
msgid "The number turns orange after %{warning} characters and red after %{danger}, so you can see the limit coming."
msgstr "Liczba obraca się na pomarańczowo po znakach %{warning} i na czerwono po %{danger}, więc można zobaczyć nadchodzący limit."
