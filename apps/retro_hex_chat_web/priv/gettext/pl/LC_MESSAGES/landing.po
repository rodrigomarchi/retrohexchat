msgstr "Stwórz postać, a potem wejdź i pogadaj na czacie."

#: lib/retro_hex_chat_web/site/pages/spaces.ex:82
#: lib/retro_hex_chat_web/site/pages/spaces/intro.html.heex:40
#, elixir-autogen, elixir-format
msgid "Three characters talking on an island, in pixel art"
msgstr "Trzy postacie rozmawiające na wyspie, w stylu pixel art"

#: lib/retro_hex_chat_web/site/pages/spaces.ex:92
#, elixir-autogen, elixir-format
msgid "Walk around a pixel-art world with the people of a chat room, in your browser. Make a character, talk and build together for free."
msgstr "Spaceruj po świecie w stylu pixel art razem z osobami z pokoju czatu, w przeglądarce. Stwórz postać, rozmawiaj i buduj razem za darmo."

#: lib/retro_hex_chat_web/site/pages/spaces/creator.html.heex:11
