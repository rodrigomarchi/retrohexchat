#: lib/retro_hex_chat_web/site/pages/spaces/places.html.heex:10
#, elixir-autogen, elixir-format
msgid "The Construct, an empty white floor, with its %{build} menu open"
msgstr "Konstrukt, puste białe piętro, z otwartym menu %{build}"

#: lib/retro_hex_chat_web/site/pages/spaces/places.html.heex:62
#, elixir-autogen, elixir-format
msgid "An office with computers and a meeting table"
msgstr "Biuro z komputerami i stołem konferencyjnym"

#: lib/retro_hex_chat_web/site/pages/spaces/how.html.heex:7
#, elixir-autogen, elixir-format
msgid "Press %{join} on the card to open the Space in a new tab."
msgstr "Naciśnij %{join} na karcie, aby otworzyć przestrzeń w nowej karcie przeglądarki."

#: lib/retro_hex_chat_web/site/pages/spaces/intro.html.heex:6
#, elixir-autogen, elixir-format
msgid "Everyone in the channel can walk around in it together."
msgstr "Wszyscy na kanale mogą razem po niej chodzić."

#: lib/retro_hex_chat_web/site/pages/spaces/how.html.heex:13
#, elixir-autogen, elixir-format
msgid "Walk with the arrow keys, WASD or the pad on the screen. Press Enter to write a message."
msgstr "Poruszaj się klawiszami strzałek, WASD lub padem na ekranie. Naciśnij Enter, aby napisać wiadomość."

#: lib/retro_hex_chat_web/components/ui/landing/game_community.ex:88
#, elixir-autogen, elixir-format
