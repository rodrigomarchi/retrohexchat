msgstr "Otwórz kanał i naciśnij przycisk Space obok jego karty."

#: lib/retro_hex_chat_web/site/pages/spaces.ex:90
#, elixir-autogen, elixir-format
msgid "Spaces: a pixel-art world for every chat room"
msgstr "Przestrzenie: świat pixel art dla każdego czatu"

#: lib/retro_hex_chat_web/site/pages/spaces/places.html.heex:18
#, elixir-autogen, elixir-format
msgid "Through the gate there is an empty white floor."
msgstr "Za bramą jest puste, białe podłoże."

#: lib/retro_hex_chat_web/site/pages/spaces/intro.html.heex:8
#, elixir-autogen, elixir-format
msgid "What you type shows up above your character and in the chat."
msgstr "To, co piszesz, pojawia się nad twoją postacią oraz na czacie."

#: lib/retro_hex_chat_web/site/pages/spaces/places.html.heex:24
#, elixir-autogen, elixir-format
msgid "Your buildings stay in the channel, and everybody can see them."
msgstr "Wasze budynki zostają na kanale i każdy może je zobaczyć."

#: lib/retro_hex_chat_web/site/pages/spaces/intro.html.heex:7
#, elixir-autogen, elixir-format
