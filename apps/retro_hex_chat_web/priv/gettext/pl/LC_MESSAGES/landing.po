#: lib/retro_hex_chat_web/site/pages/spaces/places.html.heex:19
#, elixir-autogen, elixir-format
msgid "Choose furniture, plants and games in the %{build} menu and place them anywhere."
msgstr "Wybierz meble, rośliny i gry w menu %{build} i umieść je gdziekolwiek."

#: lib/retro_hex_chat_web/site/pages/spaces/creator.html.heex:15
#, elixir-autogen, elixir-format
msgid "Choose the skin, the outfit, the hair, a hat and the face."
msgstr "Wybierz skórę, strój, włosy, kapelusz i twarz."

#: lib/retro_hex_chat_web/site/pages/spaces/intro.html.heex:15
#: lib/retro_hex_chat_web/site/pages/spaces/intro.html.heex:21
#: lib/retro_hex_chat_web/site/pages/spaces/intro.html.heex:25
