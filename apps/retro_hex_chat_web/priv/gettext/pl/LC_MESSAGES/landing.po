#: lib/retro_hex_chat_web/site/pages/ascii_art/chat.html.heex:15
#: lib/retro_hex_chat_web/site/pages/paint/chat.html.heex:15
#, elixir-autogen, elixir-format
msgid "A channel with a pixel-art heart and a rainbow text banner posted in it"
msgstr "Kanał z sercem w stylu pixel art i tęczowym tekstowym banerem opublikowanymi na nim"

#: lib/retro_hex_chat_web/site/pages/paint/chat.html.heex:2
#, elixir-autogen, elixir-format
msgid "A drawing arrives in the conversation as a picture, every pixel a sharp square."
msgstr "Rysunek pojawia się w rozmowie jako obraz, a każdy piksel to ostry kwadrat."

#: lib/retro_hex_chat_web/site/pages/ascii_art/chat.html.heex:6
#, elixir-autogen, elixir-format
msgid "A picture you turn into art stays on your computer: only the characters are posted."
msgstr "A picture you turn into art stays on your computer: only the characters are posted."

#: lib/retro_hex_chat_web/public_pages.ex:120
#: lib/retro_hex_chat_web/site/pages/ascii_art.ex:32
#, elixir-autogen, elixir-format
msgid "ASCII Art"
msgstr "ASCII Art"

#: lib/retro_hex_chat_web/site/pages/ascii_art/intro.html.heex:5
#, elixir-autogen, elixir-format
msgid "ASCII Art turns a word into a big banner made of text characters."
msgstr "ASCII Art zamienia słowo w duży baner złożony ze znaków tekstowych."

#: lib/retro_hex_chat_web/site/pages/ascii_art/intro.html.heex:6
#, elixir-autogen, elixir-format
msgid "Choose blocks, hashes or a shadow, and colour it in one colour, a rainbow or two tones."
msgstr "Wybierz bloki, hashe lub cień i pokoloruj całość jednym kolorem, tęczą lub dwoma odcieniami."

#: lib/retro_hex_chat_web/site/pages/paint/intro.html.heex:6
#, elixir-autogen, elixir-format
msgid "Draw on a grid of 32, 64 or 128 pixels in the sixteen colours of the chat."
msgstr "Rysuj na siatce 32, 64 lub 128 pikseli w szesnastu kolorach czatu."

#: lib/retro_hex_chat_web/site/pages/paint/intro.html.heex:2
#, elixir-autogen, elixir-format
msgid "Draw pixel art and share it in the chat"
msgstr "Narysuj pixel art i udostępnij go na czacie"

#: lib/retro_hex_chat_web/site/pages/features/real_time_chat.html.heex:25
#, elixir-autogen, elixir-format
msgid "Draw pixel art to post with Hex Paint"
msgstr "Rysuj pixel art do opublikowania w Hex Paint"

#: lib/retro_hex_chat_web/site/pages/paint/how.html.heex:9
#, elixir-autogen, elixir-format
msgid "Draw, then choose File, then Post to channel."
msgstr "Narysuj, a następnie wybierz Plik, a potem Opublikuj na kanale."

#: lib/retro_hex_chat_web/site/pages/paint/intro.html.heex:5
#, elixir-autogen, elixir-format
msgid "Hex Paint is a pixel drawing program that opens on the chat's desktop."
msgstr "Hex Paint to program do rysowania pikseli, który otwiera się na pulpicie czatu."

#: lib/retro_hex_chat_web/site/pages/paint.ex:40
#: lib/retro_hex_chat_web/site/pages/paint/intro.html.heex:34
#, elixir-autogen, elixir-format
msgid "Hex Paint open on a pixel-art heart over a starry night"
msgstr "Hex Paint z otwartym sercem w stylu pixel art na tle gwiaździstej nocy"

#: lib/retro_hex_chat_web/site/pages/paint.ex:39
#, elixir-autogen, elixir-format
msgid "Hex Paint: draw pixel art online and share it in a chat"
msgstr "Hex Paint: rysuj pixel art online i udostępniaj go na czacie"

#: lib/retro_hex_chat_web/site/pages/ascii_art.ex:43
#: lib/retro_hex_chat_web/site/pages/paint.ex:43
#, elixir-autogen, elixir-format
msgid "In the chat"
msgstr "Na czacie"

#: lib/retro_hex_chat_web/site/pages/ascii_art/intro.html.heex:10
#, elixir-autogen, elixir-format
msgid "It also turns a picture or a Hex Paint drawing into coloured characters."
msgstr "Zamienia też obraz lub rysunek z Hex Paint w kolorowe znaki."

#: lib/retro_hex_chat_web/site/pages/ascii_art/intro.html.heex:2
#: lib/retro_hex_chat_web/site/pages/features/real_time_chat.html.heex:33
#, elixir-autogen, elixir-format
msgid "Make ASCII art in mIRC colours"
msgstr "Twórz ASCII art w kolorach mIRC"

#: lib/retro_hex_chat_web/site/pages/ascii_art/intro.html.heex:20
#, elixir-autogen, elixir-format
msgid "Open ASCII Art"
msgstr "Otwórz ASCII Art"

#: lib/retro_hex_chat_web/site/pages/paint/intro.html.heex:23
#, elixir-autogen, elixir-format
msgid "Open Hex Paint"
msgstr "Otwórz Hex Paint"

#: lib/retro_hex_chat_web/site/pages/ascii_art/how.html.heex:4
#, elixir-autogen, elixir-format
msgid "Open Start, then Accessories, then ASCII Art, or type /ascii in the chat."
msgstr "Otwórz Start, następnie Akcesoria, następnie ASCII Art, lub wpisz /ascii na czacie."

#: lib/retro_hex_chat_web/site/pages/paint/how.html.heex:4
#, elixir-autogen, elixir-format
msgid "Open Start, then Accessories, then Hex Paint, or type /paint in the chat."
msgstr "Otwórz Start, następnie Akcesoria, następnie Hex Paint, lub wpisz /paint na czacie."

#: lib/retro_hex_chat_web/site/pages/ascii_art/intro.html.heex:11
#, elixir-autogen, elixir-format
msgid "Post the art to a chat room as one message, or copy it with its mIRC colour codes."
msgstr "Opublikuj rysunek w pokoju czatu jako jedną wiadomość albo skopiuj go wraz z kodami kolorów mIRC."

#: lib/retro_hex_chat_web/site/pages/ascii_art/chat.html.heex:2
#, elixir-autogen, elixir-format
msgid "Text art arrives as one message, every character in its column, so nobody's screen fills with a flood of lines."
msgstr "Sztuka tekstowa dociera jako jedna wiadomość, każdy znak w swojej kolumnie, więc ekran nikomu nie zapełnia się zalewem linijek."

#: lib/retro_hex_chat_web/site/pages/ascii_art.ex:40
#: lib/retro_hex_chat_web/site/pages/ascii_art/intro.html.heex:31
#, elixir-autogen, elixir-format
msgid "The word RETRO as a rainbow banner made of text characters"
msgstr "Słowo RETRO jako tęczowy baner złożony ze znaków tekstowych"

#: lib/retro_hex_chat_web/site/pages/paint/chat.html.heex:6
#, elixir-autogen, elixir-format
msgid "Turn it into text art with ASCII Art and it arrives as coloured characters instead."
msgstr "Zamień go na sztukę tekstową w ASCII Art, a zamiast tego dotrze jako kolorowe znaki."

#: lib/retro_hex_chat_web/site/pages/ascii_art/how.html.heex:9
#, elixir-autogen, elixir-format
msgid "Type a word, then choose File, then Post to channel."
msgstr "Wpisz słowo, następnie wybierz Plik, a potem Opublikuj na kanale."

#: lib/retro_hex_chat_web/site/pages/paint/intro.html.heex:10
#, elixir-autogen, elixir-format
msgid "Use a pencil, lines, rectangles, ellipses and a fill, and undo any stroke."
msgstr "Użyj ołówka, linii, prostokątów, elips i wypełnienia, a każde pociągnięcie możesz cofnąć."

#: lib/retro_hex_chat_web/site/pages/paint/intro.html.heex:14
#, elixir-autogen, elixir-format
msgid "When it is ready, post it to a channel or a friend with a line of text, or save it as a PNG."
msgstr "Gdy będzie gotowy, opublikuj go na kanale lub wyślij znajomemu z linijką tekstu albo zapisz jako PNG."

#: lib/retro_hex_chat_web/site/pages/paint.ex:35
#, elixir-autogen, elixir-format
msgid "Draw pixel art in your browser for free, in sixteen retro colours, and post your drawings to a chat room."
msgstr "Rysuj pixel art w przeglądarce za darmo, w szesnastu retro kolorach, i publikuj swoje rysunki w pokoju czatu."

#: lib/retro_hex_chat_web/site/pages/ascii_art.ex:39
#, elixir-autogen, elixir-format
msgid "Free ASCII art generator: text banners in mIRC colours"
msgstr "Darmowy generator sztuki ASCII: banery tekstowe w kolorach mIRC"

#: lib/retro_hex_chat_web/site/pages/ascii_art.ex:35
#, elixir-autogen, elixir-format
msgid "Make ASCII art in mIRC colours for free: text banners, pictures and pixel drawings, posted to a chat room as one message."
msgstr "Twórz ASCII art w kolorach mIRC za darmo: banery tekstowe, obrazki i rysunki pikselowe, publikowane w pokoju czatu jako jedna wiadomość."

#: lib/retro_hex_chat_web/site/pages/radio/intro.html.heex:6
#, elixir-autogen, elixir-format
msgid "Choose from thousands of stations around the world: the most played, a genre from chiptune to jazz, or a station by its name."
msgstr "Wybieraj spośród tysięcy stacji z całego świata: najczęściej słuchane, gatunek od chiptune po jazz albo stację według nazwy."

#: lib/retro_hex_chat_web/site/pages/radio/intro.html.heex:5
#, elixir-autogen, elixir-format
msgid "Hex Radio is an internet radio player that opens on the chat's desktop."
msgstr "Hex Radio jest internetowym odtwarzaczem radiowym, który otwiera się na pulpicie czatu."

#: lib/retro_hex_chat_web/site/pages/radio.ex:42
#: lib/retro_hex_chat_web/site/pages/radio/intro.html.heex:30
#, elixir-autogen, elixir-format
msgid "Hex Radio playing a chiptune station, its spectrum lit in green"
msgstr "Hex Radio odtwarza stację chiptune, jej widmo świeci na zielono"

#: lib/retro_hex_chat_web/site/pages/radio/sound.html.heex:14
#, elixir-autogen, elixir-format
msgid "Hex Radio with its ten-band equalizer open under the spectrum"
msgstr "Hex Radio z dziesięciopasmowym korektorem otwartym pod widmem"

#: lib/retro_hex_chat_web/site/pages/radio.ex:40
#, elixir-autogen, elixir-format
msgid "Hex Radio: listen to internet radio online in a retro player"
msgstr "Hex Radio: słuchaj radia internetowego online w odtwarzaczu retro"

#: lib/retro_hex_chat_web/site/pages/radio.ex:35
#, elixir-autogen, elixir-format
msgid "Listen to internet radio for free in a retro player: thousands of stations from around the world, a spectrum and an equalizer."
msgstr "Słuchaj radia internetowego za darmo w odtwarzaczu retro: tysiące stacji z całego świata, widmo i korektor."

#: lib/retro_hex_chat_web/site/pages/radio/intro.html.heex:2
#, elixir-autogen, elixir-format
msgid "Listen to internet radio in a retro player"
msgstr "Słuchaj radia internetowego w odtwarzaczu retro"

#: lib/retro_hex_chat_web/site/pages/features/real_time_chat.html.heex:41
#, elixir-autogen, elixir-format
msgid "Listen to internet radio with Hex Radio"
msgstr "Słuchaj radia internetowego z Hex Radio"

#: lib/retro_hex_chat_web/site/pages/radio/intro.html.heex:19
#, elixir-autogen, elixir-format
msgid "Open Hex Radio"
msgstr "Otwórz Hex Radio"

#: lib/retro_hex_chat_web/site/pages/radio/how.html.heex:4
#, elixir-autogen, elixir-format
msgid "Open Start, then Accessories, then Hex Radio, or type /radio in the chat."
msgstr "Otwórz Start, potem Akcesoria, potem Hex Radio lub wpisz /radio na czacie."

#: lib/retro_hex_chat_web/site/pages/radio/sound.html.heex:6
#, elixir-autogen, elixir-format
msgid "Open the ten-band equalizer to raise the bass or soften the treble, and put it back to flat with one click."
msgstr "Otwórz dziesięciopasmowy korektor, aby podbić bas lub złagodzić soprany, i przywróć ustawienie płaskie jednym kliknięciem."

#: lib/retro_hex_chat_web/site/pages/radio/how.html.heex:9
#, elixir-autogen, elixir-format
msgid "Pick a genre or search for a station, then click it to listen."
msgstr "Wybierz gatunek lub wyszukaj stację, a następnie kliknij ją, aby posłuchać."

#: lib/retro_hex_chat_web/site/pages/radio/intro.html.heex:10
#, elixir-autogen, elixir-format
msgid "Star the ones you like, and keep listening while you chat in another window."
msgstr "Oznacz gwiazdką te, które lubisz, i słuchaj dalej, gdy rozmawiasz w innym oknie."

#: lib/retro_hex_chat_web/site/pages/radio/sound.html.heex:2
#, elixir-autogen, elixir-format
msgid "The display draws the music as a spectrum of bars or as an oscilloscope line."
msgstr "Wyświetlacz rysuje muzykę jako widmo słupków lub jako linię oscyloskopu."

#: lib/retro_hex_chat_web/site/pages/radio.ex:46
#, elixir-autogen, elixir-format
msgid "Spectrum and equalizer"
msgstr "Widmo i korektor"
