#, elixir-autogen, elixir-format
msgid ""
"- Muting does not affect visual notifications (conversations sidebar flash, "
"title flash)"
msgstr ""
"- Muting não afeta notificações visuais (conversas sidebar flash, título "
"flash)"

#: lib/retro_hex_chat_web/controllers/help_content/feature_timers.html.heex:55
#, elixir-autogen, elixir-format
msgid "- One-shot: minimum 1 second, maximum 86,400 seconds (24 hours)."
msgstr "- Um tiro: no mínimo 1 segundo, no máximo 86.400 segundos (24 horas)."

