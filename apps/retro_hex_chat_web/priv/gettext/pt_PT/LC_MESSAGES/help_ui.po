#: lib/retro_hex_chat_web/controllers/help_content/keyboard_shortcuts.html.heex:26
#, elixir-autogen, elixir-format
msgid "Enter — Send message / select autocomplete item Shift+Enter — Insert newline in input Up — Edit last message (when input is empty) / command history Up / Down — Command history / navigate autocomplete dropdown Ctrl+Up — Browse history (saves draft) Ctrl+Down — Browse history forward (restores draft) Ctrl+R — Reverse search history Tab — Select autocomplete item / cycle nick completion Escape — Cancel edit mode / dismiss autocomplete / tooltip / — Open command autocomplete (at start of input) @ — Open nick autocomplete (at word boundary) # — Open channel autocomplete (at word boundary)"
msgstr ""
"Digite — Enviar mensagem / selecionar item autocompletar Shift+Enter — "
"Inserir nova linha na entrada Up — Editar última mensagem (quando a entrada "
"estiver vazia) / histórico de comandos Up / Down — Histórico de comandos / "
"navegar complete automaticamente dropdown Ctrl+Up — Navegar no histórico "
"(salvar rascunho) Ctrl+Down — Navegar no histórico para a frente (restore "
"rascunho) Ctrl+R — Histórico de pesquisa reversa Tab — Selecione "
"autocompletar item / ciclo de completamento Escape — Cancelar modo de edição"
" / descarte autocompletar / tooltip / — Abrir comando autocompletar (no "
"início da entrada) @ — Abrir alcunha autocompletar (no limite da palavra) # "
"— Abrir canal autocompletar (no limite da palavra)"

