#, elixir-autogen, elixir-format
msgid ""
"Opens or closes the in-window Find bar for searching messages. You can also "
"press Ctrl+Shift+F."
msgstr ""
"Abre ou fecha a barra Encontrar na janela para procurar mensagens. Você "
"também pode pressionar Ctrl+Shift+F."

#: lib/retro_hex_chat_web/controllers/help_content/keyboard_shortcuts.html.heex:7
