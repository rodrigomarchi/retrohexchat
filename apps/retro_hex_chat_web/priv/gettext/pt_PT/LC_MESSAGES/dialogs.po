msgstr "Esta mensagem foi apagada."

#: lib/retro_hex_chat_web/components/ui/dialogs/saved_dialog.ex:143
#, elixir-autogen, elixir-format
msgid "Why you kept it (optional)"
msgstr "Porque guardou (opcional)"

#: lib/retro_hex_chat_web/components/ui/dialogs/saved_dialog.ex:75
#, elixir-autogen, elixir-format
msgid "You have not kept anything yet."
msgstr "Ainda não guardou nada."

#: lib/retro_hex_chat_web/components/ui/dialogs/saved_dialog.ex:190
#, elixir-autogen, elixir-format
