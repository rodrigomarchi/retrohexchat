msgstr ""

#: lib/retro_hex_chat_web/controllers/help_content/feature_p2p_in_chat.html.heex:2
#, elixir-autogen, elixir-format
msgid "P2P sessions run right inside the chat: the invite, the conversation and every feature window live on the chat desktop, anchored to the private message with your peer."
msgstr ""

#: lib/retro_hex_chat_web/controllers/help_content/feature_channel_conference.html.heex:50
#, elixir-autogen, elixir-format
msgid "Participant tiles and the participant panel highlight the current speaker when browser audio levels are available. Quality badges summarize recent browser connection stats such as RTT, packet loss, bitrate, frame rate and freezes for each remote participant."
msgstr ""

#: lib/retro_hex_chat_web/controllers/help_content/feature_video_call.html.heex:2
#, elixir-autogen, elixir-format
msgid "Peer-to-peer video calls with rich 1:1 layouts, self-view control, screen sharing, PiP, reactions and live quality indicators."
msgstr ""

