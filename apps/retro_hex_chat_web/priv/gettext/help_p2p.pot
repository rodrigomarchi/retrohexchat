#: lib/retro_hex_chat_web/controllers/help_content/feature_network_stats.html.heex:16
#, elixir-autogen, elixir-format
msgid "The header shows an overall health rating (Excellent / Good / Fair / Poor) and a MOS score. MOS (Mean Opinion Score) is a 1–5 estimate of call quality derived from latency, jitter and packet loss: 5 is excellent, and anything below 3.5 usually feels uncomfortable."
msgstr ""

#: lib/retro_hex_chat_web/controllers/help_content/feature_network_stats.html.heex:52
#, elixir-autogen, elixir-format
msgid "Video"
msgstr ""

#: lib/retro_hex_chat_web/controllers/help_content/feature_network_stats.html.heex:46
#, elixir-autogen, elixir-format
msgid "— how much media you are currently receiving and sending, in kilobits per second."
msgstr ""

#: lib/retro_hex_chat_web/controllers/help_content/feature_network_stats.html.heex:39
#, elixir-autogen, elixir-format
msgid "— percentage of packets that never arrived. Above ~3% noticeably degrades quality."
msgstr ""

#: lib/retro_hex_chat_web/controllers/help_content/feature_network_stats.html.heex:25
#, elixir-autogen, elixir-format
msgid "— round-trip time for data to reach the peer and return. Lower is better; under ~150 ms feels instant."
msgstr ""

#: lib/retro_hex_chat_web/controllers/help_content/feature_network_stats.html.heex:32
#, elixir-autogen, elixir-format
msgid "— variation in packet arrival timing. High jitter causes choppy audio and video."
msgstr ""

#: lib/retro_hex_chat_web/controllers/help_content/feature_network_stats.html.heex:57
#, elixir-autogen, elixir-format
msgid "— why quality was capped: CPU means your device is too busy; Bandwidth means the network is too slow."
msgstr ""

#: lib/retro_hex_chat_web/controllers/help_content/feature_audio_call.html.heex:6
#, elixir-autogen, elixir-format
msgid ". Either peer can start or stop their own microphone independently; if your peer starts media first, your Call window opens and you join automatically."
msgstr ""

#: lib/retro_hex_chat_web/controllers/help_content/feature_video_call.html.heex:9
#, elixir-autogen, elixir-format
msgid ". P2P media is self-controlled: either peer can start camera or microphone independently, and the other side joins the media surface automatically."
msgstr ""

#: lib/retro_hex_chat_web/controllers/help_content/feature_channel_conference.html.heex:90
#, elixir-autogen, elixir-format
msgid "A conference statistics window opens with the call and shows both server-side SFU state and live browser connection metrics. Use the stats/dock control in the conference header to arrange the call and statistics side by side without moving focus away from the call. Closing the statistics window leaves the conference, so minimize it to keep the session running."
msgstr ""

#: lib/retro_hex_chat_web/controllers/help_content/feature_universal_lobby.html.heex:16
#, elixir-autogen, elixir-format
msgid "Audio and video are self-controlled: each peer turns their own microphone and camera on or off independently, like a modern video call. File transfers and games still ask the other side to accept."
msgstr ""

#: lib/retro_hex_chat_web/controllers/help_content/feature_p2p_in_chat.html.heex:15
#, elixir-autogen, elixir-format
msgid "Both sides use the same setup dialog. It previews your camera, lists microphone/camera/speaker devices, lets you start with microphone, camera, both or receive-only, and applies those choices when the call auto-starts. If a TURN relay is configured, the same setup lets you enable privacy relay for the session."
msgstr ""

#: lib/retro_hex_chat_web/controllers/help_content/feature_channel_conference.html.heex:8
#, elixir-autogen, elixir-format
msgid "Channel Indicator"
msgstr ""

#: lib/retro_hex_chat_web/controllers/help_content/feature_channel_conference.html.heex:2
#, elixir-autogen, elixir-format
msgid "Channel conferences are audio/video calls attached to the active channel. Use the Call button in the channel topic bar to open the pre-join dialog before entering."
msgstr ""

#: lib/retro_hex_chat_web/controllers/help_content/feature_channel_conference.html.heex:82
#, elixir-autogen, elixir-format
msgid "Channel moderators can end the conference, lock or unlock new admission, mute microphones, turn participant cameras off, stop and temporarily block screen sharing, use bulk mute/camera-off for lower-ranked participants, allow raised-hand participants to speak, and remove users from both the conference and the channel when channel policy allows it. Participants can raise a hand when they need to speak; moderators see the request queue and allowing speech unmutes the participant. A locked conference keeps users in the channel but blocks non-moderators from joining the call. Camera or screen sharing disabled by moderation is shown differently from a participant turning it off voluntarily. Destructive and bulk actions ask for confirmation first. Administrative events are recorded with the conference and relevant events appear as system messages in the channel without turning media/presence updates into chat spam."
msgstr ""

#: lib/retro_hex_chat_web/controllers/help_content/feature_video_call.html.heex:29
#, elixir-autogen, elixir-format
msgid "Click Share Screen to replace your camera feed with a browser display-capture track. Stopping from the browser or from the button restores the previous camera when possible; the peer sees a screen badge."
msgstr ""

#: lib/retro_hex_chat_web/controllers/help_content/feature_universal_lobby.html.heex:23
#, elixir-autogen, elixir-format
msgid "Closing any session window disconnects the whole session (after a confirmation); minimizing keeps everything running in the taskbar. The status bar always shows the active session — click it to bring the windows back to the front."
msgstr ""

#: lib/retro_hex_chat_web/controllers/help_content/feature_universal_lobby.html.heex:21
#, elixir-autogen, elixir-format
msgid "Closing vs. Minimizing"
msgstr ""

#: lib/retro_hex_chat_web/controllers/help_content/feature_channel_conference.html.heex:100
#, elixir-autogen, elixir-format
msgid "Conversations"
msgstr ""

#: lib/retro_hex_chat_web/controllers/help_content/feature_video_call.html.heex:35
#, elixir-autogen, elixir-format
msgid "Ctrl+Shift+. toggles screen sharing when the P2P Call window is focused. A shared screen automatically favors the focus layout."
msgstr ""

#: lib/retro_hex_chat_web/controllers/help_content/feature_audio_call.html.heex:34
#, elixir-autogen, elixir-format
msgid "Ctrl+Shift+Q in the focused P2P Call window ends only the call media. Use the status bar stop button or close confirmation to end the whole P2P session."
msgstr ""

#: lib/retro_hex_chat_web/controllers/help_content/feature_channel_conference.html.heex:64
#, elixir-autogen, elixir-format
msgid "Empty and Failure States"
msgstr ""

#: lib/retro_hex_chat_web/controllers/help_content/feature_channel_conference.html.heex:74
#, elixir-autogen, elixir-format
msgid "If the media connection is interrupted, the conference tries a short automatic recovery sequence. When automatic recovery is exhausted, use Retry to request a fresh media offer without closing the conference window."
msgstr ""

#: lib/retro_hex_chat_web/controllers/help_content/feature_channel_conference.html.heex:26
#, elixir-autogen, elixir-format
msgid "Inside the conference window, use the layout buttons to switch between automatic, grid, focus and speaker layouts, show or hide the participant panel, pin important participants, cycle your self-view between tile, picture-in-picture and hidden, or switch to compact mode when you want the call to stay visible while you keep working in chat. Larger calls automatically use a denser grid while focus and speaker layouts keep a filmstrip for the remaining participants."
msgstr ""

