#, elixir-autogen, elixir-format
msgid "(limit) — Channel cannot exceed the user limit."
msgstr "(মেলি) — চ্যানেল সীমা বহির্ভূত ।"

#: lib/retro_hex_chat_web/controllers/help_content/channel_permissions.html.heex:188
#, elixir-autogen, elixir-format
msgid ""
"(moderated) — Only Voiced, Half-Operator, Operator, and Owner can speak."
msgstr ""
"(সংযুক্ত) — শুধুমাত্র ভয়েস, হাফ-অপ অপারেটর, অপারেটর এবং মালিক কথা বলতে "
"পারেন ।"

#: lib/retro_hex_chat_web/controllers/help_content/channel_permissions.html.heex:194
#, elixir-autogen, elixir-format
