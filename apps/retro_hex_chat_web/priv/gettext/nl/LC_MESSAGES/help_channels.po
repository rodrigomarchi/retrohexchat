msgstr "Alleen van toepassing op het huidige kanaal"

#: lib/retro_hex_chat_web/controllers/help_content/chanserv_register.html.heex:46
#, elixir-autogen, elixir-format
msgid "ChanServ Access Lists"
msgstr "ChanServ-toegangslijsten"

#: lib/retro_hex_chat_web/controllers/help_content/chanserv_access.html.heex:2
#, elixir-autogen, elixir-format
msgid ""
"ChanServ access lists grant persistent channel privileges to identified "
"users when they join a registered channel."
msgstr ""
"ChanServ toegang lijsten geven persistent kanaal privileges aan "
"geïdentificeerde gebruikers wanneer ze deelnemen aan een geregistreerd "
"kanaal."

#: lib/retro_hex_chat_web/controllers/help_content/chanserv_register.html.heex:2
#, elixir-autogen, elixir-format
msgid ""
"ChanServ registration assigns a founder to the current channel and keeps "
"channel ownership, access lists, bans, and settings available after the "
"channel empties or restarts."
msgstr ""
"ChanServ registratie wijst een oprichter aan het huidige kanaal en houdt "
"kanaal eigendom, toegang lijsten, verboden en instellingen beschikbaar na "
"het kanaal leegt of herstart."

#: lib/retro_hex_chat_web/controllers/help_content/channel_transfer_ownership.html.heex:8
#: lib/retro_hex_chat_web/controllers/help_content/channel_transfer_ownership.html.heex:40
