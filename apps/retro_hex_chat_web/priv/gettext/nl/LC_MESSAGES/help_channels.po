#, elixir-autogen, elixir-format
msgid "Owner (~) > Operator (@) > Half-Operator (%) > Voice (+) > Regular"
msgstr ""
"Eigenaar (~) > Operator (@) > Half-operateur (%) > Stem (+) > Regelmatig"

