" kicken"

#: lib/retro_hex_chat_web/controllers/help_content/mode_i.html.heex:16
#, elixir-autogen, elixir-format
msgid "Channel Invites"
msgstr "Kanaaluitnodigingen"

#: lib/retro_hex_chat_web/controllers/help_content/mode_nk.html.heex:21
#, elixir-autogen, elixir-format
msgid "Channel Modes Overview"
msgstr "Overzicht kanaalmodi"

