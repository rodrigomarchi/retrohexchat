msgstr "Moderatie"

#: lib/retro_hex_chat_web/controllers/help_content/feature_universal_lobby.html.heex:7
#, elixir-autogen, elixir-format
msgid "One Connection, Every Feature"
msgstr "Eén verbinding, elk kenmerk"

#: lib/retro_hex_chat_web/controllers/help_content/feature_p2p_in_chat.html.heex:54
#, elixir-autogen, elixir-format
msgid "One Session at a Time"
msgstr "Eén sessie op een tijd"

#: lib/retro_hex_chat_web/controllers/help_content/feature_universal_lobby.html.heex:31
#, elixir-autogen, elixir-format
msgid "P2P Sessions in Chat"
msgstr "P2P-sessies in chat"

#: lib/retro_hex_chat_web/controllers/help_content/feature_channel_conference.html.heex:50
#, elixir-autogen, elixir-format
msgid ""
"Participant tiles and the participant panel highlight the current speaker "
"when browser audio levels are available. Quality badges summarize recent "
"browser connection stats such as RTT, packet loss, bitrate, frame rate and "
"freezes for each remote participant."
msgstr ""
"Deelnemende tegels en het deelnemerspaneel markeren de huidige luidspreker "
"wanneer browser audioniveaus beschikbaar zijn. Kwaliteit badges samengevat "
"recente browser verbinding statistieken zoals RTT, pakket verlies, bitrate, "
"frame rate en bevriest voor elke externe deelnemer."

#: lib/retro_hex_chat_web/controllers/help_content/feature_video_call.html.heex:2
#, elixir-autogen, elixir-format
msgid ""
"Peer-to-peer video calls with rich 1:1 layouts, self-view control, screen "
"sharing, PiP, reactions and live quality indicators."
msgstr ""
"Peer-to-peer videogesprekken met rijke 1:1 lay-outs, zelf-view controle, "
"scherm delen, PiP, reacties en live kwaliteit indicatoren."

#: lib/retro_hex_chat_web/controllers/help_content/feature_channel_conference.html.heex:16
#, elixir-autogen, elixir-format
msgid "Pre-join and Devices"
msgstr "Pre-join en apparaten"

#: lib/retro_hex_chat_web/controllers/help_content/feature_p2p_in_chat.html.heex:61
#, elixir-autogen, elixir-format
msgid "Privacy Mode"
msgstr "Privacymodus"

#: lib/retro_hex_chat_web/controllers/help_content/feature_video_call.html.heex:42
#, elixir-autogen, elixir-format
msgid ""
"Reaction buttons send short visual effects over the active P2P session. They"
" appear on the call tiles and do not create private-message rows."
msgstr ""
"Reactieknoppen sturen korte visuele effecten over de actieve P2P-sessie. Ze "
"verschijnen op de oproeptegels en maken geen privé-berichtenrijen."

#: lib/retro_hex_chat_web/controllers/help_content/feature_channel_conference.html.heex:56
#: lib/retro_hex_chat_web/controllers/help_content/feature_video_call.html.heex:40
#, elixir-autogen, elixir-format
