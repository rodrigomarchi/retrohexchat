#, elixir-autogen, elixir-format
msgid "— how much media you are currently receiving and sending, in kilobits per second."
msgstr "— how much media you are currently receiving and sending, in kilobits per second."

#: lib/retro_hex_chat_web/controllers/help_content/feature_network_stats.html.heex:32
#, elixir-autogen, elixir-format
msgid "— percentage of packets that never arrived. Above ~3% noticeably degrades quality."
msgstr "— percentage of packets that never arrived. Above ~3% noticeably degrades quality."

#: lib/retro_hex_chat_web/controllers/help_content/feature_network_stats.html.heex:46
#, elixir-autogen, elixir-format
msgid "— resolution and frame rate of the received video."
msgstr "— resolution and frame rate of the received video."

#: lib/retro_hex_chat_web/controllers/help_content/feature_network_stats.html.heex:18
#, elixir-autogen, elixir-format
msgid "— round-trip time for data to reach the peer and return. Lower is better; under ~150 ms feels instant."
msgstr "— round-trip time for data to reach the peer and return. Lower is better; under ~150 ms feels instant."

#: lib/retro_hex_chat_web/controllers/help_content/feature_network_stats.html.heex:25
#, elixir-autogen, elixir-format
msgid "— variation in packet arrival timing. High jitter causes choppy audio and video."
msgstr "— variation in packet arrival timing. High jitter causes choppy audio and video."

#: lib/retro_hex_chat_web/controllers/help_content/feature_network_stats.html.heex:50
#, elixir-autogen, elixir-format
msgid "— why quality was capped: CPU means your device is too busy; Bandwidth means the network is too slow."
msgstr "— why quality was capped: CPU means your device is too busy; Bandwidth means the network is too slow."
