msgstr "(banned) — Los usuarios prohibidos no pueden unirse. Retirada con"

#: lib/retro_hex_chat_web/controllers/help_content/channel_permissions.html.heex:156
#, elixir-autogen, elixir-format
msgid ""
"(invite-only) — Only invited users or those with ban exceptions can join."
msgstr ""
"(sólo invitado) — Sólo los usuarios invitados o aquellos con excepciones de "
"prohibición pueden unirse."

#: lib/retro_hex_chat_web/controllers/help_content/channel_permissions.html.heex:163
#, elixir-autogen, elixir-format
msgid "(key) — Requires the correct password:"
msgstr "(key) — Requiere la contraseña correcta:"

#: lib/retro_hex_chat_web/controllers/help_content/channel_permissions.html.heex:166
