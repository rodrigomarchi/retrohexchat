msgstr "Controles para discapacitados"

#: lib/retro_hex_chat_web/controllers/help_content/chanserv_ui.html.heex:22
#, elixir-autogen, elixir-format
msgid "Drop Registration confirms before running the same action as /cs drop."
msgstr ""
"Registro de la gota confirma antes de ejecutar la misma acción que la gota "
"de la gota."

#: lib/retro_hex_chat_web/controllers/help_content/chanserv_access.html.heex:39
#, elixir-autogen, elixir-format
msgid "Founders can manage SOP, AOP, and VOP lists."
msgstr "Los fundadores pueden gestionar las listas SOP, AOP y VOP."

#: lib/retro_hex_chat_web/controllers/help_content/nickserv.html.heex:66
#, elixir-autogen, elixir-format
