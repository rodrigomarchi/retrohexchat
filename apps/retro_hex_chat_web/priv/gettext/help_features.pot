#, elixir-autogen, elixir-format
msgid "While there is something new, a First unread button appears beside the conversation's other controls and scrolls to the first line you have not read. If that line is older than the part of the history currently loaded, scroll up once to load more and press it again."
msgstr ""

#: lib/retro_hex_chat_web/controllers/help_content/feature_auto_reconnect.html.heex:56
#, elixir-autogen, elixir-format
msgid "Signing In On Several Screens"
msgstr ""

#: lib/retro_hex_chat_web/controllers/help_content/feature_saved_messages.html.heex:2
#, elixir-autogen, elixir-format
msgid "A chat loses things. The address somebody typed, the link to the build, the paragraph worth reading twice — all of it scrolls. Saving is for the moment you already know you will want it later."
msgstr ""

#: lib/retro_hex_chat_web/controllers/help_content/feature_saved_messages.html.heex:23
#, elixir-autogen, elixir-format
msgid "Getting it back"
msgstr ""

#: lib/retro_hex_chat_web/controllers/help_content/feature_saved_messages.html.heex:7
#, elixir-autogen, elixir-format
msgid "Keeping a line"
msgstr ""

#: lib/retro_hex_chat_web/controllers/help_content/feature_saved_messages.html.heex:15
#, elixir-autogen, elixir-format
msgid "Nobody else can see it"
msgstr ""

#: lib/retro_hex_chat_web/controllers/help_content/feature_saved_messages.html.heex:9
#, elixir-autogen, elixir-format
msgid "Right-click a message — long press on a phone — and choose Save for Later. The same menu offers Remove from Saved on a line you already kept. It works on channel messages and on private ones."
msgstr ""

#: lib/retro_hex_chat_web/controllers/help_content/feature_saved_messages.html.heex:33
#, elixir-autogen, elixir-format
