msgstr "स्क्रीन शेयर"

#: lib/retro_hex_chat_web/controllers/help_content/feature_channel_conference.html.heex:40
#, elixir-autogen, elixir-format
msgid "Screen Sharing"
msgstr "स्क्रीन शेयरिंग"

#: lib/retro_hex_chat_web/controllers/help_content/feature_channel_conference.html.heex:97
