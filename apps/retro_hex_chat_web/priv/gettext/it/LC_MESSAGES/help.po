msgstr "Le conversazioni elencano i canali in cui sei e le tue conversazioni private. Fare clic su uno per aprirlo."

#: lib/retro_hex_chat_web/controllers/help_content/welcome.html.heex:36
#, elixir-autogen, elixir-format
msgid "Finding your way around"
msgstr "Trovare la tua strada"

#: lib/retro_hex_chat_web/controllers/help_content/welcome.html.heex:61
