#: lib/retro_hex_chat_web/controllers/help_content/welcome.html.heex:8
#, elixir-autogen, elixir-format
msgid "It runs in your web browser, so there is nothing to install. The screen looks like a classic desktop with windows, a taskbar and a Start menu, and the chat works like mIRC."
msgstr "Funziona nel tuo browser web, quindi non c'è nulla da installare. Lo schermo sembra un desktop classico con finestre, una barra delle applicazioni e un menu Start, e la chat funziona come mIRC."

#: lib/retro_hex_chat_web/controllers/help_content/welcome.html.heex:64
#, elixir-autogen, elixir-format
msgid "Join another channel: type %{command}."
msgstr "Unisciti a un altro canale: digitare %{command}."

#: lib/retro_hex_chat_web/controllers/help_content/welcome.html.heex:78
