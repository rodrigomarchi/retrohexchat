#: lib/retro_hex_chat_web/controllers/help_content/feature_status_bar.html.heex:16
#, elixir-autogen, elixir-format
msgid "Active group call or P2P session, and the online buddy badge."
msgstr ""
"Chiamata di gruppo o sessione P2P attiva e il badge dei contatti online."

#: lib/retro_hex_chat_web/controllers/help_content/feature_identity_presence.html.heex:34
#, elixir-autogen, elixir-format
msgid "Set away when you are unavailable from File > Account > Set Away, where the Presence tab also lets you set a custom message. The window title bar then shows you as Away."
msgstr ""
"Segnalati assente da File > Account > Imposta Assente, dove la scheda "
"Presenza permette anche un messaggio personalizzato. La barra del titolo "
"della finestra ti mostra allora come Assente."

#: lib/retro_hex_chat_web/controllers/help_content/feature_status_bar.html.heex:2
#, elixir-autogen, elixir-format
msgid "The status bar at the right of the menu bar reports your live session: an active call, who is online from your notify list, how fast the server is answering, and whether sounds are muted."
msgstr ""
"La barra di stato a destra della barra dei menu mostra la tua sessione: una "
"chiamata attiva, chi è online nella tua lista contatti, quanto è veloce la "
"risposta del server e se i suoni sono disattivati."

#: lib/retro_hex_chat_web/controllers/help_content/feature_status_bar.html.heex:13
#, elixir-autogen, elixir-format
msgid "Two Sections"
msgstr "Due Sezioni"

#: lib/retro_hex_chat_web/controllers/help_content/feature_status_bar.html.heex:8
#, elixir-autogen, elixir-format
msgid "Your nickname, your identity state and the conversation you are reading are not repeated here — the chat window's title bar names them."
msgstr ""
"Il tuo nickname, il tuo stato di identità e la conversazione che stai "
"leggendo non si ripetono qui: li indica già la barra del titolo della "
"finestra di chat."

