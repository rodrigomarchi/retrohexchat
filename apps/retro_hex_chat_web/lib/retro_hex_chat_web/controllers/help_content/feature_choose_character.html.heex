<p>
  {dgettext("help_space", "When you open a Space, you see the character creator first.")}
  {dgettext("help_space", "Here you put together who you will be in the Space.")}
</p>
<.help_h4 icon={:icon_community}>{dgettext("help_space", "The Preview")}</.help_h4>
<p>
  {dgettext("help_space", "You see the preview walk and turn.")}
  {dgettext("help_space", "%{left} and %{right} rotate the preview.",
    left: dgettext("chat", "Turn left"),
    right: dgettext("chat", "Turn right")
  )}
</p>
<.help_h4 icon={:icon_tab_control}>{dgettext("help_space", "The Parts")}</.help_h4>
<p>
  {dgettext("help_space", "Each tab is one part: %{parts}.",
    parts:
      Enum.join(
        [
          dpgettext("chat", "character creator", "Body"),
          dpgettext("chat", "character creator", "Skin"),
          dpgettext("chat", "character creator", "Outfit"),
          dpgettext("chat", "character creator", "Hair"),
          dpgettext("chat", "character creator", "Headwear")
        ],
        ", "
      )
  )}
  {dgettext("help_space", "Choose a piece to wear it.")}
  {dgettext("help_space", "%{bald} removes the hair. %{none} removes the hat.",
    bald: dgettext("chat", "Bald"),
    none: dpgettext("chat", "no headwear", "None")
  )}
  {dgettext("help_space", "Under a piece that can be dyed, its colours are shown.")}
  {dgettext("help_space", "An outfit and a hat each have a %{main} and a %{trim}.",
    main: dgettext("chat", "Main colour"),
    trim: dgettext("chat", "Trim colour")
  )}
</p>
<.help_h4 icon={:icon_tab_control}>{dgettext("chat", "Surprise me")}</.help_h4>
<p>
  {dgettext("help_space", "%{surprise} picks every part at random.",
    surprise: dgettext("chat", "Surprise me")
  )}
  {dgettext("help_space", "You can change any part of it afterwards.")}
</p>
<.help_h4 icon={:icon_community}>{dgettext("help_space", "Entering")}</.help_h4>
<p>
  {dgettext("help_space", "%{enter} takes you into the map.", enter: dgettext("chat", "Walk in"))}
  {dgettext("help_space", "Next time, the creator opens with this character.")}
  {dgettext("help_space", "In the chat, its face is shown beside your nickname.")}
</p>
<.help_h4 icon={:icon_community}>{dgettext("help_space", "Changing inside")}</.help_h4>
<p>
  {dgettext("help_space", "%{change} is next to the box you type in, under the map.",
    change: dgettext("chat", "Change character")
  )}
  {dgettext("help_space", "On a small screen, it shows only the face of your character.")}
  {dgettext("help_space", "Press it to open the creator over the map.")}
  {dgettext("help_space", "Change what you like, then press %{wear}.",
    wear: dgettext("chat", "Wear this")
  )}
  {dgettext("help_space", "Everybody sees the change at once.")}
  {dgettext("help_space", "In the chat, the new character appears beside your nickname.")}
  {dgettext("help_space", "Cancel keeps the character you have.")}
</p>
