<p>
  {dgettext(
    "help_commands",
    "Opens Hex Radio, the internet radio player: thousands of stations from around the world, by genre or by name."
  )}
</p>
<.help_h4 icon={:icon_code}>{dgettext("help_commands", "Syntax")}</.help_h4>
<pre>{dgettext("help_commands", "/radio")}</pre>
<.help_h4 icon={:icon_tab_control}>{dgettext("help_commands", "How It Works")}</.help_h4>
<p>
  {dgettext(
    "help_commands",
    "Opens the Hex Radio window, or brings it to the front when it is already open — the same window Start > Accessories > Hex Radio opens."
  )}
</p>
<.help_h4 icon={:icon_radio}>{dgettext("help_commands", "What You Can Do There")}</.help_h4>
<ul>
  <li>
    {dgettext(
      "help_commands",
      "Listen to the most played stations, a genre's stations, or find one by name"
    )}
  </li>
  <li>{dgettext("help_commands", "Star the stations you like to find them again")}</li>
  <li>
    {dgettext(
      "help_commands",
      "Watch the spectrum or the oscilloscope and shape the sound with the equalizer"
    )}
  </li>
</ul>
<.help_h4 icon={:icon_rules}>{dgettext("help_commands", "Rules & Limits")}</.help_h4>
<ul>
  <li>{dgettext("help_commands", "Needs an account: a visitor is asked to register first")}</li>
  <li>{dgettext("help_commands", "Closing the window stops the music")}</li>
</ul>
<.help_h4 icon={:icon_lightbulb}>{dgettext("help_commands", "Examples")}</.help_h4>
<pre>{dgettext("help_commands", "/radio")}</pre>
<.help_h4 icon={:icon_link}>{dgettext("help_commands", "See Also")}</.help_h4>
<p>
  <.help_link topic="ui-hex-radio">Hex Radio</.help_link>
</p>
