<p>
  {dgettext(
    "help_features",
    "Nick Colors lets you pin a specific color to a nickname. Without an override, RetroHexChat derives a color from the nickname itself, so the same person always looks the same — an override wins whenever you want a particular person to stand out."
  )}
</p>
<.help_h4 icon={:icon_dialog_nick_colors}>
  {dgettext("help_features", "Assigning a Color")}
</.help_h4>
<p>
  {dgettext(
    "help_features",
    "Choose Add, type the nickname, and pick a swatch from the 16-color IRC palette. Select an existing row and choose Edit to change its color, or Remove to fall back to the automatic color."
  )}
</p>
<.help_h4 icon={:icon_folder}>{dgettext("help_features", "Opening")}</.help_h4>
<p>
  {dgettext("help_features", "Go to")} <strong>{dgettext("help_features", "Tools > Nick Colors")}</strong>{dgettext(
    "help_features",
    ", or right-click a nickname and choose Set Nick Color."
  )}
</p>
<.help_h4 icon={:icon_link}>{dgettext("help_features", "See Also")}</.help_h4>
<p>
  <.help_link topic="feature-address-book">
    {dgettext("help_features", "Address Book")}
  </.help_link>
  ·
  <.help_link topic="feature-context-menus">
    {dgettext("help_features", "Context Menus")}
  </.help_link>
</p>
