<p>
  {dgettext(
    "help_features",
    "The small flag in front of a nickname is the language that person uses the chat in. You see it in the conversation, in the user list, in private messages, on the card somebody sees when they look you up, and above people in a virtual space."
  )}
</p>
<.help_h4 icon={:icon_globe}>{dgettext("help_features", "Changing Yours")}</.help_h4>
<p>
  {dgettext(
    "help_features",
    "Your flag is the language you pick under Start ▸ Language. Pick another one and the chat reopens in it, and everybody else's user list shows your new flag."
  )}
</p>
<.help_h4 icon={:icon_warning}>{dgettext("help_features", "Who Has One")}</.help_h4>
<p>
  {dgettext(
    "help_features",
    "Everybody, visitors included. Somebody whose own language the chat does not offer reads it in English, so their flag is the English one."
  )}
</p>
<.help_h4 icon={:icon_link}>{dgettext("help_features", "See Also")}</.help_h4>
<p>
  <.help_link topic="feature-character-portraits">
    {dgettext("help", "Character Portraits")}
  </.help_link>
  ·
  <.help_link topic="ui-start-menu">
    {dgettext("help", "The Start Menu")}
  </.help_link>
</p>
