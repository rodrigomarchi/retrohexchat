<p>
  {dgettext(
    "help_commands",
    "Opens Hex Paint, the pixel drawing program: draw in the sixteen chat colours and post the picture to a channel."
  )}
</p>
<.help_h4 icon={:icon_code}>{dgettext("help_commands", "Syntax")}</.help_h4>
<pre>{dgettext("help_commands", "/paint")}</pre>
<.help_h4 icon={:icon_tab_control}>{dgettext("help_commands", "How It Works")}</.help_h4>
<p>
  {dgettext(
    "help_commands",
    "Opens the Hex Paint window, or brings it to the front when it is already open — the same window Start > Accessories > Hex Paint opens."
  )}
</p>
<.help_h4 icon={:icon_paint}>{dgettext("help_commands", "What You Can Do There")}</.help_h4>
<ul>
  <li>
    {dgettext(
      "help_commands",
      "Draw on a grid of 32, 64 or 128 pixels a side in the sixteen chat colours"
    )}
  </li>
  <li>
    {dgettext(
      "help_commands",
      "Use a pencil, lines, rectangles, ellipses, a fill and an eraser, with undo and redo"
    )}
  </li>
  <li>
    {dgettext(
      "help_commands",
      "Post the picture to a channel or a private conversation, with a line of text"
    )}
  </li>
  <li>
    {dgettext(
      "help_commands",
      "Save it to your computer as a PNG, or turn it into text art in ASCII Art"
    )}
  </li>
</ul>
<.help_h4 icon={:icon_rules}>{dgettext("help_commands", "Rules & Limits")}</.help_h4>
<ul>
  <li>{dgettext("help_commands", "Needs an account: a visitor is asked to register first")}</li>
  <li>
    {dgettext("help_commands", "The drawing is kept in your browser while the window is closed")}
  </li>
</ul>
<.help_h4 icon={:icon_lightbulb}>{dgettext("help_commands", "Examples")}</.help_h4>
<pre>{dgettext("help_commands", "/paint")}</pre>
<.help_h4 icon={:icon_link}>{dgettext("help_commands", "See Also")}</.help_h4>
<p>
  <.help_link topic="ui-hex-paint">Hex Paint</.help_link>
</p>
