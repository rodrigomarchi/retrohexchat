<p>
  {dgettext(
    "help_features",
    "The Address Book (Ctrl+Shift+A) is your saved-contacts list: store notes about people you talk to. Nick colors, the ignore list and notify tracking each have their own window."
  )}
</p>
<.help_h4 icon={:icon_dialog_address_book}>{dgettext("help_features", "Contacts")}</.help_h4>
<p>
  {dgettext(
    "help_features",
    "Add a contact with an optional note, edit the note later, or remove the entry. The list shows when you first talked to each person, in your timezone."
  )}
</p>
<.help_h4 icon={:icon_link}>{dgettext("help_features", "Related Windows")}</.help_h4>
<p>
  <strong>{dgettext("help_features", "Nick Colors:")}</strong>
  {dgettext("help_features", "override display colors for specific nicks across the UI.")}<br />
  <strong>{dgettext("help_features", "Ignore List:")}</strong>
  {dgettext(
    "help_features",
    "per-type ignore entries for messages, PMs, actions, notices, and invites."
  )}<br />
  <strong>{dgettext("help_features", "Notify List:")}</strong>
  {dgettext("help_features", "track when specific nicknames come online.")}
</p>
<.help_h4 icon={:icon_folder}>{dgettext("help_features", "Opening")}</.help_h4>
<p>
  {dgettext("help_features", "Press")} <strong>{dgettext("help_features", "Ctrl+Shift+A")}</strong>{dgettext(
    "help_features",
    ", use the toolbar button, or go to"
  )} <strong>{dgettext("help_features", "Tools > Address Book")}</strong>.
</p>
<.help_h4 icon={:icon_link}>{dgettext("help_features", "See Also")}</.help_h4>
<p>
  <.help_link topic="feature-notify-list">{dgettext("help_features", "Notify List")}</.help_link>
  ·
  <.help_link topic="feature-highlight-words">
    {dgettext("help_features", "Highlight Words")}
  </.help_link>
</p>
