<p>
  {dgettext(
    "help_space",
    "In a space, Q raises a hand to say hello. Z starts or stops a dance. Each one also has a button on the screen."
  )}
</p>
<.help_h4 icon={:icon_tab_control}>{dgettext("chat", "Wave")}</.help_h4>
<p>
  {dgettext("help_space", "Press Q to raise a hand and say hello.")}
  {dgettext("help_space", "Everybody in the space can see it.")}
  {dgettext("help_space", "There is also a button for it on the screen.")}
  {dgettext("help_space", "A seated character cannot say hello.")}
</p>
<.help_h4 icon={:icon_community}>{dgettext("chat", "Dance")}</.help_h4>
<p>
  {dgettext("help_space", "Press Z to start dancing, and Z again to stop.")}
  {dgettext("help_space", "There is also a button for it on the screen.")}
  {dgettext("help_space", "The dance goes on until you stop it.")}
  {dgettext("help_space", "Walking or sitting down ends the dance.")}
  {dgettext("help_space", "People who arrive later also see you dance.")}
  {dgettext("help_space", "Dancing does not stop you from greeting or attacking.")}
</p>
