<p>
  {dgettext(
    "help_arcade",
    "The Solo Arcade lets you play classic FPS games directly in your browser via WebAssembly. No downloads, no plugins — the game engine runs natively in your browser."
  )}
</p>
<.help_h4 icon={:icon_send}>{dgettext("help_arcade", "Starting an Arcade Session")}</.help_h4>
<p>
  {dgettext(
    "help_arcade",
    "Open the "
  )}<strong>{dgettext("help_arcade", "Games")}</strong> {dgettext(
    "help_arcade",
    "menu and choose"
  )} <strong>{dgettext(
    "help_arcade",
    "Arcade"
  )}</strong>{dgettext("help_arcade", ".")}
</p>
<p>
  {dgettext(
    "help_arcade",
    "A window opens right on the chat desktop with game icons. Choose an icon to review the game details, then press Start Game to open it in a new browser window. You must be registered and identified ("
  )}<code>{dgettext("help_arcade", "/ns identify")}</code>{dgettext("help_arcade", ") to play.")}
</p>
<p>
  {dgettext(
    "help_arcade",
    "While a game is running, Back closes the current game window and returns to the icon launcher."
  )}
</p>
<.help_h4 icon={:icon_game_halflife}>
  {dgettext("help_arcade", "Available Games — Half-Life Engine")}
</.help_h4>
<ul>
  <li>
    <.help_link topic="feature-arcade-halflife-uplink">
      Half-Life: Uplink
    </.help_link>
    {dgettext("help_arcade", "— The official Valve demo with 3 unique missions (1999)")}
  </li>
</ul>
<.help_h4 icon={:icon_game_wolfenstein}>
  {dgettext("help_arcade", "Available Games — Wolf3D Engine")}
</.help_h4>
<ul>
  <li>
    <.help_link topic="feature-arcade-wolfenstein-3d">
      Wolfenstein 3D: Escape from Castle
    </.help_link>
    {dgettext("help_arcade", "— The shareware Episode 1 (1992) — the grandfather of FPS games")}
  </li>
</ul>
<.help_h4 icon={:icon_game_arcade}>
  {dgettext("help_arcade", "Available Games — DOOM Engine")}
</.help_h4>
<ul>
  <li>
    <.help_link topic="feature-arcade-doom-shareware">
      DOOM: Knee-Deep in the Dead
    </.help_link>
    {dgettext("help_arcade", "— The original shareware Episode 1 (1993)")}
  </li>
  <li>
    <.help_link topic="feature-arcade-freedoom1">
      Freedoom: Phase 1
    </.help_link>
    {dgettext("help_arcade", "— 36 levels of open-source DOOM (BSD license)")}
  </li>
  <li>
    <.help_link topic="feature-arcade-freedoom2">
      Freedoom: Phase 2
    </.help_link>
    {dgettext("help_arcade", "— 32 levels, Doom II compatible (BSD license)")}
  </li>
  <li>
    <.help_link topic="feature-arcade-freedm">FreeDM</.help_link>
    {dgettext("help_arcade", "— 32 deathmatch arenas (BSD license)")}
  </li>
  <li>
    <.help_link topic="feature-arcade-chex-quest">
      Chex Quest
    </.help_link>
    {dgettext("help_arcade", "— The 1996 cereal box classic")}
  </li>
  <li>
    <.help_link topic="feature-arcade-hacx">
      HacX: Twitch 'n Kill
    </.help_link>
    {dgettext("help_arcade", "— Cyberpunk total conversion")}
  </li>
  <li>
    <.help_link topic="feature-arcade-rekkr">
      REKKR: Sunken Land
    </.help_link>
    {dgettext("help_arcade", "— Viking-themed standalone")}
  </li>
</ul>
<.help_h4 icon={:icon_game_quake}>
  {dgettext("help_arcade", "Available Games — Quake Engine")}
</.help_h4>
<ul>
  <li>
    <.help_link topic="feature-arcade-quake-shareware">
      Quake: Dimension of the Doomed
    </.help_link>
    {dgettext("help_arcade", "— The original shareware Episode 1 (1996)")}
  </li>
  <li>
    <.help_link topic="feature-arcade-librequake">
      LibreQuake
    </.help_link>
    {dgettext("help_arcade", "— Open-source Quake replacement (BSD license)")}
  </li>
</ul>
<.help_h4 icon={:icon_game_quake2}>
  {dgettext("help_arcade", "Available Games — Quake II Engine")}
</.help_h4>
<ul>
  <li>
    <.help_link topic="feature-arcade-quake2-shareware">
      Quake II: The Invasion
    </.help_link>
    {dgettext("help_arcade", "— The official demo (1997) — Unit 1 of the singleplayer campaign")}
  </li>
</ul>
<.help_h4 icon={:icon_webrtc}>{dgettext("help_arcade", "Technology")}</.help_h4>
<p>
  {dgettext("help_arcade", "%{game} is powered by", game: "Half-Life: Uplink")}
  <strong>Xash3D-FWGS</strong>
  {dgettext("help_arcade", "(%{engine} reimplementation compiled to WebAssembly).",
    engine: "GoldSource"
  )}
  {dgettext("help_arcade", "%{game} is powered by", game: "Wolfenstein 3D")}
  <strong>ECWolf-JS</strong>
  {dgettext("help_arcade", "(%{engine} compiled to WebAssembly via Emscripten).",
    engine: "ECWolf"
  )}
  {dgettext("help_arcade", "%{engine} games are powered by", engine: "DOOM")}
  <strong>Dwasm</strong>
  {dgettext("help_arcade", "(%{engine} compiled to WebAssembly).", engine: "PrBoom+")}
  {dgettext("help_arcade", "%{engine} games are powered by", engine: "Quake")}
  <strong>Qwasm</strong>
  {dgettext("help_arcade", "(%{engine} compiled to WebAssembly).", engine: "QuakeSpasm")}
  {dgettext("help_arcade", "%{game} is powered by", game: "Quake II")}
  <strong>Qwasm2</strong>
  {dgettext(
    "help_arcade",
    "(%{engine} compiled to WebAssembly). All support keyboard, mouse, and gamepad input.",
    engine: "Yamagi Quake II"
  )}
</p>
<.help_h4 icon={:icon_clock}>{dgettext("help_arcade", "Session Timeouts")}</.help_h4>
<p>
  {dgettext(
    "help_arcade",
    "Pending sessions expire in 5 minutes. The lobby expires after 15 minutes of inactivity (with a warning at 10 minutes)."
  )}
</p>
<.help_h4 icon={:icon_link}>{dgettext("help_arcade", "See Also")}</.help_h4>
<p>
  <.help_link topic="feature-arcade-halflife">
    Half-Life (Arcade)
  </.help_link>
  ·
  <.help_link topic="feature-arcade-wolfenstein">
    Wolfenstein 3D (Arcade)
  </.help_link>
  · <.help_link topic="feature-arcade-doom">DOOM (Arcade)</.help_link>
  ·
  <.help_link topic="feature-arcade-quake">
    Quake (Arcade)
  </.help_link>
  ·
  <.help_link topic="feature-arcade-quake2">
    Quake II (Arcade)
  </.help_link>
  ·
  <.help_link topic="feature-arcade-scummvm">
    {dgettext("help_arcade", "ScummVM Adventures")}
  </.help_link>
</p>
