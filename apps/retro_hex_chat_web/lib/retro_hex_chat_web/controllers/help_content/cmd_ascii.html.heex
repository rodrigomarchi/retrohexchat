<p>
  {dgettext(
    "help_commands",
    "Opens ASCII Art: turn a word, a picture or a Hex Paint drawing into text art in mIRC colours and post it to a channel as one message."
  )}
</p>
<.help_h4 icon={:icon_code}>{dgettext("help_commands", "Syntax")}</.help_h4>
<pre>{dgettext("help_commands", "/ascii")}</pre>
<.help_h4 icon={:icon_tab_control}>{dgettext("help_commands", "How It Works")}</.help_h4>
<p>
  {dgettext(
    "help_commands",
    "Opens the ASCII Art window, or brings it to the front when it is already open — the same window Start > Accessories > ASCII Art opens."
  )}
</p>
<.help_h4 icon={:icon_ascii_art}>{dgettext("help_commands", "What You Can Do There")}</.help_h4>
<ul>
  <li>
    {dgettext(
      "help_commands",
      "Write a word in big letters made of blocks, hashes or shaded blocks, in one colour, a rainbow or two tones"
    )}
  </li>
  <li>
    {dgettext(
      "help_commands",
      "Turn a picture from your computer into coloured blocks or characters; the picture is never uploaded"
    )}
  </li>
  <li>{dgettext("help_commands", "Turn your Hex Paint drawing into text art")}</li>
  <li>
    {dgettext("help_commands", "Post the art as one message, or copy it with its colour codes")}
  </li>
</ul>
<.help_h4 icon={:icon_rules}>{dgettext("help_commands", "Rules & Limits")}</.help_h4>
<ul>
  <li>{dgettext("help_commands", "At most 30 lines of 100 characters in one block")}</li>
  <li>{dgettext("help_commands", "Needs an account: a visitor is asked to register first")}</li>
</ul>
<.help_h4 icon={:icon_lightbulb}>{dgettext("help_commands", "Examples")}</.help_h4>
<pre>{dgettext("help_commands", "/ascii")}</pre>
<.help_h4 icon={:icon_link}>{dgettext("help_commands", "See Also")}</.help_h4>
<p>
  <.help_link topic="ui-ascii-art">{dgettext("help_commands", "ASCII Art")}</.help_link>
</p>
