<p>
  {dgettext("help_features", "Toggle the visibility of UI elements from the")}
  <strong>{dgettext("help_features", "View")}</strong> {dgettext("help_features", "menu.")}
</p>
<.help_h4 icon={:icon_group_view}>{dgettext("help_features", "Available Toggles")}</.help_h4>
<p>
  <strong>{dgettext("help_features", "Toggle Conversations:")}</strong>
  {dgettext("help_features", "Show or hide the left-side channel/PM tree.")}<br />
  <strong>
    {dgettext("help_features", "Toggle Nicklist:")}
  </strong>
  {dgettext("help_features", "Show or hide the right-side user list.")}
</p>
<.help_h4 icon={:icon_lightbulb}>{dgettext("help_features", "When It Helps")}</.help_h4>
<p>
  {dgettext(
    "help_features",
    "Hide both side panels when you want the whole window for the conversation. This is useful on a small screen, or when you read a long discussion. Show them again when you want to switch conversations or see who is in the channel."
  )}
</p>
<.help_h4 icon={:icon_terminal}>{dgettext("help_features", "How to Use It")}</.help_h4>
<ol>
  <li>{dgettext("help_features", "Open the View menu in the chat window.")}</li>
  <li>
    {dgettext(
      "help_features",
      "Choose Toggle Conversations or Toggle Nicklist. Each click switches the panel between shown and hidden."
    )}
  </li>
  <li>
    {dgettext(
      "help_features",
      "You can also use the Conversations and Users buttons in the chat window toolbar, or the View group in the Start menu."
    )}
  </li>
</ol>
<.help_h4 icon={:icon_group_view}>
  {dgettext("help_features", "More Options in the View Menu")}
</.help_h4>
<ul>
  <li>
    <strong>{dgettext("help_features", "Strip Formatting:")}</strong>
    {dgettext(
      "help_features",
      "Shows messages without their colors, bold and other formatting codes."
    )}
  </li>
  <li>
    <strong>{dgettext("help_features", "Character Portraits:")}</strong>
    {dgettext(
      "help_features",
      "Shows or hides the chosen character picture beside each nickname."
    )}
  </li>
</ul>
<.help_h4 icon={:icon_document_alert}>{dgettext("help_features", "Notes")}</.help_h4>
<p>
  {dgettext(
    "help_features",
    "When the conversations panel is hidden, the Conversations button shows a number if another conversation has new messages. On a phone, the two panels open as drawers over the messages. Tap outside a drawer to close it."
  )}
</p>
<.help_h4 icon={:icon_link}>{dgettext("help_features", "See Also")}</.help_h4>
<p>
  <.help_link topic="keyboard-shortcuts">
    {dgettext("help_features", "Keyboard Shortcuts")}
  </.help_link>
</p>
