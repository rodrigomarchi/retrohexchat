<p class="text-sm mb-retro-8">
  {dgettext(
    "landing",
    "The display draws the music as a spectrum of bars or as an oscilloscope line."
  )}
  {dgettext(
    "landing",
    "Open the ten-band equalizer to raise the bass or soften the treble, and put it back to flat with one click."
  )}
</p>
<.inset tone="screen" class="p-1">
  <.screenshot
    {@shots["radio_equalizer"]}
    alt={dgettext("landing", "Hex Radio with its ten-band equalizer open under the spectrum")}
    sizes="(min-width: 760px) 740px, 100vw"
  />
</.inset>
