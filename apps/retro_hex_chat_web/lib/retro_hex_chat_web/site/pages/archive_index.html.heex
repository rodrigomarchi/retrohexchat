<section id="archive-index" class="flex h-full min-h-0 flex-col" aria-labelledby="archive-heading">
  <.topic_bar
    heading_id="archive-heading"
    channel_name={@channel}
    topic={dgettext("chat", "Archive")}
    locale={@channel_locale}
    category={@channel_category}
    class="shrink-0"
  />

  <.chat_message_list fill testid="archive-index-list">
    <.chat_message type="system" source={dgettext("chat", "System")}>
      * {dgettext(
        "landing",
        "Everything said here since the channel opened its archive, one page per day. Nothing from before it was opened is published."
      )}
    </.chat_message>

    <%!-- The rows the help window's tree lists its topics in, inside the
          conversation's own field, each a link so a robot follows it to the day. --%>
    <nav class="mt-retro-4" data-testid="archive-days">
      <.link :for={day <- @days} patch={~p"/archive/#{@slug}/#{day}"} class="block no-underline">
        <.tree_view_item>
          <:icon><Icons.icon_tab_channel class="h-3 w-3" /></:icon>
          <span class="tabular-nums">{day}</span>
        </.tree_view_item>
      </.link>
    </nav>
  </.chat_message_list>

  <.archive_actions slug={@slug} channel={@channel} />
</section>
