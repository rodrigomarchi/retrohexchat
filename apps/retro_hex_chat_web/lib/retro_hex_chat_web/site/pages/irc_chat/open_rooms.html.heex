<.section_heading>{dgettext("landing", "Read a chat room first")}</.section_heading>
<p class="text-sm mb-2">
  {dgettext(
    "landing",
    "These chat rooms publish what is said in them, so you can read the conversation before you join."
  )}
</p>
<ul class="text-sm columns-2 gap-4" data-testid="open-rooms">
  <li :for={room <- @rooms}>
    <.channel_badges category={room.category} locale={room.locale} class="mr-1" />
    <.link patch={room.path} class="underline">{room.name}</.link>
  </li>
</ul>
