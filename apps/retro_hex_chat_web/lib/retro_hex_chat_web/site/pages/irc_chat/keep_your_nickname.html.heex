<.section_heading>{dgettext("landing", "Your nickname")}</.section_heading>
<p class="text-sm">
  {dgettext("landing", "Pick any nickname that is not taken.")}
  {dgettext(
    "landing",
    "To keep your nickname, register it with %{register} and a password.",
    register: "/ns register"
  )}
  {dgettext("landing", "When you come back, identify with %{identify}.", identify: "/ns identify")}
</p>
