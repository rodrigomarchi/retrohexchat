<.section_heading>
  {dgettext("landing", "Real-time chat. Zero refresh. Zero loading.")}
</.section_heading>
<.inset tone="canvas" class="p-3 mb-2">
  <.chat_mockup />
</.inset>
<.feature_list>
  <:item icon={:icon_websocket}>{dgettext("landing", "Real-time messages via")}
    <strong>{dgettext("landing", "WebSocket")}</strong></:item>
  <:item icon={:icon_fmt_emoji}>
    {dgettext("landing", "Emoji reactions and inline formatting")}
  </:item>
  <:item icon={:icon_chat}>
    {dgettext("landing", "Replies with quoted context and direct messages")}
  </:item>
  <:item icon={:icon_link}>{dgettext("landing", "Link previews with rich metadata")}</:item>
</.feature_list>
<p class="text-xs mt-2 flex flex-wrap gap-x-retro-8 gap-y-retro-2">
  <.link
    patch={@paint_path}
    class="inline-flex items-center gap-1 underline"
    data-testid="features-paint-link"
  >
    <Icons.icon_paint class="w-3 h-3 shrink-0" />
    {dgettext("landing", "Draw pixel art to post with Hex Paint")}
  </.link>
  <.link
    patch={@ascii_art_path}
    class="inline-flex items-center gap-1 underline"
    data-testid="features-ascii-art-link"
  >
    <Icons.icon_ascii_art class="w-3 h-3 shrink-0" />
    {dgettext("landing", "Make ASCII art in mIRC colours")}
  </.link>
  <.link
    patch={@radio_path}
    class="inline-flex items-center gap-1 underline"
    data-testid="features-radio-link"
  >
    <Icons.icon_radio class="w-3 h-3 shrink-0" />
    {dgettext("landing", "Listen to internet radio with Hex Radio")}
  </.link>
</p>
