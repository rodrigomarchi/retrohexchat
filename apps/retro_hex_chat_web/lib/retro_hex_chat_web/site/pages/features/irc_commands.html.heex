<.section_heading>
  {dgettext("landing", "Powerful IRC-style commands.")}
</.section_heading>
<.inset tone="canvas" class="p-3 mb-2">
  <.commands_mockup />
</.inset>
<p class="text-sm">{dgettext("landing", "Over 50 commands with smart autocomplete.")}</p>
<p class="text-xs mt-2">
  <.link
    patch={@mirc_commands_path}
    class="inline-flex items-center gap-1 underline"
    data-testid="features-mirc-commands-link"
  >
    <Icons.icon_terminal class="w-3 h-3 shrink-0" />
    {dgettext("landing", "Coming from mIRC? See which commands work the same")}
  </.link>
</p>
