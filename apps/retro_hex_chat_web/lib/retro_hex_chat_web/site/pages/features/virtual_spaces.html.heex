<.section_heading>
  {dgettext("landing", "Every channel can become a shared 8-bit room.")}
</.section_heading>
<.inset tone="screen" class="p-1 mb-2">
  <img
    src={Endpoint.static_path("/images/landing/space_end_of_time_showcase.png")}
    alt={
      dgettext(
        "landing",
        "End of Time Space map with avatars and in-world chat bubbles"
      )
    }
    class="block w-full h-auto"
    loading="lazy"
  />
</.inset>
<.feature_list>
  <:item icon={:icon_group_view}>
    {dgettext("landing", "Open a channel's Space with the Space button next to its tab")}
  </:item>
  <:item icon={:icon_palette}>
    {dgettext("landing", "Choose an avatar before entering the shared map")}
  </:item>
  <:item icon={:icon_security}>
    {dgettext(
      "landing",
      "Server-validated movement, collision, seating, and interactions"
    )}
  </:item>
  <:item icon={:icon_chat}>
    {dgettext(
      "landing",
      "Channel and DM messages appear as bubbles in the same conversation"
    )}
  </:item>
</.feature_list>
<p class="text-xs mt-2">
  <.page_link page={:spaces} class="inline-flex items-center gap-1 underline">
    <Icons.icon_group_view class="w-3 h-3 shrink-0" />
    {dgettext("landing", "Places to go")}
  </.page_link>
</p>
