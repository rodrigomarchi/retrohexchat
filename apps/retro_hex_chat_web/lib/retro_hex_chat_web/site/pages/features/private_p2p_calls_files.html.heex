<.section_heading>
  {dgettext("landing", "Direct 1:1 connections between people.")}
</.section_heading>
<.inset
  class="p-3 mb-2"
  aria-label={dgettext("landing", "Voice call mockup")}
>
  <.diagram_voice_call_mockup class="w-full max-w-lg mx-auto" />
</.inset>
<.feature_list>
  <:item icon={:icon_microphone}>
    {dgettext("landing", "Private voice calls — direct P2P via WebRTC")}
  </:item>
  <:item icon={:icon_camera}>
    {dgettext("landing", "Video calls with camera toggle and PiP")}
  </:item>
  <:item icon={:icon_file_send}>
    {dgettext("landing", "File transfer — send files directly, no upload")}
  </:item>
  <:item icon={:icon_shield}>
    {dgettext("landing", "WebRTC encrypted with TURN relay fallback")}
  </:item>
</.feature_list>
