<.section_heading>
  {dgettext("landing", "Classic games in your browser.")}
</.section_heading>
<.inset class="p-3 mb-2">
  <.arcade_game_links groups={@arcade} data-testid="features-arcade-games" />
</.inset>
<.feature_list>
  <:item icon={:icon_game_arcade}>
    {dgettext("landing", "Open %{arcade} on the desktop, or pick a game in the catalogue",
      arcade: dgettext("ui", "Arcade")
    )}
  </:item>
  <:item icon={:icon_btn_open}>
    {dgettext(
      "landing",
      "See its screenshot, keyboard controls and tips, then press %{play}. The game opens in a tab of its own.",
      play: dgettext("games", "Play now")
    )}
  </:item>
  <:item icon={:icon_code}>
    {dgettext("landing", "Runs entirely in the browser via WebAssembly")}
  </:item>
  <:item icon={:icon_laptop}>
    {dgettext("landing", "No downloads, no plugins")}
  </:item>
</.feature_list>
<.catalogue_link path={@catalogue_path} data-testid="features-arcade-catalogue-link" />
