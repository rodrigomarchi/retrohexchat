<.section_heading>
  {dgettext("landing", "CHM-style help system built in.")}
</.section_heading>
<.inset tone="canvas" class="p-3 mb-2">
  <.help_mockup />
</.inset>
<.feature_list>
  <:item icon={:icon_btn_help_topics}>{dgettext("landing", "Open Help Topics or type")}
    <strong>{dgettext("landing", "/help")}</strong> anywhere</:item>
  <:item icon={:icon_btn_search}>
    {dgettext("landing", "Searchable topics with keyword matching")}
  </:item>
  <:item icon={:icon_link}>{dgettext("landing", "Cross-referenced “See Also” links")}</:item>
</.feature_list>
