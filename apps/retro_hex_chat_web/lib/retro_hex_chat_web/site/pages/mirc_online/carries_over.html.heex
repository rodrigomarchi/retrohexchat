<.section_heading>{dgettext("landing", "What stays the same")}</.section_heading>
<ul class="text-sm list-disc pl-5 space-y-1 mb-3">
  <li>
    {dgettext(
      "landing",
      "The everyday commands: /join, /msg, /query, /me, /whois, /away and the rest."
    )}
  </li>
  <li>
    {dgettext(
      "landing",
      "Aliases, timers, a perform list run on every connect, and your own right-click popups."
    )}
  </li>
  <li>
    {dgettext(
      "landing",
      "Owners, operators, half-ops and voice, with channel modes such as +m, +i, +k and +t."
    )}
  </li>
  <li>
    {dgettext(
      "landing",
      "NickServ to keep your nickname and ChanServ to keep your channel."
    )}
  </li>
  <li>
    {dgettext("landing", "A notify list for friends, and an ignore list for everyone else.")}
  </li>
</ul>
<.link patch={@commands_path} class="text-sm underline">
  {dgettext("landing", "Which mIRC commands work here, one by one")}
</.link>
