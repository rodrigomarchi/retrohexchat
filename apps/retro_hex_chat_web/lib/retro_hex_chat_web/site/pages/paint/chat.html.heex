<p class="text-sm mb-retro-8">
  {dgettext(
    "landing",
    "A drawing arrives in the conversation as a picture, every pixel a sharp square."
  )}
  {dgettext(
    "landing",
    "Turn it into text art with ASCII Art and it arrives as coloured characters instead."
  )}
</p>
<.inset tone="screen" class="p-1">
  <.screenshot
    {@shots["in_chat"]}
    alt={
      dgettext(
        "landing",
        "A channel with a pixel-art heart and a rainbow text banner posted in it"
      )
    }
    sizes="(min-width: 760px) 740px, 100vw"
  />
</.inset>
