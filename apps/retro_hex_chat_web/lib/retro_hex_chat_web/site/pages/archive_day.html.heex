<section id="archive-day" class="flex h-full min-h-0 flex-col" aria-labelledby="archive-heading">
  <.topic_bar
    heading_id="archive-heading"
    channel_name={@channel}
    topic={@date}
    locale={@channel_locale}
    category={@channel_category}
    class="shrink-0"
  />

  <.chat_message_list fill testid="archive-lines">
    <div :for={entry <- @entries} id={"line-#{entry.id}"} role="article" class="chat-message">
      <.chat_message
        timestamp={at(entry.at)}
        meta_title={at_full(entry.at)}
        type={if entry.action?, do: "action", else: "normal"}
        nick={entry.author}
        nick_color={ChatHelpers.default_nick_color(entry.author)}
        locale={Map.get(@locales, entry.author)}
        band={band(@runs, entry.id)}
        continuation={continuation?(@runs, entry.id)}
      >
        <span :if={entry.action?}>*</span>
        {entry.text}
        <%!-- A file was part of what was said, and the archive publishes no
              files: saying so keeps a line that is nothing but an attachment
              from reading as a line where somebody said nothing. --%>
        <.attachment_placeholder :if={entry.attachment?} />
        <.edited_tag :if={entry.edited_at} timestamp={edited_at(entry.edited_at)} />
      </.chat_message>
    </div>
  </.chat_message_list>

  <.archive_actions slug={@slug} channel={@channel}>
    <nav
      :if={@prev_path || @next_path}
      class="flex items-center gap-retro-4"
      aria-label={dgettext("landing", "Pages of this day")}
      data-testid="archive-pager"
    >
      <.button :if={@prev_path} patch={@prev_path} rel="prev" variant="outline" size="sm">
        <:icon><Icons.icon_btn_prev class="h-4 w-4" /></:icon>
        {dgettext("landing", "Earlier")}
      </.button>
      <.button :if={@next_path} patch={@next_path} rel="next" variant="outline" size="sm">
        <:icon><Icons.icon_btn_next class="h-4 w-4" /></:icon>
        {dgettext("landing", "Later")}
      </.button>
    </nav>
    <.button patch={~p"/archive/#{@slug}"} variant="outline" size="sm">
      <:icon><Icons.icon_clock class="h-4 w-4" /></:icon>
      {dgettext("landing", "All days")}
    </.button>
  </.archive_actions>
</section>
