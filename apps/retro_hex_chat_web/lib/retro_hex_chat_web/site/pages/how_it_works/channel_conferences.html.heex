<.section_heading>
  {dgettext("landing", "Group calls use your server as the media router.")}
</.section_heading>
<div class="space-y-2 mb-3">
  <.inset class="p-2 text-xs">
    <strong>
      <Icons.icon_server class="w-4 h-4 inline" /> {dgettext(
        "landing",
        "Self-hosted SFU"
      )}
    </strong>
    <br /> {dgettext(
      "landing",
      "Each browser sends media to the room server; the room server routes streams to the other participants."
    )}
  </.inset>
  <.inset class="p-2 text-xs">
    <strong>
      <Icons.icon_call_participants class="w-4 h-4 inline" /> {dgettext(
        "landing",
        "Channel membership"
      )}
    </strong>
    <br /> {dgettext(
      "landing",
      "Conference access follows the channel membership and moderation model."
    )}
  </.inset>
  <.inset class="p-2 text-xs">
    <strong>
      <Icons.icon_call_lock class="w-4 h-4 inline" /> {dgettext(
        "landing",
        "Moderation controls"
      )}
    </strong>
    <br /> {dgettext(
      "landing",
      "Operators can lock the room, mute participants, disable cameras, manage screen sharing, or end the conference."
    )}
  </.inset>
</div>
