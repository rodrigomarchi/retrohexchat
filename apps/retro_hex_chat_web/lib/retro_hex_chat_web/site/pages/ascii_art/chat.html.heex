<p class="text-sm mb-retro-8">
  {dgettext(
    "landing",
    "Text art arrives as one message, every character in its column, so nobody's screen fills with a flood of lines."
  )}
  {dgettext(
    "landing",
    "A picture you turn into art stays on your computer: only the characters are posted."
  )}
</p>
<.inset tone="screen" class="p-1">
  <.screenshot
    {@shots["in_chat"]}
    alt={
      dgettext(
        "landing",
        "A channel with a pixel-art heart and a rainbow text banner posted in it"
      )
    }
    sizes="(min-width: 760px) 740px, 100vw"
  />
</.inset>
