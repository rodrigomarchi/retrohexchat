<ol class="list-decimal space-y-retro-4 pl-retro-16 text-sm" data-testid="ascii-art-steps">
  <li>{dgettext("chat", "An account only needs a nickname and a password.")}</li>
  <li>
    {dgettext(
      "landing",
      "Open Start, then Accessories, then ASCII Art, or type /ascii in the chat."
    )}
  </li>
  <li>{dgettext("landing", "Type a word, then choose File, then Post to channel.")}</li>
</ol>

<ul class="text-sm mt-retro-8 space-y-retro-2" data-testid="ascii-art-help">
  <li :for={id <- ~w(ui-ascii-art cmd-ascii formatting-colors ui-hex-paint)}>
    <.link patch={@help[id].path} class="underline">{@help[id].title}</.link>
  </li>
</ul>
