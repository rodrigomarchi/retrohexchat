<h3 class="text-sm font-bold mb-2">
  {dgettext("landing", "18 classic games. Running in your browser.")}
</h3>
<.inset
  class="p-3 mb-2"
  aria-label={dgettext("landing", "Solo arcade flow diagram")}
>
  <.diagram_arcade_flow class="w-full max-w-lg mx-auto" />
</.inset>
<p class="text-sm">
  {dgettext("landing", "Open the")}
  <strong>{dgettext("landing", "Games")}</strong> {dgettext(
    "landing",
    "menu and choose"
  )}
  <strong>{dgettext("landing", "Arcade")}</strong> {dgettext(
    "landing",
    "to review details for DOOM, Quake, Wolfenstein 3D, Half-Life, and ScummVM adventures, then start any game as"
  )}
  <strong>{dgettext("landing", "WebAssembly")}</strong> {dgettext(
    "landing",
    "in your browser. No downloads."
  )}
</p>
