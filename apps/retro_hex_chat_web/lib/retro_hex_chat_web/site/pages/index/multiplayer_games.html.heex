<.section_heading id="games-heading">
  {dgettext("landing", "34 multiplayer games. Right from the chat.")}
</.section_heading>
<.inset
  class="p-3 mb-2"
  aria-label={dgettext("landing", "P2P multiplayer games flow diagram")}
>
  <.diagram_p2p_games class="w-full max-w-lg mx-auto" />
</.inset>
<p class="text-sm">
  {dgettext("landing", "Type")}
  <strong>{dgettext("landing", "/p2p @nick")}</strong> {dgettext(
    "landing",
    "to challenge anyone. Games run on HTML5 Canvas with state synced via WebRTC DataChannel —"
  )} <strong>{dgettext("landing", "no server involvement")}</strong>{dgettext(
    "landing",
    ", just like private P2P calls."
  )}
</p>
