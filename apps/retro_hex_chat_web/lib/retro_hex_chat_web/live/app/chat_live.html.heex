<%!-- Hidden hooks --%>
<div id="title-flash" phx-hook="TitleFlashHook" class="hidden"></div>
<div id="nick-change-hook" phx-hook="NickChangeFormHook" class="hidden"></div>
<form id="nick-change-session-form" action={~p"/chat/session"} method="post" class="hidden">
  <input type="hidden" name="_csrf_token" value={Plug.CSRFProtection.get_csrf_token()} />
  <input type="hidden" name="nickname" value={@nick_change_target || ""} />
  <input
    :if={@nick_change_token}
    type="hidden"
    name="auth_token"
    value={@nick_change_token}
  />
  <input type="hidden" name="timezone" value={@timezone} />
  <input type="hidden" name="join_channel" value={@session.active_channel || ""} />
</form>
<div id="viewport-detect" phx-hook="ViewportDetectHook" class="hidden"></div>
<div id="shortcut-dispatcher-hook" phx-hook="ShortcutDispatcherHook" class="hidden"></div>
<div id="paste-hook" phx-hook="PasteHook" class="hidden"></div>

<%!-- Toast container --%>
<RetroHexChatWeb.Components.Toast.toast_container />

<%!-- Main app container --%>
<div
  class="flex flex-col fixed inset-0 overflow-hidden bg-canvas"
  phx-click="close_context_menu"
  phx-window-keydown="window_keydown"
  id="app-container"
  phx-hook="SoundHook"
>
  <%!-- App header with toolbar & status bar --%>
  <.app_header on_logo_click={show_modal("about-dialog")}>
    <:panels>
      <.menu_bar_app
        id="menubar"
        phx-hook="MenuBarHook"
        connected={true}
        is_admin={admin?(@session)}
        on_action="toolbar_action"
      />
      <.status_bar_app
        class="ml-auto"
        nickname={@session.nickname}
        account_state={Session.identity_state(@session)}
        away={@session.away}
        on_account_click="open_account_dialog"
        on_away_toggle="toggle_account_away"
        channel={@session.active_pm || @session.active_channel}
        user_count={length(@channel_users)}
        tab_type={if @session.active_pm, do: :pm, else: :channel}
        lag_ms={@lag_ms}
        lag_status={@lag_status}
        online_buddy_count={online_buddy_count(@session.notify_list)}
        on_notify_toggle="toggle_notify_list"
        muted={@muted}
        timezone={@timezone}
        on_mute_toggle="toggle_mute"
      />
    </:panels>
  </.app_header>

  <%!-- MDI layout: conversations | chat | nicklist --%>
  <div class="flex flex-1 min-h-0">
    <%!-- Conversations sidebar --%>
    <.live_component
      module={RetroHexChatWeb.ChatLive.Components.Conversations}
      id={RetroHexChatWeb.ChatLive.Components.Conversations.id()}
      visible={@show_conversations}
      channels={@session.channels}
      active_channel={@session.active_channel}
      active_pm={@session.active_pm}
      pm_conversations={@session.pm_conversations}
      unread_counts={@unread_counts}
      highlight_channels={@highlight_channels}
      flash_channels={@flash_channels}
      muted_channels={@muted_channels}
      disconnected_channels={Map.get(assigns, :disconnected_channels, MapSet.new())}
      conversations_sections={@conversations_sections}
      channel_user_counts={@channel_user_counts}
      popular_channels={@popular_channels}
      nick_color_fn={@nick_color_fn}
    />

    <%!-- Chat area --%>
    <div class="flex flex-col flex-1 min-w-0 min-h-0 overflow-hidden">
      <%!-- Tab bar (shrink, no grow) --%>
      <.irc_tab_bar>
        <.irc_tab_item
          type="status"
          label={dgettext("chat", "Status")}
          active={@show_status_tab}
          unread={@status_unread}
          closeable={false}
          on_click="switch_tab"
        />
        <.irc_tab_item
          :for={channel <- @session.channels}
          type="channel"
          label={channel}
          active={@session.active_channel == channel && !@show_status_tab}
          unread={Map.get(@unread_counts, channel, 0) > 0}
          on_click="switch_tab"
          on_close="close_tab"
        />
        <.irc_tab_item
          :for={pm <- @session.pm_conversations}
          type="pm"
          label={pm}
          active={@session.active_pm == pm && !@show_status_tab}
          unread={Map.get(@unread_counts, "pm:#{pm}", 0) > 0}
          nick_color={@nick_color_fn.(pm)}
          on_click="switch_tab"
          on_close="close_tab"
        />
      </.irc_tab_bar>

      <%!-- Topic bar --%>
      <.topic_bar
        topic={@current_topic || ""}
        channel_name={@session.active_channel}
        variant={
          cond do
            @show_status_tab -> "status"
            @session.active_pm -> "pm"
            true -> "channel"
          end
        }
        modes={@current_modes}
      />

      <%!-- Connection status banner --%>
      <.connection_status
        state="connected"
        visible={false}
      />
      <div
        id="connection-status-hook"
        phx-hook="ConnectionStatusHook"
        phx-update="ignore"
        data-testid="connection-status-hook"
      >
        <div class="connection-banner" data-role="banner" role="status" aria-live="polite">
          <span data-role="banner-text"></span>
        </div>
        <div class="reconnect-overlay" data-role="overlay" role="dialog" aria-modal="true">
          <div class="window reconnect-overlay__window">
            <div class="title-bar">
              <div class="title-bar-text">{dgettext("chat", "Connection Lost")}</div>
            </div>
            <div class="window-body">
              <p data-role="overlay-info" class="text-xs"></p>
              <p data-role="overlay-countdown" class="text-xs"></p>
              <div class="mt-3 text-right">
                <button type="button" data-role="overlay-action">
                  {dgettext("chat", "Cancel")}
                </button>
              </div>
            </div>
          </div>
        </div>
      </div>

      <%!-- Search bar (stateful island — owns its content state) --%>
      <.live_component
        module={RetroHexChatWeb.ChatLive.Components.SearchBar}
        id={RetroHexChatWeb.ChatLive.Components.SearchBar.id()}
        visible={@search_visible}
        nickname={@session.nickname}
        active_channel={@session.active_channel}
      />

      <%!-- Messages + Nicklist row (fills remaining space) --%>
      <div class="flex flex-1 min-h-0">
        <%!-- Messages column --%>
        <div class="flex flex-col flex-1 min-w-0 min-h-0 relative">
          <%!-- Chat messages stream (stateful island — owns the :chat_messages stream
               + the channel-load spinner and load-older indicator) --%>
          <.live_component
            module={RetroHexChatWeb.ChatLive.Components.MessageViewport}
            id={RetroHexChatWeb.ChatLive.Components.MessageViewport.id()}
            chat_clear_token={@chat_clear_token}
            nick_color_fn={@nick_color_fn}
            timestamp_format={@timestamp_format}
            timezone={@timezone}
            strip_formatting={@session.strip_formatting}
            edit_mode_message_id={@edit_mode_message_id}
            show_status_tab={@show_status_tab}
            loading_more={@loading_more}
            loading_channel={@loading_channel}
          />

          <%!-- Status messages stream (stateful island — owns the :status_messages stream) --%>
          <.live_component
            module={RetroHexChatWeb.ChatLive.Components.StatusViewport}
            id={RetroHexChatWeb.ChatLive.Components.StatusViewport.id()}
            timestamp_format={@timestamp_format}
            timezone={@timezone}
            show_status_tab={@show_status_tab}
          />
        </div>

        <%!-- Nicklist sidebar --%>
        <.live_component
          module={RetroHexChatWeb.ChatLive.Components.Nicklist}
          id={RetroHexChatWeb.ChatLive.Components.Nicklist.id()}
          visible={@show_nicklist && !@session.active_pm && !@show_status_tab}
          nick_color_fn={@nick_color_fn}
        />
      </div>

      <%!-- Popups (autocomplete dropdown + syntax tooltip) --%>
      <.autocomplete
        visible={@autocomplete_visible}
        items={@autocomplete_results}
        selected_index={@autocomplete_selected}
        mode={@autocomplete_mode || :command}
        command={@autocomplete_command}
        on_select="autocomplete_select"
      />
      <.syntax_tooltip
        tooltip={@syntax_tooltip}
        detail_level={@command_help_level}
      />

      <%!-- Bottom panel: formatting toolbar + reply bar + typing + input (fixed at bottom) --%>
      <div class="shrink-0">
        <%!-- Emoji picker (positioned above input) --%>
        <.live_component
          module={RetroHexChatWeb.ChatLive.Components.EmojiPickerDialog}
          id={RetroHexChatWeb.ChatLive.Components.EmojiPickerDialog.id()}
          visible={@show_emoji_picker}
        />

        <%!-- Formatting toolbar --%>
        <.formatting_toolbar
          :if={!@show_status_tab}
          strip_active={@session.strip_formatting}
          on_format="toggle_strip_formatting"
          on_toggle_emoji="toggle_emoji_picker"
        />

        <%!-- Reply bar --%>
        <.reply_bar
          :if={@reply_to}
          author={@reply_to.author}
          message={@reply_to.preview}
          on_dismiss="cancel_reply"
        />

        <%!-- Typing indicator --%>
        <.typing_indicator
          :if={@session.active_pm}
          nick={@pm_typing_from}
        />

        <%!-- Chat input --%>
        <.chat_input
          id="chat-input-area"
          input_id="chat-input"
          value={@input}
          name="input"
          placeholder={ChatHelpers.input_placeholder(assigns)}
          action_enabled={chat_action_enabled?(@session, @show_status_tab)}
          action_active={@action_mode}
          notice_target={@notice_target}
          input_error={@input_error}
          on_submit="send_input"
          on_change="input_changed"
          on_action_toggle="toggle_action_mode"
          on_notice_cancel="cancel_notice_mode"
          hook="AutocompleteHook"
          wrapper_hook="CharCounterHook"
          autofocus
          show_toolbar={false}
        />
        <.history_search visible={true} class="u-hidden" />
      </div>
    </div>
  </div>
</div>

<%!-- Hover card (stateful island — owns the nick hover-card state) --%>
<.live_component
  module={RetroHexChatWeb.ChatLive.Components.HoverCard}
  id={RetroHexChatWeb.ChatLive.Components.HoverCard.id()}
/>

<%!-- Context menus --%>
<.chat_context_menu
  visible={@chat_context_menu.visible}
  x={@chat_context_menu.x}
  y={@chat_context_menu.y}
  type={@chat_context_menu.type || :nick}
  target_nick={@chat_context_menu.target_nick}
  target_url={@chat_context_menu.target_url}
  target_channel={@chat_context_menu.target_channel}
  target_message={@chat_context_menu.target_message}
  viewer_nick={@session.nickname}
  viewer_is_op={viewer_is_op?(@session)}
  viewer_is_identified={@session.identified}
  is_target_ignored={chat_context_target_ignored?(@session, @chat_context_menu)}
  is_target_self={@chat_context_menu.target_nick == @session.nickname}
  is_target_registered={@chat_context_menu[:is_target_registered] || false}
  is_target_op={channel_user_op?(@channel_users, @chat_context_menu.target_nick)}
  is_target_voiced={channel_user_voiced?(@channel_users, @chat_context_menu.target_nick)}
  is_target_muted={channel_user_muted?(@channel_users, @chat_context_menu.target_nick)}
  is_already_joined={@chat_context_menu.target_channel in (@session.channels || [])}
  custom_items={CustomMenus.entries_for(@session.custom_menus, :chat)}
  key_bindings={RetroHexChat.Chat.KeyBindings.defaults()}
  on_action="chat_context_action"
/>

<.conversations_context_menu
  visible={@conversations_context_menu.visible}
  x={@conversations_context_menu.x}
  y={@conversations_context_menu.y}
  type={@conversations_context_menu.type}
  channel={@conversations_context_menu.channel}
  nick={@conversations_context_menu.nick}
  is_muted={
    MapSet.member?(@muted_channels, conversation_context_key(@conversations_context_menu))
  }
  has_unread={
    UnreadTracker.unread?(@unread_counts, conversation_context_key(@conversations_context_menu))
  }
  custom_items={conversation_context_custom_items(@session, @conversations_context_menu)}
  on_action="conversations_context_action"
/>

<%!-- Nicklist context menu --%>
<.nicklist_context_menu
  visible={@context_menu.visible}
  x={@context_menu.x}
  y={@context_menu.y}
  target_nick={@context_menu.target_nick}
  viewer_nick={@session.nickname}
  viewer_is_op={viewer_is_op?(@session)}
  viewer_is_identified={@session.identified}
  is_target_ignored={context_target_ignored?(@session, @context_menu.target_nick)}
  is_target_self={@context_menu.target_nick == @session.nickname}
  is_target_op={channel_user_op?(@channel_users, @context_menu.target_nick)}
  is_target_voiced={channel_user_voiced?(@channel_users, @context_menu.target_nick)}
  is_target_muted={channel_user_muted?(@channel_users, @context_menu.target_nick)}
  show_color_picker={@show_context_color_picker}
  nick_color_fn={@nick_color_fn}
  custom_items={CustomMenus.entries_for(@session.custom_menus, :nicklist)}
  key_bindings={RetroHexChat.Chat.KeyBindings.defaults()}
  on_action="nicklist_context_action"
/>

<%!-- Dialogs --%>
<.live_component
  module={RetroHexChatWeb.ChatLive.Components.MuteDurationDialog}
  id={RetroHexChatWeb.ChatLive.Components.MuteDurationDialog.id()}
/>

<.live_component
  module={RetroHexChatWeb.ChatLive.Components.InviteChannelPickerDialog}
  id={RetroHexChatWeb.ChatLive.Components.InviteChannelPickerDialog.id()}
  visible={@show_invite_channel_picker}
  channels={@session.channels}
/>

<.live_component
  module={RetroHexChatWeb.ChatLive.Components.KnockRequestDialog}
  id={RetroHexChatWeb.ChatLive.Components.KnockRequestDialog.id()}
  visible={@show_knock_request_dialog}
/>

<%!-- About: stateless, opened client-side via show_modal (logo + Help menu) --%>
<.about_dialog id="about-dialog" show={false} />

<.live_component
  module={RetroHexChatWeb.ChatLive.Components.AccountDialog}
  id={RetroHexChatWeb.ChatLive.Components.AccountDialog.id()}
  visible={@show_account_dialog}
  nickname={@session.nickname}
  account_state={Session.identity_state(@session)}
  registered={@account_registered}
  identified={@session.identified}
  away={@session.away}
  away_message={@session.away_message || @account_last_away_message || ""}
  wallops_enabled={Session.has_mode?(@session, :wallops)}
/>

<.live_component
  module={RetroHexChatWeb.ChatLive.Components.DisconnectConfirmDialog}
  id={RetroHexChatWeb.ChatLive.Components.DisconnectConfirmDialog.id()}
/>

<.live_component
  module={RetroHexChatWeb.ChatLive.Components.DeleteConfirmDialog}
  id={RetroHexChatWeb.ChatLive.Components.DeleteConfirmDialog.id()}
/>

<.live_component
  module={RetroHexChatWeb.ChatLive.Components.NickChangeDialog}
  id={RetroHexChatWeb.ChatLive.Components.NickChangeDialog.id()}
/>

<.notify_list
  id="notify-list-dialog"
  show={@show_notify_list}
  entries={NotifyList.sorted_entries(@session.notify_list)}
  selected_entry={@notify_selected}
  selected_note={@selected_note}
  auto_whois={@session.notify_list.settings.auto_whois}
  auto_add_pm={NotifyList.auto_add_pm?(@session.notify_list)}
  show_add_dialog={@show_notify_add_dialog}
  show_edit_dialog={@show_notify_edit_dialog}
  on_select="notify_select"
  on_add="notify_add_dialog"
  on_edit="notify_edit_dialog"
  on_remove="notify_remove"
  on_toggle_auto_whois="toggle_auto_whois"
  on_toggle_auto_add_pm="toggle_auto_add_pm"
  on_close="toggle_notify_list"
/>

<.address_book
  id="address-book-dialog"
  show={@show_address_book}
  selected_tab={@address_book_tab}
  contacts={ContactList.sorted_entries(@session.contacts)}
  selected_index={@contacts_selected}
  notify_list={NotifyList.sorted_entries(@session.notify_list)}
  nick_colors={NickColors.sorted_entries(@session.nick_colors)}
  control_list={IgnoreList.sorted_entries(@session.ignore_list)}
  control_selected={@control_selected}
  show_contact_add_dialog={@show_contact_add_dialog}
  show_contact_edit_dialog={@show_contact_edit_dialog}
  show_notify_add_dialog={@show_notify_add_dialog}
  show_notify_edit_dialog={@show_notify_edit_dialog}
  show_nick_color_add_dialog={@show_nick_color_add_dialog}
  show_nick_color_edit_dialog={@show_nick_color_edit_dialog}
  show_control_add_dialog={@show_control_add_dialog}
  nick_color_fn={@nick_color_fn}
  timezone={@timezone}
  contacts_selected={@contacts_selected}
  nick_colors_selected={@nick_colors_selected}
  notify_selected={@notify_selected}
  selected_contact_note={@selected_contact_note}
  selected_notify_note={@selected_notify_note}
  nick_palette_editing_index={@nick_palette_editing_index}
  on_select="contact_select"
  on_add="contact_add_dialog"
  on_edit="contact_edit_dialog"
  on_remove="contact_remove"
  on_notify_select="notify_select"
  on_notify_add="notify_add_dialog"
  on_notify_edit="notify_edit_dialog"
  on_notify_remove="notify_remove"
  on_nick_color_select="nick_color_select"
  on_nick_color_add="nick_color_add_dialog"
  on_nick_color_edit="nick_color_edit_dialog"
  on_nick_color_remove="nick_color_remove"
  on_control_select="control_select"
  on_control_add="control_add_dialog"
  on_control_remove="control_remove"
  on_tab="address_book_tab"
  on_ok="close_address_book"
  on_cancel="close_address_book"
  on_close="close_address_book"
/>

<.live_component
  module={RetroHexChatWeb.ChatLive.Components.ChannelListDialog}
  id={RetroHexChatWeb.ChatLive.Components.ChannelListDialog.id()}
  visible={@show_channel_list}
  channels={@channel_list_channels}
  loading={@channel_list_loading}
/>

<.live_component
  module={RetroHexChatWeb.ChatLive.Components.FloodProtectionDialog}
  id={RetroHexChatWeb.ChatLive.Components.FloodProtectionDialog.id()}
  visible={@show_flood_protection_dialog}
  settings={@session.flood_protection}
/>

<.live_component
  module={RetroHexChatWeb.ChatLive.Components.SoundSettingsDialog}
  id={RetroHexChatWeb.ChatLive.Components.SoundSettingsDialog.id()}
  visible={@show_sound_settings_dialog}
/>

<.perform_dialog
  id="perform-dialog"
  show={@show_perform_dialog}
  active_tab={@perform_dialog_tab}
  perform_entries={PerformList.entries(@session.perform_list)}
  perform_selected={@perform_selected}
  perform_enabled={PerformList.enabled?(@session.perform_list)}
  autojoin_entries={AutoJoinList.entries(@session.autojoin_list)}
  autojoin_selected={@autojoin_selected}
  show_perform_add_dialog={@show_perform_add_dialog}
  show_perform_edit_dialog={@show_perform_edit_dialog}
  show_autojoin_add_dialog={@show_autojoin_add_dialog}
  show_autojoin_edit_dialog={@show_autojoin_edit_dialog}
  on_tab="perform_dialog_tab"
  on_select="perform_select"
  on_add="perform_dialog_add"
  on_edit="perform_dialog_edit"
  on_remove="perform_dialog_remove"
  on_move_up="perform_dialog_move_up"
  on_move_down="perform_dialog_move_down"
  on_toggle_enabled="perform_toggle_enabled"
  on_autojoin_select="autojoin_select"
  on_autojoin_add="autojoin_dialog_add"
  on_autojoin_edit="autojoin_dialog_edit"
  on_autojoin_remove="autojoin_dialog_remove"
  on_ok="close_perform_dialog"
  on_cancel="close_perform_dialog"
/>

<.live_component
  module={RetroHexChatWeb.ChatLive.Components.AliasDialog}
  id={RetroHexChatWeb.ChatLive.Components.AliasDialog.id()}
  visible={@show_alias_dialog}
  aliases={@session.aliases}
/>

<.live_component
  module={RetroHexChatWeb.ChatLive.Components.CustomMenusDialog}
  id={RetroHexChatWeb.ChatLive.Components.CustomMenusDialog.id()}
  visible={@show_custom_menus_dialog}
  custom_menus={@session.custom_menus}
/>

<.live_component
  module={RetroHexChatWeb.ChatLive.Components.AutoRespondDialog}
  id={RetroHexChatWeb.ChatLive.Components.AutoRespondDialog.id()}
  visible={@show_autorespond_dialog}
  rules={@session.autorespond_rules}
/>

<.live_component
  module={RetroHexChatWeb.ChatLive.Components.TimersDialog}
  id={RetroHexChatWeb.ChatLive.Components.TimersDialog.id()}
  timers={@user_timers}
/>

<.channel_central_dialog
  id="channel-central-dialog"
  show={@show_channel_central}
  active_tab={@channel_central_tab}
  channel_name={@channel_central_channel}
  topic={channel_central_topic(@channel_central_state)}
  topic_set_by={channel_central_topic_set_by(@channel_central_state)}
  topic_set_at={channel_central_topic_set_at(@channel_central_state, @timezone)}
  created_at={channel_central_created_at(@channel_central_state, @timezone)}
  member_count={channel_central_member_count(@channel_central_state)}
  operator={@channel_central_operator}
  owner={@channel_central_owner}
  welcome_message={channel_central_welcome_message(@channel_central_state)}
  throttle_seconds={channel_central_throttle_seconds(@channel_central_state)}
  notice={@channel_central_notice}
  transfer_error={@channel_central_transfer_error}
  registration={@channel_central_registration}
  access_tab={@channel_central_access_tab}
  access_selected={@channel_central_access_selected}
  access_nick={@channel_central_access_nick}
  cs_error={@channel_central_cs_error}
  cs_confirm_drop={@channel_central_cs_confirm_drop}
  identified={@session.identified}
  modes={channel_central_modes(@channel_central_state)}
  bans={channel_central_bans(@channel_central_state)}
  ban_exceptions={channel_central_ban_exceptions(@channel_central_state)}
  invite_exceptions={channel_central_invite_exceptions(@channel_central_state)}
  ban_selected={@channel_central_ban_selected}
  ban_ex_selected={@channel_central_ban_ex_selected}
  invite_ex_selected={@channel_central_invite_ex_selected}
  show_add_ban_dialog={@show_cc_add_ban_dialog}
  show_add_ban_ex_dialog={@show_cc_add_ban_ex_dialog}
  show_add_invite_ex_dialog={@show_cc_add_invite_ex_dialog}
  show_transfer_dialog={@show_cc_transfer_dialog}
  on_tab="channel_central_tab"
  on_topic_save="cc_set_topic"
  on_welcome_save="cc_save_welcome"
  on_welcome_clear="cc_clear_welcome"
  on_throttle_apply="cc_apply_throttle"
  on_transfer_open="cc_open_transfer"
  on_transfer_close="cc_close_transfer"
  on_transfer_submit="cc_transfer_ownership"
  on_mode_apply="cc_apply_modes"
  on_ban_add="cc_open_add_ban"
  on_ban_remove="cc_remove_ban"
  on_ban_select="cc_ban_select"
  on_ban_ex_add="cc_open_add_ban_ex"
  on_ban_ex_remove="cc_remove_ban_exception"
  on_ban_ex_select="cc_ban_ex_select"
  on_invite_ex_add="cc_open_add_invite_ex"
  on_invite_ex_remove="cc_remove_invite_exception"
  on_invite_ex_select="cc_invite_ex_select"
  on_cs_register="cc_cs_register"
  on_cs_drop_request="cc_cs_drop_request"
  on_cs_drop="cc_cs_drop"
  on_cs_drop_cancel="cc_cs_drop_cancel"
  on_cs_access_tab="cc_cs_access_tab"
  on_cs_access_change="cc_cs_access_change"
  on_cs_access_add="cc_cs_access_add"
  on_cs_access_select="cc_cs_access_select"
  on_cs_access_remove="cc_cs_access_remove"
  on_close="close_channel_central"
/>

<.highlight_dialog
  id="highlight-dialog"
  show={@show_highlight_dialog}
  words={HighlightWords.entries(@session.highlight_words)}
  own_nick={@session.nickname}
  selected_word={@highlight_selected}
  selected_color={@highlight_selected_color}
  show_highlight_add_dialog={@show_highlight_add_dialog}
  show_highlight_edit_dialog={@show_highlight_edit_dialog}
  on_select="highlight_select"
  on_add="open_highlight_add_dialog"
  on_edit="open_highlight_edit_dialog"
  on_remove="highlight_remove"
  on_color_select="highlight_color_pick"
  on_ok="close_highlight_dialog"
  on_cancel="close_highlight_dialog"
/>

<.live_component
  module={RetroHexChatWeb.ChatLive.Components.UrlCatcherDialog}
  id={RetroHexChatWeb.ChatLive.Components.UrlCatcherDialog.id()}
  visible={@show_url_catcher}
  entries={@url_catcher_entries}
  timezone={@timezone}
/>

<.live_component
  module={RetroHexChatWeb.ChatLive.Components.CheatsheetDialog}
  id={RetroHexChatWeb.ChatLive.Components.CheatsheetDialog.id()}
  visible={@cheatsheet_visible}
/>

<.live_component
  module={RetroHexChatWeb.ChatLive.Components.UserLookupDialog}
  id={RetroHexChatWeb.ChatLive.Components.UserLookupDialog.id()}
  visible={@show_user_lookup_dialog}
  result={@lookup_result}
/>

<.live_component
  module={RetroHexChatWeb.ChatLive.Components.PasteConfirmDialog}
  id={RetroHexChatWeb.ChatLive.Components.PasteConfirmDialog.id()}
/>

<.invite_dialog
  id="invite-dialog"
  show={length(@pending_invites) > 0}
  invites={@pending_invites}
  on_accept="invite_accept"
  on_ignore="invite_ignore"
/>

<.live_component
  module={RetroHexChatWeb.ChatLive.Components.KickQueueDialog}
  id={RetroHexChatWeb.ChatLive.Components.KickQueueDialog.id()}
/>

<%!-- Bot Management dialog --%>
<.bot_management_dialog
  id="bot-management-dialog"
  show={@show_bot_dialog}
  bots={@bot_dialog_bots}
  selected={@bot_dialog_selected}
  channels={@bot_dialog_channels}
  commands={@bot_dialog_commands}
  events={@bot_dialog_events}
  stats={@bot_dialog_stats}
  active_tab={@bot_dialog_tab}
  is_admin={admin?(@session)}
  editing_field={@bot_dialog_editing_field}
  on_close="close_bot_dialog"
/>

<%!-- New Bot form dialog --%>
<.new_bot_dialog
  id="new-bot-dialog"
  show={@show_new_bot_dialog}
  on_close="close_new_bot_dialog"
/>

<%!-- Add Command form dialog --%>
<.add_command_dialog
  id="add-command-dialog"
  show={@show_add_command_dialog}
  bot_name={if @bot_dialog_selected, do: @bot_dialog_selected.name, else: ""}
  on_close="close_add_command_dialog"
/>

<%!-- Admin Console dialog --%>
<.admin_console_dialog
  id="admin-console-dialog"
  show={@show_admin_console}
  active_tab={@admin_console_tab}
  results={@admin_console_results}
  motd_content={@admin_console_motd}
  motd_result={@admin_console_motd_result}
  motd_editable={admin_only?(@session)}
  broadcast_result={@admin_console_broadcast_result}
  broadcast_can_wallops={admin?(@session)}
  broadcast_can_announce={admin_only?(@session)}
  turn_stats={@admin_console_turn_stats}
  turn_allocations={@admin_console_turn_allocations}
  turn_result={@admin_console_turn_result}
  turn_can_refresh={admin_only?(@session)}
  audit_log_text={@admin_console_audit_log_text}
  audit_log_last={@admin_console_audit_log_last}
  audit_log_user={@admin_console_audit_log_user}
  audit_log_result={@admin_console_audit_log_result}
  audit_log_can_refresh={admin_only?(@session)}
  server_settings_info={@admin_console_server_settings_info}
  server_settings_text={@admin_console_server_settings_text}
  server_settings_values={@admin_console_server_settings_values}
  server_settings_result={@admin_console_server_settings_result}
  server_settings_can_edit={admin_only?(@session)}
  users_text={@admin_console_users_text}
  users_banlist_text={@admin_console_users_banlist_text}
  users_result={@admin_console_users_result}
  users_search={@admin_console_users_search}
  users_online_only={@admin_console_users_online_only}
  users_info_nick={@admin_console_users_info_nick}
  users_can_refresh={admin_only?(@session)}
  users_can_set_admin_role={root_admin?(@session)}
  channels_text={@admin_console_channels_text}
  channels_banlist_text={@admin_console_channels_banlist_text}
  channels_result={@admin_console_channels_result}
  channels_search={@admin_console_channels_search}
  channels_info_channel={@admin_console_channels_info_channel}
  channels_create_name={@admin_console_channels_create_name}
  channels_can_refresh={admin_only?(@session)}
  danger_zone_preview={@admin_console_danger_zone_preview}
  danger_zone_result={@admin_console_danger_zone_result}
  danger_zone_confirm={@admin_console_danger_zone_confirm}
  danger_zone_server_name={@admin_console_danger_zone_server_name}
  danger_zone_can_execute={admin_only?(@session)}
  on_tab="admin_console_tab"
  on_motd_set="admin_console_set_motd"
  on_motd_clear="admin_console_clear_motd"
  on_motd_refresh="admin_console_refresh_motd"
  on_broadcast_send="admin_console_send_broadcast"
  on_turn_refresh="admin_console_refresh_turn"
  on_audit_log_refresh="admin_console_refresh_audit_log"
  on_server_settings_save="admin_console_save_server_settings"
  on_server_settings_refresh="admin_console_refresh_server_settings"
  on_singleplayer="admin_console_start_singleplayer"
  on_users_refresh="admin_console_refresh_users"
  on_users_info="admin_console_user_info"
  on_users_ban="admin_console_user_ban"
  on_users_unban="admin_console_user_unban"
  on_users_kick="admin_console_user_kick"
  on_users_mute="admin_console_user_mute"
  on_users_unmute="admin_console_user_unmute"
  on_users_rename="admin_console_user_rename"
  on_users_role="admin_console_user_role"
  on_users_ns_info="admin_console_user_ns_info"
  on_users_ns_drop="admin_console_user_ns_drop"
  on_users_ns_resetpass="admin_console_user_ns_resetpass"
  on_channels_refresh="admin_console_refresh_channels"
  on_channels_info="admin_console_channel_info"
  on_channels_create="admin_console_channel_create"
  on_channels_delete="admin_console_channel_delete"
  on_channels_purge="admin_console_channel_purge"
  on_channels_cs_info="admin_console_channel_cs_info"
  on_channels_cs_drop="admin_console_channel_cs_drop"
  on_channels_cs_transfer="admin_console_channel_cs_transfer"
  on_channels_cs_access_list="admin_console_channel_cs_access_list"
  on_channels_cs_access_add="admin_console_channel_cs_access_add"
  on_channels_cs_access_del="admin_console_channel_cs_access_del"
  on_danger_zone_preview="admin_console_preview_nuke"
  on_danger_zone_change="admin_console_change_nuke_confirm"
  on_danger_zone_execute="admin_console_execute_nuke"
  on_close="close_admin_console"
/>
