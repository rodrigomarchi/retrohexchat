<%!-- Hidden hooks --%>
<div id="title-flash" phx-hook="TitleFlashHook" class="hidden"></div>
<div id="nick-change-hook" phx-hook="NickChangeFormHook" class="hidden"></div>
<form id="nick-change-session-form" action={~p"/chat/session"} method="post" class="hidden">
  <input type="hidden" name="_csrf_token" value={Plug.CSRFProtection.get_csrf_token()} />
  <input type="hidden" name="nickname" value={@nick_change_target || ""} />
  <input
    :if={@nick_change_token}
    type="hidden"
    name="auth_token"
    value={@nick_change_token}
  />
  <input type="hidden" name="timezone" value={@timezone} />
  <input type="hidden" name="join_channel" value={@session.active_channel || ""} />
</form>
<div id="viewport-detect" phx-hook="ViewportDetectHook" class="hidden"></div>
<div id="shortcut-dispatcher-hook" phx-hook="ShortcutDispatcherHook" class="hidden"></div>

<%!-- Toast container --%>
<RetroHexChatWeb.Components.Toast.toast_container />

<%!-- Main app container --%>
<div
  class="flex flex-col fixed inset-0 overflow-hidden bg-background"
  phx-click="close_context_menu"
  phx-window-keydown="window_keydown"
  id="app-container"
  phx-hook="SoundHook"
>
  <.desktop
    id="chat-desktop"
    persist_key="chat"
    escape_closes_windows
    data-testid="chat-desktop"
  >
    <:header>
      <%!-- App header with toolbar & status bar --%>
      <.chat_shell_header
        session={@session}
        channel_user_count={length(@channel_users)}
        lag_ms={@lag_ms}
        lag_status={@lag_status}
        muted={@muted}
        timezone={@timezone}
        group_call={@group_call}
        p2p_session={@p2p_session}
      />
    </:header>

    <%!-- The whole chat surface is one pinned window: maximized by default,
          restorable/draggable/resizable, never closable. --%>
    <.desktop_window
      id="chat"
      title={dgettext("chat", "RetroHexChat")}
      pinned
      default_maximized
      default_x={48}
      default_y={24}
      width={920}
      height={580}
      min_width={480}
      min_height={320}
      body_class="flex flex-col min-h-0 p-0 overflow-hidden"
      data-testid="chat-window"
    >
      <:icon><Icons.icon_chat class="h-4 w-4" /></:icon>

      <%!-- MDI layout: conversations | chat | nicklist --%>
      <div class="flex flex-1 min-h-0">
        <%!-- Conversations sidebar --%>
        <.live_component
          module={RetroHexChatWeb.ChatLive.Components.Conversations}
          id={RetroHexChatWeb.ChatLive.Components.Conversations.id()}
          visible={@show_conversations}
          channels={@session.channels}
          active_channel={@session.active_channel}
          active_pm={@session.active_pm}
          pm_conversations={@session.pm_conversations}
          unread_counts={@unread_counts}
          highlight_channels={@highlight_channels}
          flash_channels={@flash_channels}
          muted_channels={@muted_channels}
          disconnected_channels={Map.get(assigns, :disconnected_channels, MapSet.new())}
          conversations_sections={@conversations_sections}
          channel_user_counts={@channel_user_counts}
          popular_channels={@popular_channels}
          nick_color_fn={@nick_color_fn}
        />

        <%!-- Chat area --%>
        <div class="flex flex-col flex-1 min-w-0 min-h-0 overflow-hidden">
          <%!-- Tab bar (shrink, no grow) --%>
          <.chat_tabs
            channels={@session.channels}
            pm_conversations={@session.pm_conversations}
            unread_counts={@unread_counts}
            status_unread={@status_unread}
            show_status_tab={@show_status_tab}
            active_channel={@session.active_channel}
            active_pm={@session.active_pm}
            nick_color_fn={@nick_color_fn}
            p2p_peer={
              if @p2p_session && @p2p_session.state == :connected, do: @p2p_session.peer_nick
            }
          />

          <% conversation_space = conversation_space(@session, @show_status_tab) %>
          <% space_view? = conversation_space && @channel_view == :space %>

          <%!-- Topic bar --%>
          <.topic_bar
            topic={@current_topic || ""}
            channel_name={@session.active_channel}
            variant={
              cond do
                @show_status_tab -> "status"
                @session.active_pm -> "pm"
                true -> "channel"
              end
            }
            modes={@current_modes}
          >
            <:leading_controls :if={conversation_space}>
              <div class="flex items-center gap-px" data-testid="channel-view-tabs">
                <button
                  type="button"
                  phx-click="switch_channel_view"
                  phx-value-view="chat"
                  class={[
                    "flex h-6 items-center justify-center gap-1 px-2 py-0 shadow-retro-raised bg-surface text-xs whitespace-nowrap",
                    "focus:outline-none focus-visible:ring-1 focus-visible:ring-foreground",
                    @channel_view == :chat && "bg-canvas font-bold shadow-retro-sunken"
                  ]}
                  aria-label={dgettext("chat", "Chat")}
                  title={dgettext("chat", "Chat")}
                  aria-pressed={@channel_view == :chat}
                >
                  <Icons.icon_chat class="h-3.5 w-3.5 shrink-0" />
                  <span>{dgettext("chat", "Chat")}</span>
                </button>
                <button
                  type="button"
                  phx-click="switch_channel_view"
                  phx-value-view="space"
                  class={[
                    "flex h-6 items-center justify-center gap-1 px-2 py-0 shadow-retro-raised bg-surface text-xs whitespace-nowrap",
                    "focus:outline-none focus-visible:ring-1 focus-visible:ring-foreground",
                    @channel_view == :space && "bg-canvas font-bold shadow-retro-sunken"
                  ]}
                  aria-label={dgettext("chat", "Space")}
                  title={dgettext("chat", "Space")}
                  aria-pressed={@channel_view == :space}
                >
                  <Icons.icon_community class="h-3.5 w-3.5 shrink-0" />
                  <span>{dgettext("chat", "Space")}</span>
                </button>
                <button
                  :if={@session.active_channel && !@show_status_tab}
                  type="button"
                  phx-click="group_call_open"
                  class={[
                    "flex h-6 items-center justify-center gap-1 px-2 py-0 shadow-retro-raised bg-surface text-xs whitespace-nowrap",
                    "focus:outline-none focus-visible:ring-1 focus-visible:ring-foreground",
                    @group_call && @group_call.channel_name == @session.active_channel &&
                      "bg-canvas font-bold shadow-retro-sunken",
                    !@session.identified && "opacity-60"
                  ]}
                  aria-label={dgettext("chat", "Group Call")}
                  title={
                    if @session.identified,
                      do: dgettext("chat", "Group Call"),
                      else: dgettext("chat", "Identify with NickServ to use group calls")
                  }
                  aria-pressed={
                    to_string(
                      (@group_call && @group_call.channel_name == @session.active_channel) == true
                    )
                  }
                  disabled={!@session.identified}
                  data-testid="group-call-open"
                >
                  <Icons.icon_camera class="h-3.5 w-3.5 shrink-0" />
                  <span>{dgettext("chat", "Call")}</span>
                </button>
              </div>
            </:leading_controls>
          </.topic_bar>

          <%!-- Connection status banner + JS-driven reconnect overlay --%>
          <.connection_status_panel />

          <%!-- Search bar (stateful island — owns its content state) --%>
          <.live_component
            module={RetroHexChatWeb.ChatLive.Components.SearchBar}
            id={RetroHexChatWeb.ChatLive.Components.SearchBar.id()}
            visible={@search_visible}
            nickname={@session.nickname}
            active_channel={@session.active_channel}
          />

          <%!-- Main content + Nicklist row (fills remaining space) --%>
          <div class="flex flex-1 min-h-0" data-testid="channel-content-row">
            <div class="flex flex-col flex-1 min-w-0 min-h-0" data-testid="channel-main-column">
              <%!-- Messages column --%>
              <div class={[
                "flex flex-col flex-1 min-w-0 min-h-0 relative",
                space_view? && "hidden"
              ]}>
                <%!-- Chat messages stream (stateful island — owns the :chat_messages stream
               + the channel-load spinner and load-older indicator) --%>
                <.live_component
                  module={RetroHexChatWeb.ChatLive.Components.MessageViewport}
                  id={RetroHexChatWeb.ChatLive.Components.MessageViewport.id()}
                  chat_clear_token={@chat_clear_token}
                  nick_color_fn={@nick_color_fn}
                  timestamp_format={@timestamp_format}
                  timezone={@timezone}
                  strip_formatting={@session.strip_formatting}
                  edit_mode_message_id={@edit_mode_message_id}
                  show_status_tab={@show_status_tab}
                  loading_more={@loading_more}
                  loading_channel={@loading_channel}
                  viewer={@session.nickname}
                />

                <%!-- Status messages stream (stateful island — owns the :status_messages stream) --%>
                <.live_component
                  module={RetroHexChatWeb.ChatLive.Components.StatusViewport}
                  id={RetroHexChatWeb.ChatLive.Components.StatusViewport.id()}
                  timestamp_format={@timestamp_format}
                  timezone={@timezone}
                  show_status_tab={@show_status_tab}
                />
              </div>

              <div :if={space_view?} class="relative flex flex-1 min-w-0 min-h-0">
                <.space_character_select
                  :if={is_nil(@space_avatar)}
                  avatars={@space_avatars}
                  selected={@space_last_avatar}
                />
                <div
                  :if={@space_avatar}
                  id={conversation_space.id}
                  phx-hook="SpaceCanvasHook"
                  phx-update="ignore"
                  data-testid="channel-space-shell"
                  data-space-channel={conversation_space.channel}
                  data-join-token={conversation_space.join_token}
                  data-nickname={@session.nickname}
                  data-space-mode={conversation_space.mode}
                  data-avatar={@space_avatar}
                  class="relative flex-1 min-h-0 w-full bg-canvas"
                >
                  <canvas
                    id={"#{conversation_space.id}-canvas"}
                    class="absolute inset-0 block h-full w-full"
                  >
                  </canvas>
                  <div
                    data-space-loading
                    class="absolute inset-0 z-20 flex items-center justify-center bg-background/95"
                    data-testid="space-loading"
                  >
                    <.boot_activity_panel
                      title={
                        if conversation_space.mode == "direct_message",
                          do: dgettext("chat", "Private Space"),
                          else: dgettext("chat", "Channel Space")
                      }
                      text={
                        if conversation_space.mode == "direct_message",
                          do: dgettext("chat", "Opening private room..."),
                          else: dgettext("chat", "Entering channel space...")
                      }
                      icon={
                        if conversation_space.mode == "direct_message",
                          do: :p2p,
                          else: :channels
                      }
                      class="w-full max-w-sm"
                      data-space-loading-panel
                      text_attrs={%{"data-space-loading-text" => ""}}
                    />
                  </div>
                  <div
                    data-space-modal
                    hidden
                    class="absolute inset-0 m-auto h-fit w-fit bg-canvas shadow-retro-field p-3 text-center"
                  >
                  </div>
                </div>
              </div>

              <%!-- Composer island: autocomplete + syntax tooltip + bottom input panel --%>
              <.live_component
                module={RetroHexChatWeb.ChatLive.Components.Composer}
                id={RetroHexChatWeb.ChatLive.Components.Composer.id()}
                session={@session}
                show_status_tab={@show_status_tab}
                channel_users={@channel_users}
                show_emoji_picker={@show_emoji_picker}
                pm_typing_from={@pm_typing_from}
                edit_mode_message_id={@edit_mode_message_id}
              />
            </div>

            <%!-- Nicklist sidebar --%>
            <.live_component
              module={RetroHexChatWeb.ChatLive.Components.Nicklist}
              id={RetroHexChatWeb.ChatLive.Components.Nicklist.id()}
              visible={@show_nicklist && !@session.active_pm && !@show_status_tab}
              nick_color_fn={@nick_color_fn}
            />
          </div>
        </div>
      </div>
    </.desktop_window>

    <%!-- Highlight Words — server-managed: closing unmounts the island
          (selection/sub-form state resets); the session read-model stays
          parent-owned and flows in as passthrough. --%>
    <.desktop_window
      :if={"highlight" in @open_windows}
      id="highlight"
      title={dgettext("chat", "Highlight Words")}
      managed
      default_x={160}
      default_y={70}
      width={520}
      height={520}
      min_width={400}
      min_height={360}
      body_class="flex min-h-0 flex-col p-2"
      data-testid="highlight-window"
    >
      <:icon><Icons.icon_star class="h-4 w-4" /></:icon>
      <.live_component
        module={RetroHexChatWeb.ChatLive.Components.HighlightDialog}
        id={RetroHexChatWeb.ChatLive.Components.HighlightDialog.id()}
        session={@session}
      />
    </.desktop_window>

    <%!-- Alias / Custom Menus / Auto Respond — server-managed editors: closing
          unmounts the island, resetting selection and draft. --%>
    <.desktop_window
      :if={"alias" in @open_windows}
      id="alias"
      title={dgettext("chat", "Alias Editor")}
      managed
      default_x={130}
      default_y={100}
      width={640}
      height={460}
      min_width={480}
      min_height={320}
      body_class="flex min-h-0 flex-col p-2"
      data-testid="alias-window"
    >
      <:icon><Icons.icon_dialog_alias class="h-4 w-4" /></:icon>
      <.live_component
        module={RetroHexChatWeb.ChatLive.Components.AliasDialog}
        id={RetroHexChatWeb.ChatLive.Components.AliasDialog.id()}
        aliases={@session.aliases}
      />
    </.desktop_window>

    <.desktop_window
      :if={"custom-menus" in @open_windows}
      id="custom-menus"
      title={dgettext("chat", "Custom Menus")}
      managed
      default_x={150}
      default_y={110}
      width={640}
      height={480}
      min_width={480}
      min_height={340}
      body_class="flex min-h-0 flex-col p-2"
      data-testid="custom-menus-window"
    >
      <:icon><Icons.icon_dialog_custom_menus class="h-4 w-4" /></:icon>
      <.live_component
        module={RetroHexChatWeb.ChatLive.Components.CustomMenusDialog}
        id={RetroHexChatWeb.ChatLive.Components.CustomMenusDialog.id()}
        custom_menus={@session.custom_menus}
      />
    </.desktop_window>

    <.desktop_window
      :if={"auto-respond" in @open_windows}
      id="auto-respond"
      title={dgettext("chat", "Auto Respond")}
      managed
      default_x={170}
      default_y={120}
      width={700}
      height={440}
      min_width={540}
      min_height={320}
      body_class="flex min-h-0 flex-col p-2"
      data-testid="auto-respond-window"
    >
      <:icon><Icons.icon_dialog_auto_respond class="h-4 w-4" /></:icon>
      <.live_component
        module={RetroHexChatWeb.ChatLive.Components.AutoRespondDialog}
        id={RetroHexChatWeb.ChatLive.Components.AutoRespondDialog.id()}
        rules={@session.autorespond_rules}
      />
    </.desktop_window>

    <%!-- Address Book — server-managed four-tab mini-app; open-on-tab via
          send_update after the window mounts; seven window-scoped sub-forms. --%>
    <.desktop_window
      :if={"address-book" in @open_windows}
      id="address-book"
      title={dgettext("chat", "Address Book")}
      managed
      default_x={100}
      default_y={50}
      width={720}
      height={560}
      min_width={560}
      min_height={400}
      body_class="flex min-h-0 flex-col p-2"
      data-testid="address-book-window"
    >
      <:icon><Icons.icon_dialog_address_book class="h-4 w-4" /></:icon>
      <.live_component
        module={RetroHexChatWeb.ChatLive.Components.AddressBookDialog}
        id={RetroHexChatWeb.ChatLive.Components.AddressBookDialog.id()}
        session={@session}
        nick_color_fn={@nick_color_fn}
        timezone={@timezone}
      />
    </.desktop_window>

    <%!-- Notify List — server-managed: selection/sub-form state resets on close;
          the buddy list lives on the session and flows in as passthrough. --%>
    <.desktop_window
      :if={"notify-list" in @open_windows}
      id="notify-list"
      title={dgettext("chat", "Notify List")}
      managed
      default_x={210}
      default_y={140}
      width={560}
      height={520}
      min_width={440}
      min_height={360}
      body_class="flex min-h-0 flex-col p-2"
      data-testid="notify-list-window"
    >
      <:icon><Icons.icon_tab_notify class="h-4 w-4" /></:icon>
      <.live_component
        module={RetroHexChatWeb.ChatLive.Components.NotifyListDialog}
        id={RetroHexChatWeb.ChatLive.Components.NotifyListDialog.id()}
        session={@session}
      />
    </.desktop_window>

    <%!-- Perform — server-managed: two-tab mini-app (perform + auto-join) with
          window-scoped add/edit sub-forms; open-on-tab via send_update after
          the window mounts. --%>
    <.desktop_window
      :if={"perform" in @open_windows}
      id="perform"
      title={dgettext("chat", "Perform")}
      managed
      default_x={190}
      default_y={130}
      width={680}
      height={500}
      min_width={520}
      min_height={360}
      body_class="flex min-h-0 flex-col p-2"
      data-testid="perform-window"
    >
      <:icon><Icons.icon_dialog_perform class="h-4 w-4" /></:icon>
      <.live_component
        module={RetroHexChatWeb.ChatLive.Components.PerformDialog}
        id={RetroHexChatWeb.ChatLive.Components.PerformDialog.id()}
        session={@session}
      />
    </.desktop_window>

    <%!-- Sound Settings — server-managed: the draft seeds from the session on
          mount; closing discards an uncommitted draft. --%>
    <.desktop_window
      :if={"sound-settings" in @open_windows}
      id="sound-settings"
      title={dgettext("chat", "Sound Settings")}
      managed
      default_x={140}
      default_y={80}
      width={620}
      height={480}
      min_width={520}
      min_height={340}
      body_class="flex min-h-0 flex-col p-2"
      data-testid="sound-settings-window"
    >
      <:icon><Icons.icon_dialog_sound class="h-4 w-4" /></:icon>
      <.live_component
        module={RetroHexChatWeb.ChatLive.Components.SoundSettingsDialog}
        id={RetroHexChatWeb.ChatLive.Components.SoundSettingsDialog.id()}
        settings={@session.sound_settings}
      />
    </.desktop_window>

    <%!-- Flood Protection — server-managed: uncontrolled form, nothing to keep
          across closes. --%>
    <.desktop_window
      :if={"flood-protection" in @open_windows}
      id="flood-protection"
      title={dgettext("chat", "Flood Protection")}
      managed
      default_x={180}
      default_y={60}
      width={480}
      height={560}
      min_width={420}
      min_height={400}
      body_class="p-2"
      data-testid="flood-protection-window"
    >
      <:icon><Icons.icon_dialog_flood class="h-4 w-4" /></:icon>
      <.live_component
        module={RetroHexChatWeb.ChatLive.Components.FloodProtectionDialog}
        id={RetroHexChatWeb.ChatLive.Components.FloodProtectionDialog.id()}
        settings={@session.flood_protection}
      />
    </.desktop_window>

    <%!-- P2P Statistics — server-managed and gated on the active session:
          per-feature telemetry, connection diagram and whois for the in-chat
          P2P session. --%>
    <.desktop_window
      :if={@p2p_session && "p2p-stats" in @open_windows}
      id="p2p-stats"
      persist_geometry={false}
      title={dgettext("chat", "P2P Statistics")}
      managed
      on_close="p2p_window_close"
      default_x={880}
      default_y={64}
      width={380}
      height={420}
      data-testid="p2p-stats-window"
    >
      <:icon><Icons.icon_status_signal class="h-4 w-4" /></:icon>
      <.lobby_network_panel
        stats={@p2p_session.stats}
        info_open={@p2p_session.info_open}
        nickname={@session.nickname}
        peer_nick={@p2p_session.peer_nick}
        peer_online={@p2p_session.peer_online}
        session_status={p2p_panel_status(@p2p_session)}
        connection_label={p2p_connection_label(@p2p_session)}
        local_info={@client_info}
        peer_info={@p2p_session.peer_info}
        call_summary={@p2p_session.call_summary}
        file_summary={@p2p_session.file_summary}
        turn_only={@p2p_session.turn_only}
      />
    </.desktop_window>

    <%!-- P2P Games — server-managed: the island mounts only while open, so
          every open starts from a fresh picker. The X quits/cancels whatever
          is there (a playing game ends for BOTH peers). --%>
    <.desktop_window
      :if={@p2p_session && "p2p-games" in @open_windows}
      id="p2p-games"
      persist_geometry={false}
      title={dgettext("chat", "P2P Games")}
      managed
      on_close="p2p_window_close"
      default_x={120}
      default_y={48}
      width={680}
      body_class="p-1"
      data-testid="p2p-games-window"
    >
      <:icon><Icons.icon_game_arcade class="h-4 w-4" /></:icon>
      <.live_component
        module={RetroHexChatWeb.ChatLive.Components.P2PGameIsland}
        id={RetroHexChatWeb.ChatLive.Components.P2PGameIsland.id()}
        connected={@p2p_session.state == :connected}
        peer_nick={@p2p_session.peer_nick}
        window_id="p2p-games"
      />
    </.desktop_window>

    <%!-- P2P Call — always mounted while a session is joined so the media
          hooks and streams survive hide/show; the X asks the island to end
          the call (never just hides a live call silently). --%>
    <.desktop_window
      :if={@p2p_session && @p2p_session.state != :invite_sent}
      id="p2p-call"
      persist_geometry={false}
      title={
        if @p2p_session.peer_nick in [nil, ""],
          do: dgettext("chat", "P2P Call"),
          else: @p2p_session.peer_nick
      }
      open={false}
      on_close="p2p_window_close"
      default_x={496}
      default_y={48}
      width={460}
      body_class="p-1"
      data-testid="p2p-call-window"
    >
      <:icon><Icons.icon_camera class="h-4 w-4" /></:icon>
      <.live_component
        module={RetroHexChatWeb.ChatLive.Components.P2PMediaIsland}
        id={RetroHexChatWeb.ChatLive.Components.P2PMediaIsland.id()}
        connected={@p2p_session.state == :connected}
        nickname={@session.nickname}
        peer_nick={@p2p_session.peer_nick}
        token={@p2p_session.token}
        user_id={@p2p_session.user_id}
        window_id="p2p-call"
      />
    </.desktop_window>

    <%!-- P2P Files — always mounted while a session is joined: the island's
          FileTransferHook must stay alive for the whole connection (the data
          channel has no onmessage without it). The X cancels the transfer via
          the island; the window merely hides. --%>
    <.desktop_window
      :if={@p2p_session && @p2p_session.state != :invite_sent}
      id="p2p-files"
      persist_geometry={false}
      title={dgettext("chat", "P2P Files")}
      open={false}
      on_close="p2p_window_close"
      default_x={536}
      default_y={330}
      width={320}
      body_class="p-1"
      data-testid="p2p-files-window"
    >
      <:icon><Icons.icon_file_send class="h-4 w-4" /></:icon>
      <.live_component
        module={RetroHexChatWeb.ChatLive.Components.P2PFileIsland}
        id={RetroHexChatWeb.ChatLive.Components.P2PFileIsland.id()}
        connected={@p2p_session.state == :connected}
        nickname={@session.nickname}
        peer_nick={@p2p_session.peer_nick}
        token={@p2p_session.token}
        window_id="p2p-files"
      />
    </.desktop_window>

    <%!-- Group Call — always mounted while the user is in a channel call so
          the raw signaling channel and WebRTC hook survive hide/show. The X and
          Leave controls ask for confirmation before tearing the call down. --%>
    <.desktop_window
      :if={@group_call}
      id="group-call"
      persist_geometry={false}
      title={@group_call.channel_name || dgettext("chat", "Group Call")}
      open
      on_close="group_call_window_close"
      default_x={448}
      default_y={72}
      width={640}
      height={430}
      min_width={500}
      min_height={320}
      body_class="h-full min-h-0 overflow-hidden p-1"
      data-testid="group-call-window"
    >
      <:icon><Icons.icon_camera class="h-4 w-4" /></:icon>
      <.live_component
        module={RetroHexChatWeb.ChatLive.Components.GroupCallPanel}
        id={RetroHexChatWeb.ChatLive.Components.GroupCallPanel.id()}
        call={@group_call}
      />
    </.desktop_window>

    <%!-- Arcade — server-managed solo-game picker, a pure read-model of the
          @arcade_session assign (like P2P Statistics, no island component).
          The X keeps the session alive while a game is running (the pop-up
          keeps playing); the Leave/Close button inside ends it. --%>
    <.desktop_window
      :if={@arcade_session && "arcade-games" in @open_windows}
      id="arcade-games"
      persist_geometry={false}
      title={dgettext("chat", "Arcade")}
      managed
      on_close="arcade_window_close"
      default_x={200}
      default_y={80}
      width={680}
      height={520}
      min_width={420}
      min_height={340}
      body_class="p-2"
      data-testid="arcade-games-window"
    >
      <:icon><Icons.icon_game_arcade class="h-4 w-4" /></:icon>
      <.solo_lobby
        id="arcade-lobby"
        games={arcade_games()}
        session_status={@arcade_session.status}
        previewed_game={@arcade_session.previewed_game}
        game_name={@arcade_session.game_name}
        game_id={@arcade_session.game_id}
        game_started_at={@arcade_session.game_started_at}
        game_duration={@arcade_session.game_duration}
        inactivity_warning={@arcade_session.inactivity_warning}
        on_preview_game="arcade_preview"
        on_select_game="arcade_select_game"
        on_back="arcade_back"
        on_close="arcade_leave"
      />
    </.desktop_window>

    <%!-- Timers — server-managed: closing unmounts the island (draft state
          resets by design); reopening mounts a fresh one. --%>
    <.desktop_window
      :if={"timers" in @open_windows}
      id="timers"
      title={dgettext("chat", "Timers")}
      managed
      default_x={120}
      default_y={90}
      width={720}
      height={470}
      min_width={520}
      min_height={320}
      body_class="flex min-h-0 flex-col p-2"
      data-testid="timers-window"
    >
      <:icon><Icons.icon_btn_timers class="h-4 w-4" /></:icon>
      <.live_component
        module={RetroHexChatWeb.ChatLive.Components.TimersDialog}
        id={RetroHexChatWeb.ChatLive.Components.TimersDialog.id()}
        timers={@user_timers}
      />
    </.desktop_window>

    <%!-- Channel List — always mounted: the search filter survives closes by
          design; /list reloads the rows into the passthrough on open. --%>
    <.desktop_window
      id="channel-list"
      title={dgettext("chat", "Channel List")}
      open={false}
      default_x={120}
      default_y={70}
      width={620}
      height={480}
      min_width={480}
      min_height={320}
      body_class="flex min-h-0 flex-col p-2"
      data-testid="channel-list-window"
    >
      <:icon><Icons.icon_channels class="h-4 w-4" /></:icon>
      <.live_component
        module={RetroHexChatWeb.ChatLive.Components.ChannelListDialog}
        id={RetroHexChatWeb.ChatLive.Components.ChannelListDialog.id()}
        channels={@channel_list_channels}
        loading={@channel_list_loading}
      />
    </.desktop_window>

    <%!-- Cheatsheet — server-managed: static content, recomputed on mount. --%>
    <.desktop_window
      :if={"cheatsheet" in @open_windows}
      id="cheatsheet"
      title={dgettext("chat", "Keyboard Shortcuts")}
      managed
      default_x={200}
      default_y={60}
      width={640}
      height={520}
      min_width={480}
      min_height={320}
      body_class="flex min-h-0 flex-col p-2"
      data-testid="cheatsheet-window"
    >
      <:icon><Icons.icon_dialog_cheatsheet class="h-4 w-4" /></:icon>
      <.live_component
        module={RetroHexChatWeb.ChatLive.Components.CheatsheetDialog}
        id={RetroHexChatWeb.ChatLive.Components.CheatsheetDialog.id()}
      />
    </.desktop_window>

    <%!-- Channel Central — always mounted: the island owns all state, gates
          opens on membership, receives blind PubSub refreshes while closed,
          and drives its own window via window_command. --%>
    <.desktop_window
      id="channel-central"
      title={dgettext("chat", "Channel Central: %{channel}", channel: @cc_window_channel || "")}
      open={false}
      default_x={140}
      default_y={50}
      width={620}
      height={560}
      min_width={480}
      min_height={380}
      body_class="flex min-h-0 flex-col p-2"
      data-testid="channel-central-window"
    >
      <:icon><Icons.icon_dialog_channel_central class="h-4 w-4" /></:icon>
      <.live_component
        module={RetroHexChatWeb.ChatLive.Components.ChannelCentralDialog}
        id={RetroHexChatWeb.ChatLive.Components.ChannelCentralDialog.id()}
        session={@session}
        timezone={@timezone}
      />
    </.desktop_window>

    <%!-- Account — server-managed: every opener re-seeds tab/auth-mode/bio. --%>
    <.desktop_window
      :if={"account" in @open_windows}
      id="account"
      title={dgettext("chat", "Account")}
      managed
      default_x={180}
      default_y={70}
      width={560}
      height={520}
      min_width={420}
      min_height={360}
      body_class="flex min-h-0 flex-col p-2"
      data-testid="account-window"
    >
      <:icon><Icons.icon_status_user class="h-4 w-4" /></:icon>
      <.live_component
        module={RetroHexChatWeb.ChatLive.Components.AccountDialog}
        id={RetroHexChatWeb.ChatLive.Components.AccountDialog.id()}
        nickname={@session.nickname}
        account_state={Session.identity_state(@session)}
        registered={@account_registered}
        identified={@session.identified}
        away={@session.away}
        away_message={@session.away_message || @account_last_away_message || ""}
        wallops_enabled={Session.has_mode?(@session, :wallops)}
      />
    </.desktop_window>

    <%!-- User Lookup — server-managed: closing resets the draft and result. --%>
    <.desktop_window
      :if={"user-lookup" in @open_windows}
      id="user-lookup"
      title={dgettext("chat", "User Lookup")}
      managed
      default_x={240}
      default_y={100}
      width={420}
      height={460}
      min_width={340}
      min_height={280}
      body_class="flex min-h-0 flex-col p-2"
      data-testid="user-lookup-window"
    >
      <:icon><Icons.icon_btn_search class="h-4 w-4" /></:icon>
      <.live_component
        module={RetroHexChatWeb.ChatLive.Components.UserLookupDialog}
        id={RetroHexChatWeb.ChatLive.Components.UserLookupDialog.id()}
        result={@lookup_result}
      />
    </.desktop_window>

    <%!-- URL Catcher — always mounted (URLs keep accumulating while closed);
          the window manager owns open/close client-side. --%>
    <.desktop_window
      id="url-catcher"
      title={dgettext("chat", "URL Catcher")}
      open={false}
      default_x={80}
      default_y={60}
      width={640}
      height={440}
      min_width={420}
      min_height={280}
      body_class="flex min-h-0 flex-col p-2"
      data-testid="url-catcher-window"
    >
      <:icon><Icons.icon_link class="h-4 w-4" /></:icon>
      <.live_component
        module={RetroHexChatWeb.ChatLive.Components.UrlCatcherDialog}
        id={RetroHexChatWeb.ChatLive.Components.UrlCatcherDialog.id()}
        entries={@url_catcher_entries}
        timezone={@timezone}
      />
    </.desktop_window>

    <%!-- Admin Console — server-managed, admin-gated. The open event is the
          server-side authz for a forged window_open; the render guard here is
          the second line of defense (no admin content for non-admins). --%>
    <.desktop_window
      :if={admin?(@session) and "admin-console-dialog" in @open_windows}
      id="admin-console-dialog"
      title={dgettext("chat", "Admin Console")}
      managed
      default_x={140}
      default_y={50}
      width={680}
      height={580}
      min_width={520}
      min_height={400}
      body_class="flex min-h-0 flex-col p-2"
      data-testid="admin-console-window"
    >
      <:icon><Icons.icon_dialog_admin_console class="h-4 w-4" /></:icon>
      <.live_component
        module={RetroHexChatWeb.ChatLive.Components.AdminConsoleDialog}
        id={RetroHexChatWeb.ChatLive.Components.AdminConsoleDialog.id()}
        session={@session}
      />
    </.desktop_window>

    <%!-- Bot Management — server-managed, admin-gated (same authz model as the
          admin console: the open event gates; the render guard is defense-in-depth). --%>
    <.desktop_window
      :if={admin?(@session) and "bot-management-dialog" in @open_windows}
      id="bot-management-dialog"
      title={dgettext("chat", "Bot Management")}
      managed
      default_x={200}
      default_y={80}
      width={720}
      height={560}
      min_width={520}
      min_height={400}
      body_class="flex min-h-0 flex-col p-2"
      data-testid="bot-management-window"
    >
      <:icon><Icons.icon_btn_bot_management class="h-4 w-4" /></:icon>
      <.live_component
        module={RetroHexChatWeb.ChatLive.Components.BotManagementDialog}
        id={RetroHexChatWeb.ChatLive.Components.BotManagementDialog.id()}
        is_admin={admin?(@session)}
      />
    </.desktop_window>

    <:taskbar>
      <.taskbar id="chat-taskbar">
        <:start>
          <.start_menu_app
            id="chat-start-menu"
            is_admin={admin?(@session)}
            p2p_active={@p2p_session != nil}
          />
        </:start>
        <.taskbar_button window="chat" label={dgettext("chat", "RetroHexChat")}>
          <:icon><Icons.icon_chat class="h-4 w-4" /></:icon>
        </.taskbar_button>
        <.taskbar_button window="url-catcher" label={dgettext("chat", "URL Catcher")}>
          <:icon><Icons.icon_link class="h-4 w-4" /></:icon>
        </.taskbar_button>
        <.taskbar_button window="channel-list" label={dgettext("chat", "Channel List")}>
          <:icon><Icons.icon_channels class="h-4 w-4" /></:icon>
        </.taskbar_button>
        <.taskbar_button
          :if={"cheatsheet" in @open_windows}
          window="cheatsheet"
          label={dgettext("chat", "Keyboard Shortcuts")}
        >
          <:icon><Icons.icon_dialog_cheatsheet class="h-4 w-4" /></:icon>
        </.taskbar_button>
        <.taskbar_button
          :if={@cc_window_channel}
          window="channel-central"
          label={dgettext("chat", "Channel Central")}
        >
          <:icon><Icons.icon_dialog_channel_central class="h-4 w-4" /></:icon>
        </.taskbar_button>
        <.taskbar_button
          :if={"account" in @open_windows}
          window="account"
          label={dgettext("chat", "Account")}
        >
          <:icon><Icons.icon_status_user class="h-4 w-4" /></:icon>
        </.taskbar_button>
        <.taskbar_button
          :if={"user-lookup" in @open_windows}
          window="user-lookup"
          label={dgettext("chat", "User Lookup")}
        >
          <:icon><Icons.icon_btn_search class="h-4 w-4" /></:icon>
        </.taskbar_button>
        <.taskbar_button
          :if={admin?(@session) and "admin-console-dialog" in @open_windows}
          window="admin-console-dialog"
          label={dgettext("chat", "Admin Console")}
        >
          <:icon><Icons.icon_dialog_admin_console class="h-4 w-4" /></:icon>
        </.taskbar_button>
        <.taskbar_button
          :if={admin?(@session) and "bot-management-dialog" in @open_windows}
          window="bot-management-dialog"
          label={dgettext("chat", "Bot Management")}
        >
          <:icon><Icons.icon_btn_bot_management class="h-4 w-4" /></:icon>
        </.taskbar_button>
        <.taskbar_button
          :if={"timers" in @open_windows}
          window="timers"
          label={dgettext("chat", "Timers")}
        >
          <:icon><Icons.icon_btn_timers class="h-4 w-4" /></:icon>
        </.taskbar_button>
        <.taskbar_button
          :if={@p2p_session && "p2p-stats" in @open_windows}
          window="p2p-stats"
          label={dgettext("chat", "P2P Statistics")}
        >
          <:icon><Icons.icon_status_signal class="h-4 w-4" /></:icon>
        </.taskbar_button>
        <.taskbar_button
          :if={@p2p_session && @p2p_session.state != :invite_sent}
          window="p2p-call"
          label={@p2p_session.peer_nick || dgettext("chat", "P2P Call")}
        >
          <:icon><Icons.icon_camera class="h-4 w-4" /></:icon>
        </.taskbar_button>
        <.taskbar_button
          :if={@p2p_session && @p2p_session.state != :invite_sent}
          window="p2p-files"
          label={dgettext("chat", "P2P Files")}
        >
          <:icon><Icons.icon_file_send class="h-4 w-4" /></:icon>
        </.taskbar_button>
        <.taskbar_button
          :if={@group_call}
          window="group-call"
          label={@group_call.channel_name || dgettext("chat", "Group Call")}
          data-testid="group-call-taskbar"
        >
          <:icon><Icons.icon_camera class="h-4 w-4" /></:icon>
        </.taskbar_button>
        <.taskbar_button
          :if={@p2p_session && "p2p-games" in @open_windows}
          window="p2p-games"
          label={dgettext("chat", "P2P Games")}
        >
          <:icon><Icons.icon_game_arcade class="h-4 w-4" /></:icon>
        </.taskbar_button>
        <.taskbar_button
          :if={@arcade_session && "arcade-games" in @open_windows}
          window="arcade-games"
          label={dgettext("chat", "Arcade")}
        >
          <:icon><Icons.icon_game_arcade class="h-4 w-4" /></:icon>
        </.taskbar_button>
        <.taskbar_button
          :if={"highlight" in @open_windows}
          window="highlight"
          label={dgettext("chat", "Highlight Words")}
        >
          <:icon><Icons.icon_star class="h-4 w-4" /></:icon>
        </.taskbar_button>
        <.taskbar_button
          :if={"sound-settings" in @open_windows}
          window="sound-settings"
          label={dgettext("chat", "Sound Settings")}
        >
          <:icon><Icons.icon_dialog_sound class="h-4 w-4" /></:icon>
        </.taskbar_button>
        <.taskbar_button
          :if={"flood-protection" in @open_windows}
          window="flood-protection"
          label={dgettext("chat", "Flood Protection")}
        >
          <:icon><Icons.icon_dialog_flood class="h-4 w-4" /></:icon>
        </.taskbar_button>
        <.taskbar_button
          :if={"alias" in @open_windows}
          window="alias"
          label={dgettext("chat", "Alias Editor")}
        >
          <:icon><Icons.icon_dialog_alias class="h-4 w-4" /></:icon>
        </.taskbar_button>
        <.taskbar_button
          :if={"custom-menus" in @open_windows}
          window="custom-menus"
          label={dgettext("chat", "Custom Menus")}
        >
          <:icon><Icons.icon_dialog_custom_menus class="h-4 w-4" /></:icon>
        </.taskbar_button>
        <.taskbar_button
          :if={"auto-respond" in @open_windows}
          window="auto-respond"
          label={dgettext("chat", "Auto Respond")}
        >
          <:icon><Icons.icon_dialog_auto_respond class="h-4 w-4" /></:icon>
        </.taskbar_button>
        <.taskbar_button
          :if={"perform" in @open_windows}
          window="perform"
          label={dgettext("chat", "Perform")}
        >
          <:icon><Icons.icon_dialog_perform class="h-4 w-4" /></:icon>
        </.taskbar_button>
        <.taskbar_button
          :if={"notify-list" in @open_windows}
          window="notify-list"
          label={dgettext("chat", "Notify List")}
        >
          <:icon><Icons.icon_tab_notify class="h-4 w-4" /></:icon>
        </.taskbar_button>
        <.taskbar_button
          :if={"address-book" in @open_windows}
          window="address-book"
          label={dgettext("chat", "Address Book")}
        >
          <:icon><Icons.icon_dialog_address_book class="h-4 w-4" /></:icon>
        </.taskbar_button>
        <:tray>
          <.desktop_tray>
            <span id="chat-tray-clock" phx-hook="ClockHook" class="font-mono tabular-nums"></span>
          </.desktop_tray>
        </:tray>
      </.taskbar>
    </:taskbar>
  </.desktop>

  <div
    :if={!@live_ready}
    class="absolute inset-0 z-[2000] flex items-center justify-center bg-background/95"
    data-testid="chat-boot-loading"
  >
    <.boot_activity_panel
      title={dgettext("chat", "RetroHexChat")}
      text={dgettext("chat", "Opening chat...")}
      icon={:chat}
    />
  </div>
</div>

<%!-- Hover card (stateful island — owns the nick hover-card state) --%>
<.live_component
  module={RetroHexChatWeb.ChatLive.Components.HoverCard}
  id={RetroHexChatWeb.ChatLive.Components.HoverCard.id()}
/>

<%!-- Context menus --%>
<.live_component
  module={RetroHexChatWeb.ChatLive.Components.UserContextMenus}
  id={RetroHexChatWeb.ChatLive.Components.UserContextMenus.id()}
  session={@session}
  channel_users={@channel_users}
  nick_color_fn={@nick_color_fn}
/>

<.live_component
  module={RetroHexChatWeb.ChatLive.Components.ConversationsContextMenu}
  id={RetroHexChatWeb.ChatLive.Components.ConversationsContextMenu.id()}
  muted_channels={@muted_channels}
  unread_counts={@unread_counts}
  session={@session}
/>

<%!-- Dialogs --%>
<.live_component
  module={RetroHexChatWeb.ChatLive.Components.MuteDurationDialog}
  id={RetroHexChatWeb.ChatLive.Components.MuteDurationDialog.id()}
/>

<.live_component
  module={RetroHexChatWeb.ChatLive.Components.InviteChannelPickerDialog}
  id={RetroHexChatWeb.ChatLive.Components.InviteChannelPickerDialog.id()}
  visible={@show_invite_channel_picker}
  channels={@session.channels}
/>

<.live_component
  module={RetroHexChatWeb.ChatLive.Components.KnockRequestDialog}
  id={RetroHexChatWeb.ChatLive.Components.KnockRequestDialog.id()}
  visible={@show_knock_request_dialog}
/>

<%!-- About: stateless, opened client-side via show_modal (logo + Help menu) --%>
<.about_dialog id="about-dialog" show={false} />

<.live_component
  module={RetroHexChatWeb.ChatLive.Components.DisconnectConfirmDialog}
  id={RetroHexChatWeb.ChatLive.Components.DisconnectConfirmDialog.id()}
/>

<.live_component
  module={RetroHexChatWeb.ChatLive.Components.P2PConfirmDialog}
  id={RetroHexChatWeb.ChatLive.Components.P2PConfirmDialog.id()}
/>

<.live_component
  module={RetroHexChatWeb.ChatLive.Components.GroupCallConfirmDialog}
  id={RetroHexChatWeb.ChatLive.Components.GroupCallConfirmDialog.id()}
/>

<%!-- P2P WebRTC anchor: the wrapper is keyed by session token so switching
      sessions replaces it wholesale — the hook remounts with a fresh
      RTCPeerConnection. The inner id MUST stay "lobby-webrtc": the media,
      game and file-transfer hooks locate the shared PC through it.
      NOT mounted during :invite_sent — the creator hasn't joined yet, and a
      hook here would fight the standalone page's RTCPeerConnection if the
      creator claims the session there instead. --%>
<div
  :if={@p2p_session && @p2p_session.state != :invite_sent}
  id={"p2p-session-#{@p2p_session.token}"}
  class="hidden"
>
  <div id="lobby-webrtc" phx-hook="LobbyWebRTCHook" phx-update="ignore" data-testid="p2p-webrtc">
  </div>
</div>

<%!-- Solo arcade anchor: gated on @arcade_session (NOT the window) so the
      ArcadeSession hook keeps polling the launched game window even while the
      picker is minimized or closed. Receives `open_game_window` and reports
      `game_window_closed`/`game_window_blocked`. --%>
<div
  :if={@arcade_session}
  id="arcade-session"
  phx-hook="ArcadeSession"
  phx-update="ignore"
  class="hidden"
  data-testid="arcade-session"
>
</div>

<.live_component
  module={RetroHexChatWeb.ChatLive.Components.DeleteConfirmDialog}
  id={RetroHexChatWeb.ChatLive.Components.DeleteConfirmDialog.id()}
/>

<.live_component
  module={RetroHexChatWeb.ChatLive.Components.NickChangeDialog}
  id={RetroHexChatWeb.ChatLive.Components.NickChangeDialog.id()}
/>

<.live_component
  module={RetroHexChatWeb.ChatLive.Components.PasteConfirmDialog}
  id={RetroHexChatWeb.ChatLive.Components.PasteConfirmDialog.id()}
/>

<.live_component
  module={RetroHexChatWeb.ChatLive.Components.InviteQueueDialog}
  id={RetroHexChatWeb.ChatLive.Components.InviteQueueDialog.id()}
  invites={@pending_invites}
/>

<.live_component
  module={RetroHexChatWeb.ChatLive.Components.KickQueueDialog}
  id={RetroHexChatWeb.ChatLive.Components.KickQueueDialog.id()}
/>
