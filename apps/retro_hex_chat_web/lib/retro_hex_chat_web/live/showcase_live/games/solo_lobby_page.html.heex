<.showcase_layout active_page={@active_page}>
  <h2 class="text-lg font-bold mb-3">{dgettext("showcase", "Solo Lobby")}</h2>

  <.showcase_card
    title={dgettext("showcase", "Lobby — Game Preview")}
    description={
      dgettext(
        "showcase",
        "The window a game opens from the Arcade folders: its sheet and Play now."
      )
    }
  >
    <div class="max-w-lg">
      <.solo_lobby
        id="lobby-preview"
        session_status="lobby"
        previewed_game={@sample_preview}
        on_select_game="arcade_select_game"
        on_back="arcade_back"
      />
    </div>
    <.code_example>
      &lt;.solo_lobby
      id="lobby-preview"
      session_status="lobby"
      previewed_game=&#123;@previewed_game&#125;
      on_select_game="arcade_select_game"
      on_back="arcade_back"
      /&gt;
    </.code_example>
  </.showcase_card>

  <.showcase_card
    title={dgettext("showcase", "Playing State")}
    description="Active game session with timer and end session button."
  >
    <div class="max-w-lg">
      <.solo_lobby
        id="lobby-playing"
        session_status="playing"
        game_name="DOOM"
        game_id="doom_shareware"
        game_started_at="2026-02-27T14:30:00Z"
      />
    </div>
    <.code_example>
      &lt;.solo_lobby
      id="lobby-playing"
      session_status="playing"
      game_name="DOOM"
      game_id="doom_shareware"
      game_started_at="2026-02-27T14:30:00Z"
      /&gt;
    </.code_example>
  </.showcase_card>

  <.showcase_card
    title={dgettext("showcase", "Finished State")}
    description="Session complete with play time summary."
  >
    <div class="max-w-lg">
      <.solo_lobby
        id="lobby-finished"
        session_status="finished"
        game_name="DOOM"
        game_id="doom_shareware"
        game_duration={1847}
      />
    </div>
    <.code_example>
      &lt;.solo_lobby
      id="lobby-finished"
      session_status="finished"
      game_name="DOOM"
      game_id="doom_shareware"
      game_duration=&#123;1847&#125;
      /&gt;
    </.code_example>
  </.showcase_card>

  <.showcase_card
    title={dgettext("showcase", "Inactivity Warning")}
    description="Warning overlay shown when a lobby session is about to time out."
  >
    <div class="max-w-lg">
      <.solo_lobby
        id="lobby-inactivity"
        session_status="lobby"
        previewed_game={@sample_preview}
        inactivity_warning={true}
      />
    </div>
    <.code_example>
      &lt;.solo_lobby
      id="lobby-inactivity"
      session_status="lobby"
      previewed_game=&#123;@previewed_game&#125;
      inactivity_warning=&#123;true&#125;
      /&gt;
    </.code_example>
  </.showcase_card>
</.showcase_layout>
