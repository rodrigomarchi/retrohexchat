<.showcase_layout active_page={@active_page}>
  <h2 class="text-lg font-bold mb-3">{dgettext("showcase", "Channel Central Dialog")}</h2>

  <.showcase_card
    title={dgettext("showcase", "Operator View")}
    description="Channel Central with full operator access — all fields are editable."
  >
    <div class="h-[420px] shadow-retro-field overflow-hidden p-2 flex flex-col">
      <.channel_central_panel
        id="channel-central-op"
        channel_name="#retro-chat"
        topic="Welcome to RetroHexChat! Type /help for commands."
        topic_set_by="Troll"
        topic_set_at="2025-12-15 14:30"
        created_at="2025-01-01 00:00"
        member_count={42}
        operator={true}
        modes={@sample_modes}
        list_type={@list_type}
        list_entries={@sample_lists[@list_type]}
        list_selected={@list_selected}
        on_list_type="cc_list_type"
        on_list_select="cc_list_select"
      />
    </div>

    <.code_example>
      &lt;.channel_central_panel
      id="channel-central"
      channel_name="#retro-chat"
      topic="Welcome!"
      topic_set_by="Troll"
      operator=&#123;true&#125;
      modes=&#123;%&#123;moderated: false, invite_only: true&#125;&#125;
      list_type="bans"
      list_entries=&#123;@bans&#125;
      on_topic_save="save-topic"
      on_mode_apply="apply-modes"
      on_list_type="switch-list"
      on_list_add="add-entry"
      on_list_remove="remove-entry"
      /&gt;
    </.code_example>
  </.showcase_card>

  <.showcase_card
    title={dgettext("showcase", "Regular User View")}
    description="Channel Central as a non-operator — topic and modes are read-only, list management is hidden."
  >
    <div class="h-[420px] shadow-retro-field overflow-hidden p-2 flex flex-col">
      <.channel_central_panel
        id="channel-central-user"
        channel_name="#lobby"
        topic="General discussion channel"
        topic_set_by="Admin"
        topic_set_at="2025-11-20 09:15"
        created_at="2025-01-01 00:00"
        member_count={128}
        operator={false}
        modes={%{moderated: true, invite_only: false, topic_lock: true, key: nil, limit: 200}}
        list_type="bans"
        list_entries={@sample_lists["bans"]}
      />
    </div>
  </.showcase_card>

  <.showcase_card
    title={dgettext("showcase", "Tabs Overview")}
    description="The dialog has 4 tabs for comprehensive channel management."
  >
    <div class="overflow-x-auto">
      <table class="w-full text-xs">
        <thead>
          <tr class="border-b">
            <th class="text-left px-2 py-1">{dgettext("showcase", "Tab")}</th>
            <th class="text-left px-2 py-1">{dgettext("showcase", "Contents")}</th>
            <th class="text-left px-2 py-1">{dgettext("showcase", "Operator Only")}</th>
          </tr>
        </thead>
        <tbody>
          <tr class="border-b">
            <td class="px-2 py-1 font-bold">{dgettext("showcase", "General")}</td>
            <td class="px-2 py-1">{dgettext("showcase", "Channel info, topic editing")}</td>
            <td class="px-2 py-1">{dgettext("showcase", "Topic save button")}</td>
          </tr>
          <tr class="border-b">
            <td class="px-2 py-1 font-bold">{dgettext("showcase", "Modes")}</td>
            <td class="px-2 py-1">
              {dgettext("showcase", "Moderated, invite-only, topic lock, key, limit")}
            </td>
            <td class="px-2 py-1">{dgettext("showcase", "Apply modes button, field editing")}</td>
          </tr>
          <tr class="border-b">
            <td class="px-2 py-1 font-bold">{dgettext("showcase", "Access Lists")}</td>
            <td class="px-2 py-1">
              {dgettext(
                "showcase",
                "Bans, ban exceptions and invite exceptions behind a type selector"
              )}
            </td>
            <td class="px-2 py-1">{dgettext("showcase", "Add/Remove buttons")}</td>
          </tr>
          <tr>
            <td class="px-2 py-1 font-bold">{dgettext("showcase", "Registration")}</td>
            <td class="px-2 py-1">
              {dgettext("showcase", "ChanServ registration and SOP/AOP/VOP access lists")}
            </td>
            <td class="px-2 py-1">{dgettext("showcase", "Register, drop, access management")}</td>
          </tr>
        </tbody>
      </table>
    </div>
  </.showcase_card>
</.showcase_layout>
