<.showcase_layout active_page={@active_page}>
  <h2 class="text-lg font-bold mb-3">{dgettext("showcase", "Conversations")}</h2>

  <.showcase_card
    title={dgettext("showcase", "Full Sidebar")}
    description="IRC-native conversations sidebar with activity, joined channels, recent PMs, auto-join entries, and popular channel suggestions."
  >
    <div class="max-w-[260px] shadow-retro-field bg-white">
      <.conversations
        id="demo-full"
        channels={["#lobby", "#help", "#random", "#dev", "#music"]}
        active_channel="#lobby"
        unread_channels={["#help", "#random"]}
        unread_counts={%{"#help" => 3, "#random" => 15, "pm:alice" => 2}}
        highlight_channels={["#random"]}
        flash_channels={["#random"]}
        muted_channels={["#music"]}
        disconnected_channels={["#dev"]}
        channel_user_counts={
          %{"#lobby" => 12, "#help" => 5, "#random" => 28, "#dev" => 3, "#music" => 8}
        }
        pm_conversations={["alice", "bob", "carol"]}
        open_pm_tabs={["bob"]}
        active_pm="bob"
        unread_pms={["alice"]}
        autojoin_entries={[
          %{channel_name: "#lobby", channel_key: nil, position: 0},
          %{channel_name: "#secret", channel_key: "demo-key", position: 1}
        ]}
        popular_channels={[
          %{name: "#gaming", user_count: 45},
          %{name: "#sports", user_count: 22},
          %{name: "#movies", user_count: 18}
        ]}
      />
    </div>
    <.code_example>
      &lt;.conversations
      channels=&#123;["#lobby", "#help"]&#125;
      active_channel="#lobby"
      unread_counts=&#123;%&#123;"#help" =&gt; 3&#125;&#125;
      channel_user_counts=&#123;%&#123;"#lobby" =&gt; 12&#125;&#125;
      autojoin_entries=&#123;[%&#123;channel_name: "#lobby"&#125;]&#125;
      disconnected_channels=&#123;["#dev"]&#125;
      on_channel_click="switch_channel"
      on_close="toggle_conversations"
      /&gt;
    </.code_example>
  </.showcase_card>

  <.showcase_card
    title={dgettext("showcase", "Empty State")}
    description="When no channels, PMs, auto-join entries, or discovery rows are available. Shows 'Browse channels' when on_browse_channels is set."
  >
    <div class="max-w-[260px] shadow-retro-field bg-white">
      <.conversations id="demo-empty" on_browse_channels="open_channel_list" />
    </div>
  </.showcase_card>

  <.showcase_card
    title={dgettext("showcase", "Channels Only")}
    description="Sidebar with joined channels but no PMs, auto-join entries, or discovery rows."
  >
    <div class="max-w-[260px] shadow-retro-field bg-white">
      <.conversations
        id="demo-channels"
        channels={["#general", "#announcements"]}
        active_channel="#general"
        channel_user_counts={%{"#general" => 34, "#announcements" => 12}}
      />
    </div>
  </.showcase_card>

  <.showcase_card
    title={dgettext("showcase", "Channel States")}
    description="Visual states: normal, active, unread, highlight, muted, disconnected, and flash."
  >
    <div class="max-w-[260px] shadow-retro-field bg-white">
      <.conversations
        id="demo-states"
        channels={["#normal", "#active", "#unread", "#highlight", "#muted", "#disconnected"]}
        active_channel="#active"
        unread_channels={["#unread", "#highlight"]}
        unread_counts={%{"#unread" => 5, "#highlight" => 42}}
        highlight_channels={["#highlight"]}
        muted_channels={["#muted"]}
        disconnected_channels={["#disconnected"]}
      />
    </div>
  </.showcase_card>
</.showcase_layout>
