<.landing_layout active_page={@active_page} windows={@windows}>
  <.landing_connect_window trusted_device_id={@trusted_device_id} active_page={@active_page} />

  <section class="m-4" aria-labelledby="faq-heading">
    <.landing_page_intro
      heading_id="faq-heading"
      title={dgettext("landing", "Retro Hex Chat FAQ")}
      description={
        dgettext(
          "landing",
          "Answers to common questions about peer-to-peer calls, self-hosting, server requirements, security, mobile support, contributing, and project sponsorship."
        )
      }
      status={dgettext("landing", "Frequently asked questions")}
    >
      <:icon><Icons.icon_question class="w-4 h-4" /></:icon>
    </.landing_page_intro>

    <div class="grid md:grid-cols-2 gap-4">
      <%!-- ══════════════ GETTING STARTED ══════════════ --%>
      <.desktop_window
        id="getting-started"
        width={520}
        title={dgettext("landing", "Getting Started")}
      >
        <:icon><Icons.icon_question class="w-4 h-4" /></:icon>
        <.accordion>
          <.accordion_item :for={entry <- entries("getting-started")}>
            <.accordion_trigger group={entry.group}>
              <:icon><Icons.icon_question class="w-4 h-4" /></:icon>
              {entry.question}
            </.accordion_trigger>
            <.accordion_content>
              <p class="text-sm">
                <.answer_part :for={part <- entry.answer} part={part} />
              </p>
            </.accordion_content>
          </.accordion_item>
        </.accordion>
        <:status>
          <.window_status_bar_field grow>
            {dgettext("landing", "8 questions")}
          </.window_status_bar_field>
        </:status>
      </.desktop_window>

      <%!-- ══════════════ TECHNICAL & COMMUNITY ══════════════ --%>
      <.desktop_window
        id="technical-community"
        width={480}
        title={dgettext("landing", "Technical & Community")}
      >
        <:icon><Icons.icon_code class="w-4 h-4" /></:icon>
        <.accordion>
          <.accordion_item :for={entry <- entries("technical-community")}>
            <.accordion_trigger group={entry.group}>
              <:icon><Icons.icon_question class="w-4 h-4" /></:icon>
              {entry.question}
            </.accordion_trigger>
            <.accordion_content>
              <p class="text-sm">
                <.answer_part :for={part <- entry.answer} part={part} />
              </p>
            </.accordion_content>
          </.accordion_item>
        </.accordion>
        <:status>
          <.window_status_bar_field grow>
            {dgettext("landing", "6 questions")}
          </.window_status_bar_field>
        </:status>
      </.desktop_window>
    </div>
  </section>
</.landing_layout>
