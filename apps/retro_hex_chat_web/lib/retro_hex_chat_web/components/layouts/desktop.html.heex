<!DOCTYPE html>
<html
  lang={RetroHexChatWeb.I18n.html_lang()}
  dir={RetroHexChatWeb.I18n.html_dir()}
  class="no-js"
  data-boot={assigns[:boot] || "deferred"}
  data-member={to_string(assigns[:visitor?] == false)}
>
  <head>
    <% head = @head %>
    <% canonical_path = head.canonical_path %>
    <% canonical_url = head.canonical_url %>
    <% hreflang_alternates? = head.hreflang? %>
    <% og_image = head.og_image %>
    <% page_title = head.title %>
    <% page_description = head.description %>

    <meta charset="utf-8" />
    <%!-- Inline and synchronous: the deferred bundles run after parse, which
          would let the scriptless layout paint for a frame. --%>
    <script>
      document.documentElement.classList.remove("no-js");
    </script>
    <.head_meta />

    <%!-- The tab's title has one writer once the desktop is live:
          DocumentTitleHook, which layers the chat's activity flash over the
          title of whatever is in front. This first-paint title is
          `initial_title`, which LiveView does not track — and with no `default`
          here, LiveView's mount-time `putTitle` leaves the hook alone. --%>
    <.live_title>{@initial_title}</.live_title>
    <meta name="description" content={page_description} />
    <%!-- An invite card is addressed to whoever was sent it, not to a crawler:
          a share link in the index is an invitation nobody extended. --%>
    <meta name="robots" content={head.robots} />
    <link rel="canonical" href={canonical_url} />
    <%!-- A page that is one of a run — an archive day too long for one page —
          names its neighbours, so a crawler can walk the day in order. --%>
    <link :if={head.prev_url} rel="prev" href={head.prev_url} />
    <link :if={head.next_url} rel="next" href={head.next_url} />
    <%!-- hreflang is a claim that the same page exists in another language.
          For a conversation it is false, so the archive emits none rather than
          pointing a search engine at the same text fourteen times. --%>
    <link
      :for={
        alternate <-
          if(hreflang_alternates?,
            do: RetroHexChatWeb.SEO.alternate_links(canonical_path),
            else: []
          )
      }
      rel="alternate"
      hreflang={alternate.hreflang}
      href={alternate.href}
    />

    <%!-- Open Graph --%>
    <meta property="og:type" content={head.og_type} />
    <meta property="og:title" content={page_title} />
    <meta property="og:description" content={page_description} />
    <meta property="og:url" content={canonical_url} />
    <meta property="og:site_name" content="Retro Hex Chat" />
    <meta property="og:image" content={og_image.url} />
    <meta property="og:image:width" content={og_image.width} />
    <meta property="og:image:height" content={og_image.height} />
    <meta property="og:image:type" content={og_image.type} />
    <meta property="og:image:alt" content={og_image.alt} />
    <meta
      property="og:locale"
      content={RetroHexChatWeb.I18n.open_graph_locale()}
    />
    <meta
      :for={
        locale <-
          if(hreflang_alternates?,
            do: RetroHexChatWeb.SEO.open_graph_alternate_locales(),
            else: []
          )
      }
      property="og:locale:alternate"
      content={locale}
    />

    <%!-- Twitter Card --%>
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={page_title} />
    <meta name="twitter:description" content={page_description} />
    <meta name="twitter:image" content={og_image.url} />
    <meta name="twitter:image:alt" content={og_image.alt} />

    <%!-- JSON-LD Structured Data. A page names what it is; only the home page
          describes the application, because the application is one entity and
          claiming it on all ninety-eight landing URLs described it ninety-eight
          times with the same `url`. --%>
    <script
      :for={json <- head.json_ld}
      type="application/ld+json"
    >
      <%= Phoenix.HTML.raw(json) %>
    </script>

    <%!-- Fonts and the icon sprite --%>
    <.head_assets />

    <.app_icons />

    <link phx-track-static rel="stylesheet" href={~p"/assets/css/retrohex.css"} />
    <%!-- The desktop's first-paint bundle: the window manager, the menus and
          the clock, so the page in front is usable before the chat is. It
          imports the chat's LiveSocket itself, once there is a reason to. --%>
    <script phx-track-static type="module" src={~p"/assets/js/desktop.js"}>
    </script>
    <script phx-track-static type="module" src={~p"/assets/js/faro_entry.js"}>
    </script>
  </head>
  <body class="bg-background font-system text-text">
    {@inner_content}
  </body>
</html>
